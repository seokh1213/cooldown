  "repairs": [
    {
      "path": "rules.1;rules.2",
      "issue": "담대함 기본 공격이 일반 ability hit로 확대됨, >1 조건 및 충전당/총합 계수 혼합",
      "correction": "attack 조건·전 충전 소모·충전당 scalar와 충전 수 총합을 분리하고 AP 시전자 소유를 정정했다.",
      "sourceId": "en:body",
      "quote": "Passive: Gain a stack (max 1/2/3/4/5) every 15 seconds and when hitting a Bravado Attack. Active: Consume all stacks to restore (25 + (15% Ability Power) + (1% Health)) Health per stack to nearby ally champions ((25/50/75/100/125 + (15/30/45/60/75% Ability Power) + (1/2/3/4/5% Health)) at 1/2/3/4/5 stacks)."
    },
    {
      "path": "rules.2.effects.1.parameters",
      "issue": "일반 Health 미지원 계수에 null stat/unknown owner 조합이 스키마와 불일치",
      "correction": "원문 Health 의미는 text/gap에 보존하고 stat null인 미형식 계수의 statSubject도 null로 정정했다.",
      "sourceId": "en:body",
      "quote": "(25 + (15% Ability Power) + (1% Health)) Health per stack"
    },
    {
      "path": "gaps.0.detail",
      "issue": "실제 null/null 미형식 Health 보존과 gap의 null/unknown 표현이 불일치",
      "correction": "스키마의 일반 Health 미지원에 따른 null/null 보존이라고 정확히 기술했다.",
      "sourceId": "en:body",
      "quote": "(25 + (15% Ability Power) + (1% Health)) Health per stack"
    }

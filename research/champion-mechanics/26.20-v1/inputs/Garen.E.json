  "slotRole": "ability",
  "sources": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Garen rapidly spins his sword around his body, dealing physical damage to nearby enemies.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Garen rapidly spins his sword for 3 seconds, dealing (4/7/10/13/16 + (40/43/46/49/52% Attack Damage)) physical damage 7 times over the duration. The nearest enemy takes 25% increased damage. Champions hit by 6 strikes lose 25% Armor for 6 seconds. Recast: Garen ends this Ability early. Gains one strike from every 25% Attack Speed from items and levels. Can critically strike for (4/7/10/13/16 + (40/43/46/49/52% Attack Damage)) × (0.7 + 30% Critical Strike Damage) physical damage.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "가렌이 검을 들고 빠르게 회전하여 주변 적에게 물리 피해를 입힙니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "가렌이 3초 동안 검을 들고 빠르게 회전하여 (4/7/10/13/16 + (40/43/46/49/52% 공격력))의 물리 피해를 7회 입힙니다. 가장 가까운 적을 대상으로는 피해량이 25% 증가합니다. 공격에 6번 맞은 챔피언은 6초 동안 방어력이 25% 감소합니다. 재사용 시: 이 스킬을 일찍 종료합니다. 아이템 및 레벨로 얻은 공격 속도 25%당 공격 횟수가 1회 증가합니다. 치명타가 적용될 수 있고 치명타 적용 시 (4/7/10/13/16 + (40/43/46/49/52% 공격력)) × (0.7 + 30% 치명타 피해량)의 물리 피해를 입힙니다.",
      "variant": null
    }
  ],

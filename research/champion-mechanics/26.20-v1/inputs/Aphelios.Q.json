    {
      "id": "variant:Crescendum:en",
      "text": "Crescendum Active: Aphelios deploys a lunar sentry equipped with Aphelios' off-hand weapon that lasts 20 seconds. Sentries activate when an enemy approaches and fire at them for ((35 ~ 125) + ((34% ~ 52%) bonus Attack Damage) + (50% Ability Power)) physical damage per shot over 4 seconds.",
      "locale": "en_US",

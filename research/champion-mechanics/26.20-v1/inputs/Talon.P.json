  "slotRole": "ability",
  "sources": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Talon's spells Wound champions and large monsters, stacking up to 3 times. When Talon attacks a champion with 3 stacks of Wound, they bleed for heavy damage over time.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Talon's Abilities apply a stack to champions and large jungle monsters they damage for 6 seconds (max 3 stacks). When Talon Attacks a target with 3 stacks, he deals an additional ((80 ~ 280) + (210% bonus Attack Damage)) physical damage over 2 seconds.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "탈론이 챔피언이나 대형 몬스터에게 스킬을 사용하면 최대 3회까지 중첩되는 상처가 남습니다. 상처가 3회 중첩된 챔피언에게 기본 공격을 가하면 출혈을 일으켜 일정 시간 동안 큰 피해를 입힙니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "탈론이 챔피언이나 대형 정글 몬스터에게 스킬을 사용해 피해를 입히면 6초 동안 중첩을 적용합니다. (최대 3회 중첩) 3회 중첩된 대상에게 탈론이 기본 공격을 가하면 2초에 걸쳐 ((80 ~ 280) + (210% 추가 공격력))의 물리 피해를 추가로 입힙니다.",
      "variant": null
    }
  ],

  "slotRole": "ability",
  "sources": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Empowers an allied champion for a short duration. The ally's basic attacks and spells deal bonus magic damage and slow the target.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Nami empowers an allied champion's next 3 Attacks and Abilities for 6 seconds, causing them to Slow their targets by (15/20/25/30/35% + (5% per 100 Ability Power)) for 1s and deal an additional (20/35/50/65/80 + (20% Ability Power)) magic damage. Deals (33% ~ 66%) damage to non-champions when empowering area of effect Abilities.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "잠시 동안 아군 챔피언들을 강화해, 기본 공격과 스킬 사용 시 추가 마법 피해를 입히고 대상에게 둔화를 걸 수 있게 만듭니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "나미가 6초 동안 아군 챔피언의 다음 기본 공격과 스킬 3회를 강화합니다. 강화된 기본 공격과 스킬은 대상을 1초 동안 (15/20/25/30/35% + (주문력 100당 5%))만큼 둔화시키고 (20/35/50/65/80 + (20% 주문력))의 마법 피해를 추가로 입힙니다. 광역 스킬 강화 시 챔피언이 아닌 유닛에게는 (33% ~ 66%)의 피해를 입힙니다.",
      "variant": null
    }
  ],

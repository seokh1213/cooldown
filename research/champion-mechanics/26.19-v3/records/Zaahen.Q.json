  "sourceRefs": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Zaahen slashes twice on his next attack, dealing bonus damage and healing himself. Zaahen can recast this ability to have his next attack deal bonus damage and knock up his target.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Zaahen slashes twice on his next Attack, dealing (15/30/45/60/75 + (20/25/30/35/40% bonus Attack Damage)) bonus physical damage and restoring 5/6/7/8/9% of his max Health. Recast: Zaahen's next Attack deals (30/60/90/120/150 + (20/25/30/35/40% bonus Attack Damage)) bonus physical damage and Knocks the target Up for 0.75 seconds. Healing reduced to 50% against non-champions. Deals an additional 100% bonus damage to monsters.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "자헨이 다음 기본 공격 시 두 번 공격하며 추가 피해를 입히고 체력을 회복합니다. 자헨은 이 스킬을 다시 사용해 다음 기본 공격 시 대상에게 추가 피해를 입히고 공중에 띄울 수 있습니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "자헨이 다음 기본 공격 시 두 번 공격하며 (15/30/45/60/75 + (20/25/30/35/40% 추가 공격력))의 추가 물리 피해를 입히고 최대 체력의 5/6/7/8/9%만큼 체력을 회복합니다. 재사용 시: 다음 기본 공격 시 대상에게 (30/60/90/120/150 + (20/25/30/35/40% 추가 공격력))의 추가 물리 피해를 입히고 0.75초 동안 공중에 띄웁니다. 대상이 챔피언이 아닐 경우 체력 회복량이 50%로 감소합니다. 몬스터에게는 100%의 추가 피해를 입힙니다.",
      "variant": null
    }
  ],

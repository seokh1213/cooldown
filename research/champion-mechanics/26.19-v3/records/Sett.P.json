    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Sett's Attacks alternate between left and right punches. Right punches follow the left quickly and deal an additional ((5 ~ 90) + (55% bonus Attack Damage)) physical damage. Sett gains (0.15 ~ 2.00) Health Regeneration for each 5% missing Health.",
      "variant": null
    },
    {

    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Jarvan heroically leaps to an enemy Champion, dealing (200/325/450 + (180% bonus Attack Damage)) physical damage to them and surrounding enemies and creating an arena of impassable terrain around them for 3.5 seconds. Jarvan can Recast to collapse the terrain.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",

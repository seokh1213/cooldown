    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Bel'Veth slams her tail, dealing (80/140/200/260/320 + (150% bonus Ability Power)) magic damage, Knocking Up foes for 0.6/0.7/0.8/0.9/1 seconds, and Slowing them by 30% for 2 seconds. If a champion is hit, this refreshes the Cooldown of Void Surge in that direction.",
      "variant": null
    },

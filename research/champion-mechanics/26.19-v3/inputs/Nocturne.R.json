  "slotRole": "ability",
  "sources": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Nocturne reduces the sight radius of all enemy champions and removes their ally vision in the process. He can then launch himself at a nearby enemy champion.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Nocturne darkens the map, reducing the sight radius of all enemy champions and removing their vision of allies for 6 seconds. Nocturne can Recast this Ability during the duration to launch himself at an enemy champion dealing (150/275/400 + (120% bonus Attack Damage)) physical damage.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "녹턴이 모든 적 챔피언의 시야 반경을 줄이고 적 챔피언들 사이의 시야 공유를 중단합니다. 스킬 사용 후 적 챔피언을 대상으로 설정할 경우 그 챔피언에게 날아가 공격합니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "녹턴이 전장을 어둠으로 뒤덮어 6초 동안 모든 적 챔피언의 시야 반경을 줄이고 시야 공유를 차단합니다. 지속시간 중에 스킬을 재사용하면 적 챔피언에게 돌격해 (150/275/400 + (120% 추가 공격력))의 물리 피해를 입힙니다.",
      "variant": null
    }
  ],

    "llm:translate-matchups": "tsx scripts/llm/translate-matchups.ts",
    "llm:translate-rules": "tsx scripts/llm/translate-rules.ts",
    "llm:translate-rules-zh": "tsx scripts/llm/translate-rules-zh.ts",
    "llm:validate": "tsx scripts/llm/validate-knowledge.ts",
    "llm:test": "tsx scripts/llm/quality/run.ts",
    "llm:test:audit": "tsx scripts/llm/quality/audit.ts --refresh",
    "llm:test:generation": "tsx scripts/llm/quality/generation.ts",
    "llm:test:ui": "tsx scripts/llm/quality/run.ts --profile ui"

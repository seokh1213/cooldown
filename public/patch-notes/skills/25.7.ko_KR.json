}},"Q:다르킨 단검":{"slot":"Q","skill":{"id":"NaafiriQ","name":"다르킨 단검","description":"나피리가 최대 두 개의 단검을 던져 각 단검으로 출혈을 일으킵니다. 대상이 이미 출혈 상태라면 그 대신 추가 피해를 입힙니다.<br><br>무리가 이 스킬에 적중당한 챔피언을 향해 도약해 공격합니다.<br>","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[55,60,65,70,75],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"55/60/65/70/75","costType":"마나","rankValues":[]}},"R:사냥개의 추적":{"slot":"R","skill":{"id":"NaafiriW","name":"사냥개의 추적","description":"나피리와 무리가 챔피언에게 돌진해 피해를 입힙니다. 나피리가 처치 관여를 달성하면 주위 적들을 드러내고 이 스킬을 한 번 재사용할 수 있습니다. 두 번째 사용 시 보호막을 얻습니다.","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"마나","rankValues":[]}}},"Trundle":{"E:얼음 기둥":{"slot":"E","skill":{"id":"TrundleCircle","name":"얼음 기둥","description":"트런들이 목표 지점에 지나갈 수 없는 얼음 돌기둥을 생성합니다. 얼음 기둥 주변을 지나가는 모든 적 유닛의 이동 속도가 낮아집니다.","maxrank":5,"cooldown":[21,19.5,18,16.5,15],"cost":[75,75,75,75,75],"image":{"full":"TrundleCircle.png","sprite":"spell14.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"21/19.5/18/16.5/15","costBurn":"75/75/75/75/75","costType":"마나","rankValues":[]}}},"Yorick":{"Q:최후의 의식":{"slot":"Q","skill":{"id":"YorickQ","name":"최후의 의식","description":"요릭이 다음번 기본 공격 시 추가 피해를 입히고 체력을 회복합니다. 대상을 처치하면 무덤이 생성됩니다.","maxrank":5,"cooldown":[6,5.5,5,4.5,4],"cost":[20,20,20,20,20],"image":{"full":"YorickQ.png","sprite":"spell16.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"6/5.5/5/4.5/4","costBurn":"20/20/20/20/20","costType":"마나","rankValues":[]}},"P:영혼의 길잡이":{"slot":"P","passive":{"name":"영혼의 길잡이","description":"<font color='#FF9900'>저주받은 무리:</font> 요릭이 안개 망령 무리를 소환해 주변 적을 공격합니다.","image":{"full":"Yorick_P.png","sprite":"passive5.png","group":"passive","x":48,"y":48,"w":48,"h":48},"rankValues":[]}},"E:애도의 안개":{"slot":"E","
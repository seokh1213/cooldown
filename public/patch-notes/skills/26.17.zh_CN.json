{"schemaVersion":1,"patchVersion":"26.17","sources":{"ddragon":"16.17.1","cdragon":"16.17"},"locale":"zh_CN","champions":{"AurelionSol":{"Q:星河冲荡":{"slot":"Q","skill":{"id":"AurelionSolQ","name":"星河冲荡","description":"奥瑞利安·索尔引导他的龙息若干秒，伤害首个命中的敌人并对附近的敌人们造成削减过的溅射伤害。龙息在一个敌人身上每直接引导一秒就会造成额外伤害，这个伤害可通过已收集的【星尘】来提升。如果目标是一名英雄，那么这个技能还会收集【星尘】。","maxrank":5,"cooldown":[3],"cost":[30,35,40,45,50],"image":{"full":"AurelionSolQ.png","sprite":"spell1.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"3","costBurn":"30/35/40/45/50","costType":"法力","rankValues":[]}},"W:星穹流丽":{"slot":"W","skill":{"id":"AurelionSolW","name":"星穹流丽","description":"奥瑞利安 · 索尔沿着目标方向飞越地形。在这个状态下，他可以施放其它技能。飞行期间，星河冲荡没有冷却时间，也没有最长蓄力时间，并且造成的伤害会提升。<br><br>如果有敌方英雄因为奥瑞利安 · 索尔近期造成的伤害阵亡，星穹流丽的冷却时间会缩短。<br><br>星尘会提升星穹流丽的最大飞行距离。","maxrank":5,"cooldown":[22,20,18,16,14],"cost":[50,55,60,65,70],"image":{"full":"AurelionSolW.png","sprite":"spell1.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"22/20/18/16/14","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Chogath":{"E:恐惧之刺":{"slot":"E","skill":{"id":"VorpalSpikes","name":"恐惧之刺","description":"科加斯的攻击会释放致命的尖刺，伤害并减速面前所有的敌人。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[30,30,30,30,30],"image":{"full":"VorpalSpikes.png","sprite":"spell3.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[{"label":"基础伤害","values":"30 / 50 / 70 / 90 / 110"},{"label":"减速持续时间","values":"1.5秒"}]},"icons":[{"file":"patch-notes/icons/0f04fc9b7f1df1ee1ffa8625d7cd1839.webp","spellId":"VorpalSpikes"}]}},"Qiyana":{"Q:元素之怒 / 以绪塔尔之锋":{"slot":"Q","skill":{"id":"QiyanaQ","name":"元素之怒 / 以绪塔尔之锋","description":"奇亚娜挥舞她的武器，造成伤害和基于她元素的额外效果。","maxrank":5,"cooldown":[7],"cost":[35,35,35,35,35],"image":{"full":"QiyanaQ.png","sprite":"spell11.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"7","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[{"label":"基础伤害","values":
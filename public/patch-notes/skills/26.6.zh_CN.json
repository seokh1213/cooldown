{"schemaVersion":1,"patchVersion":"26.6","sources":{"ddragon":"16.6.1","cdragon":"16.6"},"locale":"zh_CN","champions":{"Lissandra":{"Q:寒冰碎片":{"slot":"Q","skill":{"id":"LissandraQ","name":"寒冰碎片","description":"掷出一杆冰矛，冰矛会在命中敌人时碎裂，造成魔法伤害和减速效果。碎裂会穿过目标，对被冰矛命中的其他敌人造成等量伤害。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"LissandraQ.png","sprite":"spell7.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}}},"Shyvana":{"Q:焚焰打击":{"slot":"Q","skill":{"id":"ShyvanaQ","name":"焚焰打击","description":"希瓦娜的下次攻击会打击目标和周围区域。这个技能可以再次施放。在【魔龙形态】下，它提供一次额外的再次施放，对单体目标造成巨额伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaQ.png","sprite":"spell12.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"W:烈火圣盾":{"slot":"W","skill":{"id":"ShyvanaW","name":"烈火圣盾","description":"希瓦娜获得一个护盾和移动速度，并在短暂延迟后，她周围的区域会被引爆。在【魔龙形态】下，这次爆炸如果击中一个敌方英雄，则会治疗希瓦娜。","maxrank":5,"cooldown":[14,13.5,13,12.5,12],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaW.png","sprite":"spell12.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"14/13.5/13/12.5/12","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[{"label":"基础伤害","values":"80 / 100 / 120 / 140 / 160"}]},"icons":[{"file":"patch-notes/icons/a27b376c05217e64f4e7c8e47ddc8632.webp","spellId":"ShyvanaW"}]},"E:爆炎吐息":{"slot":"E","skill":{"id":"ShyvanaE","name":"爆炎吐息","description":"希瓦娜发射一团火球，火球在击中一个大型目标时爆炸并将其减速。在【魔龙形态】下，它会穿过敌人并在击中大型目标时爆炸，还会留下一条烈焰轨迹。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaE.png","sprite":"spell12.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[{"label":"基础伤害","values":"80 / 110 / 140 / 170 / 200"},{"label":"减速持续时间","values":"2秒"}]},"icons":[{"file":"patch-notes/icons/8309d2c79c90048d35
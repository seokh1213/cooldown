{"schemaVersion":1,"patchVersion":"25.19","sources":{"ddragon":"15.19.1","cdragon":"15.19"},"locale":"zh_CN","champions":{"Lillia":{"R:夜阑谣":{"slot":"R","skill":{"id":"LilliaR","name":"夜阑谣","description":"莉莉娅使所有带着【梦尘】的敌人陷入困倦状态，然后陷入昏睡状态。这些敌人在被强制唤醒时会受到额外伤害。","maxrank":3,"cooldown":[140,120,100],"cost":[50,50,50],"image":{"full":"LilliaR.png","sprite":"spell7.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"140/120/100","costBurn":"50/50/50","costType":"法力","rankValues":[]}}},"Syndra":{"E:弱者退散":{"slot":"E","skill":{"id":"SyndraE","name":"弱者退散","description":"辛德拉将敌人和暗黑法球击退，并造成魔法伤害。被暗黑法球命中的敌人会被晕眩。","maxrank":5,"cooldown":[15],"cost":[50,50,50,50,50],"image":{"full":"SyndraE.png","sprite":"spell13.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"15","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"Q:暗黑法球":{"slot":"Q","skill":{"id":"SyndraQ","name":"暗黑法球","description":"辛德拉幻化出一个造成魔法伤害的暗黑法球。法球会存留，并且被她的其它能力所操纵。","maxrank":5,"cooldown":[7],"cost":[40,45,50,55,60],"image":{"full":"SyndraQ.png","sprite":"spell13.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"7","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}}},"Ahri":{"R:灵魄突袭":{"slot":"R","skill":{"id":"AhriR","name":"灵魄突袭","description":"阿狸向前猛冲，并放出元气弹，对周围的数个敌人造成伤害。灵魄突袭在进入冷却阶段以前最多可被施放三次，并在参与击杀敌方英雄后获得额外的再次施放次数。","maxrank":3,"cooldown":[140,120,100],"cost":[100,100,100],"image":{"full":"AhriR.png","sprite":"spell0.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"140/120/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Brand":{"P:炽热之焰":{"slot":"P","passive":{"name":"炽热之焰","description":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","image":{"full":"BrandP.png","sprite":"passive0.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}},"W:烈焰之柱":{"slot":"W","skill":{"id":"BrandW","name":"烈焰之柱","description":"在短暂的延迟后，布兰德会在目标区域创造一根烈焰之柱，来对范围内的敌方单位造成魔法伤害。带有【烈焰焚身】效果的单位会额外受到25%伤害。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[60,70,80,90,100],"image":{"full":"BrandW.png","sprite":"spell2.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}},"R:烈焰风暴":{"slot":"R","skill":{"id":"BrandR","name":"烈焰风暴","description":"布兰德释放一颗破坏力极强的火焰之种，火焰之种会在布兰德和附近敌人之间弹跳至多5次，每次弹跳时对敌人造成魔法伤害。弹跳会优先以带有即将满层的【炽热之焰】效果的英雄为目标。如果目标带有【烈焰焚身】效果，那么【R烈焰风暴】将使目标短暂减速。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"BrandR.png","sprite":"spell2.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Caitlyn":{},"Corki":{"Q:磷光炸弹":{"slot":"Q","skill":{"id":"PhosphorusBomb","name":"磷光炸弹","description":"库奇向目标区域发射一枚闪光弹，对范围内的敌人造成魔法伤害。这个技能还会暂时让目标区域附近的非隐形的单位和英雄现形。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[60,65,70,75,80],"image":{"full":"PhosphorusBomb.png","sprite":"spell2.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Diana":{"P:月银之刃":{"slot":"P","passive":{"name":"月银之刃","description":"每第三次攻击就会溅射周围的敌人，造成额外的魔法伤害。在施放一个技能后，黛安娜获得持续5秒的攻击速度。","image":{"full":"Diana_Passive_LunarBlade.png","sprite":"passive0.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}}},"Draven":{"W:血性冲刺":{"slot":"W","skill":{"id":"DravenFury","name":"血性冲刺","description":"德莱文获得移动速度和攻击速度加成。移动速度加成在持续时间过后会急剧下降。在接到一把旋转飞斧后，血性冲刺会立刻冷却完毕。","maxrank":5,"cooldown":[12],"cost":[40,35,30,25,20],"image":{"full":"DravenFury.png","sprite":"spell3.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"12","costBurn":"40/35/30/25/20","costType":"法力","rankValues":[]}},"R:冷血追命":{"slot":"R","skill":{"id":"DravenRCast","name":"冷血追命","description":"德莱文掷出两柄大斧，对命中的每个单位造成物理伤害。在命中一名敌方英雄后，大斧会缓慢地调转方向，并回到德莱文身边。在斧头正在向外飞的时候，德莱文可以激活该技能来让斧头早点飞回来。每命中一个单位，伤害值就会减少。在斧头调转方向时，伤害值会重置。会处决那些生命值低于德莱文崇拜层数的敌人们。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"DravenRCast.png","sprite":"spell3.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Jax":{"R:武器大师":{"slot":"R","skill":{"id":"JaxR","name":"武器大师","description":"每连续攻击2次，第3次攻击就会造成额外的魔法伤害。另外，贾克斯可以激活这个技能来在他周围造成伤害并增强他的决心，从而暂时性地提升他的护甲和魔法抗性。","maxrank":3,"cooldown":[110,100,90],"cost":[100,100,100],"image":{"full":"JaxR.png","sprite":"spell5.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"110/100/90","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Jinx":{"Q:枪炮交响曲！":{"slot":"Q","skill":{"id":"JinxQ","name":"枪炮交响曲！","description":"金克丝可以通过切换武器来改变普通攻击的方式。在用她的轻机枪“砰砰”攻击时，她的攻击速度会提升。在用她的火箭发射器“鱼骨头”攻击时，她的普通攻击会造成范围伤害，攻击距离提升，但会消耗法力值并且攻击得更慢。","maxrank":5,"cooldown":[0.9],"cost":[20,20,20,20,20],"image":{"full":"JinxQ.png","sprite":"spell5.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"0.9","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}},"E:嚼火者手雷！":{"slot":"E","skill":{"id":"JinxE","name":"嚼火者手雷！","description":"金克丝扔出一串陷阱手雷。手雷会在5秒后爆炸，让敌人着火。嚼火者手雷将会袭击路过的敌方英雄，并将他们束缚在原地。","maxrank":5,"cooldown":[24,20.5,17,13.5,10],"cost":[90,90,90,90,90],"image":{"full":"JinxE.png","sprite":"spell5.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"24/20.5/17/13.5/10","costBurn":"90/90/90/90/90","costType":"法力","rankValues":[]}}},"Leblanc":{"W:魔影迷踪":{"slot":"W","skill":{"id":"LeblancW","name":"魔影迷踪","description":"乐芙兰位移至目标位置，并对目标位置附近的敌人造成伤害。在接下来的4秒里，她可以激活此技能来回到她的初始位置。","maxrank":5,"cooldown":[15,13.75,12.5,11.25,10],"cost":[60,70,80,90,100],"image":{"full":"LeblancW.png","sprite":"spell7.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"15/13.75/12.5/11.25/10","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}},"R:故技重施":{"slot":"R","skill":{"id":"LeblancR","name":"故技重施","description":"乐芙兰可以施放她一个技能的故技重施版。","maxrank":3,"cooldown":[45,35,25],"cost":[0,0,0],"image":{"full":"LeblancR.png","sprite":"spell7.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"45/35/25","costBurn":"0/0/0","costType":"法力","rankValues":[]}}},"LeeSin":{"Q:天音波/回音击":{"slot":"Q","skill":{"id":"LeeSinQOne","name":"天音波/回音击","description":"天音波：李青发出刺耳的声波定位敌人，对首个敌人造成物理伤害。如果天音波击中敌人，李青在接下来3秒可施放回音击。<br>回音击：李青冲向被天音波击中的敌人，造成基于该目标已损失生命值的物理伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[50,50,50,50,50],"image":{"full":"LeeSinQOne.png","sprite":"spell7.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}}},"Mel":{"P:灼灼之光":{"slot":"P","passive":{"name":"灼灼之光","description":"每当梅尔使用技能，她的下一次攻击将额外附带3枚弹体（最多9枚）。<br><br>当梅尔通过一次技能或攻击造成伤害时，她会施加【夺命残影】——一种可以无限叠加的效果。如果目标身上叠加了足够的夺命残影伤害量，则会在下一次被梅尔命中时被直接处决，同时消耗效果层数。","image":{"full":"Mel_Passive.png","sprite":"passive2.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}}},"Pantheon":{"Q:贯星长枪":{"slot":"Q","skill":{"id":"PantheonQ","name":"贯星长枪","description":"潘森朝着选定方向刺出或投掷他的长枪。","maxrank":5,"cooldown":[11,10.25,9.5,8.75,8],"cost":[25,25,25,25,25],"image":{"full":"PantheonQ.png","sprite":"spell10.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"11/10.25/9.5/8.75/8","costBurn":"25/25/25/25/25","costType":"法力","rankValues":[]}},"W:斗盾跃击":{"slot":"W","skill":{"id":"PantheonW","name":"斗盾跃击","description":"潘森跃向一个目标，对其造成伤害和晕眩。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[55,55,55,55,55],"image":{"full":"PantheonW.png","sprite":"spell10.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"55/55/55/55/55","costType":"法力","rankValues":[]}}},"Poppy":{"Q:圣锤猛击":{"slot":"Q","skill":{"id":"PoppyQ","name":"圣锤猛击","description":"波比挥舞她的铁锤，造成伤害并创造一个区域，这个区域会减速敌人并在一段时间后爆炸。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[35,40,45,50,55],"image":{"full":"PoppyQ.png","sprite":"spell10.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[]}},"R:持卫的裁决":{"slot":"R","skill":{"id":"PoppyR","name":"持卫的裁决","description":"波比引导一次能够把敌人击飞到远方的锤击。","maxrank":3,"cooldown":[140,120,100],"cost":[100,100,100],"image":{"full":"PoppyR.png","sprite":"spell10.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"140/120/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Seraphine":{"Q:清籁穿云":{"slot":"Q","skill":{"id":"SeraphineQ","name":"清籁穿云","description":"萨勒芬妮在一个区域内造成伤害。","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[60,70,80,90,100],"image":{"full":"SeraphineQ.png","sprite":"spell12.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}},"W:聚和心声":{"slot":"W","skill":{"id":"SeraphineW","name":"聚和心声","description":"萨勒芬妮为附近的友军提供护盾和急速。如果她身上已有护盾，那么还会治疗附近的友军。","maxrank":5,"cooldown":[22],"cost":[70,75,80,85,90],"image":{"full":"SeraphineW.png","sprite":"spell12.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"22","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}}},"Sivir":{"Q:回旋之刃":{"slot":"Q","skill":{"id":"SivirQ","name":"回旋之刃","description":"希维尔像挥舞回力标一样挥出她的十字刃，并在往返时造成伤害。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[55,60,65,70,75],"image":{"full":"SivirQ.png","sprite":"spell12.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}}}}}
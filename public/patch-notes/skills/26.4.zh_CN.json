{"schemaVersion":1,"patchVersion":"26.4","sources":{"ddragon":"16.4.1","cdragon":"16.4"},"locale":"zh_CN","champions":{"Annie":{"E:熔岩护盾":{"slot":"E","skill":{"id":"AnnieE","name":"熔岩护盾","description":"为安妮或一名友军提供一层护盾、一个爆发性的移动速度加成并且对任何用攻击或技能袭击她的敌人造成伤害。","maxrank":5,"cooldown":[10],"cost":[60,65,70,75,80],"image":{"full":"AnnieE.png","sprite":"spell1.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"10","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"Q:碎裂之火":{"slot":"Q","skill":{"id":"AnnieQ","name":"碎裂之火","description":"安妮向目标投出注入了法力值的火球，对目标造成魔法伤害。如果目标死于碎裂之火，则碎裂之火消耗的法力值会返还给安妮，且碎裂之火的冷却时间减半。","maxrank":5,"cooldown":[4],"cost":[60,65,70,75,80],"image":{"full":"AnnieQ.png","sprite":"spell1.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"4","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Braum":{"R:冰川裂隙":{"slot":"R","skill":{"id":"BraumRWrapper","name":"冰川裂隙","description":"布隆敲击地面，击飞他身边和前方一条直线上的所有敌人。此外，还会在前方的直线上留下一条能让敌方减速的裂隙。","maxrank":3,"cooldown":[130,115,100],"cost":[100,100,100],"image":{"full":"BraumRWrapper.png","sprite":"spell2.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Hwei":{"R:焚心绚华绘":{"slot":"R","skill":{"id":"HweiR","name":"焚心绚华绘","description":"彗画出深重的绝望。命中的第一个敌人会成为画卷的中心。画卷向四周展开，减速并伤害附近的敌人们。展开至最大时，或是中心的敌人死亡时，画卷会发生爆炸。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"HweiR.png","sprite":"spell5.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"W:明鏡止水（WW）":{"slot":"W","skill":{"id":"HweiW","name":"明鏡止水（WW）","description":"彗画下眼中所见到的宁静，抚慰并激励众人。<br><br>这个技能会用这些功能型技能替换掉彗的技能：飞染、渲浓、宿墨","maxrank":5,"cooldown":[],"image":{"full":"HweiW.png","sprite":"spell4.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}}},"Kennen":{"R:秘奥义！万雷天牢引":{"slot":"R","skill":{"id":"KennenShurikenStorm","name":"秘奥义！万雷天牢引","description":"凯南召唤出一团风暴，会对周围的所有敌方英雄造成魔法伤害。","maxrank":3,"cooldown":[120],"cost":[0,0,0],"image":{"full":"KennenShurikenStorm.png","sprite":"spell6.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"120","costBurn":"0/0/0","costType":"能量","rankValues":[]}}},"Lux":{"Q:光之束缚":{"slot":"Q","skill":{"id":"LuxLightBinding","name":"光之束缚","description":"拉克丝释放一个光球，束缚并伤害最多两个敌方单位。","maxrank":5,"cooldown":[10],"cost":[50,50,50,50,50],"image":{"full":"LuxLightBinding.png","sprite":"spell8.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"10","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"W:曲光屏障":{"slot":"W","skill":{"id":"LuxPrismaticWave","name":"曲光屏障","description":"拉克丝掷出她的魔杖，魔杖所触及的友方单位会有光环环绕，保护他们免受敌方伤害。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[60,65,70,75,80],"image":{"full":"LuxPrismaticWave.png","sprite":"spell8.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Naafiri":{"Q:暗裔犬牙":{"slot":"Q","skill":{"id":"NaafiriQ","name":"暗裔犬牙","description":"纳亚菲利猛投出两根犬牙，每根都会施加流血效果，或在目标已经流血时施加额外伤害。<br><br>狗群伙伴们会跃向并攻击被这个技能命中的英雄或野怪。<br>","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[50,60,70,80,90],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}},"E:剔骨本能":{"slot":"E","skill":{"id":"NaafiriE","name":"剔骨本能","description":"纳亚菲利冲刺并伤害她附近一个区域内的敌人们，唤回她的狗群并完全回复它们的生命值。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[40,40,40,40,40],"image":{"full":"NaafiriE.png","sprite":"spell9.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Xayah":{"Q:双刃":{"slot":"Q","skill":{"id":"XayahQ","name":"双刃","description":"霞扔出两把具有伤害的匕首，并掉落可供她召回的羽毛。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[35,35,35,35,35],"image":{"full":"XayahQ.png","sprite":"spell16.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}},"W:致死羽衣":{"slot":"W","skill":{"id":"XayahW","name":"致死羽衣","description":"霞创造一道刀刃风暴，来提升她的攻击速度和伤害，并且如果她的攻击命中了敌人，还会提升她的移动速度。","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[60,55,50,45,40],"image":{"full":"XayahW.png","sprite":"spell16.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"60/55/50/45/40","costType":"法力","rankValues":[]}},"E:倒钩":{"slot":"E","skill":{"id":"XayahE","name":"倒钩","description":"霞唤回她之前掉落的所有羽毛，对敌人造成伤害和禁锢效果。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[20,20,20,20,20],"image":{"full":"XayahE.png","sprite":"spell16.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}}},"Ambessa":{"Q:暗袭 / 裂斩":{"slot":"Q","skill":{"id":"AmbessaQ","name":"暗袭 / 裂斩","description":"安蓓萨甩出链刃横扫她前方的半圆区域，对被链刃命中的敌人造成额外伤害。击中一个敌人后，该技能在短时间内的下一次施放会发生变化，使她向前方的一条直线猛砸链刃，对命中的首个敌人造成额外伤害。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[70,70,70,70,70],"image":{"full":"AmbessaQ.png","sprite":"spell0.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"70/70/70/70/70","costType":"能量","rankValues":[]}}},"Aphelios":{"P:传知者与真知者":{"slot":"P","passive":{"name":"传知者与真知者","description":"厄斐琉斯拥有5件由他妹妹拉露恩所制的皎月武器。他同一时间可以使用2件：1件主手武器和1件副手武器。每件武器都有1种独特的普攻方式和1个独特的技能。攻击和技能都会消耗该武器的弹药。在弹药耗尽后，厄斐琉斯会弃掉该武器，并且拉露恩会召唤下一件武器给厄斐琉斯。 ","image":{"full":"ApheliosP.png","sprite":"passive0.png","group":"passive","x":432,"y":0,"w":48,"h":48},"rankValues":[]}}},"Brand":{"P:炽热之焰":{"slot":"P","passive":{"name":"炽热之焰","description":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","image":{"full":"BrandP.png","sprite":"passive0.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}}},"Camille":{"E:钩索":{"slot":"E","skill":{"id":"CamilleE","name":"钩索","description":"卡蜜尔将她自己拉向一个墙体，然后跳下并在落地时击飞敌方英雄。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[70,70,70,70,70],"image":{"full":"CamilleE.png","sprite":"spell2.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Darius":{"P:出血":{"slot":"P","passive":{"name":"出血","description":"德莱厄斯的攻击和伤害技能会导致敌人流血，在5秒里持续造成物理伤害，最多叠加5次。在他的目标达到最大层数后，德莱厄斯会进入激怒状态并获得巨额攻击力。","image":{"full":"Darius_Icon_Hemorrhage.png","sprite":"passive0.png","group":"passive","x":240,"y":96,"w":48,"h":48},"rankValues":[]}}},"Fizz":{"W:海石三叉戟":{"slot":"W","skill":{"id":"FizzW","name":"海石三叉戟","description":"菲兹的攻击会让他的敌人们流血，同时造成持续数秒的魔法伤害。菲兹可以强化他的下次普攻来造成额外伤害，并在短时间内强化他的后续普攻。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[30,40,50,60,70],"image":{"full":"FizzW.png","sprite":"spell3.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"30/40/50/60/70","costType":"法力","rankValues":[]}}},"Graves":{"E:快速拔枪":{"slot":"E","skill":{"id":"GravesMove","name":"快速拔枪","description":"格雷福斯向前冲刺，获得一层持续数秒的护甲和魔法抗性加成。如果格雷福斯朝着一名敌方英雄冲刺，则会获得两层纯爷们效果。格雷福斯的每次未被闪避的普通攻击，都会减少这个技能的冷却时间并刷新该防御属性加成。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[40,40,40,40,40],"image":{"full":"GravesMove.png","sprite":"spell4.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Gwen":{"Q:快刀剪乱":{"slot":"Q","skill":{"id":"GwenQ","name":"快刀剪乱","description":"格温在一个锥形区域剪切她的剪刀至多6次，来造成魔法伤害。格温的每次剪切会对中心区域的敌人造成真实伤害并对它们施加她的被动技能。","maxrank":5,"cooldown":[6.5,5.75,5,4.25,3.5],"cost":[40,40,40,40,40],"image":{"full":"GwenQ.png","sprite":"spell4.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6.5/5.75/5/4.25/3.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"R:引针簇射":{"slot":"R","skill":{"id":"GwenR","name":"引针簇射","description":"格温掷出一根针来对命中的敌人们造成减速、魔法伤害，并对命中的英雄们施加【千穿百孔】。<br><br>这个技能至多可进行2段再次施放，每一段再次施放都会投掷更多的针，并造成更多伤害。 ","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"GwenR.png","sprite":"spell4.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Illaoi":{"P:古神先知":{"slot":"P","passive":{"name":"古神先知","description":"俄洛伊和她创造的<font color='#669900'>躯壳</font>会在附近的不可穿越的地形上生成触手。触手会挥向灵魂，<font color='#669900'>躯壳</font>，以及俄洛伊的【严酷训诫】的受害者们。触手会在命中敌人时造成物理伤害，如果命中目标是英雄还会治疗俄洛伊。","image":{"full":"Illaoi_P.png","sprite":"passive1.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}}},"Jinx":{},"Kassadin":{"E:能量脉冲":{"slot":"E","skill":{"id":"ForcePulse","name":"能量脉冲","description":"附近有单位施放法术技能时，卡萨丁将吸收能量，当充能完毕后，吸收的能量可转化为脉冲，对面前锥形区域内敌人造成伤害并减速。","maxrank":5,"cooldown":[21,20,19,18,17],"cost":[60,65,70,75,80],"image":{"full":"ForcePulse.png","sprite":"spell6.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"21/20/19/18/17","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Kayle":{"Q:耀焰冲击":{"slot":"Q","skill":{"id":"KayleQ","name":"耀焰冲击","description":"凯尔召出一个传送门，召唤出一把星界之剑来刺穿敌人，对命中的所有敌人造成减速、伤害和防御属性击碎效果。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[60,70,80,90,100],"image":{"full":"KayleQ.png","sprite":"spell6.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}}},"LeeSin":{"W:金钟罩/铁布衫":{"slot":"W","skill":{"id":"LeeSinWOne","name":"金钟罩/铁布衫","description":"金钟罩：李青冲向目标友军，为他自身提供护盾值。如果该友军是一名英雄，则也会获得护盾值。在使用【金钟罩】后，李青可以施放【铁布衫】。<br>铁布衫：李青艰苦卓绝的训练让他能在战斗中激发潜能。李青获得全能吸血。","maxrank":5,"cooldown":[12],"cost":[50,50,50,50,50],"image":{"full":"LeeSinWOne.png","sprite":"spell7.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"12","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}}},"Maokai":{"Q:荆棘重击":{"slot":"Q","skill":{"id":"MaokaiQ","name":"荆棘重击","description":"茂凯用一记冲击波击退附近的敌人，造成魔法伤害和减速效果。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[40,40,40,40,40],"image":{"full":"MaokaiQ.png","sprite":"spell8.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Qiyana":{},"Rengar":{"Q:残忍无情":{"slot":"Q","skill":{"id":"RengarQ","name":"残忍无情","description":"雷恩加尔的下次攻击会蛮横地戳刺他的目标来造成额外伤害。<br><br>残暴效果：造成更多伤害，并且他会获得攻击速度加成。","maxrank":5,"cooldown":[0.25],"cost":[0,0,0,0,0],"image":{"full":"RengarQ.png","sprite":"spell11.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0.25","costBurn":"0/0/0/0/0","costType":"残暴","rankValues":[]}}},"Rumble":{"R:恒温灼烧":{"slot":"R","skill":{"id":"RumbleCarpetBomb","name":"恒温灼烧","description":"兰博朝目标区域发射火箭，形成一堵火焰之墙，对范围内的敌人造成伤害并减速。","maxrank":3,"cooldown":[130,105,80],"cost":[0,0,0],"image":{"full":"RumbleCarpetBomb.png","sprite":"spell11.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"130/105/80","costBurn":"0/0/0","costType":"热量","rankValues":[]}}},"Ryze":{"R:曲境折跃":{"slot":"R","skill":{"id":"RyzeR","name":"曲境折跃","description":"被动部分：【超负荷】对带有【涌动】效果的目标造成更多伤害。<br><br>施放时，瑞兹会创造一个传送门来通向一个附近的位置。在若干秒后，站在传送门附近的友军会被传送至目标位置。","maxrank":3,"cooldown":[180,160,140],"cost":[100,100,100],"image":{"full":"RyzeR.png","sprite":"spell11.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"180/160/140","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Samira":{"Q:交火":{"slot":"Q","skill":{"id":"SamiraQ","name":"交火","description":"莎弥拉进行一次射击或斩击，造成伤害。如果在【狂飙】期间施放，那么会在完成时打击沿途的所有敌人。","maxrank":5,"cooldown":[6,5,4,3,2],"cost":[30,30,30,30,30],"image":{"full":"SamiraQ.png","sprite":"spell11.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"6/5/4/3/2","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}},"R:炼狱扳机":{"slot":"R","skill":{"id":"SamiraR","name":"炼狱扳机","description":"莎弥拉的武器倾泻出大量的子弹，狂野地射击她周围的所有敌人。","maxrank":3,"cooldown":[5],"cost":[0
{"schemaVersion":1,"patchVersion":"25.9","sources":{"ddragon":"15.9.1","cdragon":"15.9"},"locale":"zh_CN","champions":{"Annie":{"W:焚烧":{"slot":"W","skill":{"id":"AnnieW","name":"焚烧","description":"安妮向锥形区域施放一道烈焰，对区域内的所有敌人造成伤害。","maxrank":5,"cooldown":[7],"cost":[70,75,80,85,90],"image":{"full":"AnnieW.png","sprite":"spell1.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}},"Q:碎裂之火":{"slot":"Q","skill":{"id":"AnnieQ","name":"碎裂之火","description":"安妮向目标投出注入了法力值的火球，对目标造成魔法伤害。如果目标死于碎裂之火，则碎裂之火消耗的法力值会返还给安妮，且碎裂之火的冷却时间减半。","maxrank":5,"cooldown":[4],"cost":[60,65,70,75,80],"image":{"full":"AnnieQ.png","sprite":"spell1.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"4","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"R:提伯斯之怒":{"slot":"R","skill":{"id":"AnnieR","name":"提伯斯之怒","description":"安妮召唤地狱火泰迪：提伯斯为其作战，对目标区域造成伤害，提伯斯也会攻击和烧伤站在它周围的敌人。","maxrank":3,"cooldown":[130,115,100],"cost":[100,100,100],"image":{"full":"AnnieR.png","sprite":"spell1.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Leona":{"Q:破晓之盾":{"slot":"Q","skill":{"id":"LeonaShieldOfDaybreak","name":"破晓之盾","description":"蕾欧娜用盾进行下次普通攻击，造成额外魔法伤害并晕眩目标。","maxrank":5,"cooldown":[5],"cost":[30,35,40,45,50],"image":{"full":"LeonaShieldOfDaybreak.png","sprite":"spell7.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"5","costBurn":"30/35/40/45/50","costType":"法力","rankValues":[]}},"E:天顶之刃":{"slot":"E","skill":{"id":"LeonaZenithBlade","name":"天顶之刃","description":"蕾欧娜投掷一束日光，对直线上的所有敌人造成魔法伤害。当效果消失时，蕾欧娜会冲向最后一个被击中的敌人并使其无法移动。","maxrank":5,"cooldown":[12,10.5,9,7.5,6],"cost":[40,45,50,55,60],"image":{"full":"LeonaZenithBlade.png","sprite":"spell7.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/10.5/9/7.5/6","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}},"P:日光":{"slot":"P","passive":{"name":"日光","description":"技能会在敌人身上施加【日光】效果，持续1.5秒。在此期间，蕾欧娜友军对这些目标造成伤害时，会触发【日光】，使目标受到额外的魔法伤害。","image":{"full":"LeonaSunlight.png","sprite":"passive2.png","group":"passive","x":48,"y":48,"w":48,"h":48},"rankValues":[]}}},"Naafiri":{"W:暴吼":{"slot":"W","skill":{"id":"NaafiriR","name":"暴吼","description":"纳亚菲利变为不可被选取状态并强化她的狗群，生成额外的狗群伙伴并获得移动速度和攻击力提升。<br>","maxrank":5,"cooldown":[26,24,22,20,18],"cost":[60,60,60,60,60],"image":{"full":"NaafiriR.png","sprite":"spell9.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"26/24/22/20/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"E:剔骨本能":{"slot":"E","skill":{"id":"NaafiriE","name":"剔骨本能","description":"纳亚菲利冲刺并伤害她附近一个区域内的敌人们，唤回她的狗群并完全回复它们的生命值。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[35,35,35,35,35],"image":{"full":"NaafiriE.png","sprite":"spell9.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}}},"Orianna":{"Q:指令：攻击":{"slot":"Q","skill":{"id":"OrianaIzunaCommand","name":"指令：攻击","description":"奥莉安娜指挥她的魔偶，朝目标区域发射，对沿途目标造成魔法伤害（对后续目标伤害递减）。指令结束后魔偶会停在目标区域。","maxrank":5,"cooldown":[6,5.25,4.5,3.75,3],"cost":[35,35,35,35,35],"image":{"full":"OrianaIzunaCommand.png","sprite":"spell10.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"6/5.25/4.5/3.75/3","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}}},"Ashe":{"Q:射手的专注":{"slot":"Q","skill":{"id":"AsheQ","name":"射手的专注","description":"艾希会在攻击时聚集【全神贯注】效果。在【全神贯注】到达最大值时，艾希就能施放【射手的专注】来消耗掉所有【全神贯注】效果，以临时提升她的攻击速度，并在持续期间将她的普攻转变为一阵强力的飓风箭阵。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"AsheQ.png","sprite":"spell1.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Gwen":{"P:千穿百孔":{"slot":"P","passive":{"name":"千穿百孔","description":"格温的攻击会造成基于目标生命值的额外魔法伤害。她自身会获得治疗效果，数额相当于这个效果对英雄造成的一部分伤害值。","image":{"full":"Gwen_Passive.png","sprite":"passive1.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:快刀剪乱":{"slot":"Q","skill":{"id":"GwenQ","name":"快刀剪乱","description":"格温在一个锥形区域剪切她的剪刀至多6次，来造成魔法伤害。格温的每次剪切会对中心区域的敌人造成真实伤害并对它们施加她的被动技能。","maxrank":5,"cooldown":[6.5,5.75,5,4.25,3.5],"cost":[40,40,40,40,40],"image":{"full":"GwenQ.png","sprite":"spell4.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6.5/5.75/5/4.25/3.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"KSante":{"W:辟路先锋":{"slot":"W","skill":{"id":"KSanteW","name":"辟路先锋","description":"奎桑提进行蓄力，期间获得伤害减免，然后进行冲刺，对敌人造成击退和晕眩。<br><br>在全盛姿态下，造成提升过的伤害并且不再造成击退或晕眩。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[40,45,50,55,60],"image":{"full":"KSanteW.png","sprite":"spell7.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}}},"Kalista":{"E:撕裂":{"slot":"E","skill":{"id":"KalistaExpungeWrapper","name":"撕裂","description":"攻击时用长矛来刺穿目标。主动激活可以将长矛扯出，造成减速和逐步上升的伤害。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"KalistaExpungeWrapper.png","sprite":"spell6.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Morgana":{"E:黑暗之盾":{"slot":"E","skill":{"id":"MorganaE","name":"黑暗之盾","description":"莫甘娜为一名友方英雄涂上一层保护性的星火屏障，在被打破之前吸收魔法伤害和限制效果。","maxrank":5,"cooldown":[26,23.5,21,18.5,16],"cost":[80,80,80,80,80],"image":{"full":"MorganaE.png","sprite":"spell9.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"26/23.5/21/18.5/16","costBurn":"80/80/80/80/80","costType":"法力","rankValues":[]}},"R:灵魂镣铐":{"slot":"R","skill":{"id":"MorganaR","name":"灵魂镣铐","description":"莫甘娜全力释放她的星界能量，与此同时，她的羽翼会解除束缚并且会悬浮在地面上。她将黑暗痛苦组成的锁链抽击到附近的敌方英雄身上，获得移动速度。锁链会减速并造成初段伤害，并在一段延迟后，晕眩那些未能挣脱的敌方英雄。","maxrank":3,"cooldown":[120,110,100],"cost":[100,100,100],"image":{"full":"MorganaR.png","sprite":"spell9.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldo
{"schemaVersion":1,"patchVersion":"25.1","sources":{"ddragon":"15.1.1","cdragon":"15.1"},"locale":"ko_KR","champions":{"Kalista":{"Q:꿰뚫는 창":{"slot":"Q","skill":{"id":"KalistaMysticShot","name":"꿰뚫는 창","description":"칼리스타가 빠르게 날아가는 창을 던집니다. 적이 처치될 경우 관통해 날아갑니다.","maxrank":5,"cooldown":[8],"cost":[60,65,70,75,80],"image":{"full":"KalistaMysticShot.png","sprite":"spell6.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"8","costBurn":"60/65/70/75/80","costType":"마나","rankValues":[]}},"P:전투 태세":{"slot":"P","passive":{"name":"전투 태세","description":"칼리스타가 기본 공격이나 꿰뚫는 창의 준비 동작을 하는 동안 이동 명령을 하면, 칼리스타가 기본 공격과 함께 해당 위치로 도약합니다.","image":{"full":"Kalista_Passive.png","sprite":"passive1.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}},"E:뽑아 찢기":{"slot":"E","skill":{"id":"KalistaExpungeWrapper","name":"뽑아 찢기","description":"공격 시 대상을 창으로 꿰뚫습니다. 재시전하면 대상에 박힌 창을 뜯어내서 둔화시키며, 주는 피해량이 증가합니다.","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"KalistaExpungeWrapper.png","sprite":"spell6.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"마나","rankValues":[]}}},"Varus":{"Q:꿰뚫는 화살":{"slot":"Q","skill":{"id":"VarusQ","name":"꿰뚫는 화살","description":"바루스가 조준한 다음 강화된 화살을 발사하면, 조준한 시간에 비례하여 사거리와 피해량이 늘어납니다.","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[50,55,60,65,70],"image":{"full":"VarusQ.png","sprite":"spell14.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[]}},"E:퍼붓는 화살":{"slot":"E","skill":{"id":"VarusE","name":"퍼붓는 화살","description":"바루스가 화살을 비처럼 쏟아부어 물리 피해를 주고 지면을 오염시킵니다. 오염된 지면은 적의 이동 속도를 늦추며 자신에 대한 체력 회복 및 재생 효과를 감소시킵니다.","maxrank":5,"cooldown":[18,16,14,12,10],"cost":[90,90,90,90,90],"image":{"full":"VarusE.png","sprite":"spell14.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"18/16/14/12/10","costBurn":"90/90/90/90/90","costType":"마나","rankValues":[]}},"W:역병 화살":{"slot":"W","skill":{"id":"VarusW","name":"역병 화살","description":"기본 지속 효과: 바루스의 기본 공격이 추가 마법 피해를 입히고 역병을 붙입니다. 바루스가 이 대상을 다른 스킬로 공격하면 역병이 폭발하며 대상의 최대 체력에 비례한 마법 피해를 입힙니다. 사용 시: 다음번 꿰뚫는 화살이 강화됩니다.","maxrank":5,"cooldown":[40],"cost":[0,0,0,0,0],"image":{"full":"VarusW.png","sprite":"spell14.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"40","costBurn":"0/0/0/0/0","costType":"마나","rankValues":[]}}},"Warwick":{"Q:야수의 송곳니":{"slot":"Q","skill":{"id":"WarwickQ","name":"야수의 송곳니","description":"워윅이 앞으로 도약해 대상을 물고 대상 최대 체력에 비례한 피해를 입힙니다. 이때 워윅은 입힌 피해량만큼 체력을 회복합니다.","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[70,75,80,85,90],"image":{"full":"WarwickQ.png","sprite":"spell15.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"70/75/80/85/90","costType":"마나","rankValues":[]}}},"Ashe":{"P:서리 화살":{"slot":"P","passive":{"name":"서리 화살","description":"애쉬의 공격을 받은 대상이 느려지며, 이 대상에 대한 애쉬의 공격력이 상승합니다.<br><br>애쉬의 치명타는 추가 피해를 가하지 않는 대신, 대상에게 더 강력한 둔화를 적용합니다.","image":{"full":"Ashe_P.png","sprite":"passive0.png","group":"passive","x":0,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:궁사의 집중":{"slot":"Q","skill":{"id":"AsheQ","name":"궁사의 집중","description":"애쉬는 공격을 계속하면 집중이 오릅니다. 집중 중첩이 최대치에 이르면 이를 모두 소모해 애쉬가 궁사의 집중을 사용할 수 있으며, 이 때 애쉬의 공격 속도가 잠시 동안 증가하고 그 동안 기본 공격이 강력한 다발 공격으로 변합니다.","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"AsheQ.png","sprite":"spell1.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"마나","rankValues":[]}},"W:일제 사격":{"slot":"W","skill":{"id":"Volley","name":"일제 사격","description":"애쉬가 화살을 원뿔 모양으로 발사하여 더 큰 피해를 입힙니다. 이때 서리 화살의 효과도 적용됩니다.","maxrank":5,"cooldown":[18,14.5,11,7.5,4],"cost":[75,70,65,60,55],"image":{"full":"Volley.png","sprite":"spell1.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"18/14.5/11/7.5/4","costBurn":"75/70/65/60/55","costType":"마나","rankValues":[]}}},"Twitch":{"W:독약 병":{"slot":"W","skill":{
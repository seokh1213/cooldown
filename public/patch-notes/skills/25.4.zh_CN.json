{"schemaVersion":1,"patchVersion":"25.4","sources":{"ddragon":"15.4.1","cdragon":"15.4"},"locale":"zh_CN","champions":{"Lulu":{"W:奇思妙想":{"slot":"W","skill":{"id":"LuluW","name":"奇思妙想","description":"如果对友军施放，会暂时增加目标友军的攻击速度和移动速度。如果对敌人施放，会将一名敌方英雄变成可爱的动物，使其无法攻击或施法。","maxrank":5,"cooldown":[18,17.5,17,16.5,16],"cost":[65,65,65,65,65],"image":{"full":"LuluW.png","sprite":"spell7.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"18/17.5/17/16.5/16","costBurn":"65/65/65/65/65","costType":"法力","rankValues":[]}},"E:帮忙，皮克斯！":{"slot":"E","skill":{"id":"LuluE","name":"帮忙，皮克斯！","description":"如果对友军施放，会命令皮克斯跳到一名友军身上进行保护，之后会跟随并协助目标（而不是璐璐）进行攻击。如果对敌人施放，皮克斯会跳到敌人身上造成伤害，之后会跟随并提供目标的视野。","maxrank":5,"cooldown":[8],"cost":[60,65,70,75,80],"image":{"full":"LuluE.png","sprite":"spell8.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"8","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Mel":{"W:灵魂折镜":{"slot":"W","skill":{"id":"MelW","name":"灵魂折镜","description":"梅尔生成一道屏障围绕自身，这道屏障会将敌方弹体反弹给攻击者，使她免受伤害，并为她提供移动速度。","maxrank":5,"cooldown":[35,32,29,26,23],"cost":[80,60,40,20,0],"image":{"full":"MelW.png","sprite":"spell8.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"35/32/29/26/23","costBurn":"80/60/40/20/0","costType":"法力","rankValues":[]}},"Q:耀光齐射":{"slot":"Q","skill":{"id":"MelQ","name":"耀光齐射","description":"梅尔发射一连串耀光飞弹，飞弹会在目标位置周围爆炸，对范围内的敌人造成多段伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[70,80,90,100,110],"image":{"full":"MelQ.png","sprite":"spell8.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"70/80/90/100/110","costType":"法力","rankValues":[]}},"E:阳炎涡旋":{"slot":"E","skill":{"id":"MelE","name":"阳炎涡旋","description":"梅尔发射一颗阳炎法球，禁锢中心区域的敌人并减速周围区域的敌人并造成持续伤害。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,55,60,65,70],"image":{"full":"MelE.png","sprite":"spell8.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/55/60/65/70","costT
Type":"法力","rankValues":[]}}},"Diana":{"P:月银之刃":{"slot":"P","passive":{"name":"月银之刃","description":"每第三次攻击就会溅射周围的敌人，造成额外的魔法伤害。在施放一个技能后，黛安娜获得持续5秒的攻击速度。","image":{"full":"Diana_Passive_LunarBlade.png","sprite":"passive0.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:新月打击":{"slot":"Q","skill":{"id":"DianaQ","name":"新月打击","description":"释放一道月能光束，对弧形范围内的敌人造成伤害。<br><br>会对命中的敌人施加月光效果，如果中了月光效果的敌人不在潜行状态下，就会暴露在己方视野中3秒。","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[50,50,50,50,50],"image":{"full":"DianaQ.png","sprite":"spell3.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"W:苍白之瀑":{"slot":"W","skill":{"id":"DianaOrbs","name":"苍白之瀑","description":"黛安娜召出三颗护体法球，在命中敌人后爆炸，对一个区域内的敌人造成范围伤害。她也会获得一层吸收伤害的护盾。护盾的生命值会在她的第三颗法球爆炸后得到提升。","maxrank":5,"cooldown":[15,13.5,12,10.5,9],"cost":[40,45,50,55,60],"image":{"full":"DianaOrbs.png","sprite":"spell3.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"15/13.5/12/10.5/9","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}}},"Ekko":{"Q:时间卷曲器":{"slot":"Q","skill":{"id":"EkkoQ","name":"时间卷曲器","description":"艾克扔出一个时光手雷，这个手雷会在命中一个敌方英雄后扩展为一个时间扭曲的力场，对场内的所有敌方单位造成伤害和减速效果。然后它会在短暂的延迟后返回到艾克手上，返回途中会对沿途的敌人造成伤害。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[50,60,70,80,90],"image":{"full":"EkkoQ.png","sprite":"spell3.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}}},"Elise":{"W:自爆蜘蛛 / 掠行狂暴":{"slot":"W","skill":{"id":"EliseHumanW","name":"自爆蜘蛛 / 掠行狂暴","description":"人类形态：召唤一个注满毒液的小蜘蛛，并在靠近目标时爆炸。<br><br>蜘蛛形态：伊莉丝和她的小蜘蛛们获得攻击速度加成。","maxrank":5,"cooldown":[12],"cost":[60,70,80,90,100],"image":{"full":"EliseHumanW.png","sprite":"spell3.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"12","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}},"R:蜘蛛形态":{"slot":"R","skill":{"id":"EliseR","name":"蜘蛛形态","
{"schemaVersion":1,"patchVersion":"25.12","sources":{"ddragon":"15.12.1","cdragon":"15.12"},"locale":"zh_CN","champions":{"Ahri":{"R:灵魄突袭":{"slot":"R","skill":{"id":"AhriR","name":"灵魄突袭","description":"阿狸向前猛冲，并放出元气弹，对周围的数个敌人造成伤害。灵魄突袭在进入冷却阶段以前最多可被施放三次，并在参与击杀敌方英雄后获得额外的再次施放次数。","maxrank":3,"cooldown":[140,120,100],"cost":[100,100,100],"image":{"full":"AhriR.png","sprite":"spell0.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"140/120/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Aphelios":{"Q:通碧 · 碧月闪光":{"slot":"Q","skill":{"id":"ApheliosQ_ClientTooltipWrapper","name":"通碧 · 碧月闪光","description":"厄斐琉斯拥有5个不同的主动技能，基于他的主手武器：<br><br>通碧(步枪)：长距离射击，能够标记目标来跟进一次长距离攻击。<br>断魄(短镰枪)：在快速奔跑的同时用两把武器攻击附近的敌人。<br>坠明(加农炮)：禁锢被这把武器减速的所有敌人。<br>荧焰(喷火器)：引爆锥形范围内的敌人并用你的副手武器攻击他们。<br>折镜(飞轮刃)：部署一个装备着你副手武器的驻灵。<br>","maxrank":6,"cooldown":[],"image":{"full":"ApheliosQ_ClientTooltipWrapper.png","sprite":"spell1.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[{"label":"基础伤害（1级）","values":"70"}]},"icons":[{"file":"patch-notes/icons/bf6a8a1c2d5cc65190c01e50974c4be2.webp","spellId":"ApheliosCalibrumQ"}]}},"Gwen":{"W:丝缕缠流":{"slot":"W","skill":{"id":"GwenW","name":"丝缕缠流","description":"格温召唤圣霭来保护她免受圣霭外敌人的进攻。她只会被进入圣霭内的敌人们选为目标。","maxrank":5,"cooldown":[24,22.5,21,19.5,18],"cost":[60,60,60,60,60],"image":{"full":"GwenW.png","sprite":"spell4.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"24/22.5/21/19.5/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}}},"Kalista":{"Q:穿刺":{"slot":"Q","skill":{"id":"KalistaMysticShot","name":"穿刺","description":"扔出一个快速移动的长矛。长矛在击杀敌人后会继续飞行。","maxrank":5,"cooldown":[9],"cost":[60,65,70,75,80],"image":{"full":"KalistaMysticShot.png","sprite":"spell6.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"9","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Leblanc":{"R:故技重施":{"slot":"R","skill":{"id":"LeblancR","name":"故技重施","description":"乐
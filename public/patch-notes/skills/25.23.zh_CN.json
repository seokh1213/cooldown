{"schemaVersion":1,"patchVersion":"25.23","sources":{"ddragon":"15.23.1","cdragon":"15.23"},"locale":"zh_CN","champions":{"Fizz":{"R:巨鲨强袭":{"slot":"R","skill":{"id":"FizzR","name":"巨鲨强袭","description":"菲兹朝一个方向放出一条小鱼，小鱼会附身在第一个与它接触的敌方英雄身上，同时减速目标。在短暂的延迟之后，一条巨鲨就会破土而出，击飞目标并将目标附近的敌人震开。被命中的所有敌人都会受到魔法伤害和减速效果。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"FizzR.png","sprite":"spell4.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"P:伶俐斗士":{"slot":"P","passive":{"name":"伶俐斗士","description":"菲兹在移动时可以穿过单位并且从所有来源处受到的伤害都会减少一个固定的数额。","image":{"full":"Fizz_P.png","sprite":"passive1.png","group":"passive","x":240,"y":0,"w":48,"h":48},"rankValues":[]}},"W:海石三叉戟":{"slot":"W","skill":{"id":"FizzW","name":"海石三叉戟","description":"菲兹的攻击会让他的敌人们流血，同时造成持续数秒的魔法伤害。菲兹可以强化他的下次普攻来造成额外伤害，并在短时间内强化他的后续普攻。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[30,40,50,60,70],"image":{"full":"FizzW.png","sprite":"spell3.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"30/40/50/60/70","costType":"法力","rankValues":[]}}},"Kaisa":{"R:猎手本能":{"slot":"R","skill":{"id":"KaisaR","name":"猎手本能","description":"卡莎突进到一个敌方英雄身边。","maxrank":3,"cooldown":[130,100,70],"cost":[100,100,100],"image":{"full":"KaisaR.png","sprite":"spell6.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"130/100/70","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Skarner":{"Q:撼地 / 擎天":{"slot":"Q","skill":{"id":"SkarnerQ","name":"撼地 / 擎天","description":"斯卡纳从地面掘出一块巨石来强化他的普攻，这块巨石可作为飞弹投掷。","maxrank":5,"cooldown":[8,6.75,5.5,4.25,3],"cost":[45,45,45,45,45],"image":{"full":"SkarnerQ.png","sprite":"spell12.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"8/6.75/5.5/4.25/3","costBurn":"45/45/45/45/45","costType":"法力","rankValues":[]}}},"Swain":{"E:永不复行":{"slot":"E","skill":{"id":"SwainE","name":"永不复行","description":"斯维因释放一道恶魔之手向前击出。手臂随后会返回至斯维因处，并禁锢它命中的敌人。斯维因之后可以选择将所有被禁锢的英雄们拉拽得更靠近他。这个技能在【恶魔升华】期间会有一个更短的冷却时间。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,55,60,65,70],"image":{"full":"SwainE.png","sprite":"spell13.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Zaahen":{"Q:暗裔长刀":{"slot":"Q","skill":{"id":"ZaahenQ","name":"暗裔长刀","description":"亚恒的下一次攻击进行两次斩击，造成额外伤害并治疗他自身。亚恒可以再次施放这个技能来让他的下一次攻击造成额外伤害并击飞他的目标。<br>","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[25,25,25,25,25],"image":{"full":"ZaahenQ.png","sprite":"spell16.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"25/25/25/25/25","costType":"法力","rankValues":[]}}},"Aatrox":{"P:赐死剑气":{"slot":"P","passive":{"name":"赐死剑气","description":"每过一段时间，亚托克斯的下次普攻会造成额外<magicDamage>魔法伤害</magicDamage>，并治疗亚托克斯，治疗量基于目标的最大生命值。 ","image":{"full":"Aatrox_Passive.png","sprite":"passive0.png","group":"passive","x":0,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:暗裔利刃":{"slot":"Q","skill":{"id":"AatroxQ","name":"暗裔利刃","description":"亚托克斯向下猛砸他的巨剑，并造成物理伤害。他可以挥击三次，每次都有一个不同的范围效果。","maxrank":5,"cooldown":[14,12,10,8,6],"cost":[0,0,0,0,0],"image":{"full":"AatroxQ.png","sprite":"spell0.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"14/12/10/8/6","costBurn":"0/0/0/0/0","costType":"鲜血魔井","rankValues":[]}}},"Ahri":{"W:妖异狐火":{"slot":"W","skill":{"id":"AhriW","name":"妖异狐火","description":"阿狸获得短暂的爆发性移动速度加成，并放出三团狐火，锁定附近的敌人进行攻击。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[30,30,30,30,30],"image":{"full":"AhriW.png","sprite":"spell0.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Ambessa":{"Q:暗袭 / 裂斩":{"slot":"Q","skill":{"id":"AmbessaQ","name":"暗袭 / 裂斩","description":"安蓓萨甩出链刃横扫她前方的半圆区域，对被链刃命中的敌人造成额外伤害。击中一个敌人后，该技能在短时间内的下一次施放会发生变化，使她向前方的一条直线猛砸链刃，对命中的首个敌人造成额外伤害。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[70,70,70,70,70],"image":{"full":"AmbessaQ.png","sprite":"spell0.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"70/70/70/70/70","costType":"能量","rankValues":[]}}},"Ashe":{"Q:射手的专注":{"slot":"Q","skill":{"id":"AsheQ","name":"射手的专注","description":"艾希会在攻击时聚集【全神贯注】效果。在【全神贯注】到达最大值时，艾希就能施放【射手的专注】来消耗掉所有【全神贯注】效果，以临时提升她的攻击速度，并在持续期间将她的普攻转变为一阵强力的飓风箭阵。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"AsheQ.png","sprite":"spell1.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Caitlyn":{"P:爆头":{"slot":"P","passive":{"name":"爆头","description":"每进行几次基础攻击，对中了她的陷阱或绳网的单位进行攻击时，凯特琳就会造成一次【爆头】效果，造成随暴击几率增长的额外伤害。在对中了陷阱或绳网的目标进行攻击时，凯特琳的【爆头】攻击距离翻倍。","image":{"full":"Caitlyn_Headshot.png","sprite":"passive0.png","group":"passive","x":0,"y":96,"w":48,"h":48},"rankValues":[]}}},"Chogath":{"E:恐惧之刺":{"slot":"E","skill":{"id":"VorpalSpikes","name":"恐惧之刺","description":"科加斯的攻击会释放致命的尖刺，伤害并减速面前所有的敌人。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[30,30,30,30,30],"image":{"full":"VorpalSpikes.png","sprite":"spell2.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"DrMundo":{"E:大力行医":{"slot":"E","skill":{"id":"DrMundoE","name":"大力行医","description":"被动 - 蒙多医生获得额外攻击力，数额会基于他的最大生命值而提升。<br><br>主动 - 蒙多医生用他的“医用”手提包猛砸一个敌人，造成基于他已损失生命值的额外伤害。如果这个敌人被击杀，那么还会被拍飞，对途经的所有敌人造成伤害。","maxrank":5,"cooldown":[9,8.25,7.5,6.75,6],"cost":[0,0,0,0,0],"image":{"full":"DrMundoE.png","sprite":"spell3.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"9/8.25/7.5/6.75/6","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"Jayce":{"Q:浩瀚無垠（Q）（戰槌型態）":{"slot":"Q","skill":{"id":"JayceToTheSkies","name":"浩瀚無垠（Q）（戰槌型態）","description":"锤形态：跳向一个敌人，对敌人造成物理伤害和减速效果。 <br><br>炮形态：发射一团电球，在命中一名敌人或者到达最大射程后爆炸，对命中的敌人造成物理伤害。","maxrank":6,"cooldown":[],"image":{"full":"JayceToTheSkies.png","sprite":"spell5.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}},"Q:電磁脈衝（Q）（加農型態）":{"slot":"Q","skill":{"id":"JayceToTheSkies","name":"電磁脈衝（Q）（加農型態）","description":"锤形态：跳向一个敌人，对敌人造成物理伤害和减速效果。 <br><br>炮形态：发射一团电球，在命中一名敌人或者到达最大射程后爆炸，对命中的敌人造成物理伤害。","maxrank":6,"cooldown":[],"image":{"full":"JayceToTheSkies.png","sprite":"spell5.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}}},"Jhin":{"P:低语":{"slot":"P","passive":{"name":"低语","description":"烬的手枪，“低语”，是一台精密的设备，用来造成出色的伤害。它会以一个固定的频率发射子弹，并且只能装四颗子弹。烬会将黑暗魔法注入最后一颗子弹，来让它产生暴击并造成额外斩杀伤害。当“低语”暴击时，它会为烬提供一个爆发性的移动速度加成。","image":{"full":"Jhin_P.png","sprite":"passive1.png","group":"passive","x":144,"y":96,"w":48,"h":48},"rankValues":[]}},"W:致命华彩":{"slot":"W","skill":{"id":"JhinW","name":"致命华彩","description":"烬挥舞他的长枪，进行一次射程极远的射击。它可穿透小兵和野怪，但会在命中第一个敌方英雄后停下。如果目标最近踩到了烬的陷阱、承受过烬的伤害或被烬的队友给命中过，那么还会受到禁锢效果。","maxrank":5,"cooldown":[12],"cost":[50,55,60,65,70],"image":{"full":"JhinW.png","sprite":"spell5.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"12","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Jinx":{"R:超究极死神飞弹！":{"slot":"R","skill":{"id":"JinxR","name":"超究极死神飞弹！","description":"金克丝发射一枚能够跨越整个地图的飞弹，并且飞行的时间越长，伤害值越高。飞弹会在命中一名敌方英雄后爆炸，对目标和目标附近的敌人造成伤害，且目标的生命值越低，所受的伤害值越高。","maxrank":3,"cooldown":[85,65,45],"cost":[100,100,100],"image":{"full":"JinxR.png","sprite":"spell5.png","group":"spell","x":336,"y":144,"w":48,"h":48},"cooldownBurn":"85/65/45","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Hwei":{"Q:熔岩裂隙（QE）":{"slot":"Q","skill":{"id":"HweiQ","name":"熔岩裂隙（QE）","description":"彗将眼中所见的灾难逐一描绘，造成可怕的破坏力。<br><br>这个技能会用这些伤害型技能替换掉彗的技能：没骨火、攒聚雷、连皴山。","maxrank":5,"cooldown":[],"image":{"full":"HweiQ.png","sprite":"spell4.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}}},"Malphite":{"W:雷霆拍击":{"slot":"W","skill":{"id":"Obduracy","name":"雷霆拍击","description":"墨菲特的攻击蕴含着如此惊人的力道以至于它引发了一次音爆。在接下来的数秒里，他的攻击会在他面前引发余波。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[30,35,40,45,50],"image":{"full":"Obduracy.png","sprite":"spell8.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"30/35/40/45/50","costType":"法力","rankValues":[]}}},"Mel":{"P:灼灼之光":{"slot":"P","passive":{"name":"灼灼之光","description":"每当梅尔使用技能，她的下一次攻击将额外附带3枚弹体（最多9枚）。<br><br>当梅尔通过一次技能或攻击造成伤害时，她会施加【夺命残影】——一种可以无限叠加的效果。如果目标身上叠加了足够的夺命残影伤害量，则会在下一次被梅尔命中时被直接处决，同时消耗效果层数。","image":{"full":"Mel_Passive.png","sprite":"passive2.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}},"E:阳炎涡旋":{"slot":"E","skill":{"id":"MelE","name":"阳炎涡旋","description":"梅尔发射一颗阳炎法球，禁锢中心区域的敌人并减速周围区域的敌人并造成持续伤害。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,55,60,65,70],"image":{"full":"MelE.png","sprite":"spell8.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"MissFortune":{"R:弹幕时间":{"slot":"R","skill":{"id":"MissFortuneBulletTime","name":"弹幕时间","description":"厄运小姐向她面前的锥形范围内引导一阵子弹风暴，对敌人造成大量伤害。这个技能的每波子弹都可以暴击。","maxrank":3,"cooldown":[120,110,100],"cost":[100,100,100],"image":{"full":"MissFortuneBulletTime.png","sprite":"spell8.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"120/110/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Ornn":{"W:风箱炎息":{"slot":"W","skill":{"id":"OrnnW","name":"风箱炎息","description":"奥恩向前进发，喷出炎息。被最后一阵炎息命中的敌人将变为易碎状态。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[45,50,55,60,65],"image":{"full":"OrnnW.png","sprite":"spell10.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"45/50/55/60/65","costType":"法力","rankValues":[]}}},"RekSai":{"P:艾克塞之怒":{"slot":"P","passive":{"name":"艾克塞之怒","description":"雷克塞可通过攻击和命中基础技能来生成怒气。她在位于地下时可消耗怒气来回复生命值。","image":{"full":"RekSai_Passive.png","sprite":"passive3.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}}},"Riven":{"P:符文之刃":{"slot":"P","passive":{"name":"符文之刃","description":"锐雯的技能会为她的剑刃充能，并且她的普通攻击会消耗充能来造成额外伤害。","image":{"full":"RivenRunicBlades.png","sprite":"passive3.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}}},"Sion":{"Q:残虐猛击":{"slot":"Q","skill":{"id":"SionQ","name":"残虐猛击","description":"赛恩开始蓄力，并在释放时对他前方的一个区域进行一次强劲的猛击，对区域内的敌人造成伤害。如果他蓄力时间足够久，那么被命中的敌人还会受到击飞和晕眩效果。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[45,45,45,45,45],"image":{"full":"SionQ.png","sprite":"spell12.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"45/45/45/45/45","costType":"法力","rankValues":[]}}},"Tristana":{},"Vladimir":{},"Volibear":{},"Xayah":{"P:锐切":{"slot":"P","passive":{"name":"锐切","description":"在使用一次技能后，霞的下几次普攻将命中沿途的所有敌人，并各落下一根<font color='#C200E1'>羽毛</font>。","image":{"full":"XayahPassive.png","sprite":"passive5.png","group":"passive","x":288,"y":0,"w":48,"h":48},"rankValues":[]}}},"Zeri":{"R:超限爆闪":{"slot":"R","skill":{"id":"ZeriR","name":"超限爆闪","description":"泽丽放出一道电能新星，并且自身进入超负荷状态，来获得伤害提升和可叠加的移动速度，并且这个状态可在她每次命中敌方英雄时刷新持续时间并变得更强。在超负荷状态下。【枪火迸射】会变成一个快速的3连发，并在敌人之间引发连锁闪电。","maxrank":3,"cooldown":[80,75,70],"cost":[100,100,100],"image":{"full":"ZeriR.png","sprite":"spell17.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"80/75/70","costBurn":"100/100/100","costType":"法力","rankValues":[]}}}}}
{"schemaVersion":1,"patchVersion":"25.24","sources":{"ddragon":"15.24.1","cdragon":"15.24"},"locale":"zh_CN","champions":{"Mel":{"E:阳炎涡旋":{"slot":"E","skill":{"id":"MelE","name":"阳炎涡旋","description":"梅尔发射一颗阳炎法球，禁锢中心区域的敌人并减速周围区域的敌人并造成持续伤害。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,60,70,80,90],"image":{"full":"MelE.png","sprite":"spell8.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}}},"Sejuani":{"Q:极寒突袭":{"slot":"Q","skill":{"id":"SejuaniQ","name":"极寒突袭","description":"瑟庄妮向前冲锋，将敌人击飞至空中。冲锋会在命中一名敌方英雄后停止。","maxrank":5,"cooldown":[18,16.5,15,13.5,12],"cost":[60,65,70,75,80],"image":{"full":"SejuaniQ.png","sprite":"spell11.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"18/16.5/15/13.5/12","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"W:凛冬之怒":{"slot":"W","skill":{"id":"SejuaniW","name":"凛冬之怒","description":"瑟庄妮两次挥舞她的链枷，造成伤害、减速敌人并施加霜冻层数。","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[60,60,60,60,60],"image":{"full":"SejuaniW.png","sprite":"spell11.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"R:极冰寒狱":{"slot":"R","skill":{"id":"SejuaniR","name":"极冰寒狱","description":"瑟庄妮投出她的套索来冻结并击晕命中的第一名敌方英雄，并创造一次冰风暴来减速其它敌人。","maxrank":3,"cooldown":[120,105,90],"cost":[100,100,100],"image":{"full":"SejuaniR.png","sprite":"spell12.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"120/105/90","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"E:永冻领域":{"slot":"E","skill":{"id":"SejuaniE","name":"永冻领域","description":"瑟庄妮冻结并晕眩一名叠满了霜冻层数的敌方英雄。","maxrank":5,"cooldown":[1.5],"cost":[20,20,20,20,20],"image":{"full":"SejuaniE.png","sprite":"spell12.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"1.5","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}}},"Braum":{"P:震荡猛击":{"slot":"P","passive":{"name":"震荡猛击","description":"布隆的普通攻击会对目标施加震荡猛击效果。一旦施加了第一层震荡猛击，<font color='#FFF673'>友军</font>的普通攻击也会对目标叠加震荡猛击。<br><br>在效果到达4层后，目标会被击晕并受到魔法伤害。在接下来的数秒里，布隆和友军无法再次对目标叠加震荡猛击的层数，但布隆的攻击会对目标造成额外魔法伤害。","image":{"full":"Braum_Passive.png","sprite":"passive0.png","group":"passive","x":384,"y":48,"w":48,"h":48},"rankValues":[]}}},"DrMundo":{"Q:病毒屠刀":{"slot":"Q","skill":{"id":"DrMundoQ","name":"病毒屠刀","description":"蒙多医生掷出一把沾染病菌的骨锯，对命中的第一个敌人造成基于其当前生命值的魔法伤害和减速效果。","maxrank":5,"cooldown":[4],"cost":[0,0,0,0,0],"image":{"full":"DrMundoQ.png","sprite":"spell3.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"4","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"Kayn":{"P:暗裔魔镰":{"slot":"P","passive":{"name":"暗裔魔镰","description":"凯隐使用的是一把上古神兵，并且一直都在与附在武器上的暗裔灵体拉亚斯特为了身体的控制权而战斗着。要么<font color='#fe5c50'>暗裔杀手</font>将获胜，要么凯隐将统御拉亚斯特并变为<font color='#8484fb'>影流刺客</font>。<br><hr><font color='#fe5c50'>暗裔杀手：</font>治疗自身，数额相当于一部分对敌方英雄造成的技能伤害值。<br><br><font color='#8484fb'>影流刺客：</font>在与敌方英雄作战的最初几秒里，造成额外伤害。","image":{"full":"Kayn_Passive_Primary.png","sprite":"passive2.png","group":"passive","x":96,"y":0,"w":48,"h":48},"rankValues":[]}}},"Khazix":{"W:虚空突刺":{"slot":"W","skill":{"id":"KhazixW","name":"虚空突刺","description":"卡兹克发射爆炸性的尖刺，对命中的敌人造成物理伤害。卡兹克如果在爆炸范围内，则会回复生命值。如果他选择<font color='#00DD33'>进化刺鞘</font>的话，虚空突刺现在会呈锥形发射三个尖刺，减速被命中的敌人并使被命中的敌方英雄显形2秒。<font color='#FFF673'>孤立无援</font>的目标会被减速额外的幅度。","maxrank":5,"cooldown":[9],"cost":[55,60,65,70,75],"image":{"full":"KhazixW.png","sprite":"spell6.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"9","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}}},"MasterYi":{},"Nasus":{"Q:汲魂痛击":{"slot":"Q","skill":{"id":"NasusQ","name":"汲魂痛击","description":"内瑟斯对敌人施放汲魂痛击造成伤害，如果敌人死于汲魂痛击，则永久增加下次汲魂痛击的伤害。","maxrank":5,"cooldown":[7.5,6.5,5.5,4.5,3.5],"cost":[20,20,20,20,20],"image":{"full":"NasusQ.png","sprite":"spell9.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"7.5/6.5/5.5/4.5/3.5","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}}},"Nidalee":{"Q:标枪投掷 / 推倒":{"slot":"Q","skill":{"id":"JavelinToss","name":"标枪投掷 / 推倒","description":"人类形态下，奈德丽向她的目标投掷标枪，飞行中击中目标造成伤害。美洲狮形态下，她的下一次攻击会试图对目标造成致命伤害，目标的生命值越低，造成的伤害越大。","maxrank":5,"cooldown":[6],"cost":[50,55,60,65,70],"image":{"full":"JavelinToss.png","sprite":"spell9.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Swain":{"P:狂食鸦群":{"slot":"P","passive":{"name":"狂食鸦群","description":"斯维因的鸦群会收集<i>魂屑</i>来治疗斯维因并永久提升他的最大生命值。","image":{"full":"Swain_P.png","sprite":"passive4.png","group":"passive","x":432,"y":0,"w":48,"h":48},"rankValues":[]}}},"Viktor":{"Q:虹吸能量":{"slot":"Q","skill":{"id":"ViktorQ","name":"虹吸能量","description":"维克托引爆一个敌方单位，造成魔法伤害，同时获得一道护盾，并强化自己的下次普通攻击。<br><br>增强：虹吸能量的护盾提升60%，并且维克托在施放这个技能后获得额外移动速度加成。<br>","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[45,50,55,60,65],"image":{"full":"ViktorQ.png","sprite":"spell15.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"45/50/55/60/65","costType":"法力","rankValues":[]}}},"Zaahen":{"P:不落之志":{"slot":"P","passive":{"name":"不落之志","description":"亚恒对敌方英雄打出的攻击和技能会为他提供【果决】层数，每层获得额外攻击力。当叠满【果决】时，亚恒获得攻击力提升并且能够复活。","image":{"full":"ZaahenP.Zaahen.png","sprite":"passive5.png","group":"passive","x":192,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:暗裔长刀":{"slot":"Q","skill":{"id":"ZaahenQ","name":"暗裔长刀","description":"亚恒的下一次攻击进行两次斩击，造成额外伤害并治疗他自身。亚恒可以再次施放这个技能来让他的下一次攻击造成额外伤害并击飞他的目标。<br>","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[25,25,25,25,25],"image":{"full":"ZaahenQ.png","sprite":"spell16.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"25/25/25/25/25","costType":"法力","rankValues":[]}},"E:赤金突袭":{"slot":"E","skill":{"id":"ZaahenE","name":"赤金突袭","description":"亚恒冲刺至一个位置然后切击他的周围。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[40,40,40,40,40],"image":{"full":"ZaahenE.png","sprite":"spell16.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Zed":{"P:影忍法！灭魂劫":{"slot":"P","passive":{"name":"影忍法！灭魂劫","description":"劫的普通攻击会对低生命值的目标造成额外魔法伤害。这个特效在数秒内只能对相同的敌方英雄生效一次。","image":{"full":"ZedP.png","sprite":"passive5.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}}}}}
{"schemaVersion":1,"patchVersion":"26.16","sources":{"ddragon":"16.16.1","cdragon":"16.16"},"locale":"ko_KR","champions":{"Azir":{"Q:사막의 맹습":{"slot":"Q","skill":{"id":"AzirQWrapper","name":"사막의 맹습","description":"아지르가 모든 모래 병사를 특정 위치로 보냅니다. 모래 병사들은 통과하는 적에게 마법 피해를 입히고, 1초 둔화 효과를 적용합니다.","maxrank":5,"cooldown":[14,12,10,8,6],"cost":[70,80,90,100,110],"image":{"full":"AzirQWrapper.png","sprite":"spell2.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"14/12/10/8/6","costBurn":"70/80/90/100/110","costType":"마나","rankValues":[{"label":"기본 피해량","values":"75 / 95 / 115 / 135 / 155"}]},"icons":[{"file":"patch-notes/icons/b391531c43df417b33716f3083d0461b.webp","spellId":"AzirQWrapper"}]}},"Camille":{"W:전술적 휩쓸기":{"slot":"W","skill":{"id":"CamilleW","name":"전술적 휩쓸기","description":"카밀이 잠시 후 전방을 원뿔형으로 휩쓸어 피해를 입힙니다. 원뿔의 바깥쪽 절반에 있는 적은 이동 속도가 느려지고 추가 피해를 입으며, 카밀의 체력을 회복시킵니다.","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,55,60,65,70],"image":{"full":"CamilleW.png","sprite":"spell2.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[{"label":"기본 피해량","values":"60 / 85 / 110 / 135 / 160"},{"label":"둔화 지속시간","values":"2초"}]},"icons":[{"file":"patch-notes/icons/84db784993efbc23e38d28946aadd3c4.webp","spellId":"CamilleW"}]},"P:적응형 방어 체계":{"slot":"P","passive":{"name":"적응형 방어 체계","description":"챔피언에게 기본 공격 시 잠시 동안 카밀 최대 체력의 일부에 해당하는 피해를 흡수하는 보호막이 생깁니다. 적 챔피언이 어떤 피해를 주는지에 따라 물리 혹은 마법 보호막 중 하나만 생성됩니다.","image":{"full":"Camille_Passive.png","sprite":"passive0.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}}},"Kennen":{"R:날카로운 소용돌이":{"slot":"R","skill":{"id":"KennenShurikenStorm","name":"날카로운 소용돌이","description":"케넨이 번개의 폭풍을 소환하여 근처 적 챔피언을 공격하고 마법 피해를 입힙니다.","maxrank":3,"cooldown":[120],"cost":[0,0,0],"image":{"full":"KennenShurikenStorm.png","sprite":"spell7.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"120","costBurn":"0/0/0","cost
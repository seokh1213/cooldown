{"schemaVersion":1,"patchVersion":"26.10","sources":{"ddragon":"16.10.1","cdragon":"16.10"},"locale":"ko_KR","champions":{"Galio":{"Q:전장의 돌풍":{"slot":"Q","skill":{"id":"GalioQ","name":"전장의 돌풍","description":"갈리오가 두 개의 돌풍을 발사해 지속 피해를 입히는 거대한 소용돌이를 만듭니다.","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[60,65,70,75,80],"image":{"full":"GalioQ.png","sprite":"spell4.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"60/65/70/75/80","costType":"마나","rankValues":[{"label":"기본 피해량","values":"70 / 105 / 140 / 175 / 210"}]}},"E:정의의 주먹":{"slot":"E","skill":{"id":"GalioE","name":"정의의 주먹","description":"갈리오가 잠시 뒤로 물러났다가 돌진하며 처음으로 충돌한 적 챔피언을 공중으로 띄웁니다.","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[50,50,50,50,50],"image":{"full":"GalioE.png","sprite":"spell4.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"50/50/50/50/50","costType":"마나","rankValues":[{"label":"기본 피해량","values":"100 / 135 / 170 / 205 / 240"}]},"icons":[{"file":"patch-notes/icons/04bf521c1cdda1270b8e30b568859445.webp","spellId":"GalioE"}]},"R:영웅출현":{"slot":"R","skill":{"id":"GalioR","name":"영웅출현","description":"갈리오가 아군이 있는 위치를 착지 지점으로 정해, 해당 지점 주변의 모든 아군에게 마법 보호막을 씌웁니다. 잠시 후 해당 지역에 착지하여 근처의 적을 공중으로 띄웁니다.","maxrank":3,"cooldown":[180,160,140],"cost":[100,100,100],"image":{"full":"GalioR.png","sprite":"spell4.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"180/160/140","costBurn":"100/100/100","costType":"마나","rankValues":[{"label":"기본 피해량","values":"150 / 250 / 350"}]}}},"LeeSin":{"W:방호 / 강철의 의지":{"slot":"W","skill":{"id":"LeeSinWOne","name":"방호 / 강철의 의지","description":"방호: 리 신이 대상 아군에게 돌격하여 자신에게 피해를 흡수하는 보호막을 생성합니다. 해당 아군이 챔피언일 경우 아군에게도 보호막이 적용됩니다. 방호를 사용하고 난 뒤 강철의 의지를 시전할 수 있습니다.<br>강철의 의지: 고된 수행으로 리 신이 전투에서 보다 잘 살아남을 수 있게 됩니다. 모든 피해 흡혈 효과를 얻습니다.","maxrank":5,"cooldown":[7],"cost":[50,50,50,50,50],"image":{"full":"LeeSinWOne.png","sprite":"spell7.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"50/50/50/50/50","costType":"기력","rankValues":[]}},"E:폭풍/무력화":{"slot":"E","skill":{"id":"LeeSinEOne","name":"폭풍/무력화","description":"폭풍: 리 신이 바닥을 내리쳐 마법 피해를 입히고 은신한 유닛을 드러내는 충격파를 발생시킵니다. 폭풍이 적에게 명중하면 무력화를 사용할 수 있습니다.<br>무력화: 리 신이 폭풍에 피해를 입은 적을 약화시키며 이동 속도를 낮춥니다. 저하된 이동 속도는 시간이 지남에 따라 점차 회복됩니다.","maxrank":5,"cooldown":[8],"cost":[50,50,50,50,50],"image":{"full":"LeeSinEOne.png","sprite":"spell7.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"8","costBurn":"50/50/50/50/50","costType":"기력","rankValues":[{"label":"둔화 지속시간","values":"4초"}]},"icons":[{"file":"patch-notes/icons/7e00bcefdf896f4a21d8a8364425a19f.webp","spellId":"LeeSinEOne"}]},"R:용의 분노":{"slot":"R","skill":{"id":"LeeSinR","name":"용의 분노","description":"리 신이 강력한 돌려차기로 적 챔피언을 뒤로 밀어내고 공격 대상과 대상과 부딪히는 모든 적에게 물리 피해를 입힙니다. 공격 대상과 부딪힌 적은 짧은 시간 공중에 떠오릅니다. 이 기술은 제시 페링이 전수한 기술이지만, 리 신은 적을 맵 밖으로 날려버리지는 않습니다.","maxrank":3,"cooldown":[110,85,60],"cost":[0,0,0],"image":{"full":"LeeSinR.png","sprite":"spell7.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"110/85/60","costBurn":"0/0/0","costType":"기력","rankValues":[{"label":"기본 피해량","values":"175 / 400 / 625"}]},"icons":[{"file":"patch-notes/icons/676d937459d8bc8538e6a6b7796ee9ef.webp","spellId":"LeeSinR"}]}},"Naafiri":{"R:사냥개의 추적":{"slot":"R","skill":{"id":"NaafiriW","name":"사냥개의 추적","description":"나피리와 무리가 챔피언에게 돌진해 피해를 입힙니다. 나피리가 처치 관여를 달성하면 주위 적들을 드러내고 이 스킬을 한 번 재사용할 수 있습니다. 두 번째 사용 시 보호막을 얻습니다.","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"마나","rankValues":[{"label":"기본 피해량","values":"150 / 225 / 300"},{"label":"둔화 지속시간","values":"0.25초"}]},"icons":[{"file":"patch-notes/icons/654880d3d20f04bf2abb4e0113cb877d.webp","spellId":"NaafiriW"}]},"Q:다르킨 단검":{"slot":"Q","skill":{"id":"NaafiriQ","name":"다르킨 단검","description":"나피리가 최대 두 개의 단검을 던져 각 단검으로 출혈을 일으킵니다. 대상이 이미 출혈 상태라면 그 대신 추가 피해를 입힙니다.<br><br>무리가 이 스킬에 처음 적중당한 챔피언 또는 몬스터를 향해 도약해 공격합니다.<br>","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[50,60,70,80,90],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"50/60/70/80/90","costType":"마나","rankValues":[]}}},"Quinn":{"R:후방 지원":{"slot":"R","skill":{"id":"QuinnR","name":"후방 지원","description":"퀸과 발러가 뭉쳐 엄청난 속도로 날아다닙니다. 스킬을 종료하면 공중 강습을 사용하게 되며 근처의 모든 적에게 피해를 입히고 적 챔피언에게 취약 표식을 남깁니다.","maxrank":3,"cooldown":[3],"cost":[50,25,0],"image":{"full":"QuinnR.png","sprite":"spell10.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"3","costBurn":"50/25/0","costType":"마나","rankValues":[{"label":"둔화 지속시간","values":"3초"},{"label":"기본 피해량","values":"60 / 90 / 120"}]}},"P:매사냥":{"slot":"P","passive":{"name":"매사냥","description":"데마시아 독수리 발러가 주기적으로 적에게 <font color='#FFF673'>취약</font> 표식을 남깁니다. <font color='#FFF673'>취약</font>해진 대상에 대한 퀸의 첫 번째 기본 공격은 추가 물리 피해를 입힙니다.","image":{"full":"Quinn_Passive.png","sprite":"passive3.png","group":"passive","x":144,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:실명 공격":{"slot":"Q","skill":{"id":"QuinnQ","name":"실명 공격","description":"퀸이 발러를 보내 하나의 적에게 표식을 남기고 대상의 시야를 크게 좁힙니다. 또한 근처의 모든 적에게 피해를 입힙니다.","maxrank":5,"cooldown":[11,10.5,10,9.5,9],"cost":[50,55,60,65,70],"image":{"full":"QuinnQ.png","sprite":"spell10.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"11/10.5/10/9.5/9","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[{"label":"기본 피해량","values":"65 / 100 / 135 / 170 / 205"}]},"icons":[{"file":"patch-notes/icons/56c6e313115f23dbbeaaca25383ea73f.webp","spellId":"QuinnQ"}]}},"Shyvana":{"W:지옥불 방패":{"slot":"W","skill":{"id":"ShyvanaW","name":"지옥불 방패","description":"쉬바나가 보호막과 이동 속도를 얻으며, 잠시 후 쉬바나 주변에 폭발을 일으킵니다.  용 형상일 때 폭발이 적 챔피언에게 적중하면 체력을 회복합니다.","maxrank":5,"cooldown":[13,12.25,11.5,10.75,10],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaW.png","sprite":"spell12.png","group":"spell","x":
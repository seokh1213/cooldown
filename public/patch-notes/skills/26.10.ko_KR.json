ell17.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"5/4.5/4/3.5/3","costBurn":"40/40/40/40/40","costType":"기력","rankValues":[{"label":"기본 피해량","values":"70 / 92.5 / 115 / 137.5 / 160"},{"label":"둔화 지속시간","values":"1.5초"}]},"icons":[{"file":"patch-notes/icons/df92bc18feceff5c0f317b0aaca0f714.webp","spellId":"ZedE"}]},"P:약자 멸시":{"slot":"P","passive":{"name":"약자 멸시","description":"제드가 체력이 낮은 적을 기본 공격하면 마법 피해를 추가로 입힙니다. 같은 적 챔피언에게는 몇 초가 지나야 이 효과가 다시 적용됩니다.","image":{"full":"ZedP.png","sprite":"passive5.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}}},"Zeri":{"Q:집중 사격":{"slot":"Q","skill":{"id":"ZeriQ","name":"집중 사격","description":"처음 적중한 적에게 물리 피해를 입히는 공격 7발을 발사합니다. 이 스킬은 기본 공격으로 간주됩니다.","maxrank":5,"cooldown":[0],"cost":[0,0,0,0,0],"image":{"full":"ZeriQ.png","sprite":"spell17.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"0/0/0/0/0","costType":"마나","rankValues":[{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"22 / 26 / 30 / 34 / 38"},{"label":"둔화 지속시간","values":"0.25초"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"}]},"icons":[{"file":"patch-notes/icons/733b3e12fbbaec551a8f70edf013bf93.webp","spellId":"ZeriQ"}]},"R:번개 방출":{"slot":"R","skill":{"id":"ZeriR","name":"번개 방출","description":"제리가 전류를 방출하고 자신을 과충전해, 피해량과 이동 속도가 증가합니다. 제리가 적 챔피언을 맞힐 때마다 이동 속도 증가 효과가 중첩되고 지속시간이 회복됩니다. 과충전된 동안 집중 사격이 더욱 빠른 3연발 사격으로 바뀌며, 대상 주변 적에게 번개가 연쇄적으로 튑니다.","maxrank":3,"cooldown":[80,75,70],"cost":[100,100,100],"image":{"full":"ZeriR.png","sprite":"spell17.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"80/75/70","costBurn":"100/100/100","costType":"마나","rankValues":[]}}},"Ambessa":{"Q:교활한 휩쓸기 / 파멸의 일격":{"slot":"Q","skill":{"id":"AmbessaQ","name":"교활한 휩쓸기 / 파멸의 일격","description":"암베사가 쌍둥이 용사냥개로 전방 반원을 휩쓸어 날에 적중한 적에게 추가 피해를 입힙니다. 적을 타격하면 다음에 이 스킬을 사용할 때 짧은 시간 동안 스킬이 변하며 암베사가 전방에 일직선상으로 쌍둥이 용사냥개를 내리쳐 처음 적중한 적에게 추가 피해를 입힙니다.","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[70,70,70,70,70],"image":{"full":"AmbessaQ.png","sprite":"spell0.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"70/70/70/70/70","costType":"기력","rankValues":[]}},"R:공개 처형":{"slot":"R","skill":{"id":"AmbessaR","name":"공개 처형","description":"암베사가 선택한 일직선상에서 가장 멀리 있는 적 챔피언에게 순간 이동한 후 제압합니다. 이후 해당 적 챔피언을 지면에 내리쳐 피해를 입히고 기절시킵니다.","maxrank":3,"cooldown":[130,115,100],"cost":[0,0,0],"image":{"full":"AmbessaR.png","sprite":"spell1.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"0/0/0","costType":"기력","rankValues":[]}}},"Anivia":{},"Ashe":{"Q:궁사의 집중":{"slot":"Q","skill":{"id":"AsheQ","name":"궁사의 집중","description":"애쉬는 공격을 계속하면 집중이 오릅니다. 집중 중첩이 최대치에 이르면 이를 모두 소모해 애쉬가 궁사의 집중을 사용할 수 있으며, 이 때 애쉬의 공격 속도가 잠시 동안 증가하고 그 동안 기본 공격이 강력한 다발 공격으로 변합니다.","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"AsheQ.png","sprite":"spell1.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"마나","rankValues":[]}}},"MonkeyKing":{"W:분신 전사":{"slot":"W","skill":{"id":"MonkeyKingDecoy","name":"분신 전사","description":"오공이 잠깐 동안 <font color='#91d7ee'>투명</font> 상태가 되고 지정한 방향으로 돌진하며 근처 적을 공격하는 분신을 남깁니다.","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[60,55,50,45,40],"image":{"full":"MonkeyKingDecoy.png","sprite":"spell8.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"60/55/50/45/40","costType":"마나","rankValues":[]}},"E:근두운 급습":{"slot":"E","skill":{"id":"MonkeyKingNimbus","name":"근두운 급습","description":"오공이 대상에게 돌격하는 동시에 자신의 분신을 만들어 대상 근처에 있는 적들에게 추가 공격을 하여 피해를 줍니다.","maxrank":5,"cooldown":[10,9.25,8.5,7.75,7],"cost":[30,35,40,45,50],"image":{"full":"MonkeyKingNimbus.png","sprite":"spell8.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"10/9.25/8.5/7.75/7","costBurn":"30/
{"schemaVersion":1,"patchVersion":"26.13","sources":{"ddragon":"16.13.1","cdragon":"16.13"},"locale":"zh_CN","champions":{"Brand":{"E:烈火燃烧":{"slot":"E","skill":{"id":"BrandE","name":"烈火燃烧","description":"布兰德在目标身上引发一阵强力的爆裂至附近的敌人处，造成魔法伤害。如果目标带有【烈焰焚身】效果，那么【E烈火燃烧】的扩散距离翻倍。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[90,90,90,90,90],"image":{"full":"BrandE.png","sprite":"spell2.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"90/90/90/90/90","costType":"法力","rankValues":[{"label":"基础伤害","values":"55 / 80 / 105 / 130 / 155"}]}},"P:炽热之焰":{"slot":"P","passive":{"name":"炽热之焰","description":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","image":{"full":"BrandP.png","sprite":"passive0.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}}},"Draven":{"E:开道利斧":{"slot":"E","skill":{"id":"DravenDoubleShot","name":"开道利斧","description":"德莱文扔出他的斧头，对命中的目标造成物理伤害，并将他们击退至一边。被命中的目标会受到减速效果。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[70,70,70,70,70],"image":{"full":"DravenDoubleShot.png","sprite":"spell3.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[{"label":"基础伤害","values":"75 / 110 / 145 / 180 / 215"}]}},"R:冷血追命":{"slot":"R","skill":{"id":"DravenRCast","name":"冷血追命","description":"德莱文掷出两柄大斧，对命中的每个单位造成物理伤害。在命中一名敌方英雄后，大斧会缓慢地调转方向，并回到德莱文身边。在斧头正在向外飞的时候，德莱文可以激活该技能来让斧头早点飞回来。每命中一个单位，伤害值就会减少。在斧头调转方向时，伤害值会重置。会处决那些生命值低于德莱文崇拜层数的敌人们。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"DravenRCast.png","sprite":"spell3.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Kaisa":{"W:虚空索敌":{"slot":"W","skill":{"id":"KaisaW","name":"虚空索敌","description":"卡莎发射一束长程弹体，并用她的被动来标记敌人。<br><br>活体武器：这个技能得到升级，可施加更多被动标记并在命中英雄时减少冷却时间。","maxrank":5,"cooldown":[20,18.5,17,15.5,14],"cost":[55,60,65,70,75],"image":{"full":"KaisaW.png","sprite":"spell5.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"20/18.5/17/15.5/14","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}},"R:猎手本能":{"slot":"R","skill":{"id":"KaisaR","name":"猎手本能","description":"卡莎突进到一个敌方英雄身边。","maxrank":3,"cooldown":[130,100,70],"cost":[100,100,100],"image":{"full":"KaisaR.png","sprite":"spell6.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"130/100/70","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Poppy":{"Q:圣锤猛击":{"slot":"Q","skill":{"id":"PoppyQ","name":"圣锤猛击","description":"波比挥舞她的铁锤，造成伤害并创造一个区域，这个区域会减速敌人并在一段时间后爆炸。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[35,40,45,50,55],"image":{"full":"PoppyQ.png","sprite":"spell10.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[{"label":"减速持续时间","values":"0.5秒"},{"label":"对野怪最大伤害","values":"75 / 105 / 135 / 165 / 195"}]},"icons":[{"file":"patch-notes/icons/70fef4c075ba62af93f8771598aca3da.webp","spellId":"PoppyQ"}]}},"Rumble":{"Q:纵火盛宴":{"slot":"Q","skill":{"id":"RumbleFlameThrower","name":"纵火盛宴","description":"兰博朝敌人放火，每秒对前方锥形范围内的敌人造成伤害，持续3秒。在危险温度时，兰博增加对其造成的伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"RumbleFlameThrower.png","sprite":"spell11.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"热量","rankValues":[{"label":"基础伤害","values":"50 / 75 / 100 / 125 / 150"}]},"icons":[{"file":"patch-notes/icons/c123c51be75b1bff099d4e25b29ebb47.webp","spellId":"RumbleFlameThrower"}]}},"Sion":{"W:灵魂熔炉":{"slot":"W","skill":{"id":"SionW","name":"灵魂熔炉","description":"赛恩为自己套上护盾，并能在3秒后再次激活这个技能来对身边的敌人造成魔法伤害。在赛恩击杀敌人时，他会被动获得最大生命值。","maxrank":5,"cooldown":[15,14,13,12,11],"cost":[75,80,85,90,95],"image":{"full":"SionW.png","sprite":"spell12.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn"
":[]}},"Q:伏魔三钉":{"slot":"Q","skill":{"id":"LockeQ","name":"伏魔三钉","description":"洛克依次击出三颗驱魔大钉，对命中的敌人们造成伤害，并附上一层印记。洛克的攻击可以引爆印记，造成额外伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[70,70,70,70,70],"image":{"full":"LockeQ.png","sprite":"spell7.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}},"W:灵焰仪式":{"slot":"W","skill":{"id":"LockeW","name":"灵焰仪式","description":"洛克点燃自己的灵魂，从而获得攻击速度和移动速度，但会不断对自身造成伤害。技能结束时，洛克将回复一部分在技能持续期间受到的伤害。","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[50,55,60,65,70],"image":{"full":"LockeW.png","sprite":"spell7.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"E:灰猎无影":{"slot":"E","skill":{"id":"LockeE","name":"灰猎无影","description":"洛克传送至目标位置，并在下一次攻击时朝目标冲刺，对途经的敌人们造成伤害。","maxrank":5,"cooldown":[10],"cost":[30,40,50,60,70],"image":{"full":"LockeE.png","sprite":"spell7.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"10","costBurn":"30/40/50/60/70","costType":"法力","rankValues":[]}},"R:万魔狱":{"slot":"R","skill":{"id":"LockeR","name":"万魔狱","description":"洛克扔出封印法器来对命中的敌人们造成伤害并且有可能将其处决。成功处决敌人会为洛克提供增益效果。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"LockeR.png","sprite":"spell7.png","group":"spell","x":336,"y":144,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[{"label":"基础伤害","values":"150 / 225 / 300"},{"label":"减速持续时间","values":"2秒"}]},"icons":[{"file":"patch-notes/icons/5a8e66787162622a9c9cf4f535adab84.webp","spellId":"LockeR"}]}},"Aphelios":{"Q:通碧 · 碧月闪光":{"slot":"Q","skill":{"id":"ApheliosQ_ClientTooltipWrapper","name":"通碧 · 碧月闪光","description":"厄斐琉斯拥有5个不同的主动技能，基于他的主手武器：<br><br>通碧(步枪)：长距离射击，能够标记目标来跟进一次长距离攻击。<br>断魄(短镰枪)：在快速奔跑的同时用两把武器攻击附近的敌人。<br>坠明(加农炮)：禁锢被这把武器减速的所有敌人。<br>荧焰(喷火器)：引爆锥形范围内的敌人并用你的副手武器攻击他们。<br>折镜(飞轮刃)：部署一个装备着你副手武器的驻灵。<br>","maxrank":6,"cooldown":[],"image":{
ource":"communitydragon","cost":[60,70,80,90,100],"costBurn":"60/70/80/90/100","costType":"法力值","resource":"法力值","range":[950,950,950,950,950],"rangeBurn":"950/950/950/950/950","image":{"full":"EliseHumanW.png"},"rankValues":[{"label":"伤害","values":"60/100/140/180/220"},{"label":"法力值消耗","values":"60/70/80/90/100"}],"scalings":[{"id":"damage","labelEn":"W Scaling","labelKo":"W 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"1:TotalDamage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"TotalDamage","kind":"damage","damageType":"magical","baseByRank":[60,100,140,180,220],"terms":[{"stat":"abilityPower","coefficientsByRank":[0.75,0.75,0.75,0.75,0.75]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/990846260495a0306f08789635e3c974.webp","spellId":"EliseSpiderW"}]}},"Fiora":{"R:无双挑战":{"slot":"R","skill":{"id":"FioraR","name":"无双挑战","maxrank":3,"cooldown":[110,90,70],"cooldownBurn":"110/90/70","description":"菲奥娜显示出一个敌方英雄身上的所有四处破绽，并在目标附近时获得移动速度加成。如果菲奥娜命中了所有四处破绽，或者目标在死前至少被命中了一处破绽，那么菲奥娜和范围内的友军就会在接下来的几秒里持续获得治疗效果。","summary":"菲奥娜显示出一个敌方英雄身上的所有四处破绽，并在目标附近时获得移动速度加成。如果菲奥娜命中了所有四处破绽，或者目标在死前至少被命中了一处破绽，那么菲奥娜和范围内的友军就会在接下来的几秒里持续获得治疗效果。","tooltip":"<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span><span>决斗之舞</span><span class=\"text-cyan-600 dark:text-cyan-500\">移动速度</span>加成提升至30/40/50%。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动</span>：菲奥娜标出一名英雄身上的全部四处<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">破绽</span>，最多可造成<span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">(12% + ([[si:scalead]]0.16% 额外攻击力))最大生命值的真实伤害</span>并在目标附近时获得<span>决斗之舞</span>的<span class=\"text-cyan-600 dark:text-cyan-500\">移动速度加成</span>。<br /><br />如果菲奥娜在8秒内命中了全部四处<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">破绽</span>，或者在目标死前至少命中一处，那么菲奥娜就会为周围的友方英雄每秒回复<span class=\"text-green-600 dark:text-green-400\">(80/105/130 + ([[si:scalead]]70% 额外攻击力))生命值</span>，持续5秒。","tooltipSource":"communitydragon","cost":[100,100,100],"costBurn":"100/100/100","costType":"法力值","resource":"法力值","range":[500,500,500],"rangeBurn":"500/500/500","image":{"full":"FioraR.png"},"rankValues":[{"label":"冷却时间","values":"110/90/70"},{"label":"决斗移动速度加成","values":"30%/40%/50%"},{"label":"每秒治疗","values":"80/105/130"}],"scalings":[{"id":"damage","labelEn":"R Scaling","labelKo":"R 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"3:HealPerSecondCalc"}]}],"conditions":["per-second"],"simulation":{"status":"unavailable","unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/bb029ac1d64bb16570fde2a3b10ad055.webp","spellId":"FioraR"}]}},"Khazix":{"P:无形威胁":{"slot":"P","passive":{"name":"无形威胁","description":"当卡兹克没有在敌方队伍的视野内时，他的下次对敌方英雄发起的攻击会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((22 ~ 141[[si:scalelevel]]) + ([[si:scalead]]50% 额外攻击力))魔法伤害</span>和持续2秒的25%<span class=\"text-purple-600 dark:text-purple-500\">减速</span>。<br /><br />附近没有友军的敌人会处于<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">孤立无援</span>状态。","summary":"附近陷入<font color='#FFF673'>孤立无援</font>状态的敌人会被标记出来。卡兹克的技能会与<font color='#FFF673'>孤立无援</font>的目标产生交互作用。<br><br>当卡兹克没有被敌方队伍所看见时，他会获得无形威胁，使他的下次对敌方英雄发动的普通攻击造成额外魔法伤害，并使目标减速数秒。","spellId":"KhazixPassive","tooltipSource":"communitydragon","rankValues":[],"levelValues":[{"values":[22,29,36,43,50,57,64,71,78,85,92,99,106,113,120,127,134,141,148,155],"digits":0}],"scalings":[],"conditions":[],"simulation":{"status":"unavailable","unsupportedPartTypes":[]},"image":{"full":"Khazix_P.png"}},"icons":[{"file":"patch-notes/icons/381784b9dffe43fb396b0a04613ad6c8.webp","spellId":"KhazixPassive"}]},"W:虚空突刺":{"slot":"W","skill":{"id":"KhazixW","name":"虚空突刺","maxrank":5,"cooldown":[9,9,9,9,9],"cooldownBurn":"9/9/9/9/9","description":"卡兹克发射爆炸性的尖刺，对命中的敌人造成物理伤害。卡兹克如果在爆炸范围内，则会回复生命值。如果他选择<font color='#00DD33'>进化刺鞘</font>的话，虚空突刺现在会呈锥形发射三个尖刺，减速被命中的敌人并使被命中的敌方英雄显形2秒。<font color='#FFF673'>孤立无援</font>的目标会被减速额外的幅度。","summary":"卡兹克发射爆炸性的尖刺，对命中的敌人造成物理伤害。卡兹克如果在爆炸范围内，则会回复生命值。如果他选择<font color='#00DD33'>进化刺鞘</font>的话，虚空突刺现在会呈锥形发射三个尖刺，减速被命中的敌人并使被命中的敌方英雄显形2秒。<font color='#FFF673'>孤立无援</font>的目标会被减速额外的幅度。","tooltip":"卡兹克发射一根尖刺，对命中的首个目标及一个小区域内造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(75/105/135/165/195 + ([[si:scalead]]100% 额外攻击力))物理伤害</span>。如果卡兹克在该区域内，那么他会回复<span class=\"text-green-600 dark:text-green-400\">(55/75/95/115/135 + ([[si:scaleap]]50% 法术强度))生命值</span>。","tooltipSource":"communitydragon","cost":[55,60,65,70,75],"costBurn":"55/60/65/70/75","costType":"法力值","resource":"法力值","range":[1000,1000,1000,1000,1000],"rangeBurn":"1000/1000/1000/1000/1000","image":{"full":"KhazixW.png"},"rankValues":[{"label":"伤害","values":"75/105/135/165/195"},{"label":"治疗效果","values":"55/75/95/115/135"},{"label":"法力值消耗","values":"55/60/65/70/75"}],"scalings":[{"id":"damage","labelEn":"W Scaling","labelKo":"W 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"1:BaseDamage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"BaseDamage","kind":"damage","damageType":"physical","baseByRank":[105,135,165,195,195],"terms":[{"stat":"bonusAttackDamage","coefficientsByRank":[1,1,1,1,1]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/109f484241a7ad258b04faa965fdd689.webp","spellId":"KhazixW"}]},"E:跃击":{"slot":"E","skill":{"id":"KhazixE","name":"跃击","maxrank":5,"cooldown":[20,18,16,14,12],"cooldownBurn":"20/18/16/14/12","description":"卡兹克跳向一个区域，在着陆时造成物理伤害。如果他选择<font color='#00DD33'>进化虫翼</font>的话，跃击的距离会提升200并在击杀和助攻时重置冷却时间。","summary":"卡兹克跳向一个区域，在着陆时造成物理伤害。如果他选择<font color='#00DD33'>进化虫翼</font>的话，跃击的距离会提升200并在击杀和助攻时重置冷却时间。","tooltip":"卡兹克进行跳跃，在着陆时造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(65/100/135/170/205 + ([[si:scalead]]40% 额外攻击力))物理伤害</span>。","tooltipSource":"communitydragon","cost":[50,50,50,50,50],"costBurn":"50/50/50/50/50","costType":"法力值","resource":"法力值","range":[700,700,700,700,700],"rangeBurn":"700/700/700/700/700","image":{"full":"KhazixE.png"},"rankValues":[{"label":"伤害","values":"65/100/135/170/205"},{"label":"冷却时间","values":"20/18/16/14/12"}],"scalings":[{"id":"damage","labelEn":"E Scaling","labelKo":"E 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"2:TotalDamage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"TotalDamage","kind":"damage","damageType":"physical","baseByRank":[100,135,170,205,240],"terms":[{"stat":"bonusAttackDamage","coefficientsByRank":[0.4000000059604645,0.4000000059604645,0.4000000059604645,0.4000000059604645,0.4000000059604645]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/0fdf401460decffb20e2ae74fe41dad9.webp","spellId":"KhazixE"}]}},"Lillia":{"R:夜阑谣":{"slot":"R","skill":{"id":"LilliaR","name":"夜阑谣","maxrank":3,"cooldown":[150,130,110],"cooldownBurn":"150/130/110","description":"莉莉娅使所有带着【梦尘】的敌人陷入困倦状态，然后陷入昏睡状态。这些敌人在被强制唤醒时会受到额外伤害。","summary":"莉莉娅使所有带着【梦尘】的敌人陷入困倦状态，然后陷入昏睡状态。这些敌人在被强制唤醒时会受到额外伤害。","tooltip":"莉莉娅使所有带着<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">梦尘</span>的敌人陷入<span class=\"text-purple-600 dark:text-purple-500\">困倦状态</span>1.5秒。此后，他们会陷入<span class=\"text-purple-600 dark:text-purple-500\">昏睡状态</span>2.5秒。<br /><br />在被伤害惊醒时，他们会受到额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(100/150/200 + ([[si:scaleap]]40% 法术强度))魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">【困倦状态】的单位会在期间内受到减速效果，然后陷入【昏睡状态】。<br />【昏睡状态】的单位无法移动或行动，直到被一名敌人用非周期性的伤害打醒为止。</span>","tooltipSource":"communitydragon","cost":[50,50,50],"costBurn":"50/50/50","costType":"法力值","resource":"法力值","range":[1600,1600,1600],"rangeBurn":"1600/1600/1600","image":{"full":"LilliaR.png"},"rankValues":[{"label":"冷却时间","values":"150/130/110"},{"label":"惊醒伤害","values":"100/150/200"}],"scalings":[{"id":"damage","labelEn":"R Scaling","labelKo":"R 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"3:TotalDamage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"TotalDamage","kind":"damage","damageType":"magical","baseByRank":[100,150,200],"terms":[{"stat":"abilityPower","coefficientsByRank":[0.4000000059604645,0.4000000059604645,0.4000000059604645]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/c8a31d8415023b7538ea73819de7c2cd.webp","spellId":"LilliaR"}]}},"Lucian":{"P:圣光银弹":{"slot":"P","passive":{"name":"圣光银弹","description":"每使用一个技能后，卢锡安在3.5秒内的下一次普攻都会连续发射两颗子弹。第二颗子弹对目标造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">([[si:scalead]](50% ~ 60%[[si:scalelevel]]) 攻击力)物理伤害</span>，对小兵时提升至<span class=\"text-red-600 dark:text-red-500 font-semibold\">([[si:scalead]]100% 攻击力)物理伤害</span>。<br /><br /><span>警惕：</span>当卢锡安从另一位友军处获得直接治疗或护盾、或者有一名附近的敌方英雄被<span class=\"text-purple-600 dark:text-purple-500\">定身</span>时，他的双枪会<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">能量过载</span>，使他的下2次普通攻击造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(5 + ([[si:scalead]]15% 攻击力))魔法伤害</span>。","summary":"每使用一个技能时，卢锡安的下次普通攻击都会连射2次。当卢锡安从另一位友军处获得治疗或护盾、或者有一名附近的敌方英雄被定身时，他的下2次普通攻击造成额外魔法伤害。","spellId":"LucianPassive","tooltipSource":"communitydragon","rankValues":[],"levelValues":[{"values":[50,50,50,50,50,50,55,55,55,55,55,55,60,60,60,60,60,60,70,70],"digits":2,"trimZeros":true,"percent":true}],"scalings":[],"conditions":[],"simulation":{"status":"unavailable","unsupportedPartTypes":[]},"image":{"full":"Lucian_Passive.png"}},"icons":[{"file":"patch-notes/icons/9d3f1b111b109b137ad5f14fc85a49f7.webp","spellId":"LucianPassive"}]},"Q:透体圣光":{"slot":"Q","skill":{"id":"LucianQ","name":"透体圣光","maxrank":5,"cooldown":[9,8,7,6,5],"cooldownBurn":"9/8/7/6/5","description":"卢锡安射出一束穿透性的圣光穿过他的目标。","summary":"卢锡安射出一束穿透性的圣光穿过他的目标。","tooltip":"卢锡安发射一束透体圣光，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(90/130/170/210/250 + ([[si:scalead]]100% 额外攻击力))物理伤害</span>。<br /><br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">这个技能的施放时间会随着卢锡安的等级提升而缩短。</span>","toolti
,"expression":{"id":"TotalDamage","kind":"damage","damageType":"physical","root":{"kind":"sum","parts":[{"kind":"value","value":{"byRank":[30,50,70,90,110]}},{"kind":"stat","stat":"totalAttackDamage","coefficient":{"byRank":[1,1,1,1,1]}},{"kind":"buffStacks","buff":"{1b1d7345}","coefficient":{"byRank":[1,1,1,1,1]},"stackSource":"Q"}]},"requiresBuffStacks":true},"unsupportedPartTypes":["BuffCounterByCoefficientCalculationPart","nonlinear-product"]}},"icons":[{"file":"patch-notes/icons/73df91d4a822ef1bfd8b1616851cc453.webp","spellId":"NasusQ"}]}},"Nocturne":{"R:鬼影重重":{"slot":"R","skill":{"id":"NocturneParanoia","name":"鬼影重重","maxrank":3,"cooldown":[160,130,100],"cooldownBurn":"160/130/100","description":"魔腾减少所有敌方英雄的视野范围，并在此过程中移除敌方英雄的友军的视野。魔腾能够借机突进到附近的敌方英雄身边。","summary":"魔腾减少所有敌方英雄的视野范围，并在此过程中移除敌方英雄的友军的视野。魔腾能够借机突进到附近的敌方英雄身边。","tooltip":"魔腾使地图变暗，降低所有敌方英雄的视野半径并移除其友方视野，持续6秒。魔腾能够在持续期间<span class=\"text-yellow-600 dark:text-yellow-300\">再次施放</span>这个技能，来突进到一名敌方英雄的身边并造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(150/275/400 + ([[si:scalead]]120% 额外攻击力))物理伤害</span>。","tooltipSource":"communitydragon","cost":[100,100,100],"costBurn":"100/100/100","costType":"法力值","resource":"法力值","range":[2500,3250,4000],"rangeBurn":"2500/3250/4000","image":{"full":"NocturneParanoia.png"},"rankValues":[{"label":"伤害","values":"150/275/400"},{"label":"冷却时间","values":"160/130/100"}],"scalings":[{"id":"damage","labelEn":"R Scaling","labelKo":"R 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"3:Damage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"Damage","kind":"damage","damageType":"physical","baseByRank":[150,275,400],"terms":[{"stat":"bonusAttackDamage","coefficientsByRank":[1.2000000476837158,1.2000000476837158,1.2000000476837158]}]},"unsupportedPartTypes":[]}}}},"Poppy":{"Q:圣锤猛击":{"slot":"Q","skill":{"id":"PoppyQ","name":"圣锤猛击","maxrank":5,"cooldown":[8,7,6,5,4],"cooldownBurn":"8/7/6/5/4","description":"波比挥舞她的铁锤，造成伤害并创造一个区域，这个区域会减速敌人并在一段时间后爆炸。","summary":"波比挥舞她的铁锤，造成伤害并创造一个区域，这个区域会减速敌人并在一段时间后爆炸。","tooltip":"波比猛砸地面，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(30/55/80/105/130 + ([[si:scalead]]75% 额外攻击力))</span>外加<span class=\"text-red-600 dark:text-red-500 font-semibold\">7/7.5/8/8.5/9%最大生命值的物理伤害</span>并使该地面变得不稳定。 <br /><br />不稳定区域会使敌人<span class=\"text-purple-600 dark:text-purple-500\">减速</span>(20/23/26/29/32% + ([[si:scalehealth]]每100点额外生命值0.8%))并在1秒后喷发，再次造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(30/55/80/105/130 + ([[si:scalead]]75% 额外攻击力))</span>外加<span class=\"text-red-600 dark:text-red-500 font-semibold\">7/7.5/8/8.5/9%最大生命值的物理伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">每一击对小兵和野怪的百分比生命值伤害的上限为70/105/140/175/210。</span>","tooltipSource":"communitydragon","cost":[35,40,45,50,55],"costBurn":"35/40/45/50/55","costType":"法力值","resource":"法力值","range":[430,430,430,430,430],"rangeBurn":"430/430/430/430/430","image":{"full":"PoppyQ.png"},"rankValues":[{"label":"伤害","values":"30/55/80/105/130"},{"label":"%最大生命值","values":"7%/7.5%/8%/8.5%/9%"},{"label":"减速","values":"20%/23%/26%/29%/32%"},{"label":"冷却时间","values":"8/7/6/5/4"},{"label":"法力值消耗","values":"35/40/45/50/55"},{"label":"对野怪的伤害封顶值","values":"70/105/140/175/210"}],"scalings":[{"id":"damage","labelEn":"Q Scaling","labelKo":"Q 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"0:BaseDamage"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"BaseDamage","kind":"damage","damageType":"physical","baseByRank":[30,55,80,105,130],"terms":[{"stat":"bonusAttackDamage","coefficientsByRank":[0.75,0.75,0.75,0.75,0.75]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/70fef4c075ba62af93f8771598aca3da.webp","spellId":"PoppyQ"}]}},"Rumble":{"P:机械重组":{"slot":"P","passive":{"name":"机械重组","description":"兰博的技能生成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">热量</span>。在<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">50热量</span>以上时，他会进入<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">危险温度</span>，使他的基础技能可以获得额外效果。当他到达<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">150热量</span>时，他会进入持续4秒的过热状态。<br /><br />在过热状态下，兰博会<span class=\"text-purple-600 dark:text-purple-500\">沉默</span>自身，但会获得<span>(30% ~ 100%[[si:scalelevel]])攻击速度</span>并使他的攻击造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((5 ~ 40[[si:scalelevel]]) + ([[si:scaleap]]25% 法术强度))外加4%最大生命值的魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">对野怪的百分比伤害的上限为(90 ~ 175[[si:scalelevel]])。</span>","summary":"兰博的技能都能使其获得热量。当兰博的热量达到50%时，他会处于危险温度状态，所有基础技能都会获得额外效果。当热量达到100%时，他会进入过热状态，获得额外的攻击速度并让他的普通攻击造成额外伤害，但也会让他在数秒内无法施放技能。","spellId":"RumbleHeatSystem","tooltipSource":"communitydragon","rankValues":[],"levelValues":[{"values":[30,32.96471,36.07353,39.32647,42.72353,46.26471,49.95,53.77941,57.75294,61.87059,66.13235,70.53824,75.08824,79.78235,84.62059,89.60294,94.72941,100,100,100],"digits":0,"percent":true},{"values":[5,7.058824,9.117647,11.17647,13.23529,15.29412,17.35294,19.41176,21.47059,23.52941,25.58824,27.64706,29.70588,31.76471,33.82353,35.88235,37.94118,40,40,40],"digits":0},{"values":[90,93.6,97.375,101.325,105.45,109.75,114.225,118.875,123.7,128.7,133.875,139.225,144.75,150.45,156.325,162.375,168.6,175,175,175],"digits":0}],"scalings":[],"conditions":[],"simulation":{"status":"unavailable","unsupportedPartTypes":[]},"image":{"full":"Rumble_JunkyardTitan1.png"}},"icons":[{"file":"patch-notes/icons/f666501a8d1d64ec185ca939378ce08c.webp","spellId":"RumbleHeatSystem"}]}},"Ryze":{"Q:超负荷":{"slot":"Q","skill":{"id":"RyzeQWrapper","name":"超负荷","maxrank":5,"cooldown":[5,5,5,5,5],"cooldownBurn":"5/5/5/5/5","description":"被动部分：瑞兹的其它基础技能会重置【超负荷】的冷却时间并且充能一层符文。当瑞兹带着2层符文施放【超负荷】时，他会获得短暂的爆发性移动速度加成。<br><br>施放时，瑞兹会沿直线扔出一团纯粹能量，来对命中的第一个敌人造成伤害。如果目标身上有【涌动】效果，那么【超负荷】会造成额外伤害并弹射至附近带有【涌动】效果的敌人身上。","summary":"被动部分：瑞兹的其它基础技能会重置【超负荷】的冷却时间并且充能一层符文。当瑞兹带着2层符文施放【超负荷】时，他会获得短暂的爆发性移动速度加成。<br><br>施放时，瑞兹会沿直线扔出一团纯粹能量，来对命中的第一个敌人造成伤害。如果目标身上有【涌动】效果，那么【超负荷】会造成额外伤害并弹射至附近带有【涌动】效果的敌人身上。","tooltip":"<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span><span>符文禁锢</span>和<span>法术涌动</span>会刷新这个技能的冷却时间并充能一枚符文，持续4秒(最多2枚符文)。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动：</span>瑞兹释放一次魔爆，对命中的第一个敌人造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(75/95/115/135/155 + ([[si:scaleap]]55% 法术强度) + (2% 额外 法力值))魔法伤害</span>。如果目标带有<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">涌动</span>，则它会将其消耗，使这个技能造成15/40/65/90%伤害提升并弹射至附近带有<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">涌动</span>的敌人们。<br /><br />如果2枚符文已被充能，瑞兹就会释放所有符文的能量，来为瑞兹提供持续2秒的<span class=\"text-cyan-600 dark:text-cyan-500\">28/32/36/40/44%移动速度</span>。<br />","tooltipSource":"communitydragon","cost":[40,38,36,34,32],"costBurn":"40/38/36/34/32","costType":"法力值","resource":"法力值","range":[1000,1000,1000,1000,1000],"rangeBurn":"1000/1000/1000/1000/1000","image":{"full":"RyzeQWrapper.png"},"rankValues":[{"label":"伤害","values":"75/95/115/135/155"},{"label":"移动速度","values":"28%/32%/36%/40%/44%"},{"label":"法力消耗","values":"40/38/36/34/32"}],"scalings":[{"id":"damage","labelEn":"Q Scaling","labelKo":"Q 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"0:QDamageCalc"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"QDamageCalc","kind":"damage","damageType":"magical","baseByRank":[75,95,115,135,155],"terms":[{"stat":"abilityPower","coefficientsByRank":[0.550000011920929,0.550000011920929,0.550000011920929,0.550000011920929,0.550000011920929]},{"stat":"bonusMana","coefficientsByRank":[0.019999999552965164,0.019999999552965164,0.019999999552965164,0.019999999552965164,0.019999999552965164]}]},"unsupportedPartTypes":[]}}},"E:法术涌动":{"slot":"E","skill":{"id":"RyzeE","name":"法术涌动","maxrank":5,"cooldown":[3.5,3.25,3,2.75,2.5],"cooldownBurn":"3.5/3.25/3/2.75/2.5","description":"瑞兹放出一颗纯净魔法能量球，对一名敌人造成伤害并对附近的敌人造成减益效果。瑞兹的技能可以对带有该减益的敌人造成额外效果。","summary":"瑞兹放出一颗纯净魔法能量球，对一名敌人造成伤害并对附近的敌人造成减益效果。瑞兹的技能可以对带有该减益的敌人造成额外效果。","tooltip":"瑞兹发射一颗法球，造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + ([[si:scaleap]]50% 法术强度) + (2% 额外 法力值))魔法伤害</span>并施加持续4秒的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">涌动</span>给目标和附近的敌人们。已被<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">涌动</span>影响的敌人们将使其进一步扩散。","tooltipSource":"communitydragon","cost":[40,50,60,70,80],"costBurn":"40/50/60/70/80","costType":"法力值","resource":"法力值","range":[615,615,615,615,615],"rangeBurn":"615/615/615/615/615","image":{"full":"RyzeE.png"},"rankValues":[{"label":"伤害","values":"60/90/120/150/180"},{"label":"冷却时间","values":"3.5/3.25/3/2.75/2.5"},{"label":"法力消耗","values":"40/50/60/70/80"}],"scalings":[{"id":"damage","labelEn":"E Scaling","labelKo":"E 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"2:EDamageCalc"}]}],"conditions":[],"simulation":{"status":"complete","primary":{"id":"EDamageCalc","kind":"damage","damageType":"magical","baseByRank":[60,90,120,150,180],"terms":[{"stat":"abilityPower","coefficientsByRank":[0.5,0.5,0.5,0.5,0.5]},{"stat":"bonusMana","coefficientsByRank":[0.019999999552965164,0.019999999552965164,0.019999999552965164,0.019999999552965164,0.019999999552965164]}]},"unsupportedPartTypes":[]}}}},"Vi":{"P:爆裂护盾":{"slot":"P","passive":{"name":"爆裂护盾","description":"蔚在用一个已激活的技能命中一名敌人或建筑物后，会获得<span class=\"text-blue-600 dark:text-blue-300\">([[si:scalehealth]]10% 生命值)护盾值</span>，持续3秒。","summary":"蔚持续为护盾充能。护盾会在蔚的技能命中一名敌人后激活。","spellId":"ViPassive","tooltipSource":"communitydragon","rankValues":[],"scalings":[],"conditions":[],"simulation":{"status":"unavailable","unsupportedPartTypes":[]},"image":{"full":"ViPassive.png"}},"icons":[{"file":"patch-notes/icons/69cfc99300b66a5cfcecbe83e2c7a4b9.webp","spellId":"ViPassive"}]}},"Volibear":{"P:狂雷渐起":{"slot":"P","passive":{"name":"狂雷渐起","description":"沃利贝尔在每次用攻击或技能造成伤害时都会
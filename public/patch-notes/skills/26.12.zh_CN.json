],"image":{"full":"SyndraQ.png","sprite":"spell13.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"7","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[{"label":"基础伤害","values":"90 / 125 / 160 / 195 / 230"}]},"icons":[{"file":"patch-notes/icons/058a99b1bc587b445faaf2377eb4b919.webp","spellId":"SyndraQ"}]}},"Tristana":{"Q:急速射击":{"slot":"Q","skill":{"id":"TristanaQ","name":"急速射击","description":"崔丝塔娜急速射击，短时间内提升攻击速度。","maxrank":5,"cooldown":[20,19,18,17,16],"cost":[15,20,25,30,35],"image":{"full":"TristanaQ.png","sprite":"spell14.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"20/19/18/17/16","costBurn":"15/20/25/30/35","costType":"法力","rankValues":[]}}},"XinZhao":{"W:风斩电刺":{"slot":"W","skill":{"id":"XinZhaoW","name":"风斩电刺","description":"赵信用他的长枪斩击他的前方，之后将长枪向前刺击，并使被击中的敌人减速并对其施加被挑战印记。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[60,60,60,60,60],"image":{"full":"XinZhaoW.png","sprite":"spell16.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"E:无畏冲锋":{"slot":"E","skill":{"id":"XinZhaoE","name":"无畏冲锋","description":"赵信对一名敌人发起冲锋，获得攻击速度并对范围内的所有敌人造成伤害，并使他们暂时减速。以被挑战的敌人为目标时，这个技能的施放距离会获得提升。","maxrank":5,"cooldown":[11],"cost":[60,60,60,60,60],"image":{"full":"XinZhaoE.png","sprite":"spell16.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"11","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[{"label":"基础伤害","values":"50 / 75 / 100 / 125 / 150"},{"label":"减速持续时间","values":"0.5秒"}]}},"P:果决":{"slot":"P","passive":{"name":"果决","description":"每第三次攻击造成额外伤害并治疗赵信自身。","image":{"full":"XinZhaoReworkP.png","sprite":"passive5.png","group":"passive","x":384,"y":0,"w":48,"h":48},"rankValues":[]}}},"Aatrox":{"Q:暗裔利刃":{"slot":"Q","skill":{"id":"AatroxQ","name":"暗裔利刃","description":"亚托克斯向下猛砸他的巨剑，并造成物理伤害。他可以挥击三次，每次都有一个不同的范围效果。","maxrank":5,"cooldown":[14,12,10,8,6],"cost":[0,0,0,0,0],"image":{"full":"AatroxQ.png","sprite":"spell0.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"14/12/10/8/6","costBurn":"0/0/0/0/0","costType":"鲜血魔井","rankValues":[]}}},"Gwen":{"Q:快刀剪乱":{"slot":"Q","skill":{"id":"GwenQ","name":"快刀剪乱","description":"格温在一个锥形区域剪切她的剪刀至多6次，来造成魔法伤害。格温的每次剪切会对中心区域的敌人造成真实伤害并对它们施加她的被动技能。","maxrank":5,"cooldown":[6.5,5.75,5,4.25,3.5],"cost":[40,40,40,40,40],"image":{"full":"GwenQ.png","sprite":"spell4.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6.5/5.75/5/4.25/3.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"E:断续疾走":{"slot":"E","skill":{"id":"GwenE","name":"断续疾走","description":"格温冲刺一小段距离然后获得攻击速度、攻击距离和魔法伤害<OnHit>攻击特效</OnHit>，持续若干秒。如果她在此期间命中了一个敌人，那么这个技能的冷却时间会获得部分返还。","maxrank":5,"cooldown":[13,12.5,12,11.5,11],"cost":[35,35,35,35,35],"image":{"full":"GwenE.png","sprite":"spell4.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"13/12.5/12/11.5/11","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[{"label":"基础伤害","values":"15"}]},"icons":[{"file":"patch-notes/icons/2304c3db026f7d5da247927ff8eb8f74.webp","spellId":"GwenE"}]}},"LeeSin":{"Q:天音波/回音击":{"slot":"Q","skill":{"id":"LeeSinQOne","name":"天音波/回音击","description":"天音波：李青发出刺耳的声波定位敌人，对首个敌人造成物理伤害。如果天音波击中敌人，李青在接下来3秒可施放回音击。<br>回音击：李青冲向被天音波击中的敌人，造成基于该目标已损失生命值的物理伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[50,50,50,50,50],"image":{"full":"LeeSinQOne.png","sprite":"spell7.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}}},"Orianna":{"P:发条协奏":{"slot":"P","passive":{"name":"发条协奏","description":"奥莉安娜的攻击会造成额外魔法伤害。这个伤害可在奥莉安娜对相同目标进行更多次攻击后提升。","image":{"full":"OriannaPassive.png","sprite":"passive3.png","group":"passive","x":336,"y":0,"w":48,"h":48},"rankValues":[]}},"R:指令：冲击波":{"slot":"R","skill":{"id":"OrianaDetonateCommand","name":"指令：冲击波","description":"奥莉安娜指挥她的魔偶，释放一股冲击波，对周围敌军造成魔法伤害并在短暂延迟后将他们拉向魔偶。","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"OrianaDetonateCommand.png","sprite":"spell10.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Ryze":{},"Varus":{"P:复仇之欲":{"slot":"P","passive":{"name":"复仇之欲","description":"每完成一次击杀或助攻，韦鲁斯就会暂时获得攻击速度、攻击力和法术强度。如果敌人是个英雄，则这个加成的幅度会更大。","image":{"full":"VarusPassive.png","sprite":"passive4.png","group":"passive","x":240,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:穿刺之箭":{"slot":"Q","skill":{"id":"VarusQ","name":"穿刺之箭","description":"韦鲁斯开始蓄力，随后进行一次远距离的强力射击，蓄力时间越长，伤害越高。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[50,55,60,65,70],"image":{"full":"VarusQ.png","sprite":"spell14.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"W:枯萎箭袋":{"slot":"W","skill":{"id":"VarusW","name":"枯萎箭袋","description":"被动：韦鲁斯的普通攻击会造成额外的伤害，并附加枯萎效果。韦鲁斯的其它技能会引爆枯萎效果，造成基于目标最大生命值的魔法伤害。主动：韦鲁斯增强他的下一个【穿刺之箭】。","maxrank":5,"cooldown":[40],"cost":[0,0,0,0,0],"image":{"full":"VarusW.png","sprite":"spell14.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"40","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Yuumi":{"P:猫的博爱":{"slot":"P","passive":{"name":"猫的博爱","description":"周期性地，当悠米用一个攻击或技能击中一个英雄时，她会为自身和她要附身的下一个友方英雄回复生命值。<br><br>在附身于友方英雄时，悠米会与她的友方英雄们生成一个特殊羁绊。在附身于拥有最强羁绊的那名友方英雄时，悠米的各个技能会获得强化。","image":{"full":"YuumiP2.png","sprite":"passive5.png","group":"passive","x":144,"y":48,"w":48,"h":48},"rankValues":[]}},"E:旺盛精力":{"slot":"E","skill":{"id":"YuumiE","name":"旺盛精力","description":"为悠米提供护盾值和一个爆发性的移动速度和攻击速度加成。如果她处于附身状态，那么她会将这个效果传给她附身的友方英雄。<br>","maxrank":5,"cooldown":[10],"cost":[80,90,100,110,120],"image":{"full":"YuumiE.png","sprite":"spell16.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"10","costBurn":"80/90/100/110/120","costType":"法力","rankValues":[]}}}}}
{"schemaVersion":1,"patchVersion":"25.6","sources":{"ddragon":"15.6.1","cdragon":"15.6"},"locale":"zh_CN","champions":{"Fiora":{"Q:破空斩":{"slot":"Q","skill":{"id":"FioraQ","name":"破空斩","description":"菲奥娜向一个方向冲刺，并刺击一个附近的敌人，造成物理伤害并施加攻击特效。","maxrank":5,"cooldown":[13,11.25,9.5,7.75,6],"cost":[20,20,20,20,20],"image":{"full":"FioraQ.png","sprite":"spell3.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"13/11.25/9.5/7.75/6","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}}},"Gwen":{"E:断续疾走":{"slot":"E","skill":{"id":"GwenE","name":"断续疾走","description":"格温冲刺一小段距离然后获得攻击速度、攻击距离和魔法伤害<OnHit>攻击特效</OnHit>，持续若干秒。如果她在此期间命中了一个敌人，那么这个技能的冷却时间会获得部分返还。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[35,35,35,35,35],"image":{"full":"GwenE.png","sprite":"spell4.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}},"P:千刀萬剮（被動）":{"slot":"P","passive":{"name":"千刀萬剮（被動）","description":"格温的攻击会造成基于目标生命值的额外魔法伤害。她自身会获得治疗效果，数额相当于这个效果对英雄造成的一部分伤害值。","image":{"full":"Gwen_Passive.png","sprite":"passive1.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:快刀剪乱":{"slot":"Q","skill":{"id":"GwenQ","name":"快刀剪乱","description":"格温在一个锥形区域剪切她的剪刀至多6次，来造成魔法伤害。格温的每次剪切会对中心区域的敌人造成真实伤害并对它们施加她的被动技能。","maxrank":5,"cooldown":[6.5,5.75,5,4.25,3.5],"cost":[40,40,40,40,40],"image":{"full":"GwenQ.png","sprite":"spell4.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6.5/5.75/5/4.25/3.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"W:丝缕缠流":{"slot":"W","skill":{"id":"GwenW","name":"丝缕缠流","description":"格温召唤圣霭来保护她免受圣霭外敌人的进攻。她只会被进入圣霭内的敌人们选为目标。","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[60,60,60,60,60],"image":{"full":"GwenW.png","sprite":"spell4.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"R:引针簇射":{"slot":"R","skill":{"id":"GwenR","name":"引针簇射","description":"格温掷出一根针来对命中的敌人们造成减速、魔法伤害，并对命中的英雄们施加【千穿百孔】。<br><br>这个技能至多可进行2段再次施放，每一段再次施放都会投掷更多的针，并造成更多伤害。 ","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"GwenR.png","sprite":"spell4.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Kaisa":{"R:猎手本能":{"slot":"R","skill":{"id":"KaisaR","name":"猎手本能","description":"卡莎突进到一个敌方英雄身边。","maxrank":3,"cooldown":[120,90,60],"cost":[100,100,100],"image":{"full":"KaisaR.png","sprite":"spell6.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"120/90/60","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Lillia":{"E:流涡种":{"slot":"E","skill":{"id":"LilliaE","name":"流涡种","description":"莉莉娅猛掷出一枚种子，种子在着陆时会造成伤害和减速效果。如果种子未能命中任何东西，那么它将继续滚动，直到命中墙体或一名敌人为止。","maxrank":5,"cooldown":[12],"cost":[70,70,70,70,70],"image":{"full":"LilliaE.png","sprite":"spell7.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"12","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Lucian":{"E:冷酷追击":{"slot":"E","skill":{"id":"LucianE","name":"冷酷追击","description":"卢锡安冲刺一小段距离。【圣光银弹】的攻击会减少【冷酷追击】的冷却时间。","maxrank":5,"cooldown":[16,15.5,15,14.5,14],"cost":[40,30,20,10,0],"image":{"full":"LucianE.png","sprite":"spell7.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"16/15.5/15/14.5/14","costBurn":"40/30/20/10/0","costType":"法力","rankValues":[]}}},"Naafiri":{"W:暴吼":{"slot":"W","skill":{"id":"NaafiriR","name":"暴吼","description":"纳亚菲利变为不可被选取状态并强化她的狗群，生成额外的狗群伙伴并获得移动速度和攻击力提升。<br>","maxrank":5,"cooldown":[20,19.5,19,18.5,18],"cost":[60,60,60,60,60],"image":{"full":"NaafiriR.png","sprite":"spell9.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"20/19.5/19/18.5/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"E:剔骨本能":{"slot":"E","skill":{"id":"NaafiriE","name":"剔骨本能","description":"纳亚菲利冲刺并伤害她附近一个区域内的敌人们，唤回她的狗群并完全回复它们的生命值。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[35,35,35,35,35],"image":{"full":"NaafiriE.png","sprite":"spell9.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}},"R:猎狗血性":{"slot":"R","skill":{"id":"NaafiriW","name":"猎狗血性","description":"纳亚菲利与她的狗群伙伴们一起向一个英雄冲刺，然后造成伤害。如果纳亚菲利参与了一次击杀，那么她会显形附近的敌方英雄们并且可以再次施放这个技能一次。第二次施放会提供一个护盾。","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"P:狂烈种群":{"slot":"P","passive":{"name":"狂烈种群","description":"纳亚菲利生成狗群伙伴，它们会在她攻击或施放技能时攻击目标。","image":{"full":"Icons_Naafiri_P.png","sprite":"passive2.png","group":"passive","x":336,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:暗裔犬牙":{"slot":"Q","skill":{"id":"NaafiriQ","name":"暗裔犬牙","description":"纳亚菲利猛投出两根犬牙，每根都会施加流血效果，或在目标已经流血时施加额外伤害。<br><br>狗群伙伴们会跃向并攻击被这个技能命中的英雄。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[55,60,65,70,75],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}}},"Smolder":{"R:妈----！":{"slot":"R","skill":{"id":"SmolderR","name":"妈----！","description":"斯莫德召唤他的妈妈从天空喷吐烈焰，对她的烈焰中心的敌人们造成额外伤害和减速。","maxrank":3,"cooldown":[120,110,100],"cost":[100,100,100],"image":{"full":"SmolderR.png","sprite":"spell13.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"120/110/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"W:阿嚏！":{"slot":"W","skill":{"id":"SmolderW","name":"阿嚏！","description":"斯莫德发出一个萌萌的烈焰喷嚏，喷嚏会在命中敌人时爆炸。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[50,55,60,65,70],"image":{"full":"SmolderW.png","sprite":"spell13.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"E:扑棱，扑棱，扑棱！":{"slot":"E","skill":{"id":"SmolderE","name":"扑棱，扑棱，扑棱！","description":"斯莫德展翅高飞，无视地形并轰击生命值最低的敌人。","maxrank":5,"cooldown":[24,22,20,18,16],"cost":[65,65,65,65,65],"image":{"full":"SmolderE.png","sprite":"spell13.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"24/22/20/18/16","costBurn":"65/65/65/65/65","costType":"法力","rankValues":[]}}},"Caitlyn":{"W:约德尔诱捕器":{"slot":"W","skill":{"id":"CaitlynW","name":"约德尔诱捕器","description":"凯特琳设下一个陷阱，这个陷阱在被敌方英雄踩中时，会使该英雄显形并被束缚1.5秒，并为凯特琳提供一次强化版的爆头。","maxrank":5,"cooldown":[0.5],"cost":[20,20,20,20,20],"image":{"full":"CaitlynW.png","sprite":"spell2.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"0.5","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}},"R:让子弹飞":{"slot":"R","skill":{"id":"CaitlynR","name":"让子弹飞","description":"凯特琳精心准备完美一击，拥有超远射程并对单个目标造成巨大伤害。敌方英雄能为友军拦截子弹。","maxrank":3,"cooldown":[90],"cost":[100,100,100],"image":{"full":"CaitlynR.png","sprite":"spell2.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"90","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Corki":{},"Darius":{"P:出血":{"slot":"P","passive":{"name":"出血","description":"德莱厄斯的攻击和伤害技能会导致敌人流血，在5秒里持续造成物理伤害，最多叠加5次。在他的目标达到最大层数后，德莱厄斯会进入激怒状态并获得巨额攻击力。","image":{"full":"Darius_Icon_Hemorrhage.png","sprite":"passive0.png","group":"passive","x":240,"y":96,"w":48,"h":48},"rankValues":[]}}},"Draven":{"P:德莱文联盟":{"slot":"P","passive":{"name":"德莱文联盟","description":"在接住一把旋转飞斧或者击杀了一个小兵、野怪或防御塔后，德莱文会从他的粉丝那里获得崇拜效果。击杀一名敌方英雄会为德莱文提供额外赏金，赏金的多少取决于他拥有多少层崇拜效果。","image":{"full":"Draven_passive.png","sprite":"passive0.png","group":"passive","x":336,"y":96,"w":48,"h":48},"rankValues":[]}}},"Ezreal":{},"Garen":{"E:审判":{"slot":"E","skill":{"id":"GarenE","name":"审判","description":"盖伦快速地旋转身体挥舞大剑，并对邻近敌人造成物理伤害。","maxrank":5,"cooldown":[9],"cost":[0,0,0,0,0],"image":{"full":"GarenE.png","sprite":"spell4.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"9","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"JarvanIV":{"Q:巨龙撞击":{"slot":"Q","skill":{"id":"JarvanIVDragonStrike","name":"巨龙撞击","description":"嘉文四世的长矛穿透敌人，对沿途的敌人造成物理伤害和护甲击碎效果。如果嘉文四世该技能指向德邦军旗，那么他将会被导向军旗，并击飞沿途所有敌人。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[45,50,55,60,65],"image":{"full":"JarvanIVDragonStrike.png","sprite":"spell5.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"45/50/55/60/65","costType":"法力","rankValues":[]}}},"Jhin":{"P:低语":{"slot":"P","passive":{"name":"低语","description":"烬的手枪，“低语”，是一台精密的设备，用来造成出色的伤害。它会以一个固定的频率发射子弹，并且只能装四颗子弹。烬会将黑暗魔法注入最后一颗子弹，来让它产生暴击并造成额外斩杀伤害。当“低语”暴击时，它会为烬提供一个爆发性的移动速度加成。","image":{"full":"Jhin_P.png","sprite":"passive1.png","group":"passive","x":144,"y":96,"w":48,"h":48},"rankValues":[]}}},"Jinx":{"R:超究极死神飞弹！":{"slot":"R","skill":{"id":"JinxR","name":"超究极死神飞弹！","description":"金克丝发射一枚能够跨越整个地图的飞弹，并且飞行的时间越长，伤害值越高。飞弹会在命中一名敌方英雄后爆炸，对目标和目标附近的敌人造成伤害，且目标的生命值越低，所受的伤害值越高。","maxrank":3,"cooldown":[85,65,45],"cost":[100,100,100],"image":{"full":"JinxR.png","sprite":"spell5.png","group":"spell","x":336,"y":144,"w":48,"h":48},"cooldownBurn":"85/65/45","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Karma":{"Q:心灵烈焰":{"slot":"Q","skill":{"id":"KarmaQ","name":"心灵烈焰","description":"卡尔玛向前方发射一枚灵能法球。这枚法球会在命中第一个敌人时爆炸，并造成伤害。<br><br>梵咒增效：除爆炸之外，梵咒还会提升她的心灵烈焰的破坏力，同时创造出一个火环，火环会在短暂的延时后造成伤害。","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[40,50,60,70,80],"image":{"full":"KarmaQ.png","sprite":"spell6.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"40/50/60/70/80","costType":"法力","rankValues":[]}}},"Khazix":{"P:无形威胁":{"slot":"P","passive":{"name":"无形威胁","description":"附近陷入<font color='#FFF673'>孤立无援</font>状态的敌人会被标记出来。卡兹克的技能会与<font color='#FFF673'>孤立无援</font>的目标产生交互作用。<br><br>当卡兹克没有被敌方队伍所看见时，他会获得无形威胁，使他的下次对敌方英雄发动的普通攻击造成额外魔法伤害，并使目标减速数秒。","image":{"full":"Khazix_P.png","sprite":"passive2.png","group":"passive","x":192,"y":0,"w":48,"h":48},"rankValues":[]}},"E:跃击":{"slot":"E","skill":{"id":"KhazixE","name":"跃击","description":"卡兹克跳向一个区域，在着陆时造成物理伤害。如果他选择<font color='#00DD33'>进化虫翼</font>的话，跃击的距离会提升200并在击杀和助攻时重置冷却时间。","maxrank":5,"cooldown":[20,18,16,14,12],"cost":[50,50,50,50,50],"image":{"full":"KhazixE.png","sprite":"spell6.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"20/18/16/14/12","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}}},"MasterYi":{"Q:阿尔法突袭":{"slot":"Q","skill":{"id":"AlphaStrike","name":"阿尔法突袭","description":"易以肉眼难以发觉的速度穿梭于战场，对多个敌人造成物理伤害，同时处于不可被选取的状态下。阿尔法突袭可以暴击，并对野怪造成额外物理伤害。普通攻击可以减少阿尔法突袭的冷却时间。","maxrank":5,"cooldown":[20,19.5,19,18.5,18],"cost":[50,55,60,65,70],"image":{"full":"AlphaStrike.png","sprite":"spell8.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"20/19.5/19/18.5/18","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Poppy":{"Q:圣锤猛击":{"slot":"Q","skill":{"id":"PoppyQ","name":"圣锤猛击","description":"波比挥舞她的铁锤，造成伤害并创造一个区域，这个区域会减速敌人并在一段时间后爆炸。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[35,40,45,50,55],"image":{"full":"PoppyQ.png","sprite":"spell10.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[]}}},"Singed":{"Q:剧毒踪迹":{"slot":"Q","skill":{"id":"PoisonTrail","name":"剧毒踪迹","description":"辛吉德在身后留下剧毒踪迹，对经过上面的敌人造成持续伤害。","maxrank":5,"cooldown":[0],"cost":[13,13,13,13,13],"image":{"full":"PoisonTrail.png","sprite":"spell12.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"0","costBurn":"13/13/13/13/13","costType":"法力","rankValues":[]}},"E:过肩摔":{"slot":"E","skill":{"id":"Fling","name":"过肩摔","description":"伤害目标敌方单位，并将他们投掷到辛吉德身后。如果辛吉德将目标扔到强力粘胶上，目标还会被禁锢。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[60,70,80,90,100],"image":{"full":"Fling.png","sprite":"spell12.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}}},"TwistedFate":{},"XinZhao":{"Q:三重爪击":{"slot":"Q","skill":{"id":"XinZhaoQ","name":"三重爪击","description":"赵信的下3次普攻将造成额外伤害并且第三次攻击将击飞目标。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[30,30,30,30,30],"image":{"full":"XinZhaoQ.png","sprite":"spell16.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Yorick":{"E:哀伤之雾":{"slot":"E","skill":{"id":"YorickE","name":"哀伤之雾","description":"约里克扔出一小团黑雾，对敌人造成伤害、减速效果并标记敌人。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[50,55,60,65,70],"image":{"full":"YorickE.png","sprite":"spell16.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}}}}
{"schemaVersion":1,"patchVersion":"26.17","sources":{"ddragon":"16.17.1","cdragon":"16.17"},"locale":"ko_KR","champions":{"AurelionSol":{"Q:빛의 숨결":{"slot":"Q","skill":{"id":"AurelionSolQ","name":"빛의 숨결","description":"아우렐리온 솔이 몇 초 동안 용의 숨결을 내뿜어 처음 적중하는 적에게 피해를 입히고 주변 적에게는 그보다 적은 광역 피해를 입힙니다. 숨결이 적에게 적중할 때마다 매초 추가 피해를 입힙니다. 추가 피해량은 획득한 별가루 양만큼 증가합니다. 대상이 챔피언이면 별가루를 획득합니다.","maxrank":5,"cooldown":[3],"cost":[30,35,40,45,50],"image":{"full":"AurelionSolQ.png","sprite":"spell1.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"3","costBurn":"30/35/40/45/50","costType":"마나","rankValues":[]}},"W:별의 비행":{"slot":"W","skill":{"id":"AurelionSolW","name":"별의 비행","description":"아우렐리온 솔이 지정한 방향으로 날아갑니다. 이 상태에서 다른 스킬을 사용할 수 있습니다. 비행 중 빛의 숨결은 재사용 대기시간이나 최대 정신 집중 시간이 없으며 피해가 증가합니다.<br><br>아우렐리온 솔이 피해를 입힌 지 얼마 되지 않은 적 챔피언이 죽을 때마다 별의 비행의 남은 재사용 대기시간이 감소합니다.<br><br>별가루는 별의 비행 최대 사거리를 늘립니다.","maxrank":5,"cooldown":[22,20,18,16,14],"cost":[50,55,60,65,70],"image":{"full":"AurelionSolW.png","sprite":"spell1.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"22/20/18/16/14","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[]}}},"Chogath":{"E:날카로운 가시":{"slot":"E","skill":{"id":"VorpalSpikes","name":"날카로운 가시","description":"초가스가 공격할 때마다 치명적인 가시가 발사되어 정면에 있는 모든 적에게 피해를 입히고 둔화시킵니다.","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[30,30,30,30,30],"image":{"full":"VorpalSpikes.png","sprite":"spell3.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"30/30/30/30/30","costType":"마나","rankValues":[{"label":"기본 피해량","values":"30 / 50 / 70 / 90 / 110"},{"label":"둔화 지속시간","values":"1.5초"}]},"icons":[{"file":"patch-notes/icons/0f04fc9b7f1df1ee1ffa8625d7cd1839.webp","spellId":"VorpalSpikes"}]}},"Qiyana":{"Q:원소의 분노 / 이쉬탈의 칼날":{"slot":"Q","skill":{"id":"QiyanaQ","name":"원소의 분노 / 이쉬탈의 칼날","description":"키아나가 무기를 휘둘러 원소에 따른 추가 효과와 함께 피해를 입힙니다.","maxrank":5,"cooldown":[7],"cost":[35,35,35,35,35],"image":{"full":"QiyanaQ.png","sprite":
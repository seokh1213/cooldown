{"schemaVersion":1,"patchVersion":"26.18","sources":{"ddragon":"16.18.1","cdragon":"16.18"},"locale":"ko_KR","champions":{"Cassiopeia":{"Q:맹독 폭발":{"slot":"Q","skill":{"id":"CassiopeiaQ","name":"맹독 폭발","description":"카시오페아가 잠시 후 대상 지역에 독을 폭발시킵니다. 적 챔피언이 독에 맞을 경우 카시오페아의 이동 속도가 증가합니다.","maxrank":5,"cooldown":[3.5],"cost":[50,55,60,65,70],"image":{"full":"CassiopeiaQ.png","sprite":"spell3.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"3.5","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[{"label":"기본 피해량","values":"65 / 100 / 135 / 170 / 205"}]},"icons":[{"file":"patch-notes/icons/b5307fb69afe8f4c0cf5874de2a47f1f.webp","spellId":"CassiopeiaQ"}]},"E:쌍독니":{"slot":"E","skill":{"id":"CassiopeiaE","name":"쌍독니","description":"카시오페아가 대상에게 강력한 공격을 가하고 그 피해량에 비례해 자신의 체력을 회복합니다. 적이 독에 중독되면 피해량이 상승하며 적이 처치될 경우 카시오페아의 마나가 회복됩니다.","maxrank":5,"cooldown":[0.75],"cost":[45,45,45,45,45],"image":{"full":"CassiopeiaE.png","sprite":"spell3.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"0.75","costBurn":"45/45/45/45/45","costType":"마나","rankValues":[{"label":"추가 피해량","values":"20 / 45 / 70 / 95 / 120"}]}},"P:독사의 품격":{"slot":"P","passive":{"name":"독사의 품격","description":"카시오페아의 모든 이동 속도 추가 효과가 증가합니다.","image":{"full":"Cassiopeia_Passive.png","sprite":"passive0.png","group":"passive","x":96,"y":96,"w":48,"h":48},"rankValues":[]}},"R:석화의 응시":{"slot":"R","skill":{"id":"CassiopeiaR","name":"석화의 응시","description":"카시오페아가 눈에서 마법의 에너지를 발사하여 정면에서 자신을 바라보는 적을 기절시키고, 등지고 있는 적의 속도를 늦춥니다.","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"CassiopeiaR.png","sprite":"spell3.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"마나","rankValues":[]}}},"Ekko":{"Q:시간의 톱니바퀴":{"slot":"Q","skill":{"id":"EkkoQ","name":"시간의 톱니바퀴","description":"에코가 적 챔피언에게 맞으면 펼쳐져서 시간 왜곡 지대를 만들고, 지대 안에 있는 적 모두를 둔화시키며 피해를 입히는 시간 톱니바퀴를 던집니다. 잠시 후 톱니바퀴는 되감겨 에코에게 돌아오며, 경로 상에 있는 적에게 피해를 입힙니다.","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[40,50,60,70,80],"image":{"full":"EkkoQ.png","sprite":"spell3.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"40/50/60/70/80","costType":"마나","rankValues":[]}}},"Nautilus":{"Q:닻줄 견인":{"slot":"Q","skill":{"id":"NautilusAnchorDrag","name":"닻줄 견인","description":"노틸러스가 전방으로 닻을 던집니다.  닻이 적을 맞히면 노틸러스와 대상이 가까이 당겨지며 대상에게 마법 피해를 입힙니다. 닻이 지형을 맞히면 노틸러스가 지형 쪽으로 끌려갑니다.","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[60,60,60,60,60],"image":{"full":"NautilusAnchorDrag.png","sprite":"spell9.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"60/60/60/60/60","costType":"마나","rankValues":[{"label":"기본 피해량","values":"85 / 125 / 165 / 205 / 245"}]},"icons":[{"file":"patch-notes/icons/18c6e1f1c65038fd42910154faee2ffd.webp","spellId":"NautilusAnchorDrag"}]}},"Seraphine":{"E:비트 발사":{"slot":"E","skill":{"id":"SeraphineE","name":"비트 발사","description":"세라핀이 일직선상에 있는 적들에게 피해를 입히고 이동을 방해합니다.","maxrank":5,"cooldown":[11],"cost":[60,60,60,60,60],"image":{"full":"SeraphineE.png","sprite":"spell12.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"11","costBurn":"60/60/60/60/60","costType":"마나","rankValues":[{"label":"기본 피해량","values":"70 / 100 / 130 / 160 / 190"},{"label":"둔화 지속시간","values":"1.1 / 1.2 / 1.3 / 1.4 / 1.5초"}]}}},"Syndra":{"W:의지의 힘":{"slot":"W","skill":{"id":"SyndraW","name":"의지의 힘","description":"신드라가 적 미니언 혹은 어둠 구체를 잡아서 던져 마법 피해를 입히고, 적의 이동 속도를 감소시킵니다.","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[60,70,80,90,100],"image":{"full":"SyndraW.png","sprite":"spell14.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"60/70/80/90/100","costType":"마나","rankValues":[{"label":"둔화 지속시간","values":"1.5초"},{"label":"기본 피해량","values":"70 / 100 / 130 / 160 / 190"}]}},"P:초월":{"slot":"P","passive":{"name":"초월","description":"신드라가 레벨을 올리고 적에게 피해를 입혀서 분노의 조각을 획득합니다. 분노의 조각은 스킬을 강화합니다.<br><br><font color='#FF9900'>어둠 구체</font>: 신드라가 1번의 추가 충전량을 유지할 수 있습니다.<br><font color='#FF9900'>의지의 힘</font>: 추가 고정 피해를 입힙니다.<br><font color='#FF9900'>적군 와해</font>: 스킬 적용 범위 폭이 증가하고 모든 대상을 둔화시킵니다.<br><font color='#FF9900'>풀려난 힘</font>: 체력이 낮은 대상을 처형합니다.","image":{"full":"SyndraPassive.png","sprite":"passive4.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}}},"Bard":{},"Kassadin":{"Q:무의 구체":{"slot":"Q","skill":{"id":"NullLance","name":"무의 구체","description":"카사딘이 대상에게 공허 에너지로 구성된 구체를 발사하여 피해를 입히고 정신 집중을 끊습니다. 여분의 에너지는 카사딘의 몸을 감싸 잠시 동안 보호막을 형성하며 마법 피해를 흡수합니다.","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[60,65,70,75,80],"image":{"full":"NullLance.png","sprite":"spell6.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"60/65/70/75/80","costType":"마나","rankValues":[{"label":"기본 피해량","values":"65 / 95 / 125 / 155 / 185"}]},"icons":[{"file":"patch-notes/icons/387a4f0b5d3f0666e7c3454e23214180.webp","spellId":"NullLance"}]},"R:균열 이동":{"slot":"R","skill":{"id":"RiftWalk","name":"균열 이동","description":"카사딘이 가까운 지역으로 순간 이동하면서 주변 적 유닛에게 피해를 입힙니다. 짧은 시간 동안 여러 번의 균열 이동을 시전하면 마나를 추가로 소모하는 대신 추가 피해를 입힐 수 있습니다.","maxrank":3,"cooldown":[5,3.5,2],"cost":[40,40,40],"image":{"full":"RiftWalk.png","sprite":"spell6.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"5/3.5/2","costBurn":"40/40/40","costType":"마나","rankValues":[]}}},"MasterYi":{"R:최후의 전사":{"slot":"R","skill":{"id":"Highlander","name":"최후의 전사","description":"마스터 이가 엄청난 속도로 이동하며 순간적으로 자신의 이동 속도와 공격 속도를 높이고 모든 둔화 효과에 대해 면역이 됩니다. 스킬이 활성화된 동안 적 챔피언을 처치하거나 어시스트를 올리면 최후의 전사 지속시간이 늘어납니다. 적 챔피언을 처치하거나 어시스트를 올리면 기본 지속 효과로 다른 스킬들의 재사용 대기시간이 감소합니다.","maxrank":3,"cooldown":[85],"cost":[100,100,100],"image":{"full":"Highlander.png","sprite":"spell9.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"85","costBurn":"100/100/100","costType":"마나","rankValues":[]}}},"Viego":{"P:군주의 지배":{"slot":"P","passive":{"name":"군주의 지배","description":"비에고 앞에서 쓰러지는 적은 망령이 됩니다. 망령을 공격하면 비에고가 일시적으로 죽은 적의 몸을 지배하며 대상 최대 체력의 일부만큼 체력을 회복하고 대상의 기본 스킬과 아이템을 사용할 수 있습니다. 적의 궁극기는 제외되는 대신 자신의 궁극기를 비용 소모 없이 한 번 사용할 수 있습니다.","image":{"full":"Viego_Passive.png","sprite":"passive5.png","group":"passive","x":96,"y":0,"w":48,"h":48},"rankValues":[]}}},"Zaahen":{"Q:다르킨의 글레이브":{"slot":"Q","skill":{"id":"ZaahenQ","name":"다르킨의 글레이브","description":"자헨이 다음 기본 공격 시 두 번 공격하며 추가 피해를 입히고 체력을 회복합니다. 자헨은 이 스킬을 다시 사용해 다음 기본 공격 시 대상에게 추가 피해를 입히고 공중에 띄울 수 있습니다.<br>","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[25,25,25,25,25],"image":{"full":"ZaahenQ.png","sprite":"spell17.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"25/25/25/25/25","costType":"마나","rankValues":[]}}},"Zeri":{"W:초강력 레이저":{"slot":"W","skill":{"id":"ZeriW","name":"초강력 레이저","description":"제리가 전기 파동을 발사해 처음 적중하는 적을 둔화시키고 피해를 입힙니다. 파동이 벽에 맞으면 장거리 레이저로 확산됩니다.","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[50,60,70,80,90],"image":{"full":"ZeriW.png","sprite":"spell17.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"50/60/70/80/90","costType":"마나","rankValues":[{"label":"둔화 지속시간","values":"2초"}]},"icons":[{"file":"patch-notes/icons/7a3050e4f359e0b805a1a8c70e1fea94.webp","spellId":"ZeriW"}]}}}}
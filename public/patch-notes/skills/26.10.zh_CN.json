{"schemaVersion":1,"patchVersion":"26.10","sources":{"ddragon":"16.10.1","cdragon":"16.10"},"locale":"zh_CN","champions":{"Galio":{"Q:战争罡风":{"slot":"Q","skill":{"id":"GalioQ","name":"战争罡风","description":"加里奥发射两道罡风，罡风在汇聚后会形成一团大型龙卷风，造成持续伤害。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[60,65,70,75,80],"image":{"full":"GalioQ.png","sprite":"spell4.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[{"label":"基础伤害","values":"70 / 105 / 140 / 175 / 210"}]}},"E:正义冲拳":{"slot":"E","skill":{"id":"GalioE","name":"正义冲拳","description":"加里奥将暂时后跳然后冲锋，击飞他遇到的第一个敌方英雄。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[50,50,50,50,50],"image":{"full":"GalioE.png","sprite":"spell4.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[{"label":"基础伤害","values":"100 / 135 / 170 / 205 / 240"}]},"icons":[{"file":"patch-notes/icons/04bf521c1cdda1270b8e30b568859445.webp","spellId":"GalioE"}]},"R:英雄登场":{"slot":"R","skill":{"id":"GalioR","name":"英雄登场","description":"加里奥将一名友军的当前位置作为他的着陆点，并为区域内的所有友军提供一个魔法护盾。在短暂的延迟后，加里奥会落到该位置上，然后击退附近的敌人。","maxrank":3,"cooldown":[180,160,140],"cost":[100,100,100],"image":{"full":"GalioR.png","sprite":"spell4.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"180/160/140","costBurn":"100/100/100","costType":"法力","rankValues":[{"label":"基础伤害","values":"150 / 250 / 350"}]}}},"LeeSin":{"W:金钟罩/铁布衫":{"slot":"W","skill":{"id":"LeeSinWOne","name":"金钟罩/铁布衫","description":"金钟罩：李青冲向目标友军，为他自身提供护盾值。如果该友军是一名英雄，则也会获得护盾值。在使用【金钟罩】后，李青可以施放【铁布衫】。<br>铁布衫：李青艰苦卓绝的训练让他能在战斗中激发潜能。李青获得全能吸血。","maxrank":5,"cooldown":[7],"cost":[50,50,50,50,50],"image":{"full":"LeeSinWOne.png","sprite":"spell7.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}},"E:天雷破/摧筋断骨":{"slot":"E","skill":{"id":"LeeSinEOne","name":"天雷破/摧筋断骨","description":"天雷破：李青猛击地面，施放冲击波，造成魔法伤害并使命中的敌方单位显形。如果天雷破命中了一名敌人，那么李青可以施放【摧筋断骨】。<br>摧筋断骨：李青致残被天雷破给伤害到的敌人，减少其移动速度。持续期间受影响单位的移动速度会逐渐恢复正常。","maxrank":5,"cooldown":[8],"cost":[50,50,50,50,50],"image":{"full":"LeeSinEOne.png","sprite":"spell7.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"8","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[{"label":"减速持续时间","values":"4秒"}]},"icons":[{"file":"patch-notes/icons/7e00bcefdf896f4a21d8a8364425a19f.webp","spellId":"LeeSinEOne"}]},"R:猛龙摆尾":{"slot":"R","skill":{"id":"LeeSinR","name":"猛龙摆尾","description":"李青用强力的回旋踢击退敌方英雄，对目标以及被目标撞到的任何敌人造成物理伤害。 被目标撞到的敌人会被短暂击飞。这项技艺是春哥教他的，不过李青不能将玩家的英雄踢到地图外面去。","maxrank":3,"cooldown":[110,85,60],"cost":[0,0,0],"image":{"full":"LeeSinR.png","sprite":"spell7.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"110/85/60","costBurn":"0/0/0","costType":"能量","rankValues":[{"label":"基础伤害","values":"175 / 400 / 625"}]},"icons":[{"file":"patch-notes/icons/676d937459d8bc8538e6a6b7796ee9ef.webp","spellId":"LeeSinR"}]}},"Naafiri":{"R:猎狗血性":{"slot":"R","skill":{"id":"NaafiriW","name":"猎狗血性","description":"纳亚菲利与她的狗群伙伴们一起向一个英雄冲刺，然后造成伤害。如果纳亚菲利参与了一次击杀，那么她会显形附近的敌方英雄们并且可以再次施放这个技能一次。第二次施放会提供一个护盾。","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"法力","rankValues":[{"label":"基础伤害","values":"150 / 225 / 300"},{"label":"减速持续时间","values":"0.25秒"}]},"icons":[{"file":"patch-notes/icons/654880d3d20f04bf2abb4e0113cb877d.webp","spellId":"NaafiriW"}]},"Q:暗裔犬牙":{"slot":"Q","skill":{"id":"NaafiriQ","name":"暗裔犬牙","description":"纳亚菲利猛投出两根犬牙，每根都会施加流血效果，或在目标已经流血时施加额外伤害。<br><br>狗群伙伴们会跃向并攻击被这个技能命中的英雄或野怪。<br>","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[50,60,70,80,90],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}}},"Q
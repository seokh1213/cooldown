{"schemaVersion":1,"patchVersion":"26.10","sources":{"ddragon":"16.10.1","cdragon":"16.10"},"locale":"zh_CN","champions":{"Galio":{"Q:战争罡风":{"slot":"Q","skill":{"id":"GalioQ","name":"战争罡风","description":"加里奥发射两道罡风，罡风在汇聚后会形成一团大型龙卷风，造成持续伤害。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[60,65,70,75,80],"image":{"full":"GalioQ.png","sprite":"spell4.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[{"label":"基础伤害","values":"70 / 105 / 140 / 175 / 210"}]}},"E:正义冲拳":{"slot":"E","skill":{"id":"GalioE","name":"正义冲拳","description":"加里奥将暂时后跳然后冲锋，击飞他遇到的第一个敌方英雄。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[50,50,50,50,50],"image":{"full":"GalioE.png","sprite":"spell4.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[{"label":"基础伤害","values":"100 / 135 / 170 / 205 / 240"}]},"icons":[{"file":"patch-notes/icons/04bf521c1cdda1270b8e30b568859445.webp","spellId":"GalioE"}]}},"LeeSin":{"W:金钟罩/铁布衫":{"slot":"W","skill":{"id":"LeeSinWOne","name":"金钟罩/铁布衫","description":"金钟罩：李青冲向目标友军，为他自身提供护盾值。如果该友军是一名英雄，则也会获得护盾值。在使用【金钟罩】后，李青可以施放【铁布衫】。<br>铁布衫：李青艰苦卓绝的训练让他能在战斗中激发潜能。李青获得全能吸血。","maxrank":5,"cooldown":[7],"cost":[50,50,50,50,50],"image":{"full":"LeeSinWOne.png","sprite":"spell7.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}}},"Naafiri":{"R:猎狗血性":{"slot":"R","skill":{"id":"NaafiriW","name":"猎狗血性","description":"纳亚菲利与她的狗群伙伴们一起向一个英雄冲刺，然后造成伤害。如果纳亚菲利参与了一次击杀，那么她会显形附近的敌方英雄们并且可以再次施放这个技能一次。第二次施放会提供一个护盾。","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"法力","rankValues":[{"label":"基础伤害","values":"150 / 225 / 300"},{"label":"减速持续时间","values":"0.25秒"}]},"icons":[{"file":"patch-notes/icon
],"image":{"full":"IreliaE.png","sprite":"spell5.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"R:先锋之刃":{"slot":"R","skill":{"id":"IreliaR","name":"先锋之刃","description":"艾瑞莉娅发射庞大数量的利刃，它们会在命中一名敌方英雄时向外爆开。被利刃命中的敌人会受到伤害并被标记。然后利刃会形成一道刃墙，在敌人穿过时造成伤害、和减速效果。","maxrank":3,"cooldown":[125,105,85],"cost":[100,100,100],"image":{"full":"IreliaR.png","sprite":"spell5.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"125/105/85","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Kayn":{"P:暗裔魔镰":{"slot":"P","passive":{"name":"暗裔魔镰","description":"凯隐使用的是一把上古神兵，并且一直都在与附在武器上的暗裔灵体拉亚斯特为了身体的控制权而战斗着。要么<font color='#fe5c50'>暗裔杀手</font>将获胜，要么凯隐将统御拉亚斯特并变为<font color='#8484fb'>影流刺客</font>。<br><hr><font color='#fe5c50'>暗裔杀手：</font>治疗自身，数额相当于一部分对敌方英雄造成的技能伤害值。<br><br><font color='#8484fb'>影流刺客：</font>在与敌方英雄作战的最初几秒里，造成额外伤害。","image":{"full":"Kayn_Passive_Primary.png","sprite":"passive2.png","group":"passive","x":96,"y":0,"w":48,"h":48},"rankValues":[]}}},"Malzahar":{"W:虚空虫群":{"slot":"W","skill":{"id":"MalzaharW","name":"虚空虫群","description":"玛尔扎哈召唤虚灵去攻击附近的敌人。","maxrank":5,"cooldown":[8],"cost":[40,45,50,55,60],"image":{"full":"MalzaharW.png","sprite":"spell8.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"8","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}}},"MasterYi":{"E:无极剑道":{"slot":"E","skill":{"id":"WujuStyle","name":"无极剑道","description":"提供额外真实伤害至普攻","maxrank":5,"cooldown":[14],"cost":[0,0,0,0,0],"image":{"full":"WujuStyle.png","sprite":"spell8.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"14","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Smolder":{"Q:超级灼热龙息":{"slot":"Q","skill":{"id":"SmolderQ","name":"超级灼热龙息","description":"斯莫德在一名敌人身上喷吐烈焰。随着他获得更多层数，这个技能会变得更加强力。","maxrank":5,"cooldown":[5.5,5,4.5,4,3.5],"cost":[25,25,25,25,25],"image":{"full":"SmolderQ.png","sprite":"spell13.png","group":"spell","x":96,"y":0,
,100],"image":{"full":"YuumiR.png","sprite":"spell16.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"120/110/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}}}}
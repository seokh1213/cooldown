{"schemaVersion":1,"patchVersion":"25.18","sources":{"ddragon":"15.18.1","cdragon":"15.18"},"locale":"zh_CN","champions":{"Amumu":{"Q:绷带牵引":{"slot":"Q","skill":{"id":"BandageToss","name":"绷带牵引","description":"阿木木向目标投掷粘稠的绷带，将自己拉向目标，并对目标造成伤害和眩晕效果。","maxrank":5,"cooldown":[3],"cost":[50,50,50,50,50],"image":{"full":"BandageToss.png","sprite":"spell1.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"3","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}}},"Taliyah":{"Q:石穿":{"slot":"Q","skill":{"id":"TaliyahQ","name":"石穿","description":"塔莉垭朝目标方向扔出一串岩石，同时自身可自由移动。这个技能会在她脚下生成【掘石场】。如果塔莉垭在【掘石场】上使用【Q石穿】，她将消耗掉【掘石场】来投掷一颗更强大的岩石来减速敌人。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"TaliyahQ.png","sprite":"spell13.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}},"E:撒石阵":{"slot":"E","skill":{"id":"TaliyahE","name":"撒石阵","description":"塔莉垭创造一个可减速的雷区。如果敌人在使用冲刺技能途径雷区或是被强制位移效果途经雷区，石雷就会爆炸并晕眩该敌人。","maxrank":5,"cooldown":[14],"cost":[90,90,90,90,90],"image":{"full":"TaliyahE.png","sprite":"spell13.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"14","costBurn":"90/90/90/90/90","costType":"法力","rankValues":[]}}},"Velkoz":{"E:构造分解":{"slot":"E","skill":{"id":"VelkozE","name":"构造分解","description":"维克兹让一个区域爆炸，击飞敌人，并将近处的敌人略微击退。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[50,55,60,65,70],"image":{"full":"VelkozE.png","sprite":"spell15.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"R:生命形态瓦解射线":{"slot":"R","skill":{"id":"VelkozR","name":"生命形态瓦解射线","description":"维克兹释放一束被引导的光线跟随鼠标指针，可造成魔法伤害，持续2.5秒。【有机体解构】效果会研究敌方英雄，从而使他们受到真实伤害。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"VelkozR.png","sprite":"spell15.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Volibear":{"P:狂雷渐起":{"slot":"P","passive":{"name":"狂雷渐起","description":"沃利贝尔的攻击和技能会提供攻击速度，并且最终使他的攻击对附近的敌人们造成额外魔法伤害。","image":{"full":"Volibear_Icon_P.png","sprite":"passive5.png","group":"passive","x":192,"y":0,"w":48,"h":48},"rankValues":[{"label":"每层每100法强攻击速度","values":"3%"},{"label":"闪电额外攻击力系数","values":"0%"}]},"icons":[{"file":"patch-notes/icons/a79c595dca2f2fbc0315d368514903f9.webp","spellId":"VolibearP"}]}},"Annie":{"W:焚烧":{"slot":"W","skill":{"id":"AnnieW","name":"焚烧","description":"安妮向锥形区域施放一道烈焰，对区域内的所有敌人造成伤害。","maxrank":5,"cooldown":[7],"cost":[70,75,80,85,90],"image":{"full":"AnnieW.png","sprite":"spell1.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}},"R:提伯斯之怒":{"slot":"R","skill":{"id":"AnnieR","name":"提伯斯之怒","description":"安妮召唤地狱火泰迪：提伯斯为其作战，对目标区域造成伤害，提伯斯也会攻击和烧伤站在它周围的敌人。","maxrank":3,"cooldown":[130,115,100],"cost":[100,100,100],"image":{"full":"AnnieR.png","sprite":"spell1.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Ashe":{},"Aurora":{"P:驱灵奇术":{"slot":"P","passive":{"name":"驱灵奇术","description":"阿萝拉的技能或攻击伤害能从敌人身上抽离出灵物。被抽离灵物跟随阿萝拉并治疗她。","image":{"full":"AuroraPassive.Aurora.png","sprite":"passive0.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}}},"Azir":{"W:沙兵现身":{"slot":"W","skill":{"id":"AzirW","name":"沙兵现身","description":"阿兹尔召唤一个黄沙士兵来为他攻击附近的敌方单位。如果敌方单位在士兵的攻击距离内，那么士兵会代替阿兹尔进行普攻。士兵的攻击会对一条直线上的敌人造成魔法伤害。","maxrank":5,"cooldown":[1.5],"cost":[40,35,30,25,20],"image":{"full":"AzirW.png","sprite":"spell1.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"1.5","costBurn":"40/35/30/25/20","costType":"法力","rankValues":[]}}},"Briar":{"Q:冲头":{"slot":"Q","skill":{"id":"BriarQ","name":"冲头","description":"贝蕾亚跃向一个单位并用她的（痛苦之）脚镣命中敌人们，将他们晕眩并削减他们的护甲。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"BriarQ.png","sprite":"spell2.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"W:血莽 / 噬击":{"slot":"W","skill":{"id":"BriarW","name":"血莽 / 噬击","description":"贝蕾亚向前跳跃并击碎她的囚枷，进入一种【血莽】状态来使她无休止地追击相距最近的那个敌人（优先以英雄为目标）。在【血莽】状态下，她的攻击速度和移动速度获得提升，并且她的攻击会在她目标四周的一个区域内造成伤害。<br><br>贝蕾亚可以在【血莽】状态下再次激活这个技能，来让她的下一次攻击噬咬她的目标，造成基于目标已损失生命值的额外伤害，并且基于她造成的伤害来为她提供治疗效果。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[0,0,0,0,0],"image":{"full":"BriarW.png","sprite":"spell2.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"R:毙除":{"slot":"R","skill":{"id":"BriarR","name":"毙除","description":"贝蕾亚踢出她的囚枷中的血石，让被它命中的第一个英雄成为她的猎物。她随后会径直走向该目标，在抵达目标处时恐惧周围的其它敌人们，并进入一个彻底血狂的状态。她将追击她的猎物直至阵亡才罢休，获得【血莽】的助益以及额外的护甲、魔抗、生命偷取和移动速度。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"BriarR.png","sprite":"spell2.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"怒气","rankValues":[]}}},"Cassiopeia":{"E:双生毒牙":{"slot":"E","skill":{"id":"CassiopeiaE","name":"双生毒牙","description":"卡西奥佩娅释放一次攻击，可对中毒的目标造成额外伤害并且基于实际伤害值为她提供治疗效果。如果目标死于这次攻击，卡西奥佩娅会回复法力值。","maxrank":5,"cooldown":[0.75],"cost":[40,40,40,40,40],"image":{"full":"CassiopeiaE.png","sprite":"spell2.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"0.75","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Galio":{"P:巨像重击":{"slot":"P","passive":{"name":"巨像重击","description":"每过若干秒，加里奥的下次普攻就能在小范围内造成额外魔法伤害。","image":{"full":"Galio_Passive.png","sprite":"passive1.png","group":"passive","x":288,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:战争罡风":{"slot":"Q","skill":{"id":"GalioQ","name":"战争罡风","description":"加里奥发射两道罡风，罡风在汇聚后会形成一团大型龙卷风，造成持续伤害。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[70,75,80,85,90],"image":{"full":"GalioQ.png","sprite":"spell4.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}}},"Garen":{"E:审判":{"slot":"E","skill":{"id":"GarenE","name":"审判","description":"盖伦快速地旋转身体挥舞大剑，并对邻近敌人造成物理伤害。","maxrank":5,"cooldown":[9,8.25,7.5,6.75,6],"cost":[0,0,0,0,0],"image":{"full":"GarenE.png","sprite":"spell4.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"9/8.25/7.5/6.75/6","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"Hwei":{"P:落款":{"slot":"P","passive":{"name":"落款","description":"彗准备在那些受到他的技能伤害的敌人们身上留下落款。<br><br>用另一个伤害型技能命中时，即可完成他的落款，将其留在敌人脚下。落款会在短暂延迟后引爆，对范围内的所有敌人造成魔法伤害。","image":{"full":"HweiPassive.png","sprite":"passive1.png","group":"passive","x":240,"y":48,"w":48,"h":48},"rankValues":[]}},"W:靜謐筆法：川流湍急（WQ）":{"slot":"W","skill":{"id":"HweiW","name":"靜謐筆法：川流湍急（WQ）","description":"彗画下眼中所见到的宁静，抚慰并激励众人。<br><br>这个技能会用这些功能型技能替换掉彗的技能：飞染、渲浓、宿墨","maxrank":5,"cooldown":[],"image":{"full":"HweiW.png","sprite":"spell4.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}},"E:主题：悚":{"slot":"E","skill":{"id":"HweiE","name":"主题：悚","description":"彗将眼中所见到的恐怖景象付诸笔端，带来震慑人心的画面。<br><br>这个技能会用这些控制型技能替换掉彗的技能：阴沉变意、滞涩幽瞳、双钩血喉。","maxrank":5,"cooldown":[13,12.5,12,11.5,11],"cost":[50,55,60,65,70],"image":{"full":"HweiE.png","sprite":"spell5.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"13/12.5/12/11.5/11","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Jayce":{"Q:苍穹之跃 / 电能震荡":{"slot":"Q","skill":{"id":"JayceToTheSkies","name":"苍穹之跃 / 电能震荡","description":"锤形态：跳向一个敌人，对敌人造成物理伤害和减速效果。 <br><br>炮形态：发射一团电球，在命中一名敌人或者到达最大射程后爆炸，对命中的敌人造成物理伤害。","maxrank":6,"cooldown":[16,14,12,10,8,6],"cost":[40,40,40,40,40,40],"image":{"full":"JayceToTheSkies.png","sprite":"spell5.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"16/14/12/10/8/6","costBurn":"40/40/40/40/40/40","costType":"法力","rankValues":[]}}},"Illaoi":{"P:古神先知":{"slot":"P","passive":{"name":"古神先知","description":"俄洛伊和她创造的<font color='#669900'>躯壳</font>会在附近的不可穿越的地形上生成触手。触手会挥向灵魂，<font color='#669900'>躯壳</font>，以及俄洛伊的【严酷训诫】的受害者们。触手会在命中敌人时造成物理伤害，如果命中目标是英雄还会治疗俄洛伊。","image":{"full":"Illaoi_P.png","sprite":"passive1.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}},"W:严酷训诫":{"slot":"W","skill":{"id":"IllaoiW","name":"严酷训诫","description":"俄洛伊跃向她的目标，造成物理伤害并使附近的触手也挥向目标。","maxrank":5,"cooldown":[4],"cost":[30,30,30,30,30],"image":{"full":"IllaoiW.png","sprite":"spell5.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"4","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}},"E:灵魂试炼":{"slot":"E","skill":{"id":"IllaoiE","name":"灵魂试炼","description":"俄洛伊把灵魂从一名敌人的肉身中扯出，强迫它站在她面前。 灵魂会将其所受的一部分伤害传递到本体上。如果灵魂被击杀，或者本体离灵魂过远，那么本体就会成为一个<font color='#669900'>躯壳</font>并且开始生成触手。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[35,40,45,50,55],"image":{"full":"IllaoiE.png","sprite":"spell5.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[]}}},"Qiyana":{"P:凌人贵气":{"slot":"P","passive":{"name":"凌人贵气","description":"奇亚娜对每名敌人发起的第一次普攻或技能会造成额外伤害。","image":{"full":"Qiyana_Passive.png","sprite":"passive3.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}}},"Sylas":{"P:破敌禁法":{"slot":"P","passive":{"name":"破敌禁法","description":"在施放一次技能后，塞拉斯会储存一层【破敌禁法】效果。塞拉斯的普攻将消耗一层效果并环绕自身挥舞他的盈能锁链来对命中的敌人造成额外魔法伤害。当塞拉斯拥有一层【破敌禁法】效果时，他会获得攻击速度。 ","image":{"full":"SylasP.png","sprite":"passive4.png","group":"passive","x":0,"y":48,"w":48,"h":48},"rankValues":[]}}},"Yunara":{"E:明踪步 | 夜影翻":{"slot":"E","skill":{"id":"YunaraE","name":"明踪步 | 夜影翻","description":"芸阿娜获得持续衰减的移动速度并进入幽灵状态。在她处于超凡形态期间，她转而朝着一个方向冲刺。","maxrank":5,"cooldown":[7.5],"cost":[40,40,40,40,40],"image":{"full":"YunaraE.png","sprite":"spell16.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"7.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Zac":{"R:动感弹球":{"slot":"R","skill":{"id":"ZacR","name":"动感弹球","descripti
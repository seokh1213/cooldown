{"schemaVersion":1,"patchVersion":"26.2","sources":{"ddragon":"16.2.1","cdragon":"16.2"},"locale":"zh_CN","champions":{"Kayle":{"Q:耀焰冲击":{"slot":"Q","skill":{"id":"KayleQ","name":"耀焰冲击","description":"凯尔召出一个传送门，召唤出一把星界之剑来刺穿敌人，对命中的所有敌人造成减速、伤害和防御属性击碎效果。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[60,70,80,90,100],"image":{"full":"KayleQ.png","sprite":"spell6.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}}},"Malphite":{"E:大地震颤":{"slot":"E","skill":{"id":"Landslide","name":"大地震颤","description":"墨菲特锤击地面，放射出冲击波对目标造成基于他护甲值的魔法伤害，同时暂时降低目标攻击速度。","maxrank":5,"cooldown":[7],"cost":[50,55,60,65,70],"image":{"full":"Landslide.png","sprite":"spell8.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"7","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"R:势不可挡":{"slot":"R","skill":{"id":"UFSlash","name":"势不可挡","description":"墨菲特自身高速冲向一个区域，对区域内的敌人们造成伤害和击飞效果。","maxrank":3,"cooldown":[130,115,100],"cost":[100,100,100],"image":{"full":"UFSlash.png","sprite":"spell8.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"W:雷霆拍击":{"slot":"W","skill":{"id":"Obduracy","name":"雷霆拍击","description":"墨菲特的攻击蕴含着如此惊人的力道以至于它引发了一次音爆。在接下来的数秒里，他的攻击会在他面前引发余波。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[30,35,40,45,50],"image":{"full":"Obduracy.png","sprite":"spell8.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"30/35/40/45/50","costType":"法力","rankValues":[]}}},"Nunu":{"Q:吞噬":{"slot":"Q","skill":{"id":"NunuQ","name":"吞噬","description":"威朗普撕咬一个小兵、野怪或敌方英雄，造成巨大伤害并回复自己的生命值。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[60,60,60,60,60],"image":{"full":"NunuQ.png","sprite":"spell9.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"W:史上最大雪球！":{"slot":"W","ski
{"schemaVersion":1,"patchVersion":"25.14","sources":{"ddragon":"15.14.1","cdragon":"15.14"},"locale":"zh_CN","champions":{"Fizz":{"W:海石三叉戟":{"slot":"W","skill":{"id":"FizzW","name":"海石三叉戟","description":"菲兹的攻击会让他的敌人们流血，同时造成持续数秒的魔法伤害。菲兹可以强化他的下次普攻来造成额外伤害，并在短时间内强化他的后续普攻。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[30,40,50,60,70],"image":{"full":"FizzW.png","sprite":"spell3.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"30/40/50/60/70","costType":"法力","rankValues":[]}},"E:古灵/精怪":{"slot":"E","skill":{"id":"FizzE","name":"古灵/精怪","description":"菲兹跳到空中，同时优雅地落在他的长矛上，变得不可被选取。在这个姿态下，菲兹可以选择立原地着陆，也可以选择在着陆之前再跳一段距离。","maxrank":5,"cooldown":[16,14,12,10,8],"cost":[75,80,85,90,95],"image":{"full":"FizzE.png","sprite":"spell4.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"16/14/12/10/8","costBurn":"75/80/85/90/95","costType":"法力","rankValues":[]}}},"Kled":{"W:暴烈秉性":{"slot":"W","skill":{"id":"KledW","name":"暴烈秉性","description":"克烈获得持续4次攻击的巨幅攻速加成。第四次攻击会造成更多伤害。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"KledW.png","sprite":"spell7.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"勇气","rankValues":[]}},"P:怯战蜥蜴斯嘎尔":{"slot":"P","passive":{"name":"怯战蜥蜴斯嘎尔","description":"克烈的可靠坐骑——斯嘎尔——会为他承受伤害。当斯嘎尔的生命值耗尽时，会导致克烈进入非骑乘状态。额外生命值属性只会施加给斯嘎尔。<br><br>在非骑乘状态下时，克烈会更换若干技能并对英雄造成较少伤害。克烈可通过与敌人作战来回复斯嘎尔的勇气。在勇气到达满值时，克烈会骑着拥有部分生命值的斯嘎尔重回骑乘状态。","image":{"full":"Kled_P.png","sprite":"passive2.png","group":"passive","x":288,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:飞索捕熊器":{"slot":"Q","skill":{"id":"KledQ","name":"飞索捕熊器","description":"克烈投掷一个捕熊器，钩住一个敌人并造成伤害。如果短时间内牵引没有被打破，那么目标会受到额外物理伤害并被拽向克烈。<br><br>当处于非骑乘状态下时，这个技能会被替换为【随身手枪】——一个远程枪击技能，可将克烈击退并回复勇气值。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[0,0,0,0,0],"image":{"full":"KledQ.png","sprite":"spell7.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"0/0/0/0/0","costType":"勇气","rankValues":[]}},"Q:掌心雷發射（未騎乘小嘎時的Q）":{"slot":"Q","skill":{"id":"KledQ","name":"掌心雷發射（未騎乘小嘎時的Q）","description":"克烈投掷一个捕熊器，钩住一个敌人并造成伤害。如果短时间内牵引没有被打破，那么目标会受到额外物理伤害并被拽向克烈。<br><br>当处于非骑乘状态下时，这个技能会被替换为【随身手枪】——一个远程枪击技能，可将克烈击退并回复勇气值。","maxrank":5,"cooldown":[],"image":{"full":"KledQ.png","sprite":"spell7.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"","costType":"勇气","rankValues":[]}},"E:比武":{"slot":"E","skill":{"id":"KledE","name":"比武","description":"克烈发起突进，造成物理伤害并短暂获得爆发性移速加成。克烈可以再次施放这个技能来回身突进，穿过初始目标，同时造成等额伤害。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"KledE.png","sprite":"spell7.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"勇气","rankValues":[]}},"R:冲啊——！！":{"slot":"R","skill":{"id":"KledR","name":"冲啊——！！","description":"克烈和斯嘎尔朝着一个位置发起冲锋，同时在身后留下一条提供加速效果的轨迹，并为自己构建一个护盾。斯嘎尔会在遭遇首个敌方英雄时将其锁定并发起撞击。","maxrank":3,"cooldown":[140,125,110],"cost":[0,0,0],"image":{"full":"KledR.png","sprite":"spell7.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"140/125/110","costBurn":"0/0/0","costType":"勇气","rankValues":[]}}},"Yunara":{"Q:灵蕴拳":{"slot":"Q","skill":{"id":"YunaraQ","name":"灵蕴拳","description":"芸阿娜获得攻击速度、额外附带伤害并且她的攻击会散播至附近的敌人。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"YunaraQ.png","sprite":"spell16.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Azir":{"W:沙兵现身":{"slot":"W","skill":{"id":"AzirW","name":"沙兵现身","description":"阿兹尔召唤一个黄沙士兵来为他攻击附近的敌方单位。如果敌方单位在士兵的攻击距离内，那么士兵会代替阿兹尔进行普攻。士兵的攻击会对一条直线上的敌人造成魔法伤害。这个技能还会被动为阿兹尔和他的士兵们提供攻击速度加成。","maxrank":5,"cooldown":[1.5],"cost":[40,35,30,25,20],"image":{"full":"AzirW.png","sprite":"spell1.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"1.5","costBurn":"40/35/30/25/20","costType":"法力","rankValues":[]}}},"Braum":{},"Briar":{"R:毙除":{"slot":"R","skill":{"id":"BriarR","name":"毙除","description":"贝蕾亚踢出她的囚枷中的血石，让被它命中的第一个英雄成为她的猎物。她随后会径直走向该目标，在抵达目标处时恐惧周围的其它敌人们，并进入一个彻底血狂的状态。她将追击她的猎物直至阵亡才罢休，获得【血莽】的助益以及额外的护甲、魔抗、生命偷取和移动速度。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"BriarR.png","sprite":"spell2.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"怒气","rankValues":[]}}},"Darius":{"Q:大杀四方":{"slot":"Q","skill":{"id":"DariusCleave","name":"大杀四方","description":"德莱厄斯蓄力然后将他的斧头挥舞成一个大圈。被斧刃击中的敌人会比被斧柄击中的敌人受到更多伤害。德莱厄斯会基于被斧刃击中的敌方英雄或大型野怪的数量来获得治疗效果。","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[25,30,35,40,45],"image":{"full":"DariusCleave.png","sprite":"spell2.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"25/30/35/40/45","costType":"法力","rankValues":[]}}},"Fiora":{"R:无双挑战":{"slot":"R","skill":{"id":"FioraR","name":"无双挑战","description":"菲奥娜显示出一个敌方英雄身上的所有四处破绽，并在目标附近时获得移动速度加成。如果菲奥娜命中了所有四处破绽，或者目标在死前至少被命中了一处破绽，那么菲奥娜和范围内的友军就会在接下来的几秒里持续获得治疗效果。","maxrank":3,"cooldown":[110,90,70],"cost":[100,100,100],"image":{"full":"FioraR.png","sprite":"spell3.png","group":"spell","x":336,"y":144,"w":48,"h":48},"cooldownBurn":"110/90/70","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"LeeSin":{},"Riven":{"P:符文之刃":{"slot":"P","passive":{"name":"符文之刃","description":"锐雯的技能会为她的剑刃充能，并且她的普通攻击会消耗充能来造成额外伤害。","image":{"full":"RivenRunicBlades.png","sprite":"passive3.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}}},"Sett":{},"TwistedFate":{"Q:万能牌":{"slot":"Q","skill":{"id":"WildCards","name":"万能牌","description":"崔斯特扔出三张卡牌，卡牌会对沿途的每个敌方单位造成伤害。","maxrank":5,"cooldown":[6,5.75,5.5,5.25,5],"cost":[60,70,80,90,100],"image":{"full":"WildCards.png","sprite":"spell14.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"6/5.75/5.5/5.25/5","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}}},"Yasuo":{},"Yuumi":{"R:魔典终章":{"slot":"R","skill":{"id":"YuumiR","name":"魔典终章","description":"悠米引导5道波纹来伤害敌人并治疗友军。在引导时，悠米可以移动、附身并施放【旺盛精力】。在附身于她的挚友身上时，这个技能还会跟随她的鼠标。","maxrank":3,"cooldown":[120,110,100],"cost":[100,100,100],"image":{"full":"YuumiR.png","sprite":"spell16.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"120/110/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Ziggs":{"Q:弹跳炸弹":{"slot":"Q","skill":{"id":"ZiggsQ","name":"弹跳炸弹","description":"吉格斯扔出一个会弹跳的炸弹，对敌人造成魔法伤害。","maxrank":5,"cooldown":[6,5.5,5,4.5,4],"cost":[50,55,60,65,70],"image":{"full":"ZiggsQ.png","sprite":"spell17.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"6/5.5/5/4.5/4","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"E:海克斯爆破雷区":{"slot":"E","skill":{"id":"ZiggsE","name":"海克斯爆破雷区","description":"吉格斯布下敌人一踩就炸的感应雷区，对踩中地雷的敌人造成魔法伤害和减速效果。对相同目标的后续爆炸将造成较少伤害。","maxrank":5,"cooldown":[16],"cost":[70,80,90,100,110],"image":{"full":"ZiggsE.png","sprite":"spell17.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"16","costBurn":"70/80/90/100/110","costType":"法力","rankValues":[]}},"R:科学的地狱火炮":{"slot":"R","skill":{"id":"ZiggsR","name":"科学的地狱火炮","description":"吉格斯部署他的尖端发明，科学的地狱火炮，将它推送一段极远的距离。在主要爆炸区域里的敌人会比在其它爆炸区域里的敌人受到更多的伤害。","maxrank":3,"cooldown":[120,95,70],"cost":[100,100,100],"image":{"full":"ZiggsR.png","sprite":"spell17.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"120/95/70","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Zoe":{"Q:飞星乱入！":{"slot":"Q","skill":{"id":"ZoeQ","name":"飞星乱入！","description":"佐伊发射一个可在飞行途中由她重新导向的飞弹。飞弹在直线上飞行的路程越远，造成的伤害就会越高。","maxrank":5,"cooldown":[8.5,8,7.5,7,6.5],"cost":[40,45,50,55,60],"image":{"full":"ZoeQ.png","sprite":"spell17.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"8.5/8/7.5/7/6.5","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}},"W:窃法巧手":{"slot":"W","skill":{"id":"ZoeW","name":"窃法巧手","description":"佐伊可以拾取敌方在施放召唤师技能和主动型装备时产生的法术碎片，从而让她自己能够施放一次性的相应技能或效果。在她施放一次召唤师技能的同时，她会获得3颗飞弹来射向距她最近的目标。","maxrank":5,"cooldown":[0.25],"cost":[0,0,0,0,0],"image":{"full":"ZoeW.
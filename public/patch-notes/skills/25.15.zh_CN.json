{"schemaVersion":1,"patchVersion":"25.15","sources":{"ddragon":"15.15.1","cdragon":"15.15"},"locale":"zh_CN","champions":{"RekSai":{"E:狂野之噬 / 挖掘隧道":{"slot":"E","skill":{"id":"RekSaiE","name":"狂野之噬 / 挖掘隧道","description":"雷克塞噬咬她的目标，可在满怒时造成额外伤害。<br><br>在地底时，雷克塞挖掘出一个可重复使用、长期存在的隧道。敌人可以通过踩在任一入口上来摧毁整条隧道。","maxrank":5,"cooldown":[6],"cost":[0,0,0,0,0],"image":{"full":"RekSaiE.png","sprite":"spell11.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"6","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"R:虚空猛冲":{"slot":"R","skill":{"id":"RekSaiR","name":"虚空猛冲","description":"雷克塞对目标造成伤害即可将其标记。她可以激活这个技能，暂时变成不可被选取状态，并扑向一个被标记的目标，并基于其最大生命值造成大量伤害。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"RekSaiR.png","sprite":"spell11.png","group":"spell","x":240,"y":0,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"怒气","rankValues":[]}},"W:遁地 / 破土而出":{"slot":"W","skill":{"id":"RekSaiW","name":"遁地 / 破土而出","description":"雷克塞遁入地下，提供新的技能并提升移动速度。她的视野距离会被降低并且无法进行普攻。<br><br>在地底时，雷克塞可以施放破土而出，击飞并伤害身边的敌人。","maxrank":5,"cooldown":[4],"cost":[0,0,0,0,0],"image":{"full":"RekSaiW.png","sprite":"spell11.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"4","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}}},"Alistar":{},"Belveth":{"P:溶烛化紫 ":{"slot":"P","passive":{"name":"溶烛化紫 ","description":"每当卑尔维斯击杀大型小兵和野怪和英雄时，都会获得永久的额外攻速加成。她还会在使用一个技能后获得暂时的攻击速度加成。","image":{"full":"Belveth_Passive.png","sprite":"passive0.png","group":"passive","x":240,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:虚空激流":{"slot":"Q","skill":{"id":"BelvethQ","name":"虚空激流","description":"卑尔维斯朝选定方向进行突进，对途经的所有敌人造成伤害。","maxrank":5,"cooldown":[1],"cost":[0,0,0,0,0],"image":{"full":"BelvethQ.png","sprite":"spell1.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"1","costBurn":"0/0/0/0/0","costType":"","rankValues":[]}}},"Braum":{},"Corki":{"Q:磷光炸弹":{"slot":"Q","skill":{"id":"PhosphorusBomb","name":"磷光炸弹","description":"库奇向目标区域发射一枚闪光弹，对范围内的敌人造成魔法伤害。这个技能还会暂时让目标区域附近的非隐形的单位和英雄现形。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[60,65,70,75,80],"image":{"full":"PhosphorusBomb.png","sprite":"spell2.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"R:火箭轰击":{"slot":"R","skill":{"id":"MissileBarrage","name":"火箭轰击","description":"库奇朝着他的目标地点发射一枚导弹。导弹会在命中第一个敌人后爆炸，并对目标周围单位造成伤害。库奇每隔一段时间就会挂载一枚导弹，最多挂载7枚。每发射2枚导弹后，下一次就会发射超级导弹，造成额外伤害。","maxrank":3,"cooldown":[2],"cost":[35,35,35],"image":{"full":"MissileBarrage.png","sprite":"spell2.png","group":"spell","x":336,"y":144,"w":48,"h":48},"cooldownBurn":"2","costBurn":"35/35/35","costType":"法力","rankValues":[]}}},"Illaoi":{"P:古神先知":{"slot":"P","passive":{"name":"古神先知","description":"俄洛伊和她创造的<font color='#669900'>躯壳</font>会在附近的不可穿越的地形上生成触手。触手会挥向灵魂，<font color='#669900'>躯壳</font>，以及俄洛伊的【严酷训诫】的受害者们。触手会在命中敌人时造成物理伤害，如果命中目标是英雄还会治疗俄洛伊。","image":{"full":"Illaoi_P.png","sprite":"passive1.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:触手猛击":{"slot":"Q","skill":{"id":"IllaoiQ","name":"触手猛击","description":"提升触手造成的伤害。在激活时，俄洛伊会挥出一条触手来造成物理伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[40,45,50,55,60],"image":{"full":"IllaoiQ.png","sprite":"spell5.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"40/45/50/55/60","costType":"法力","rankValues":[]}},"E:灵魂试炼":{"slot":"E","skill":{"id":"IllaoiE","name":"灵魂试炼","description":"俄洛伊把灵魂从一名敌人的肉身中扯出，强迫它站在她面前。 灵魂会将其所受的一部分伤害传递到本体上。如果灵魂被击杀，或者本体离灵魂过远，那么本体就会成为一个<font color='#669900'>躯壳</font>并且开始生成触手。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[35,40,45,50,55],"image":{"full":"IllaoiE.png","sprite":"spell5.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[]}}},"Irelia":{},"Kled":{"P:怯战蜥蜴斯嘎尔":{"slot":"P","passive":{"name":"怯战蜥蜴斯嘎尔","description":"克烈的可靠坐骑——斯嘎尔——会为他承受伤害。当斯嘎尔的生命值耗尽时，会导致克烈进入非骑乘状态。额外生命值属性只会施加给斯嘎尔。<br><br>在非骑乘状态下时，克烈会更换若干技能并对英雄造成较少伤害。克烈可通过与敌人作战来回复斯嘎尔的勇气。在勇气到达满值时，克烈会骑着拥有部分生命值的斯嘎尔重回骑乘状态。","image":{"full":"Kled_P.png","sprite":"passive2.png","group":"passive","x":288,"y":0,"w":48,"h":48},"rankValues":[]}}},"MasterYi":{"Q:阿尔法突袭":{"slot":"Q","skill":{"id":"AlphaStrike","name":"阿尔法突袭","description":"易以肉眼难以发觉的速度穿梭于战场，对多个敌人造成物理伤害，同时处于不可被选取的状态下。阿尔法突袭可以暴击，并对野怪造成额外物理伤害。普通攻击可以减少阿尔法突袭的冷却时间。","maxrank":5,"cooldown":[20,19.5,19,18.5,18],"cost":[50,55,60,65,70],"image":{"full":"AlphaStrike.png","sprite":"spell8.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"20/19.5/19/18.5/18","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Nilah":{},"Pantheon":{"Q:贯星长枪":{"slot":"Q","skill":{"id":"PantheonQ","name":"贯星长枪","description":"潘森朝着选定方向刺出或投掷他的长枪。","maxrank":5,"cooldown":[11,10.25,9.5,8.75,8],"cost":[25,25,25,25,25],"image":{"full":"PantheonQ.png","sprite":"spell10.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"11/10.25/9.5/8.75/8","costBurn":"25/25/25/25/25","costType":"法力","rankValues":[]}}},"Quinn":{"Q:炫目攻势":{"slot":"Q","skill":{"id":"QuinnQ","name":"炫目攻势","description":"奎因唤出华洛，来标记一名敌人并遮蔽其视野，然后对目标附近区域内的所有敌人造成伤害。","maxrank":5,"cooldown":[11,10.5,10,9.5,9],"cost":[50,55,60,65,70],"image":{"full":"QuinnQ.png","sprite":"spell10.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"11/10.5/10/9.5/9","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Rell":{"W:驭铁术：轰落":{"slot":"W","skill":{"id":"RellW_Dismount","name":"驭铁术：轰落","description":"骑乘状态：芮尔化马为甲，以披甲状态向下轰落，击飞敌人们并获得高额护盾值。在披甲状态下，她获得护甲、魔法抗性、攻击速度和攻击距离，但移动速度缓慢。<br><br>披甲状态：芮尔化甲为马，提供爆发性的移动速度并且她的下一次攻击会对敌人造成击飞效果。<br><br>","maxrank":5,"cooldown":[10],"cost":[40,40,40,40,40],"image":{"full":"RellW_Dismount.png","sprite":"spell11.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"10","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}}}}
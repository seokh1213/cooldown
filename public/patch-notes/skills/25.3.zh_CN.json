":48,"h":48},"cooldownBurn":"10","costBurn":"40/40/40/40/40/40","costType":"法力","rankValues":[]}},"R:墨丘利之炮 / 墨丘利之锤":{"slot":"R","skill":{"id":"JayceStanceHtG","name":"墨丘利之炮 / 墨丘利之锤","description":"锤形态：将墨丘利之锤变成墨丘利之炮，获得新的技能和远程攻击能力。切换至这个形态后的第一下攻击将会减少目标的护甲和魔法抗性。<br><br>炮形态：将墨丘利之炮变成墨丘利之锤，获得新的技能和护甲与魔法抗性加成，切换至这个形态后的第一下攻击将会造成额外的魔法伤害。","maxrank":1,"cooldown":[6],"cost":[0],"image":{"full":"JayceStanceHtG.png","sprite":"spell5.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"6","costBurn":"0","costType":"法力","rankValues":[]}}},"MissFortune":{},"Nasus":{"P:吞噬灵魂":{"slot":"P","passive":{"name":"吞噬灵魂","description":"内瑟斯吸取敌人的生命能量，从而获得生命偷取加成。","image":{"full":"Nasus_Passive.png","sprite":"passive2.png","group":"passive","x":432,"y":96,"w":48,"h":48},"rankValues":[]}}},"Quinn":{"W:敏锐感知":{"slot":"W","skill":{"id":"QuinnW","name":"敏锐感知","description":"在奎因攻击了一名<font color='#FFF673'>易损</font>目标后，被动地为奎因提供攻击速度和移动速度加成。主动激活可以让华洛驱散周围一大片区域的战争迷雾。","maxrank":5,"cooldown":[50,45,40,35,30],"cost":[0,0,0,0,0],"image":{"full":"QuinnW.png","sprite":"spell10.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"50/45/40/35/30","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Rell":{},"Samira":{"E:狂飙":{"slot":"E","skill":{"id":"SamiraE","name":"狂飙","description":"莎弥拉冲刺并越过一名敌人（包含建筑物），斩击沿途的敌人并获得攻击速度。击杀一名敌方英雄会刷新这个技能的冷却时间。","maxrank":5,"cooldown":[20,18,16,14,12],"cost":[40,40,40,40,40],"image":{"full":"SamiraE.png","sprite":"spell11.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"20/18/16/14/12","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Skarner":{"E:以绪塔尔冲击":{"slot":"E","skill":{"id":"SkarnerE","name":"以绪塔尔冲击","description":"斯卡纳向前冲锋并穿过地形。如果他撞击到一个英雄或大型野怪，则可将其猛推到他命中的下一个墙体上，造成伤害和晕眩效果。","maxrank":5,"cooldown":[20,19,18,17,16],"cost":[50,55,60,65,70],"image":{"full":"SkarnerE.png","sprite":"spell13.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"20/19/18/17/16","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Swain":{"P:狂食鸦群":{"slot":"P","passive":{"name":"狂食鸦群","description":"斯维因的鸦群会收集<i>魂屑</i>来治疗斯维因并永久提升他的最大生命值。","image":{"full":"Swain_P.png","sprite":"passive4.png","group":"passive","x":432,"y":0,"w":48,"h":48},"rankValues":[]}},"E:永不复行":{"slot":"E","skill":{"id":"SwainE","name":"永不复行","description":"斯维因释放一道恶魔之手向前击出。手臂随后会返回至斯维因处，并禁锢它命中的敌人。斯维因之后可以选择将所有被禁锢的英雄们拉拽得更靠近他。这个技能在【恶魔升华】期间会有一个更短的冷却时间。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[60,65,70,75,80],"image":{"full":"SwainE.png","sprite":"spell13.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Teemo":{"E:毒性射击":{"slot":"E","skill":{"id":"TeemoE","name":"毒性射击","description":"提莫的每次攻击将使目标中毒，在命中时和之后的4秒里每秒造成伤害。","maxrank":5,"cooldown":[0],"cost":[0,0,0,0,0],"image":{"full":"TeemoE.png","sprite":"spell14.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Thresh":{"E:厄运钟摆":{"slot":"E","skill":{"id":"ThreshE","name":"厄运钟摆","description":"锤石会提升攻击伤害，攻击的间歇期越久伤害值越高。在激活此技能时，锤石会挥舞他的锁链，将命中的所有敌人带向锁链挥舞的方向。","maxrank":5,"cooldown":[13,12.25,11.5,10.75,10],"cost":[60,65,70,75,80],"image":{"full":"ThreshE.png","sprite":"spell14.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"13/12.25/11.5/10.75/10","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Viego":{}}}
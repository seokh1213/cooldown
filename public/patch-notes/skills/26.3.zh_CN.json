{"schemaVersion":1,"patchVersion":"26.3","sources":{"ddragon":"16.3.1","cdragon":"16.3"},"locale":"zh_CN","champions":{"Ahri":{"W:妖异狐火":{"slot":"W","skill":{"id":"AhriW","name":"妖异狐火","description":"阿狸获得短暂的爆发性移动速度加成，并放出三团狐火，锁定附近的敌人进行攻击。","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[30,30,30,30,30],"image":{"full":"AhriW.png","sprite":"spell0.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Mel":{"Q:耀光齐射":{"slot":"Q","skill":{"id":"MelQ","name":"耀光齐射","description":"梅尔发射一连串耀光飞弹，飞弹会在目标位置周围爆炸，对范围内的敌人造成多段伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[70,75,80,85,90],"image":{"full":"MelQ.png","sprite":"spell8.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}},"E:阳炎涡旋":{"slot":"E","skill":{"id":"MelE","name":"阳炎涡旋","description":"梅尔发射一颗阳炎法球，禁锢中心区域的敌人并减速周围区域的敌人并造成持续伤害。","maxrank":5,"cooldown":[11,10.5,10,9.5,9],"cost":[50,60,70,80,90],"image":{"full":"MelE.png","sprite":"spell8.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"11/10.5/10/9.5/9","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}},"P:灼灼之光":{"slot":"P","passive":{"name":"灼灼之光","description":"每当梅尔使用技能，她的下一次攻击将额外附带3枚弹体（最多9枚）。<br><br>当梅尔通过一次技能或攻击造成伤害时，她会施加【夺命残影】——一种可以无限叠加的效果。如果目标身上叠加了足够的夺命残影伤害量，则会在下一次被梅尔命中时被直接处决，同时消耗效果层数。","image":{"full":"Mel_Passive.png","sprite":"passive2.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}},"W:灵魂折镜":{"slot":"W","skill":{"id":"MelW","name":"灵魂折镜","description":"梅尔生成一道屏障围绕自身，这道屏障会将敌方弹体反弹给攻击者，使她免受伤害，并为她提供移动速度。","maxrank":5,"cooldown":[35,32,29,26,23],"cost":[80,60,40,20,0],"image":{"full":"MelW.png","sprite":"spell8.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"35/32/29/26/23","costBurn":"80/60/40/20/0","costType":"法力","rankValues":[]}},"R:鎏金蚀日":{"slot":"R","skill":{"id":"MelR","name":"鎏金蚀日","description":"梅尔无视距离，对所有带有【夺命残影】层数的敌人进行打击，造成基于【夺命残影】层数的额外伤害。<br><br>【鎏金蚀日】的技能等级会提升【夺命残影】的伤害。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"MelR.png","sprite":"spell8.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Volibear":{"E:霹天雳地":{"slot":"E","skill":{"id":"VolibearE","name":"霹天雳地","description":"沃利贝尔在目标区域召唤一道闪电箭，对其中的敌人造成魔法伤害和减速效果，并且如果沃利贝尔在闪电落点区域内，他还会获得一层护盾。","maxrank":5,"cooldown":[16],"cost":[60,60,60,60,60],"image":{"full":"VolibearE.png","sprite":"spell15.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"16","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"Q:擂首一击":{"slot":"Q","skill":{"id":"VolibearQ","name":"擂首一击","description":"沃利贝尔在朝着敌人时会获得移动速度，并且会对他攻击的第一个敌人造成<status>晕眩</status>和伤害。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[50,50,50,50,50],"image":{"full":"VolibearQ.png","sprite":"spell15.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}}},"Belveth":{"R:万载豪筵":{"slot":"R","skill":{"id":"BelvethR","name":"万载豪筵","description":"卑尔维斯消耗【虚空珊瑚残片】，转化为她的真实形态并提升她的最大生命值、攻击距离、攻击速度和非战斗状态下的移动速度。消耗来自虚空史诗级野怪的【虚空珊瑚残片】将为她提供更久的终极技能持续时长，以及召唤【虚空鱼】的能量。","maxrank":3,"cooldown":[1],"cost":[0,0,0],"image":{"full":"BelvethR.png","sprite":"spell2.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"1","costBurn":"0/0/0","costType":"","rankValues":[]}}},"Braum":{"Q:寒冬之咬":{"slot":"Q","skill":{"id":"BraumQ","name":"寒冬之咬","description":"布隆驱动盾牌中的冷冻冰块，对敌人造成魔法伤害和减速效果。<br><br>对目标施加一层<font color='#FFF673'>震荡猛击</font>。","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[45,50,55,60,65],"image":{"full":"BraumQ.png","sprite":"spell2.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"45/50/55/60/65","costType":"法力","rankValues":[]}}},"Briar":{"Q:冲头":{"slot":"Q","skill":{"id":"BriarQ","name":"冲头","description":"贝蕾亚跃向一个单位并用她的（痛苦之）脚镣命中敌人们，将他们晕眩并削减他们的护甲。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"BriarQ.png","sprite":"spell2.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"W:血莽 / 噬击":{"slot":"W","skill":{"id":"BriarW","name":"血莽 / 噬击","description":"贝蕾亚向前跳跃并击碎她的囚枷，进入一种【血莽】状态来使她无休止地追击相距最近的那个敌人（优先以英雄为目标）。在【血莽】状态下，她的攻击速度和移动速度获得提升，并且她的攻击会在她目标四周的一个区域内造成伤害。<br><br>贝蕾亚可以在【血莽】状态下再次激活这个技能，来让她的下一次攻击噬咬她的目标，造成基于目标已损失生命值的额外伤害，并且基于她造成的伤害来为她提供治疗效果。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[0,0,0,0,0],"image":{"full":"BriarW.png","sprite":"spell2.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"E:惊吼":{"slot":"E","skill":{"id":"BriarE","name":"惊吼","description":"贝蕾亚重新集中她的意志，移除【血莽】并将能量引导为一次强力吼叫，对敌人造成伤害和减速。在蓄力时，她获得伤害减免并回复一部分最大生命值。一次完全蓄力的吼叫会将敌人们击退，对那些与墙体碰撞的敌人造成额外伤害和晕眩。","maxrank":5,"cooldown":[16],"cost":[0,0,0,0,0],"image":{"full":"BriarE.png","sprite":"spell2.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"16","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}},"R:毙除":{"slot":"R","skill":{"id":"BriarR","name":"毙除","description":"贝蕾亚踢出她的囚枷中的血石，让被它命中的第一个英雄成为她的猎物。她随后会径直走向该目标，在抵达目标处时恐惧周围的其它敌人们，并进入一个彻底血狂的状态。她将追击她的猎物直至阵亡才罢休，获得【血莽】的助益以及额外的护甲、魔抗、生命偷取和移动速度。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"BriarR.png","sprite":"spell2.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"怒气","rankValues":[]}}},"Diana":{"P:月银之刃":{"slot":"P","passive":{"name":"月银之刃","description":"每第三次攻击就会溅射周围的敌人，造成额外的魔法伤害。在施放一个技能后，黛安娜获得持续5秒的攻击速度。","image":{"full":"Diana_Passive_LunarBlade.png","sprite":"passive0.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}}},"Draven":{},"Ekko":{"P:Z型驱动共振":{"slot":"P","passive":{"name":"Z型驱动共振","description":"每当艾克对相同目标施放第三次普攻或伤害性技能时，都会造成额外魔法伤害，并且如果目标是英雄，那么艾克还会获得爆发性的移动速度加成。<br><br>","image":{"full":"Ekko_P.png","sprite":"passive0.png","group":"passive","x":432,"y":96,"w":48,"h":48},"rankValues":[]}}},"Ezreal":{"E:奥术跃迁":{"slot":"E","skill":{"id":"EzrealE","name":"奥术跃迁","description":"伊泽瑞尔传送到附近的目标区域，并向最近的敌人发射一束自动寻敌的魔法箭。优先选择被【精华跃动】击中的敌人。","maxrank":5,"cooldown":[26,23,20,17,14],"cost":[70,70,70,70,70],"image":{"full":"EzrealE.png","sprite":"spell3.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"26/23/20/17/14","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Hecarim":{"Q:暴走":{"slot":"Q","skill":{"id":"HecarimRapidSlash","name":"暴走","description":"赫卡里姆猛劈周围的敌人，同时造成物理伤害。如果这个技能对至少一名敌人造成伤害，那么赫卡里姆会提升【暴走】的伤害并为随后施放的【暴走】缩短冷却时间。","maxrank":5,"cooldown":[4],"cost":[28,26,24,22,20],"image":{"full":"HecarimRapidSlash.png","sprite":"spell4.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"4","costBurn":"28/26/24/22/20","costType":"法力","rankValues":[]}}},"Heimerdinger":{"W:海克斯科技微型导弹":{"slot":"W","skill":{"id":"HeimerdingerW","name":"海克斯科技微型导弹","description":"黑默丁格以鼠标悬停处为焦点，发射数枚长程导弹。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[50,60,70,80,90],"image":{"full":"HeimerdingerW.png","sprite":"spell4.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}}},"Jayce":{"Q:苍穹之跃 / 电能震荡":{"slot":"Q","skill":{"id":"JayceToTheSkies","name":"苍穹之跃 / 电能震荡","description":"锤形态：跳向一个敌人，对敌人造成物理伤害和减速效果。 <br><br>炮形态：发射一团电球，在命中一名敌人或者到达最大射程后爆炸，对命中的敌人造成物理伤害。","maxrank":6,"cooldown":[16,14,12,10,8,6],"cost":[40,40,40,40,40,40],"image":{"full":"JayceToTheSkies.png","sprite":"spell5.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"16/14/12/10/8/6","costBurn":"40/40/40/40/40/40","costType":"法力","rankValues":[]}},"R:墨丘利之炮 / 墨丘利之锤":{"slot":"R","skill":{"id":"JayceStanceHtG","name":"墨丘利之炮 / 墨丘利之锤","description":"锤形态：将墨丘利之锤变成墨丘利之炮，获得新的技能和远程攻击能力。切换至这个形态后的第一下攻击将会减少目标的护甲和魔法抗性。<br><br>炮形态：将墨丘利之炮变成墨丘利之锤，获得新的技能和护甲与魔法抗性加成，切换至这个形态后的第一下攻击将会造成额外的魔法伤害。","maxrank":1,"cooldown":[6],"cost":[0],"image":{"full":"JayceStanceHtG.png","sprite":"spell5.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"6","costBurn":"0","costType":"法力","rankValues":[]}}},"Kayn":{"Q:巨镰横扫":{"slot":"Q","skill":{"id":"KaynQ","name":"巨镰横扫","description":"凯隐向前冲刺并打击附近的敌人。冲刺和打击都会造成伤害。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[40,40,40,40,40],"image":{"full":"KaynQ.png","sprite":"spell6.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Maokai":{"Q:荆棘重击":{"slot":"Q","skill":{"id":"MaokaiQ","name":"荆棘重击","description":"茂凯用一记冲击波击退附近的敌人，造成魔法伤害和减速效果。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[40,40,40,40,40],"image":{"full":"MaokaiQ.png","sprite":"spell8.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Naafiri":{"P:狂烈种群":{"slot":"P","passive":{"name":"狂烈种群","description":"纳亚菲利生成狗群伙伴，它们会在她攻击或施放技能时攻击目标。","image":{"full":"Icons_Naafiri_P.png","sprite":"passive2.png","group":"passive","x":336,"y":96,"w":48,"h":48},"rankValues":[]}}},"Nilah":{},"Nunu":{"W:史上最大雪球！":{"slot":"W","skill":{"id":"NunuW","name":"史上最大雪球！","description":"威朗普滚起一个雪球，它的尺寸和速度将随着滚动时间而增长。雪球会伤害并击飞敌人。","maxrank":5,"cooldown":[14],"cost":[50,55,60,65,70],"image":{"full":"NunuW.png","sprite":"spell9.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"14","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"E:雪球飞射":{"slot":"E","skill":{"id":"NunuE","name":"雪球飞射","description":"努努掷出多个雪球以伤害敌人。当他完成后，威朗普就会禁锢被雪球命中过的任何英雄或大型野怪。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[50,55,60,65,70],"image":{"full":"NunuE.png","sprite":"spell10.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Riven":{"P:符文之刃":{"slot":"P","passive":{"name":"符文之刃","description":"锐雯的技能会为她的剑刃
{"schemaVersion":1,"patchVersion":"25.21","sources":{"ddragon":"15.21.1","cdragon":"15.21"},"locale":"zh_CN","champions":{"Gwen":{"W:丝缕缠流":{"slot":"W","skill":{"id":"GwenW","name":"丝缕缠流","description":"格温召唤圣霭来保护她免受圣霭外敌人的进攻。她只会被进入圣霭内的敌人们选为目标。","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[60,60,60,60,60],"image":{"full":"GwenW.png","sprite":"spell4.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"E:断续疾走":{"slot":"E","skill":{"id":"GwenE","name":"断续疾走","description":"格温冲刺一小段距离然后获得攻击速度、攻击距离和魔法伤害<OnHit>攻击特效</OnHit>，持续若干秒。如果她在此期间命中了一个敌人，那么这个技能的冷却时间会获得部分返还。","maxrank":5,"cooldown":[13,12.5,12,11.5,11],"cost":[35,35,35,35,35],"image":{"full":"GwenE.png","sprite":"spell4.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"13/12.5/12/11.5/11","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}},"P:千穿百孔":{"slot":"P","passive":{"name":"千穿百孔","description":"格温的攻击会造成基于目标生命值的额外魔法伤害。她自身会获得治疗效果，数额相当于这个效果对英雄造成的一部分伤害值。","image":{"full":"Gwen_Passive.png","sprite":"passive1.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:快刀剪乱":{"slot":"Q","skill":{"id":"GwenQ","name":"快刀剪乱","description":"格温在一个锥形区域剪切她的剪刀至多6次，来造成魔法伤害。格温的每次剪切会对中心区域的敌人造成真实伤害并对它们施加她的被动技能。","maxrank":5,"cooldown":[6.5,5.75,5,4.25,3.5],"cost":[40,40,40,40,40],"image":{"full":"GwenQ.png","sprite":"spell4.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6.5/5.75/5/4.25/3.5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"R:引针簇射":{"slot":"R","skill":{"id":"GwenR","name":"引针簇射","description":"格温掷出一根针来对命中的敌人们造成减速、魔法伤害，并对命中的英雄们施加【千穿百孔】。<br><br>这个技能至多可进行2段再次施放，每一段再次施放都会投掷更多的针，并造成更多伤害。 ","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"GwenR.png","sprite":"spell4.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Yunara":{"E:明踪步 | 夜影翻":{"slot":"E","skill":{"id":"YunaraE","name":"明踪步 | 夜影翻","description":"芸阿娜获得持续衰减的移动速度并进入幽灵状态。在她处于超凡形态期间，她转而朝着一个方向冲刺。","maxrank":5,"cooldown":[9],"cost":[40,40,40,40,40],"image":{"full":"YunaraE.png","sprite":"spell16.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"9","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"W:善恶轮 | 寂灭掌":{"slot":"W","skill":{"id":"YunaraW","name":"善恶轮 | 寂灭掌","description":"芸阿娜发射一颗不停旋转的念珠，对敌人们造成伤害和减速。在她处于超凡形态期间，她转而发射一记射线，对敌人们造成伤害和减速。","maxrank":5,"cooldown":[10],"cost":[60,60,60,60,60],"image":{"full":"YunaraW.png","sprite":"spell16.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"10","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"W:毀滅弧光（超凡狀態）（W）":{"slot":"W","skill":{"id":"YunaraW","name":"毀滅弧光（超凡狀態）（W）","description":"芸阿娜发射一颗不停旋转的念珠，对敌人们造成伤害和减速。在她处于超凡形态期间，她转而发射一记射线，对敌人们造成伤害和减速。","maxrank":5,"cooldown":[],"image":{"full":"YunaraW.png","sprite":"spell16.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"","costType":"法力","rankValues":[]}}},"Bard":{"W:游神圣坛":{"slot":"W","skill":{"id":"BardW","name":"游神圣坛","description":"升起一座生命圣坛，圣坛会在短时间内持续充能，并在治疗和加速第一个接触它的友军后消失。","maxrank":5,"cooldown":[0],"cost":[70,70,70,70,70],"image":{"full":"BardW.png","sprite":"spell1.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"0","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Diana":{"P:銀月之刃（被動）":{"slot":"P","passive":{"name":"銀月之刃（被動）","description":"每第三次攻击就会溅射周围的敌人，造成额外的魔法伤害。在施放一个技能后，黛安娜获得持续5秒的攻击速度。","image":{"full":"Diana_Passive_LunarBlade.png","sprite":"passive0.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}}},"DrMundo":{"E:大力行医":{"slot":"E","skill":{"id":"DrMundoE","name":"大力行医","description":"被动 - 蒙多医生获得额外攻击力，数额会基于他的最大生命值而提升。<br><br>主动 - 蒙多医生用他的“医用”手提包猛砸一个敌人，造成基于他已损失生命值的额外伤害。如果这个敌人被击杀，那么还会被拍飞，对途经的所有敌人造成伤害。","maxrank":5,"cooldown":[9,8.25,7.5,6.75,6],"cost":[0,0,0,0,0],"image":{"full":"DrMundoE.png","sprite":"spell3.png","group"
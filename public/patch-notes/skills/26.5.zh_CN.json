{"schemaVersion":1,"patchVersion":"26.5","sources":{"ddragon":"16.5.1","cdragon":"16.5"},"locale":"zh_CN","champions":{"Lillia":{"R:夜阑谣":{"slot":"R","skill":{"id":"LilliaR","name":"夜阑谣","description":"莉莉娅使所有带着【梦尘】的敌人陷入困倦状态，然后陷入昏睡状态。这些敌人在被强制唤醒时会受到额外伤害。","maxrank":3,"cooldown":[150,130,110],"cost":[50,50,50],"image":{"full":"LilliaR.png","sprite":"spell7.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"150/130/110","costBurn":"50/50/50","costType":"法力","rankValues":[]}},"P:梦满枝":{"slot":"P","passive":{"name":"梦满枝","description":"用一个技能命中一位英雄或野怪，将持续造成额外的最大生命值伤害。","image":{"full":"Lillia_Icon_Passive.png","sprite":"passive2.png","group":"passive","x":96,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:飞花挞":{"slot":"Q","skill":{"id":"LilliaQ","name":"飞花挞","description":"被动部分：莉莉娅在用技能命中敌人时，会获得移动速度。主动部分：莉莉娅对附近的敌人造成魔法伤害，并对边缘的敌人造成额外真实伤害。","maxrank":5,"cooldown":[6,5.5,5,4.5,4],"cost":[65,65,65,65,65],"image":{"full":"LilliaQ.png","sprite":"spell7.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"6/5.5/5/4.5/4","costBurn":"65/65/65/65/65","costType":"法力","rankValues":[]}}},"Orianna":{"Q:指令：攻击":{"slot":"Q","skill":{"id":"OrianaIzunaCommand","name":"指令：攻击","description":"奥莉安娜指挥她的魔偶，朝目标区域发射，对沿途目标造成魔法伤害（对后续目标伤害递减）。指令结束后魔偶会停在目标区域。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[35,35,35,35,35],"image":{"full":"OrianaIzunaCommand.png","sprite":"spell10.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}}},"Volibear":{"W:暴怒撕咬":{"slot":"W","skill":{"id":"VolibearW","name":"暴怒撕咬","description":"沃利贝尔伤害一名敌人，施加攻击特效并将其标记。对相同目标再次施放这个技能，会造成额外伤害并治疗沃利贝尔。","maxrank":5,"cooldown":[5],"cost":[20,25,30,35,40],"image":{"full":"VolibearW.png","sprite":"spell15.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"5","costBurn":"20/25/30/35/40","costType":"法力","rankValues":[]}},"E:霹天雳地":{"slot":"E","skill":{"id":"VolibearE","name":"霹天雳地","description":"沃利贝尔在目标区域召唤一道闪电箭，对其中的敌人造成魔法伤害和减速效果，并且如果沃利贝尔在闪电落点区域内，他还会获得一层护盾。","maxrank":5,"cooldown":[16],"cost":[50,50,50,50,50],"image":{"full":"VolibearE.png","sprite":"spell15.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"16","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"Q:擂首一击":{"slot":"Q","skill":{"id":"VolibearQ","name":"擂首一击","description":"沃利贝尔在朝着敌人时会获得移动速度，并且会对他攻击的第一个敌人造成<status>晕眩</status>和伤害。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[50,50,50,50,50],"image":{"full":"VolibearQ.png","sprite":"spell15.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}}},"Akali":{"W:我流奥义！霞阵":{"slot":"W","skill":{"id":"AkaliW","name":"我流奥义！霞阵","description":"阿卡丽扔下一颗烟幕弹并暂时提供移动速度。在烟幕中时，阿卡丽会变为隐形状态并且不会被敌方的技能和攻击所选中。进行攻击或使用技能都将使阿卡丽短暂显形。","maxrank":5,"cooldown":[20,19,18,17,16],"cost":[0,0,0,0,0],"image":{"full":"AkaliW.png","sprite":"spell0.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"20/19/18/17/16","costBurn":"0/0/0/0/0","costType":"能量","rankValues":[]}}},"Azir":{},"Garen":{"Q:致命打击":{"slot":"Q","skill":{"id":"GarenQ","name":"致命打击","description":"盖伦的移动速度获得爆发性提升，同时移除身上的所有减速效果。他的下次攻击将打击敌人的要害部位，造成额外伤害并将目标沉默。","maxrank":5,"cooldown":[8],"cost":[0,0,0,0,0],"image":{"full":"GarenQ.png","sprite":"spell4.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"8","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}},"E:审判":{"slot":"E","skill":{"id":"GarenE","name":"审判","description":"盖伦快速地旋转身体挥舞大剑，并对邻近敌人造成物理伤害。","maxrank":5,"cooldown":[9,8.25,7.5,6.75,6],"cost":[0,0,0,0,0],"image":{"full":"GarenE.png","sprite":"spell4.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"9/8.25/7.5/6.75/6","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"Khazix":{"Q:品尝恐惧":{"slot":"Q","skill":{"id":"KhazixQ","name":"品尝恐惧","description":"对目标造成物理伤害。对<font color='#FFF673'>孤立无援</font>的目标造成的伤害会提高。如果他选择<font color='#00DD33'>进化收割利爪</font>的话，这个技能会在对抗<font color='#FFF673'>孤立无援</font>的目标时返还一部分冷却时间。卡兹克也会提升他的普通攻击和品尝恐惧的距离。","maxrank":5,"cooldown":[4],"cost":[20,20,20,20,20],"image":{"full":"KhazixQ.png","sprite":"spell6.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"4","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}}},"LeeSin":{"Q:天音波/回音击":{"slot":"Q","skill":{"id":"LeeSinQOne","name":"天音波/回音击","description":"天音波：李青发出刺耳的声波定位敌人，对首个敌人造成物理伤害。如果天音波击中敌人，李青在接下来3秒可施放回音击。<br>回音击：李青冲向被天音波击中的敌人，造成基于该目标已损失生命值的物理伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[50,50,50,50,50],"image":{"full":"LeeSinQOne.png","sprite":"spell7.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"50/50/50/50/50","costType":"能量","rankValues":[]}}},"Mel":{"P:灼灼之光":{"slot":"P","passive":{"name":"灼灼之光","description":"每当梅尔使用技能，她的下一次攻击将额外附带3枚弹体（最多9枚）。<br><br>当梅尔通过一次技能或攻击造成伤害时，她会施加【夺命残影】——一种可以无限叠加的效果。如果目标身上叠加了足够的夺命残影伤害量，则会在下一次被梅尔命中时被直接处决，同时消耗效果层数。","image":{"full":"Mel_Passive.png","sprite":"passive2.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:耀光齐射":{"slot":"Q","skill":{"id":"MelQ","name":"耀光齐射","description":"梅尔发射一连串耀光飞弹，飞弹会在目标位置周围爆炸，对范围内的敌人造成多段伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[70,75,80,85,90],"image":{"full":"MelQ.png","sprite":"spell8.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}},"R:鎏金蚀日":{"slot":"R","skill":{"id":"MelR","name":"鎏金蚀日","description":"梅尔无视距离，对所有带有【夺命残影】层数的敌人进行打击，造成基于【夺命残影】层数的额外伤害。<br><br>【鎏金蚀日】的技能等级会提升【夺命残影】的伤害。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"MelR.png","sprite":"spell8.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Neeko":{"W:两生花影":{"slot":"W","skill":{"id":"NeekoW","name":"两生花影","description":"被动效果：妮蔻每第三次攻击造成额外魔法伤害，并短暂提升她的移动速度。主动效果：妮蔻能够朝一个方向投射出一个幻像并通过再次施放来改变幻象的方向。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[0,0,0,0,0],"image":{"full":"NeekoW.png","sprite":"spell9.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Nocturne":{"P:暗影之刃":{"slot":"P","passive":{"name":"暗影之刃","description":"每过数秒，魔腾的下次攻击就会对附近敌人造成额外物理伤害，并治疗自己。<br><br>魔腾的普通攻击会减少该技能的冷却时间。","image":{"full":"Nocturne_UmbraBlades.png","sprite":"passive3.png","group":"passive","x":192,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:梦魇之径":{"slot":"Q","skill":{"id":"NocturneDuskbringer","name":"梦魇之径","description":"魔腾扔出一把暗影之刃，对敌人造成伤害并留下幽灵影径，并使受到伤害的敌方英雄也留下幽灵影径。在影径上时，魔腾无视任何碰撞体积，并且他的移动速度和攻击力也会得到提高。","maxrank":5,"cooldown":[8],"cost":[60,65,70,75,80],"image":{"full":"NocturneDuskbringer.png","sprite":"spell9.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"8","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Samira":{"Q:交火":{"slot":"Q","skill":{"id":"SamiraQ","name":"交火","description":"莎弥拉进行一次射击或斩击，造成伤害。如果在【狂飙】期间施放，那么会在完成时打击沿途的所有敌人。","maxrank":5,"cooldown":[6,5,4,3,2],"cost":[30,30,30,30,30],"image":{"full":"SamiraQ.png","sprite":"spell11.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"6/5/4/3/2","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Taliyah":{"Q:石穿":{"slot":"Q","skill":{"id":"TaliyahQ","name":"石穿","description":"塔莉垭朝目标方向扔出一串岩石，同时自身可自由移动。这个技能会在她脚下生成【掘石场】。如果塔莉垭在【掘石场】上使用【Q石穿】，她将消耗掉【掘石场】来投掷一颗更强大的岩石来减速敌人。","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"TaliyahQ.png","sprite":"spell13.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}}},"Varus":{"Q:穿刺之箭":{"slot":"Q","skill":{"id":"VarusQ","name":"穿刺之箭","description":"韦鲁斯开始蓄力，随后进行一次远距离的强力射击，蓄力时间越长，伤害越高。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[50,55,60,65,70],"image":{"full":"VarusQ.png","sprite":"spell14.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"W:枯萎箭袋":{"slot":"W","skill":{"id":"VarusW","name":"枯萎箭袋","description":"被动：韦鲁斯的普通攻击会造成额外的伤害，并附加枯萎效果。韦鲁斯的其它技能会引爆枯萎效果，造成基于目标最大生命值的魔法伤害。主动：韦鲁斯增强他的下一个【穿刺之箭】。","maxrank":5,"cooldown":[40],"cost":[0,0,0,0,0],"image":{"full":"VarusW.png","sprite":"spell14.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"40","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}}}}
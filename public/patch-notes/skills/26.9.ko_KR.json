{"schemaVersion":1,"patchVersion":"26.9","sources":{"ddragon":"16.9.1","cdragon":"16.9"},"locale":"ko_KR","champions":{"Shyvana":{"W:지옥불 방패":{"slot":"W","skill":{"id":"ShyvanaW","name":"지옥불 방패","description":"쉬바나가 보호막과 이동 속도를 얻으며, 잠시 후 쉬바나 주변에 폭발을 일으킵니다.  용 형상일 때 폭발이 적 챔피언에게 적중하면 체력을 회복합니다.","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaW.png","sprite":"spell12.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기본 피해량","values":"80 / 100 / 120 / 140 / 160"}]}},"E:용암 분출":{"slot":"E","skill":{"id":"ShyvanaE","name":"용암 분출","description":"쉬바나가 화염구를 날리고 대형 대상에게 적중 시 폭발하며 둔화를 적용합니다. 용 형상일 때는 화염구가 대형 적에게 적중 시 관통하며 폭발하고 지나간 자리에 불길을 남깁니다.","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaE.png","sprite":"spell12.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기본 피해량","values":"50 / 65 / 80 / 95 / 110"},{"label":"둔화 지속시간","values":"2초"}]},"icons":[{"file":"patch-notes/icons/8309d2c79c90048d35a6275b39e06637.webp","spellId":"ShyvanaE"}]}},"Taliyah":{"Q:파편 난사":{"slot":"Q","skill":{"id":"TaliyahQ","name":"파편 난사","description":"탈리야가 지정한 방향으로 바위 조각을 던집니다. 이 때 탈리야는 자유롭게 이동할 수 있으며 탈리야 아래의 땅이 다져집니다. 다져진 땅 위에서 파편 난사를 사용하면 다져진 땅이 사라지면서 적을 둔화하는 큰 바위를 던집니다.","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"TaliyahQ.png","sprite":"spell13.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"마나","rankValues":[{"label":"기본 피해량","values":"55 / 72.5 / 90 / 107.5 / 125"},{"label":"둔화 지속시간","values":"1.5초"}]},"icons":[{"file":"patch-notes/icons/af5c088cd68796460be7bcaac5182fc2.webp","spellId":"TaliyahQ"}]}},"Udyr":{"Q:야생 발톱":{"slot":"Q","skill":{"id":"UdyrQ","name":"야생 발톱","description":"공격 속도가 증가하고 다음 두 차례 기본 공격으로 추가 물리 피해를 입힙니다. 재사용 시: 공격 속도가 더 많이 증가
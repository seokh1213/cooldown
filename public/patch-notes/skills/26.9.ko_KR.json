{"schemaVersion":1,"patchVersion":"26.9","sources":{"ddragon":"16.9.1","cdragon":"16.9"},"locale":"ko_KR","champions":{"Shyvana":{"W:지옥불 방패":{"slot":"W","skill":{"id":"ShyvanaW","name":"지옥불 방패","description":"쉬바나가 보호막과 이동 속도를 얻으며, 잠시 후 쉬바나 주변에 폭발을 일으킵니다.  용 형상일 때 폭발이 적 챔피언에게 적중하면 체력을 회복합니다.","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaW.png","sprite":"spell12.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기본 피해량","values":"80 / 100 / 120 / 140 / 160"}]}},"E:용암 분출":{"slot":"E","skill":{"id":"ShyvanaE","name":"용암 분출","description":"쉬바나가 화염구를 날리고 대형 대상에게 적중 시 폭발하며 둔화를 적용합니다. 용 형상일 때는 화염구가 대형 적에게 적중 시 관통하며 폭발하고 지나간 자리에 불길을 남깁니다.","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaE.png","sprite":"spell12.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기본 피해량","values":"50 / 65 / 80 / 95 / 110"},{"label":"둔화 지속시간","values":"2초"}]},"icons":[{"file":"patch-notes/icons/8309d2c79c90048d35a6275b39e06637.webp","spellId":"ShyvanaE"}]},"Q:잉걸불 일격":{"slot":"Q","skill":{"id":"ShyvanaQ","name":"잉걸불 일격","description":"쉬바나의 다음 기본 공격이 대상과 주변 지역을 모두 타격합니다. 이 스킬은 재사용할 수 있습니다. 용 형상일 때는 스킬을 한 번 더 사용할 수 있으며, 단일 대상에게 막대한 피해를 입힙니다.","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaQ.png","sprite":"spell12.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[]}}},"Taliyah":{"Q:파편 난사":{"slot":"Q","skill":{"id":"TaliyahQ","name":"파편 난사","description":"탈리야가 지정한 방향으로 바위 조각을 던집니다. 이 때 탈리야는 자유롭게 이동할 수 있으며 탈리야 아래의 땅이 다져집니다. 다져진 땅 위에서 파편 난사를 사용하면 다져진 땅이 사라지면서 적을 둔화하는 큰 바위를 던집니다.","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"TaliyahQ.png","sprite":"spell13.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"마나","rankValues":[{"label":"기본 피해량","values":"55 / 72.5 / 90 / 107.5 / 125"},{"label":"둔화 지속시간","values":"1.5초"}]},"icons":[{"file":"patch-notes/icons/af5c088cd68796460be7bcaac5182fc2.webp","spellId":"TaliyahQ"}]}},"Udyr":{"Q:야생 발톱":{"slot":"Q","skill":{"id":"UdyrQ","name":"야생 발톱","description":"공격 속도가 증가하고 다음 두 차례 기본 공격으로 추가 물리 피해를 입힙니다. 재사용 시: 공격 속도가 더 많이 증가하고 다음 두 차례 기본 공격으로 번개를 일으켜 대상을 타격합니다.","maxrank":6,"cooldown":[6],"cost":[20,20,20,20,20,20],"image":{"full":"UdyrQ.png","sprite":"spell14.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"6","costBurn":"20/20/20/20/20/20","costType":"마나","rankValues":[{"label":"기본 피해량","values":"6 / 12 / 18 / 24 / 30"}]},"icons":[{"file":"patch-notes/icons/a4533396f81a75878c798efe0b16f29f.webp","spellId":"UdyrQ"}]},"W:강철 갑옷":{"slot":"W","skill":{"id":"UdyrW","name":"강철 갑옷","description":"보호막을 얻고 다음 두 차례의 기본 공격을 통해 체력을 회복합니다. 재사용 시: 강화된 보호막을 얻은 후 몇 초에 걸쳐 최대 체력에 비례해 체력을 회복합니다.","maxrank":6,"cooldown":[6],"cost":[40,40,40,40,40,40],"image":{"full":"UdyrW.png","sprite":"spell14.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"6","costBurn":"40/40/40/40/40/40","costType":"마나","rankValues":[]}},"E:불길 쇄도":{"slot":"E","skill":{"id":"UdyrE","name":"불길 쇄도","description":"이동 속도가 증가합니다. 이 태세를 취한 후 적에게 처음 기본 공격을 가할 때마다 대상을 기절시킵니다. 재사용 시: 몇 초간 이동 속도가 더 많이 증가하고 이동 불가 효과에 면역이 됩니다. ","maxrank":6,"cooldown":[6],"cost":[40,40,40,40,40,40],"image":{"full":"UdyrE.png","sprite":"spell14.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"6","costBurn":"40/40/40/40/40/40","costType":"마나","rankValues":[]}}},"Zeri":{"Q:집중 사격":{"slot":"Q","skill":{"id":"ZeriQ","name":"집중 사격","description":"처음 적중한 적에게 물리 피해를 입히는 공격 7발을 발사합니다. 이 스킬은 기본 공격으로 간주됩니다.","maxrank":5,"cooldown":[0],"cost":[0,0,0,0,0],"image":{"full":"ZeriQ.png","sprite":"spell17.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"0/0/0/0/0","costType":"마나","rankValues":[{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"21 / 24 / 27 / 30 / 33"},{"label":"둔화 지속시간","values":"0.25초"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"},{"label":"기본 피해량","values":"5 / 15 / 25 / 35 / 45"}]}},"E:스파크 돌진":{"slot":"E","skill":{"id":"ZeriE","name":"스파크 돌진","description":"제리가 짧은 거리를 돌진하며 집중 사격을 충전합니다. 충전된 집중 사격은 적을 꿰뚫습니다. 돌진 시 맞닥트리는 지형을 모두 뛰어넘습니다.","maxrank":5,"cooldown":[24,22.5,21,19.5,18],"cost":[90,85,80,75,70],"image":{"full":"ZeriE.png","sprite":"spell17.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"24/22.5/21/19.5/18","costBurn":"90/85/80/75/70","costType":"마나","rankValues":[]}},"P:살아있는 배터리":{"slot":"P","passive":{"name":"살아있는 배터리","description":"제리의 기본 공격은 마법 피해를 입히며 스킬로 간주됩니다. 이동하거나 집중 사격을 사용하면 제리의 스파크 팩에 에너지가 쌓입니다. 완전히 충전되면 제리의 다음 기본 공격이 추가 피해를 입힙니다.","image":{"full":"ZeriP.png","sprite":"passive5.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}},"W:초강력 레이저":{"slot":"W","skill":{"id":"ZeriW","name":"초강력 레이저","description":"제리가 전기 파동을 발사해 처음 적중하는 적을 둔화시키고 피해를 입힙니다. 파동이 벽에 맞으면 장거리 레이저로 확산됩니다.","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[50,60,70,80,90],"image":{"full":"ZeriW.png","sprite":"spell17.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"50/60/70/80/90","costType":"마나","rankValues":[{"label":"둔화 지속시간","values":"2초"}]}},"R:번개 방출":{"slot":"R","skill":{"id":"ZeriR","name":"번개 방출","description":"제리가 전류를 방출하고 자신을 과충전해, 피해량과 이동 속도가 증가합니다. 제리가 적 챔피언을 맞힐 때마다 이동 속도 증가 효과가 중첩되고 지속시간이 회복됩니다. 과충전된 동안 집중 사격이 더욱 빠른 3연발 사격으로 바뀌며, 대상 주변 적에게 번개가 연쇄적으로 튑니다.","maxrank":3,"cooldown":[80,75,70],"cost":[100,100,100],"image":{"full":"ZeriR.png","sprite":"spell17.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"80/75/70","costBurn":"100/100/100","costType":"마나","rankValues":[]}}},"Zoe":{"E:헤롱헤롱쿨쿨방울":{"slot":"E","skill":{"id":"ZoeE","name":"헤롱헤롱쿨쿨방울","description":"대상을 졸음 상태에 빠지게 한 뒤 잠들게 합니다. 잠든 동안 대상의 마법 저항력이 감소됩니다. 잠든 뒤 처음으로 입는 피해는 두 배로 적용됩니다. (최대치 있음)","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[80,80,80,80,80],"image":{"full":"ZoeE.png","sprite":"spell17.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"80/80/80/80/80","costType":"마나","rankValues":[{"label":"기본 피해량","values":"70 / 110 / 150 / 190 / 230"}]},"icons":[{"file":"patch-notes/icons/a6717b379a71ca21a0adbf78565f8e45.webp","spellId":"ZoeE"}]},"W:주문도둑":{"slot":"W","skill":{"id":"ZoeW","name":"주문도둑","description":"적이 소환사 주문이나 사용 효과가 있는 아이템을 사용하면 주문 파편이 남고, 조이는 그 파편을 주워 해당 주문 및 효과를 사용할 수 있습니다. 또한 조이가 소환사 주문을 사용하면 미사일이 3개 생성되어 가장 가까운 적에게 날아갑니다.","maxrank":5,"cooldown":[0.25],"cost":[0,0,0,0,0],"image":{"full":"ZoeW.png","sprite":"spell17.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"0.25","costBurn":"0/0/0/0/0","costType":"마나","rankValues":[]}}},"Ambessa":{"R:공개 처형":{"slot":"R","skill":{"id":"AmbessaR","name":"공개 처형","description":"암베사가 선택한 일직선상에서 가장 멀리 있는 적 챔피언에게 순간 이동한 후 제압합니다. 이후 해당 적 챔피언을 지면에 내리쳐 피해를 입히고 기절시킵니다.","maxrank":3,"cooldown":[130,115,100],"cost":[0,0,0],"image":{"full":"AmbessaR.png","sprite":"spell1.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"0/0/0","costType":"기력","rankValues":[]}}},"Briar":{},"Ezreal":{"Q:신비한 화살":{"slot":"Q","skill":{"id":"EzrealQ","name":"신비한 화살","description":"이즈리얼이 에너지로 이루어진 화살을 발사합니다. 적 유닛에게 명중하면 모든 스킬의 재사용 대기시간이 약간 감소합니다.","maxrank":5,"cooldown":[5.5,5.25,5,4.75,4.5],"cost":[28,31,34,37,40],"image":{"full":"EzrealQ.png","sprite":"spell3.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"5.5/5.25/5/4.75/4.5","costBurn":"28/31/34/37/40","costType":"마나","rankValues":[{"label":"기본 피해량","values":"20 / 45 / 70 / 95 / 120"}]},"icons":[{"file":"patch-notes/icons/4564965b9799bba407a0b03203c475eb.webp","spellId":"EzrealQ"}]},"W:정수의 흐름":{"slot":"W","skill":{"id":"EzrealW","name":"정수의 흐름","description":"이
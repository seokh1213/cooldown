400 italic\">施放时间受益于永久<span>攻击速度</span> (?% / 100%)。善恶轮对小兵造成(50% ~ 100%[[si:scalelevel]])伤害并且它的周期伤害会处决低生命值的小兵。寂灭掌会获得一个终极技能的各种助益。</span>","tooltipSource":"communitydragon","tooltipDiagnostics":{"unresolvedTokens":["f3.0"]},"cost":[60,60,60,60,60],"costBurn":"60/60/60/60/60","costType":"法力","resource":"法力","range":[1150,1150,1150,1150,1150],"rangeBurn":"1150/1150/1150/1150/1150","image":{"full":"YunaraW.png"},"rankValues":[{"label":"伤害","values":"55/95/135/175/215"},{"label":"每秒伤害","values":"33/57/81/105/129"}],"levelValues":[{"values":[50,50,50,50,50,50,50,50,75,75,75,75,100,100,100,100,100,100,100,100],"digits":0,"percent":true}],"scalings":[{"id":"damage","labelEn":"W Scaling","labelKo":"W 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"1:Calc_Damage_Initial"}]}],"conditions":["per-second"],"simulation":{"status":"complete","primary":{"id":"Calc_Damage_Initial","kind":"damage","damageType":"magical","baseByRank":[55,95,135,175,215],"terms":[{"stat":"bonusAttackDamage","coefficientsByRank":[0.8500000238418579,0.8500000238418579,0.8500000238418579,0.8500000238418579,0.8500000238418579]},{"stat":"abilityPower","coefficientsByRank":[0.5,0.5,0.5,0.5,0.5]}]},"unsupportedPartTypes":[]}}}}}}
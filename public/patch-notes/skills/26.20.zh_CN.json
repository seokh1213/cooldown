":"complete","primary":{"id":"TotalDamage","kind":"damage","damageType":"magical","baseByRank":[70,115,160,205,250],"terms":[{"stat":"abilityPower","coefficientsByRank":[0.6000000238418579,0.6000000238418579,0.6000000238418579,0.6000000238418579,0.6000000238418579]}]},"unsupportedPartTypes":[]}},"icons":[{"file":"patch-notes/icons/a1d8c39c8bdf9e78531fcb9dbface87b.webp","spellId":"SwainW"}]}},"Vayne":{"Q:闪避突袭":{"slot":"Q","skill":{"id":"VayneTumble","name":"闪避突袭","maxrank":5,"cooldown":[6,5,4,3,2],"cooldownBurn":"6/5/4/3/2","description":"薇恩进行翻滚，并小心地填充她的下一发射击。她的下次攻击造成额外伤害。","summary":"薇恩进行翻滚，并小心地填充她的下一发射击。她的下次攻击造成额外伤害。","tooltip":"薇恩翻滚一小段距离，并且她的下次普通攻击造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">(([[si:scalead]]75/85/95/105/115% 攻击力) + ([[si:scaleap]]50% 法术强度))物理伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">这个技能会在造成伤害时触发技能特效。</span>","tooltipSource":"communitydragon","cost":[30,30,30,30,30],"costBurn":"30/30/30/30/30","costType":"法力值","resource":"法力值","range":[300,300,300,300,300],"rangeBurn":"300/300/300/300/300","image":{"full":"VayneTumble.png"},"rankValues":[{"label":"冷却时间","values":"6/5/4/3/2"},{"label":"攻击力收益率","values":"75%/85%/95%/105%/115%"}],"scalings":[{"id":"damage","labelEn":"Q Scaling","labelKo":"Q 계수","parts":[{"stat":null,"coefficient":1,"op":"add","rawRef":"0:ADRatioBonus"}]}],"conditions":[],"simulation":{"status":"unavailable","unsupportedPartTypes":[]}}}}}}
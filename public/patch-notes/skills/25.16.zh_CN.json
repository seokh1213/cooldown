{"schemaVersion":1,"patchVersion":"25.16","sources":{"ddragon":"15.16.1","cdragon":"15.16"},"locale":"zh_CN","champions":{"Brand":{"R:烈焰风暴":{"slot":"R","skill":{"id":"BrandR","name":"烈焰风暴","description":"布兰德释放一颗破坏力极强的火焰之种，火焰之种会在布兰德和附近敌人之间弹跳至多5次，每次弹跳时对敌人造成魔法伤害。弹跳会优先以带有即将满层的【炽热之焰】效果的英雄为目标。如果目标带有【烈焰焚身】效果，那么【R烈焰风暴】将使目标短暂减速。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"BrandR.png","sprite":"spell2.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}},"P:炽热之焰":{"slot":"P","passive":{"name":"炽热之焰","description":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","image":{"full":"BrandP.png","sprite":"passive0.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:火焰烙印":{"slot":"Q","skill":{"id":"BrandQ","name":"火焰烙印","description":"布兰德向前方放出一团可造成魔法伤害的火球。如果目标带有【烈焰焚身】效果，那么【Q火焰烙印】将使目标晕眩@StunDuration@秒。","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[70,70,70,70,70],"image":{"full":"BrandQ.png","sprite":"spell2.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Gnar":{"Q:投掷回力标 / 投掷顽石":{"slot":"Q","skill":{"id":"GnarQ","name":"投掷回力标 / 投掷顽石","description":"纳尔扔出一个回力标，对敌人造成伤害和减速效果，直到开始折返为止。如果纳尔接住了折返的回力标，那么这个技能的冷却时间就会减少。<br><br>巨型纳尔扔出一颗石头，石头会在命中第一个敌人后停下，对这个敌人附近的所有敌方单位造成伤害和减速效果。巨型纳尔可以通过拾取这颗石头来减少这个技能的冷却时间。","maxrank":5,"cooldown":[16,14.5,13,11.5,10],"cost":[0,0,0,0,0],"image":{"full":"GnarQ.png","sprite":"spell4.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"16/14.5/13/11.5/10","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}}},"Lulu":{"E:帮忙，皮克斯！":{"slot":"E","skill":{"id":"LuluE","name":"帮忙，皮克斯！","description":"如果对友军施放，会命令皮克斯跳到一名友军身上进行保护，之后会跟随并协助目标（而不是璐璐）进行攻击。如果对敌人施放，皮克斯会跳到敌人身上造成伤害，之后会跟随并提供目标的视野。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[60,65,70,75,80],"image":{"full":"LuluE.png","sprite":"spell8.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Shaco":{"Q:欺诈魔术":{"slot":"Q","skill":{"id":"Deceive","name":"欺诈魔术","description":"萨科进入隐形状态并传送到目标位置。<br><br>他在隐形状态下的第一次普攻将获得增强，造成额外伤害并在目标背后攻击时必定会暴击。","maxrank":5,"cooldown":[13,12.5,12,11.5,11],"cost":[40,40,40,40,40],"image":{"full":"Deceive.png","sprite":"spell12.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"13/12.5/12/11.5/11","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"P:背刺":{"slot":"P","passive":{"name":"背刺","description":"在目标的背后时，萨科的普攻和【E双面毒刃】会造成额外伤害。","image":{"full":"Jester_CarefulStrikes.png","sprite":"passive3.png","group":"passive","x":432,"y":96,"w":48,"h":48},"rankValues":[]}}},"Trundle":{"W:冰封领域":{"slot":"W","skill":{"id":"trundledesecrate","name":"冰封领域","description":"特朗德尔将目标区域变成他的领土，增加自己在该区域的攻击速度、移动速度，并且会从所有治疗手段中获得额外治疗效果。","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[40,40,40,40,40],"image":{"full":"trundledesecrate.png","sprite":"spell14.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Zyra":{"E:缠绕之根":{"slot":"E","skill":{"id":"ZyraE","name":"缠绕之根","description":"婕拉朝前方放出贯穿地面的藤蔓来诱捕她的目标，藤蔓经过的敌人会受到伤害和束缚效果。如果在一颗种子附近施放，那么【E缠绕之根】就会让种子长成一株藤蔓鞭击者，可进行短程攻击并降低敌人的移动速度。","maxrank":5,"cooldown":[11],"cost":[70,75,80,85,90],"image":{"full":"ZyraE.png","sprite":"spell17.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"11","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}},"R:绞杀之藤":{"slot":"R","skill":{"id":"ZyraR","name":"绞杀之藤","description":"婕拉在目标区域召唤一个扭曲的密林，在蔓延时对区域内的所有敌人造成伤害，并在收缩时击飞区域内的所有敌人。密林内的植物会被进入激怒状态。","maxrank":3,"cooldown":[110,100,90],"cost":[100,100,100],"image":{"full":"ZyraR.png","sprite":"spell17.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"110/100/90","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Illaoi":{"P:古神先知":{"slot":"P","passive":{"name":"古神先知","description":"俄洛伊和她创造的<font color='#669900'>躯壳</font>会在附近的不可穿越的地形上生成触手。触手会挥向灵魂，<font color='#669900'>躯壳</font>，以及俄洛伊的【严酷训诫】的受害者们。触手会在命中敌人时造成物理伤害，如果命中目标是英雄还会治疗俄洛伊。","image":{"full":"Illaoi_P.png","sprite":"passive1.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}}},"JarvanIV":{},"Kalista":{"E:撕裂":{"slot":"E","skill":{"id":"KalistaExpungeWrapper","name":"撕裂","description":"攻击时用长矛来刺穿目标。主动激活可以将长矛扯出，造成减速和逐步上升的伤害。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"KalistaExpungeWrapper.png","sprite":"spell6.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"MasterYi":{"Q:阿尔法突袭":{"slot":"Q","skill":{"id":"AlphaStrike","name":"阿尔法突袭","description":"易以肉眼难以发觉的速度穿梭于战场，对多个敌人造成物理伤害，同时处于不可被选取的状态下。阿尔法突袭可以暴击，并对野怪造成额外物理伤害。普通攻击可以减少阿尔法突袭的冷却时间。","maxrank":5,"cooldown":[20,19.5,19,18.5,18],"cost":[50,55,60,65,70],"image":{"full":"AlphaStrike.png","sprite":"spell8.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"20/19.5/19/18.5/18","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Mordekaiser":{"Q:破灭之锤":{"slot":"Q","skill":{"id":"MordekaiserQ","name":"破灭之锤","description":"莫德凯撒用他的权杖猛砸地面，来对被击中的每个敌人造成伤害。在只命中单个敌人时，伤害会提升。","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[0,0,0,0,0],"image":{"full":"MordekaiserQ.png","sprite":"spell8.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"0/0/0/0/0","costType":"护盾","rankValues":[]}}},"Morgana":{"W:折磨之影":{"slot":"W","skill":{"id":"MorganaW","name":"折磨之影","description":"莫甘娜在一个区域施放一团诅咒之影，对胆敢站在她黑色环形之中的敌人造成伤害。敌人会持续受到魔法伤害，并且生命值越低受到伤害越高。","maxrank":5,"cooldown":[12],"cost":[70,85,100,115,130],"image":{"full":"MorganaW.png","sprite":"spell9.png","group":"spell","x":144,"y":0,"w":48,"h":48},"cooldownBurn":"12","costBurn":"70/85/100/115/130","costType":"法力","rankValues":[]}}},"Nautilus":{"E:暗流涌动":{"slot":"E","skill":{"id":"NautilusSplashZone","name":"暗流涌动","description":"诺提勒斯在他身边生成3道爆炸波纹。每道爆炸波纹都会伤害并减速敌人。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[50,60,70,80,90],"image":{"full":"NautilusSplashZone.png","sprite":"spell9.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"50/60/70/80/90","costType":"法力","rankValues":[]}}},"Nocturne":{"Q:梦魇之径":{"slot":"Q","skill":{"id":"NocturneDuskbringer","name":"梦魇之径","description":"魔腾扔出一把暗影之刃，对敌人造成伤害并留下幽灵影径，并使受到伤害的敌方英雄也留下幽灵影径。在影径上时，魔腾无视任何碰撞体积，并且他的移动速度和攻击力也会得到提高。","maxrank":5,"cooldown":[8],"cost":[60,65,70,75,80],"image":{"full":"NocturneDuskbringer.png","sprite":"spell9.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"8","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Qiyana":{"Q:元素之怒 / 以绪塔尔之锋":{"slot":"Q","skill":{"id":"QiyanaQ","name":"元素之怒 / 以绪塔尔之锋","description":"奇亚娜挥舞她的武器，造成伤害和基于她元素的额外效果。","maxrank":5,"cooldown":[7],"cost":[35,35,35,35,35],"image":{"full":"QiyanaQ.png","sprite":"spell10.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"7","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}},"W:方圆塑令":{"slot":"W","skill":{"id":"QiyanaW","name":"方圆塑令","description":"奇亚娜突进到一个位置并用一种元素为她的武器附魔。当武器有附魔时，她的攻击和技能会造成额外伤害。","maxrank":5,"cooldown":[7],"cost":[25,30,35,40,45],"image":{"full":"QiyanaW.png","sprite":"spell10.png","group":"spell","x":336,"y":96,"w":48,"h":48},"cooldownBurn":"7","costBurn":"25/30/35/40/45","costType":"法力","rankValues":[]}}},"RekSai":{},"Rell":{"W:驭铁术：轰落":{"slot":"W","skill":{"id":"RellW_Dismount","name":"驭铁术：轰落","description":"骑乘状态：芮尔化马为甲，以披甲状态向下轰落，击飞敌人们并获得高额护盾值。在披甲状态下，她获得护甲、魔法抗性、攻击速度和攻击距离，但移动速度缓慢。<br><br>披甲状态：芮尔化甲为马，提供爆发性的移动速度并且她的下一次攻击会对敌人造成击飞效果。<br><br>","maxrank":5,"cooldown":[10],"cost":[40,40,40,40,40],"image":{"full":"RellW_Dismount.png","sprite":"spell11.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"10","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Rumble":{"Q:纵火盛宴":{"slot":"Q","skill":{"id":"RumbleFlameThrower","name":"纵火盛宴","description":"兰博朝敌人放火，每秒对前方锥形范围内的敌人造成伤害，持续3秒。在危险温度时，兰博增加对其造成的伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"RumbleFlameThrower.png","sprite":"spell11.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"热量","rankValues":[]}},"R:恒温灼烧":{"slot":"R","skill":{"id":"RumbleCarpetBomb","name":"恒温灼烧","description":"兰博朝目标区域发射火箭，形成一堵火焰之墙，对范围内的敌人造成伤害并减速。","maxrank":3,"cooldown":[130,105,80],"cost":[0,0,0],"image":{"full":"RumbleCarpetBomb.png","sprite":"spell11.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"130/105/80","costBurn":"0/0/0","costType":"热量","rankValues":[]}}},"Singed":{"Q:剧毒踪迹":{"slot":"Q","skill":{"id":"PoisonTrail","name":"剧毒踪迹","description":"辛吉德在身后留下剧毒踪迹，对经过上面的敌人造成持续伤害。","maxrank":5,"cooldown":[0],"cost":[13,13,13,13,13],"image":{"full":"PoisonTrail.png","sprite":"spell12.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"0","costBurn":"13/13/13/13/13","costType":"法力","rankValues":[]}}},"Sion":{"P:死亡荣耀":{"slot":"P","passive":{"name":"死亡荣耀","description":"在被击杀后，赛恩会回光返照一段时间并且生命值会快速衰减。在此期间，他的攻击会变得超快，获得生命偷取，并且每次攻击会额外造成基于目标最大生命值的额外伤害。","image":{"full":"Sion_Passive1.png","sprite":"passive4.png","group":"passive","x":144,"y":0,"w":48,"h":48},"rankValues":[]}},"E:杀手怒吼":{"slot":"E","skill":{"id":"SionE","name":"杀手怒吼","description":"赛恩发射一个短程冲击波，来对命中的第一个敌人造成伤害、减速效果和破甲效果。如果冲击波命中的是小兵或者野怪，那么目标敌方单位还会被击退，对沿途的所有敌方单位造成伤害、减速和护甲击碎效果。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[35,40,45,50,55],"image":{"full":"SionE.png","sprite":"spell12.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"35/40/45/50/55","costType":"法力","rankValues":[]}},"R:蛮横冲撞":{"slot":"R","skill":{"id":"SionR","name":"蛮横冲撞","description":"赛恩朝着一个方向冲锋，持续提升移动速度。他可以朝着鼠标悬停处进行微小的转向。当他与一名敌人产生碰撞时，他会基于敌人们与碰撞点之间的距离造成伤害和击飞效果。","maxrank":3,"cooldown":[140,100,60],"cost":[100,100,100],"image":{"full":"SionR.png","sprite":"spell12.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"140/100/60","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Sylas":{"P:破敌禁法":{"slot":"P","passive":{"name":"破敌禁法","description":"在施放一次技能后，塞拉斯会储存一层【破敌禁法】效果。塞拉斯的普攻将消耗一层效果并环绕自身挥舞他的盈能锁链来对命中的敌人造成额外魔法伤害。当塞拉斯拥有一层【破敌禁法】效果时，他会获得攻击速度。 ","image":{"full":"SylasP.png","sprite":"passive4.png","group":"passive","x":0,"y":48,"w":48,"h":48},"rankValues":[]}}},"Varus":{"Q:穿刺之箭":{"slot":"Q","skill":{"id":"VarusQ","name":"穿刺之箭","description":"韦鲁斯开始蓄力，随后进行一次远距离的强力射击，蓄力时间越长，伤害越高。","maxrank":5,"cooldown":[16,15,14,13,12],"cost":[50,55,60,65,70],"image":{"full":"VarusQ.png","sprite":"spell14.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"16/15/14/13/12","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"W:枯萎箭袋":{"slot":"W","skill":{"id":"VarusW","name":"枯萎箭袋","description":"被动：韦鲁斯的普通攻击会造成额外的伤害，并附加枯萎效果。韦鲁斯的其它技能会引爆枯萎效果，造成基于目标最大生命值的魔法伤害。主动：韦鲁斯增强他的下一个【穿刺之箭】。","maxrank":5,"cooldown":[40],"cost":[0,0,0,0,0],"image":{"full":"VarusW.png","sprite":"spell14.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"40","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}},"E:恶灵箭雨":{"slot":"E","skill":{"id":"VarusE","name":"恶灵箭雨","description":"韦鲁斯射出一阵箭雨，造成物理伤害并污染地面。被污染的地面将会减慢敌人的移动速度，并降低他们的自我治疗效果和回复效果。","maxrank":5,"cooldown":[18,16,14,12,10],"cost":[90,90,90,90,90],"image":{"full":"VarusE.png","sprite":"spell15.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"18/16/14/12/10","costBurn":"90/90/90/90/90","costType":"法力","rankValues":[]}}},"Viego":{"Q:破败王剑":{"slot":"Q","skill":{"id":"ViegoQ","name":"破败王剑","description":"佛耶戈的鬼魅之刃会在被动地在命中时造成额外的百分比当前生命值伤害<OnHit>攻击特效</OnHit>，并对近期被他用一个技能袭击过的敌人进行两次打击，同时窃取生命值。<br><br>佛耶戈可以激活这个技能来向前刺出他的双手巨剑，穿刺他前方的所有敌人们。","maxrank":5,"cooldown":[5,4.5,4,3.5,3],"cost":[0,0,0,0,0],"image":{"full":"ViegoQ.png","sprite":"spell15.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"5/4.5/4/3.5/3","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}}},"Warwick":{"P:血之饥渴":{"slot":"P","passive":{"name":"血之饥渴","description":"沃里克的普攻造成额外魔法伤害。如果沃里克的生命值低于50%，那么他会获得等额的治疗效果。如果他的生命值低于25%，则治疗效果提升至三倍。","image":{"full":"WarwickP.png","sprite":"passive5.png","group":"passive","x":240,"y":0,"w":48,"h":48},"rankValues":[]}}},"XinZhao":{"Q:三重爪击":{"slot":"Q","skill":{"id":"XinZhaoQ","name":"三重爪击","description":"赵信的下3次普攻将造成额外伤害并且第三次攻击将击飞目标。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[30,30,30,30,30],"image":{"full":"XinZhaoQ.png","sprite":"spell16.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Yuumi":{"Q:摸鱼飞弹":{"slot":"Q","skill":{"id":"YuumiQ","name":"摸鱼飞弹","description":"悠米发射一道飞弹，对命中的首个单位造成伤害和减速效果。如果它在到达目标之前至少飞行了1.35秒，那么还会造成额外伤害和强化减速效果。在附身于她的挚友身上时，将总造成强化减速效果并且为她的挚友提供额外附加伤害。<br><br>在附身状态时，飞弹可以通过你的指针来控制。","maxrank":6,"cooldown":[6.5],"cost":[50,55,60,65,70,75],"image":{"full":"YuumiQ.png","sprite":"spell16.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"6.5","costBurn":"50/55/60/65/70/75","costType":"法力","rankValues":[]}},"W:悠米出动！":{"slot":"W","skill":{"id":"YuumiW","name":"悠米出动！","description":"悠米突进到一名目标友方英雄处，变得不可被选取（防御塔除外）。在附身于她的挚友身上时，她会获得治疗与护盾强度并为她的这名友军提供附加治疗效果。","maxrank":5,"cooldown":[0],"cost":[0,0,0,0,0],"image":{"full":"YuumiW.png","sprite":"spell16.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"0","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}}}}
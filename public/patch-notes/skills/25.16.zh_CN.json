{"schemaVersion":1,"patchVersion":"25.16","sources":{"ddragon":"15.16.1","cdragon":"15.16"},"locale":"zh_CN","champions":{"Brand":{"R:烈焰风暴":{"slot":"R","skill":{"id":"BrandR","name":"烈焰风暴","description":"布兰德释放一颗破坏力极强的火焰之种，火焰之种会在布兰德和附近敌人之间弹跳至多5次，每次弹跳时对敌人造成魔法伤害。弹跳会优先以带有即将满层的【炽热之焰】效果的英雄为目标。如果目标带有【烈焰焚身】效果，那么【R烈焰风暴】将使目标短暂减速。","maxrank":3,"cooldown":[100,90,80],"cost":[100,100,100],"image":{"full":"BrandR.png","sprite":"spell2.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Gnar":{"Q:投掷回力标 / 投掷顽石":{"slot":"Q","skill":{"id":"GnarQ","name":"投掷回力标 / 投掷顽石","description":"纳尔扔出一个回力标，对敌人造成伤害和减速效果，直到开始折返为止。如果纳尔接住了折返的回力标，那么这个技能的冷却时间就会减少。<br><br>巨型纳尔扔出一颗石头，石头会在命中第一个敌人后停下，对这个敌人附近的所有敌方单位造成伤害和减速效果。巨型纳尔可以通过拾取这颗石头来减少这个技能的冷却时间。","maxrank":5,"cooldown":[16,14.5,13,11.5,10],"cost":[0,0,0,0,0],"image":{"full":"GnarQ.png","sprite":"spell4.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"16/14.5/13/11.5/10","costBurn":"0/0/0/0/0","costType":"怒气","rankValues":[]}}},"Lulu":{"E:帮忙，皮克斯！":{"slot":"E","skill":{"id":"LuluE","name":"帮忙，皮克斯！","description":"如果对友军施放，会命令皮克斯跳到一名友军身上进行保护，之后会跟随并协助目标（而不是璐璐）进行攻击。如果对敌人施放，皮克斯会跳到敌人身上造成伤害，之后会跟随并提供目标的视野。","maxrank":5,"cooldown":[10,9.5,9,8.5,8],"cost":[60,65,70,75,80],"image":{"full":"LuluE.png","sprite":"spell8.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"10/9.5/9/8.5/8","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}}},"Shaco":{"Q:欺诈魔术":{"slot":"Q","skill":{"id":"Deceive","name":"欺诈魔术","description":"萨科进入隐形状态并传送到目标位置。<br><br>他在隐形状态下的第一次普攻将获得增强，造成额外伤害并在目标背后攻击时必定会暴击。","maxrank":5,"cooldown":[13,12.5,12,11.5,11],"cost":[40,40,40,40,40],"image":{"full":"Deceive.png","sprite":"spell12.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"13/12.5/12/11.5/11","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Trundle":{"W:冰封领域":{"slot":"W","skill":{"id":"trundledesecrate","name":"冰封领域","description":"特朗德尔将目标区域变成他的领土，增加自己在该区域的攻击速度、移动速度，并且会从所有治疗手段中获得额外治疗效果。","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[40,40,40,40,40],"image":{"full":"trundledesecrate.png","sprite":"spell14.png","group":"spell","x":240,"y":48,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Zyra":{"E:缠绕之根":{"slot":"E","skill":{"id":"ZyraE","name":"缠绕之根","description":"婕拉朝前方放出贯穿地面的藤蔓来诱捕她的目标，藤蔓经过的敌人会受到伤害和束缚效果。如果在一颗种子附近施放，那么【E缠绕之根】就会让种子长成一株藤蔓鞭击者，可进行短程攻击并降低敌人的移动速度。","maxrank":5,"cooldown":[11],"cost":[70,75,80,85,90],"image":{"full":"ZyraE.png","sprite":"spell17.png","group":"spell","x":0,"y":96,"w":48,"h":48},"cooldownBurn":"11","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}}}}}
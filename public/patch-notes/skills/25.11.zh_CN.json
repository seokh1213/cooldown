{"schemaVersion":1,"patchVersion":"25.11","sources":{"ddragon":"15.11.1","cdragon":"15.11"},"locale":"zh_CN","champions":{"Garen":{"W:勇气":{"slot":"W","skill":{"id":"GarenW","name":"勇气","description":"盖伦被动地通过击杀敌人来提升护甲和魔法抗性。他也可以激活这个技能来暂时获得一层护盾和韧性，并在接下来的较长持续时间里获得较弱的伤害减免效果。","maxrank":5,"cooldown":[22,19.5,17,14.5,12],"cost":[0,0,0,0,0],"image":{"full":"GarenW.png","sprite":"spell4.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"22/19.5/17/14.5/12","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}},"E:审判":{"slot":"E","skill":{"id":"GarenE","name":"审判","description":"盖伦快速地旋转身体挥舞大剑，并对邻近敌人造成物理伤害。","maxrank":5,"cooldown":[9,8.25,7.5,6.75,6],"cost":[0,0,0,0,0],"image":{"full":"GarenE.png","sprite":"spell4.png","group":"spell","x":96,"y":48,"w":48,"h":48},"cooldownBurn":"9/8.25/7.5/6.75/6","costBurn":"0/0/0/0/0","costType":"无","rankValues":[]}},"R:德玛西亚正义":{"slot":"R","skill":{"id":"GarenR","name":"德玛西亚正义","description":"盖伦召唤德玛西亚之力，试图处决一名敌方英雄。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"GarenR.png","sprite":"spell4.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"无","rankValues":[]}}},"Lucian":{"E:冷酷追击":{"slot":"E","skill":{"id":"LucianE","name":"冷酷追击","description":"卢锡安冲刺一小段距离。【圣光银弹】的攻击会减少【冷酷追击】的冷却时间。","maxrank":5,"cooldown":[18,17,16,15,14],"cost":[40,30,20,10,0],"image":{"full":"LucianE.png","sprite":"spell7.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"18/17/16/15/14","costBurn":"40/30/20/10/0","costType":"法力","rankValues":[]}}},"Rengar":{"R:狩猎律动":{"slot":"R","skill":{"id":"RengarR","name":"狩猎律动","description":"雷恩加尔激活他的掠食者本能，<font color='#cd90ee'>伪装</font>自身并感知附近极大范围内的距他最近的敌方英雄。在狩猎律动期间，他会获得移动速度加成，他的下次攻击将使他即使不在草丛内也可以进行跳跃，并且会减少目标的护甲。","maxrank":3,"cooldown":[100,90,80],"cost":[0,0,0],"image":{"full":"RengarR.png","sprite":"spell11.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"100/90/80","costBurn":"0/0/0","costType":"残暴","rankValues":[]}}},"Aatrox":{"P:赐死剑气":{"slot":"P","passive":{"name":"赐死剑气","description":"每过一段时间，亚托克斯的下次普攻会造成额外<physicalDamage>物理伤害</physicalDamage>，并治疗亚托克斯，治疗量基于目标的最大生命值。","image":{"full":"Aatrox_Passive.png","sprite":"passive0.png","group":"passive","x":0,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:暗裔利刃":{"slot":"Q","skill":{"id":"AatroxQ","name":"暗裔利刃","description":"亚托克斯向下猛砸他的巨剑，并造成物理伤害。他可以挥击三次，每次都有一个不同的范围效果。","maxrank":5,"cooldown":[14,12,10,8,6],"cost":[0,0,0,0,0],"image":{"full":"AatroxQ.png","sprite":"spell0.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"14/12/10/8/6","costBurn":"0/0/0/0/0","costType":"鲜血魔井","rankValues":[]}},"W:恶火束链":{"slot":"W","skill":{"id":"AatroxW","name":"恶火束链","description":"亚托克斯猛砸地面，对命中的第一个敌人造成伤害。英雄和大型野怪需要快速离开被影响的区域，否则就会被拖拽到中心并再次受到伤害。","maxrank":5,"cooldown":[20,18,16,14,12],"cost":[0,0,0,0,0],"image":{"full":"AatroxW.png","sprite":"spell0.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"20/18/16/14/12","costBurn":"0/0/0/0/0","costType":"鲜血魔井","rankValues":[]}}},"Annie":{"W:焚烧":{"slot":"W","skill":{"id":"AnnieW","name":"焚烧","description":"安妮向锥形区域施放一道烈焰，对区域内的所有敌人造成伤害。","maxrank":5,"cooldown":[7],"cost":[70,75,80,85,90],"image":{"full":"AnnieW.png","sprite":"spell1.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}}},"Ashe":{"Q:射手的专注":{"slot":"Q","skill":{"id":"AsheQ","name":"射手的专注","description":"艾希会在攻击时聚集【全神贯注】效果。在【全神贯注】到达最大值时，艾希就能施放【射手的专注】来消耗掉所有【全神贯注】效果，以临时提升她的攻击速度，并在持续期间将她的普攻转变为一阵强力的飓风箭阵。","maxrank":5,"cooldown":[0],"cost":[30,30,30,30,30],"image":{"full":"AsheQ.png","sprite":"spell1.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"0","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Chogath":{},"Diana":{"P:月银之刃":{"slot":"P","passive":{"name":"月银之刃","description":"每第三次攻击就会溅射周围的敌人，造成额外的魔法伤害。在施放一个技能后，黛安娜获得持续5秒的攻击速度。","image":{"full":"Diana_Passive_LunarBlade.png","sprite":"passive0.png","group":"passive","x":288,"y":96,"w":48,"h":48},"rankValues":[]}}},"Elise":{"P:蜘蛛女皇":{"slot":"P","passive":{"name":"蜘蛛女皇","description":"人类形态：每当伊莉丝的技能命中一名敌人时，就会有一只小蜘蛛准备就绪。<br><br>蜘蛛形态：普攻造成额外魔法伤害并回复自身生命值。","image":{"full":"ElisePassive.png","sprite":"passive1.png","group":"passive","x":0,"y":0,"w":48,"h":48},"rankValues":[]}}},"Kassadin":{"E:能量脉冲":{"slot":"E","skill":{"id":"ForcePulse","name":"能量脉冲","description":"附近有单位施放法术技能时，卡萨丁将吸收能量，当充能完毕后，吸收的能量可转化为脉冲，对面前锥形区域内敌人造成伤害并减速。","maxrank":5,"cooldown":[21,20,19,18,17],"cost":[60,65,70,75,80],"image":{"full":"ForcePulse.png","sprite":"spell6.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"21/20/19/18/17","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"R:虚空行走":{"slot":"R","skill":{"id":"RiftWalk","name":"虚空行走","description":"卡萨丁传送到附近区域，对区域内的敌方单位造成伤害。 在一段时间内连续施放虚空行走技能会消耗更多的法力值，但也会造成额外伤害。","maxrank":3,"cooldown":[5,3.5,2],"cost":[40,40,40],"image":{"full":"RiftWalk.png","sprite":"spell6.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"5/3.5/2","costBurn":"40/40/40","costType":"法力","rankValues":[]}}},"Ryze":{"W:符文禁锢":{"slot":"W","skill":{"id":"RyzeW","name":"符文禁锢","description":"瑞兹将一个目标陷入一个符文牢笼中，来对其造成伤害和减速效果。如果目标身上带有【涌动】效果，那么减速效果会替换为禁锢效果。","maxrank":5,"cooldown":[11,10.5,10,9.5,9],"cost":[40,55,70,85,100],"image":{"full":"RyzeW.png","sprite":"spell11.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"11/10.5/10/9.5/9","costBurn":"40/55/70/85/100","costType":"法力","rankValues":[]}},"R:曲境折跃":{"slot":"R","skill":{"id":"RyzeR","name":"曲境折跃","description":"被动部分：【超负荷】对带有【涌动】效果的目标造成更多伤害。<br><br>施放时，瑞兹会创造一个传送门来通向一个附近的位置。在若干秒后，站在传送门附近的友军会被传送至目标位置。","maxrank":3,"cooldown":[180,160,140],"cost":[100,100,100],"image":{"full":"RyzeR.png","sprite":"spell11.png","group":"spell","x":144,"y":144,"w":48,"h":48},"cooldownBurn":"180/160/140","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Sivir":{"W:弹射":{"slot":"W","skill":{"id":"SivirW","name":"弹射","description":"希维尔的下几次普通攻击
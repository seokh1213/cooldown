{"schemaVersion":1,"patchVersion":"25.20","sources":{"ddragon":"15.20.1","cdragon":"15.20"},"locale":"ko_KR","champions":{"Anivia":{"Q:냉기 폭발":{"slot":"Q","skill":{"id":"FlashFrost","name":"냉기 폭발","description":"애니비아가 날개를 모아 얼음 구체를 소환한 뒤 발사하여 명중 당한 적들을 추위에 떨게 하고 피해를 입힙니다. 폭발 시 일정 반경 안에 있는 적에게 피해를 입히고 기절시킵니다.","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[80,85,90,95,100],"image":{"full":"FlashFrost.png","sprite":"spell1.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"80/85/90/95/100","costType":"마나","rankValues":[]}},"E:동상":{"slot":"E","skill":{"id":"Frostbite","name":"동상","description":"애니비아가 날개를 퍼덕이며 적에게 얼음 바람을 일으켜 피해를 입힙니다. 최근 냉기 폭발이나 최대 크기에 도달한 얼음 폭풍에 적중당한 대상이 입는 피해는 2배로 증가합니다.","maxrank":5,"cooldown":[4],"cost":[50,50,50,50,50],"image":{"full":"Frostbite.png","sprite":"spell1.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"4","costBurn":"50/50/50/50/50","costType":"마나","rankValues":[]}}},"Camille":{"W:전술적 휩쓸기":{"slot":"W","skill":{"id":"CamilleW","name":"전술적 휩쓸기","description":"카밀이 잠시 후 전방을 원뿔형으로 휩쓸어 피해를 입힙니다. 원뿔의 바깥쪽 절반에 있는 적은 이동 속도가 느려지고 추가 피해를 입으며, 카밀의 체력을 회복시킵니다.","maxrank":5,"cooldown":[15,14,13,12,11],"cost":[50,55,60,65,70],"image":{"full":"CamilleW.png","sprite":"spell2.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"15/14/13/12/11","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[]}}},"MonkeyKing":{"W:분신 전사":{"slot":"W","skill":{"id":"MonkeyKingDecoy","name":"분신 전사","description":"오공이 잠깐 동안 <font color='#91d7ee'>투명</font> 상태가 되고 지정한 방향으로 돌진하며 근처 적을 공격하는 분신을 남깁니다.","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[60,55,50,45,40],"image":{"full":"MonkeyKingDecoy.png","sprite":"spell8.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"60/55/50/45/40","costType":"마나","rankValues":[]}},"Q:파쇄격":{"slot":"Q","skill":{"id":"MonkeyKingDoubleAttack","name":"파쇄격","description":"오공의 다음 공격 사거리가 증가하고 추가 피해를 입히며 맞은 대상의 방어력이 몇 초 동안 낮아집니다.","maxrank":5,"cooldown":[8,7.5,7,6.5,6],"cost":[20,20,20,20,20],"image":{"full":"MonkeyKingDoubleAttack.png","sprite":"spell8.png","group":"spell","x":192,"y":144,"w":48,"h":48},"cooldownBurn":"8/7.5/7/6.5/6","costBurn":"20/20/20/20/20","costType":"마나","rankValues":[]}},"E:근두운 급습":{"slot":"E","skill":{"id":"MonkeyKingNimbus","name":"근두운 급습","description":"오공이 대상에게 돌격하는 동시에 자신의 분신을 만들어 대상 근처에 있는 적들에게 추가 공격을 하여 피해를 줍니다.","maxrank":5,"cooldown":[10,9.25,8.5,7.75,7],"cost":[30,35,40,45,50],"image":{"full":"MonkeyKingNimbus.png","sprite":"spell8.png","group":"spell","x":288,"y":144,"w":48,"h":48},"cooldownBurn":"10/9.25/8.5/7.75/7","costBurn":"30/35/40/45/50","costType":"마나","rankValues":[]}}},"Azir":{"W:일어나라!":{"slot":"W","skill":{"id":"AzirW","name":"일어나라!","description":"아지르가 모래 병사를 소환하여 근처에 있는 대상을 공격합니다. 아지르의 기본 공격은 모래 병사의 공격 범위 내에 있는 대상에게 가해집니다. 아지르와 모래 병사의 공격은 일직선 상의 적들에게 마법 피해를 입힙니다.","maxrank":5,"cooldown":[1.5],"cost":[40,35,30,25,20],"image":{"full":"AzirW.png","sprite":"spell1.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"1.5","costBurn":"40/35/30/25/20","costType":"마나","rankValues":[]}},"E:신기루":{"slot":"E","skill":{"id":"AzirEWrapper","name":"신기루","description":"아지르에게 잠시 보호막이 생성되고 아지르가 모래 병사 중 하나에게 질주하여 적에게 피해를 입힙니다. 적 챔피언에게 부딪친 경우에는 배치 가능한 새로운 모래 병사를 즉시 준비하고 질주를 멈춥니다.","maxrank":5,"cooldown":[22,20.5,19,17.5,16],"cost":[60,60,60,60,60],"image":{"full":"AzirEWrapper.png","sprite":"spell1.png","group":"spell","x":96,"y":144,"w":48,"h":48},"cooldownBurn":"22/20.5/19/17.5/16","costBurn":"60/60/60/60/60","costType":"마나","rankValues":[]}}},"Briar":{"P:진홍빛 저주":{"slot":"P","passive":{"name":"진홍빛 저주","description":"브라이어는 기본 공격과 스킬로 중첩 가능한 출혈 효과를 적용하며, 출혈 피해의 일정 비율만큼 체력을 회복합니다. 늘 허기진 브라이어는 잃은 체력에 비례해 체력 회복량이 증가하는 대신 기본 체력 재생이 없습니다.","image":{"full":"BriarP.png","sprite":"passive0.png","group":"passive","x":432,"y":48,"w":48,"h":48},"rankValues":[]}}},"Fizz":{"W:심해석 삼지창":{"slot":"W","skill":{"id":"FizzW","name":"심해석 삼지창","description":"피즈가 적을 공격하면 출
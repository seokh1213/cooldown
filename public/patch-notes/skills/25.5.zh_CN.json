{"schemaVersion":1,"patchVersion":"25.5","sources":{"ddragon":"15.5.1","cdragon":"15.5"},"locale":"zh_CN","champions":{"Skarner":{"E:以绪塔尔冲击":{"slot":"E","skill":{"id":"SkarnerE","name":"以绪塔尔冲击","description":"斯卡纳向前冲锋并穿过地形。如果他撞击到一个英雄或大型野怪，则可将其猛推到他命中的下一个墙体上，造成伤害和晕眩效果。","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[50,55,60,65,70],"image":{"full":"SkarnerE.png","sprite":"spell13.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}},"Q:撼地 / 擎天":{"slot":"Q","skill":{"id":"SkarnerQ","name":"撼地 / 擎天","description":"斯卡纳从地面掘出一块巨石来强化他的普攻，这块巨石可作为飞弹投掷。","maxrank":5,"cooldown":[13,11.5,10,8.5,7],"cost":[45,45,45,45,45],"image":{"full":"SkarnerQ.png","sprite":"spell12.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"13/11.5/10/8.5/7","costBurn":"45/45/45/45/45","costType":"法力","rankValues":[]}}},"Ambessa":{"E:血戮":{"slot":"E","skill":{"id":"AmbessaE","name":"血戮","description":"安蓓萨环绕自身挥舞链刃，对附近的敌人们造成伤害和减速。若在施放该技能后使用【龙犬诡步】，则会在冲刺结束时进行第二次打击。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[70,70,70,70,70],"image":{"full":"AmbessaE.png","sprite":"spell1.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"13/12/11/10/9","costBurn":"70/70/70/70/70","costType":"能量","rankValues":[]}}},"Aphelios":{},"Ashe":{"R:魔法水晶箭":{"slot":"R","skill":{"id":"EnchantedCrystalArrow","name":"魔法水晶箭","description":"艾希射出一支沿直线飞行的魔法水晶箭。如果水晶箭命中了一名敌方英雄，那么它会对该英雄造成伤害和晕眩效果，晕眩时长取决于水晶箭的飞行距离。此外，该英雄附近的敌方单位会受到伤害和减速效果。","maxrank":3,"cooldown":[100,80,60],"cost":[100,100,100],"image":{"full":"EnchantedCrystalArrow.png","sprite":"spell1.png","group":"spell","x":48,"y":96,"w":48,"h":48},"cooldownBurn":"100/80/60","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Aurora":{"E:怪奇喷涌":{"slot":"E","skill":{"id":"AuroraE","name":"怪奇喷涌","description":"阿萝拉打开界域之窗，施放出一道灵魂魔法洪流，让双界汇聚，放出一道灵物魔法震波，对敌人造成伤害和减速，然后阿萝拉也会向后跳到安全处。","maxrank":5,"cooldown":[15,14,13,12,11],"cost":[80,80,80,80,80],"image":{"full":"AuroraE.pn
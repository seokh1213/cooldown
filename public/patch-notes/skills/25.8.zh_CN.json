{"schemaVersion":1,"patchVersion":"25.8","sources":{"ddragon":"15.8.1","cdragon":"15.8"},"locale":"zh_CN","champions":{"Ahri":{"W:妖异狐火":{"slot":"W","skill":{"id":"AhriW","name":"妖异狐火","description":"阿狸获得短暂的爆发性移动速度加成，并放出三团狐火，锁定附近的敌人进行攻击。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[30,30,30,30,30],"image":{"full":"AhriW.png","sprite":"spell0.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}},"E:魅惑妖术":{"slot":"E","skill":{"id":"AhriE","name":"魅惑妖术","description":"阿狸献出红唇热吻，对命中的第一个敌人造成伤害并将目标魅惑，并且立刻终止目标的移动技能并使目标无恶意地走向她。","maxrank":5,"cooldown":[12],"cost":[60,60,60,60,60],"image":{"full":"AhriE.png","sprite":"spell0.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}}},"Annie":{"W:焚烧":{"slot":"W","skill":{"id":"AnnieW","name":"焚烧","description":"安妮向锥形区域施放一道烈焰，对区域内的所有敌人造成伤害。","maxrank":5,"cooldown":[7],"cost":[90,95,100,105,110],"image":{"full":"AnnieW.png","sprite":"spell1.png","group":"spell","x":48,"y":48,"w":48,"h":48},"cooldownBurn":"7","costBurn":"90/95/100/105/110","costType":"法力","rankValues":[]}},"Q:碎裂之火":{"slot":"Q","skill":{"id":"AnnieQ","name":"碎裂之火","description":"安妮向目标投出注入了法力值的火球，对目标造成魔法伤害。如果目标死于碎裂之火，则碎裂之火消耗的法力值会返还给安妮，且碎裂之火的冷却时间减半。","maxrank":5,"cooldown":[4],"cost":[60,65,70,75,80],"image":{"full":"AnnieQ.png","sprite":"spell1.png","group":"spell","x":0,"y":48,"w":48,"h":48},"cooldownBurn":"4","costBurn":"60/65/70/75/80","costType":"法力","rankValues":[]}},"R:提伯斯之怒":{"slot":"R","skill":{"id":"AnnieR","name":"提伯斯之怒","description":"安妮召唤地狱火泰迪：提伯斯为其作战，对目标区域造成伤害，提伯斯也会攻击和烧伤站在它周围的敌人。","maxrank":3,"cooldown":[130,115,100],"cost":[100,100,100],"image":{"full":"AnnieR.png","sprite":"spell1.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"130/115/100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Naafiri":{"E:剔骨本能":{"slot":"E","skill":{"id":"NaafiriE","name":"剔骨本能","description":"纳亚菲利冲刺并伤害她附近一个区域内的敌人们，唤回她的狗群并完全回复它们的生命值。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[35,35,35,35,35],"image":{"full":"NaafiriE.png","sprite":"spell9.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}}},"Shen":{"W:奥义！魂佑":{"slot":"W","skill":{"id":"ShenW","name":"奥义！魂佑","description":"当慎或友方英雄在魂刃附近时，魂刃会对原本要命中他们的攻击进行格挡。","maxrank":5,"cooldown":[16,14.5,13,11.5,10],"cost":[40,40,40,40,40],"image":{"full":"ShenW.png","sprite":"spell12.png","group":"spell","x":432,"y":48,"w":48,"h":48},"cooldownBurn":"16/14.5/13/11.5/10","costBurn":"40/40/40/40/40","costType":"能量","rankValues":[]}},"Q:奥义！暮临":{"slot":"Q","skill":{"id":"ShenQ","name":"奥义！暮临","description":"慎召回他的魂刃并用它进行攻击，造成基于目标最大生命值的额外伤害。如果魂刃在召回途中与一个敌方英雄产生了碰撞，那么慎的魂刃攻击会获得极大强化，并且所有被碰撞的敌人在逃离慎的时候都会被减速。","maxrank":5,"cooldown":[8,7.25,6.5,5.75,5],"cost":[140,130,120,110,100],"image":{"full":"ShenQ.png","sprite":"spell12.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"8/7.25/6.5/5.75/5","costBurn":"140/130/120/110/100","costType":"能量","rankValues":[]}}},"Blitzcrank":{"P:法力屏障":{"slot":"P","passive":{"name":"法力屏障","description":"布里茨在血量过低时会获得一层基于它法力值的护盾。","image":{"full":"Blitzcrank_ManaBarrier.png","sprite":"passive0.png","group":"passive","x":288,"y":48,"w":48,"h":48},"rankValues":[]}},"Q:机械飞爪":{"slot":"Q","skill":{"id":"RocketGrab","name":"机械飞爪","description":"布里茨发射它的右手，来抓取碰到的第一个敌人，在对敌人造成伤害的同时，还会将这名敌人拉到它的面前。","maxrank":5,"cooldown":[20,19,18,17,16],"cost":[100,100,100,100,100],"image":{"full":"RocketGrab.png","sprite":"spell2.png","group":"spell","x":96,"y":0,"w":48,"h":48},"cooldownBurn":"20/19/18/17/16","costBurn":"100/100/100/100/100","costType":"法力","rankValues":[]}}},"Brand":{"P:炽热之焰":{"slot":"P","passive":{"name":"炽热之焰","description":"布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。","image":{"full":"BrandP.png","sprite":"passive0.png","group":"passive","x":336,"y":48,"w":48,"h":48},"rankValues":[]}}},"Gwen":{"E:断续疾走":{"slot":"E","skill":{"id":"GwenE","name":"断续疾走","description":"格温冲刺一小段距离然后获得攻击速度、攻击距离和魔法伤害<OnHit>攻击特效</OnHit>，持续若干秒。如果她在此期间命中了一个敌人，那么这个技能的冷却时间会获得部分返还。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[35,35,35,35,35],"image":{"full":"GwenE.png","sprite":"spell4.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"35/35/35/35/35","costType":"法力","rankValues":[]}}},"Hwei":{"P:落款":{"slot":"P","passive":{"name":"落款","description":"彗准备在那些受到他的技能伤害的敌人们身上留下落款。<br><br>用另一个伤害型技能命中时，即可完成他的落款，将其留在敌人脚下。落款会在短暂延迟后引爆，对范围内的所有敌人造成魔法伤害。","image":{"full":"HweiPassive.png","sprite":"passive1.png","group":"passive","x":240,"y":48,"w":48,"h":48},"rankValues":[]}},"R:焚心绚华绘":{"slot":"R","skill":{"id":"HweiR","name":"焚心绚华绘","description":"彗画出深重的绝望。命中的第一个敌人会成为画卷的中心。画卷向四周展开，减速并伤害附近的敌人们。展开至最大时，或是中心的敌人死亡时，画卷会发生爆炸。","maxrank":3,"cooldown":[140,115,80],"cost":[100,100,100],"image":{"full":"HweiR.png","sprite":"spell5.png","group":"spell","x":48,"y":0,"w":48,"h":48},"cooldownBurn":"140/115/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Lulu":{},"Mel":{"P:炙灼耀輝（被動）":{"slot":"P","passive":{"name":"炙灼耀輝（被動）","description":"每当梅尔使用技能，她的下一次攻击将额外附带3枚弹体（最多9枚）。<br><br>当梅尔通过一次技能或攻击造成伤害时，她会施加【夺命残影】——一种可以无限叠加的效果。如果目标身上叠加了足够的夺命残影伤害量，则会在下一次被梅尔命中时被直接处决，同时消耗效果层数。","image":{"full":"Mel_Passive.png","sprite":"passive2.png","group":"passive","x":48,"y":96,"w":48,"h":48},"rankValues":[]}}},"Renekton":{"R:终极统治":{"slot":"R","skill":{"id":"RenektonReignOfTheTyrant","name":"终极统治","description":"雷克顿转换为暴君形态，获得额外生命值，并对周围敌人造成伤害。此形态的雷克顿定时获得怒气。","maxrank":3,"cooldown":[120,100,80],"cost":[0,0,0],"image":{"full":"RenektonReignOfTheTyrant.png","sprite":"spell11.png","group":"spell","x":336,"y":48,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"0/0/0","costType":"怒气","rankValues":[]}}},"Singed":{"P:剧毒冲流":{"slot":"P","passive":{"name":"剧毒冲流","description":"辛吉德借助附近英雄进行漂移，在经过他们时获得爆发性的移动速度加成。","image":{"full":"Singed_Passive.png","sprite":"passive4.png","group":"passive","x":96,"y":0,"w":48,"h":48},"rankValues":[]}}},"Sona":{"Q:英勇赞美诗":{"slot":"Q","skill":{"id":"SonaQ","name":"英勇赞美诗","description":"娑娜弹奏英勇赞美诗，弹出音波，对附近的两名敌人造成魔法伤害，优先选取英雄和野怪为目标。娑娜会暂时获得一个光环，为附近友军的下一次攻击提供额外魔法伤害。","maxrank":5,"cooldown":[8],"cost":[50,55,60,65,70],"image":{"full":"SonaQ.png","sprite":"spell13.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"8","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Syndra":{"W:驱使念力":{"slot":"W","skill":{"id":"SyndraW","name":"驱使念力","description":"辛德拉抓取并投掷一名敌方小兵或者暗黑法球，来对敌人造成魔法伤害，并减少他们的移动速度。","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[60,70,80,90,100],"image":{"full":"SyndraW.png","sprite":"spell13.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"12/11/10/9/8","costBurn":"60/70/80/90/100","costType":"法力","rankValues":[]}},"E:弱者退散":{"slot":"E","skill":{"id":"SyndraE","name":"弱者退散","description":"辛德拉将敌人和暗黑法球击退，并造成魔法伤害。被暗黑法球命中的敌人会被晕眩。","maxrank":5,"cooldown":[17],"cost":[50,50,50,50,50],"image":{"full":"SyndraE.png","sprite":"spell13.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"17","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"R:能量倾泻":{"slot":"R","skill":{"id":"SyndraR","name":"能量倾泻","description":"辛德拉用她的所有暗黑法球来轰击一名敌方英雄。","maxrank":3,"cooldown":[120,100,80],"cost":[100,100,100],"image":{"full":"SyndraR.png","sprite":"spell13.png","group":"spell","x":240,"y":96,"w":48,"h":48},"cooldownBurn":"120/100/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Tristana":{"R:毁灭射击":{"slot":"R","skill":{"id":"TristanaR","name":"毁灭射击","description":"崔丝塔娜装填巨型加农炮弹攻击目标单位，造成巨大伤害并击退目标。如果目标携带着【爆炸火花】的炸弹，那么该炸弹的爆炸半径翻倍。","maxrank":3,"cooldown":[100],"cost":[100,100,100],"image":{"full":"TristanaR.png","sprite":"spell14.png","group":"spell","x":144,"y":48,"w":48,"h":48},"cooldownBurn":"100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Xerath":{"
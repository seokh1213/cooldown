lliaE","name":"流涡种","description":"莉莉娅猛掷出一枚种子，种子在着陆时会造成伤害和减速效果。如果种子未能命中任何东西，那么它将继续滚动，直到命中墙体或一名敌人为止。","maxrank":5,"cooldown":[12],"cost":[70,70,70,70,70],"image":{"full":"LilliaE.png","sprite":"spell7.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"12","costBurn":"70/70/70/70/70","costType":"法力","rankValues":[]}}},"Olaf":{"E:鲁莽挥击":{"slot":"E","skill":{"id":"OlafRecklessStrike","name":"鲁莽挥击","description":"奥拉夫以破釜沉舟之势发动进攻，对目标造成真实伤害（不受护甲与魔抗减免），同时，自身也会根据敌方所受的伤害而受到真实伤害的反噬。","maxrank":5,"cooldown":[11,10,9,8,7],"cost":[0,0,0,0,0],"image":{"full":"OlafRecklessStrike.png","sprite":"spell10.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"11/10/9/8/7","costBurn":"0/0/0/0/0","costType":"法力","rankValues":[]}}},"Shaco":{"P:背刺":{"slot":"P","passive":{"name":"背刺","description":"在目标的背后时，萨科的普攻和【E双面毒刃】会造成额外伤害。","image":{"full":"Jester_CarefulStrikes.png","sprite":"passive3.png","group":"passive","x":432,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:欺诈魔术":{"slot":"Q","skill":{"id":"Deceive","name":"欺诈魔术","description":"萨科进入隐形状态并传送到目标位置。<br><br>他在隐形状态下的第一次普攻将获得增强，造成额外伤害并在目标背后攻击时必定会暴击。","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[40,40,40,40,40],"image":{"full":"Deceive.png","sprite":"spell12.png","group":"spell","x":192,"y":48,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}}},"Shen":{"Q:奥义！暮临":{"slot":"Q","skill":{"id":"ShenQ","name":"奥义！暮临","description":"慎召回他的魂刃并用它进行攻击，造成基于目标最大生命值的额外伤害。如果魂刃在召回途中与一个敌方英雄产生了碰撞，那么慎的魂刃攻击会获得极大强化，并且所有被碰撞的敌人在逃离慎的时候都会被减速。","maxrank":5,"cooldown":[8,7.25,6.5,5.75,5],"cost":[140,130,120,110,100],"image":{"full":"ShenQ.png","sprite":"spell12.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"8/7.25/6.5/5.75/5","costBurn":"140/130/120/110/100","costType":"能量","rankValues":[]}}},"Singed":{"P:毒氣推進（被動）":{"slot":"P","passive":{"name":"毒氣推進（被動）","description":"辛吉德借助附近英雄进行漂移，在经过他们时获得爆发性的移动速度加成。","image":{"full":"Singed_Passive.png","sprite":"passive4.png","group":"passive","x":96,"y":0,"w":48,"h":48},"rankValues":[]}},"Q:剧毒踪迹":{"slot":"Q","skill":{"id":"PoisonTrail","name":"剧毒踪迹","description":"辛吉德在身后留下剧毒踪迹，对经过上面的敌人造成持续伤害。","maxrank":5,"cooldown":[0],"cost":[13,13,13,13,13],"image":{"full":"PoisonTrail.png","sprite":"spell12.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"0","costBurn":"13/13/13/13/13","costType":"法力","rankValues":[]}},"R:疯狂药剂":{"slot":"R","skill":{"id":"InsanityPotion","name":"疯狂药剂","description":"辛吉德喝下精心炮制的化学药剂，大幅提高战斗属性，并使他的【剧毒踪迹】可以施加重伤效果。","maxrank":3,"cooldown":[100],"cost":[100,100,100],"image":{"full":"InsanityPotion.png","sprite":"spell12.png","group":"spell","x":432,"y":96,"w":48,"h":48},"cooldownBurn":"100","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Volibear":{"W:暴怒撕咬":{"slot":"W","skill":{"id":"VolibearW","name":"暴怒撕咬","description":"沃利贝尔伤害一名敌人，施加攻击特效并将其标记。对相同目标再次施放这个技能，会造成额外伤害并治疗沃利贝尔。","maxrank":5,"cooldown":[5],"cost":[30,35,40,45,50],"image":{"full":"VolibearW.png","sprite":"spell15.png","group":"spell","x":240,"y":144,"w":48,"h":48},"cooldownBurn":"5","costBurn":"30/35/40/45/50","costType":"法力","rankValues":[]}}},"Xerath":{"Q:奥能脉冲":{"slot":"Q","skill":{"id":"XerathArcanopulseChargeUp","name":"奥能脉冲","description":"泽拉斯聚集能量，随后发射出一道射程很远的能量光束，对所有命中的目标造成魔法伤害。","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[80,90,100,110,120],"image":{"full":"XerathArcanopulseChargeUp.png","sprite":"spell16.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"80/90/100/110/120","costType":"法力","rankValues":[]}},"W:毁灭之眼":{"slot":"W","skill":{"id":"XerathArcaneBarrage2","name":"毁灭之眼","description":"在目标区域降下奥术能量的弹幕，对一个区域内的所有敌人造成减速效果和魔法伤害。区域中心的目标会受到额外伤害和一个更强大的减速效果。","maxrank":5,"cooldown":[14,13,12,11,10],"cost":[80,90,100,110,120],"image":{"full":"XerathArcaneBarrage2.png","sprite":"spell16.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"14/13/12/11/10","costBurn":"80/90/100/110/120","costType":"法力","rankValues":[]}},"E:冲击
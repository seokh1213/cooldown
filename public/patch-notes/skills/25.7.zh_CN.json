{"schemaVersion":1,"patchVersion":"25.7","sources":{"ddragon":"15.7.1","cdragon":"15.7"},"locale":"zh_CN","champions":{"Darius":{"E:无情铁手":{"slot":"E","skill":{"id":"DariusAxeGrabCone","name":"无情铁手","description":"德莱厄斯磨利他的巨斧，被动地让他的物理伤害无视目标一部分护甲。在主动施放时，德莱厄斯会用斧头上的钩子横扫他的敌人，并将他们拉到德莱厄斯身边。","maxrank":5,"cooldown":[26,23.5,21,18.5,16],"cost":[70,60,50,40,30],"image":{"full":"DariusAxeGrabCone.png","sprite":"spell3.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"26/23.5/21/18.5/16","costBurn":"70/60/50/40/30","costType":"法力","rankValues":[]}}},"Lulu":{"W:奇思妙想":{"slot":"W","skill":{"id":"LuluW","name":"奇思妙想","description":"如果对友军施放，会暂时增加目标友军的攻击速度和移动速度。如果对敌人施放，会将一名敌方英雄变成可爱的动物，使其无法攻击或施法。","maxrank":5,"cooldown":[18],"cost":[65,65,65,65,65],"image":{"full":"LuluW.png","sprite":"spell7.png","group":"spell","x":432,"y":144,"w":48,"h":48},"cooldownBurn":"18","costBurn":"65/65/65/65/65","costType":"法力","rankValues":[]}},"Q:闪耀长枪":{"slot":"Q","skill":{"id":"LuluQ","name":"闪耀长枪","description":"璐璐和皮克斯各自发射一个穿刺飞弹，对命中的所有敌人造成伤害和重度减速效果。","maxrank":5,"cooldown":[7],"cost":[50,55,60,65,70],"image":{"full":"LuluQ.png","sprite":"spell7.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"7","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Naafiri":{"W:暴吼":{"slot":"W","skill":{"id":"NaafiriR","name":"暴吼","description":"纳亚菲利变为不可被选取状态并强化她的狗群，生成额外的狗群伙伴并获得移动速度和攻击力提升。<br>","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[60,60,60,60,60],"image":{"full":"NaafiriR.png","sprite":"spell9.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"60/60/60/60/60","costType":"法力","rankValues":[]}},"P:狂烈种群":{"slot":"P","passive":{"name":"狂烈种群","description":"纳亚菲利生成狗群伙伴，它们会在她攻击或施放技能时攻击目标。","image":{"full":"Icons_Naafiri_P.png","sprite":"passive2.png","group":"passive","x":336,"y":96,"w":48,"h":48},"rankValues":[]}},"Q:暗裔犬牙":{"slot":"Q","skill":{"id":"NaafiriQ","name":"暗裔犬牙","description":"纳亚菲利猛投出两根犬牙，每根都会施加流血效果，或在目标已经流血时施加额外伤害。<br><br>狗群伙伴们会跃向并攻击被这个技能命中的英雄。","maxrank":5,"cooldown":[9,8.5,8,7.5,7],"cost":[55,60,65,70,75],"image":{"full":"NaafiriQ.png","sprite":"spell9.png","group":"spell","x":288,"y":0,"w":48,"h":48},"cooldownBurn":"9/8.5/8/7.5/7","costBurn":"55/60/65/70/75","costType":"法力","rankValues":[]}},"R:猎狗血性":{"slot":"R","skill":{"id":"NaafiriW","name":"猎狗血性","description":"纳亚菲利与她的狗群伙伴们一起向一个英雄冲刺，然后造成伤害。如果纳亚菲利参与了一次击杀，那么她会显形附近的敌方英雄们并且可以再次施放这个技能一次。第二次施放会提供一个护盾。","maxrank":3,"cooldown":[110,95,80],"cost":[100,100,100],"image":{"full":"NaafiriW.png","sprite":"spell9.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"110/95/80","costBurn":"100/100/100","costType":"法力","rankValues":[]}}},"Trundle":{"E:寒冰之柱":{"slot":"E","skill":{"id":"TrundleCircle","name":"寒冰之柱","description":"特朗德尔在目标地点召唤寒冰之柱，令敌人无法通过，并减缓附近敌方单位的移动速度。","maxrank":5,"cooldown":[21,19.5,18,16.5,15],"cost":[75,75,75,75,75],"image":{"full":"TrundleCircle.png","sprite":"spell14.png","group":"spell","x":288,"y":48,"w":48,"h":48},"cooldownBurn":"21/19.5/18/16.5/15","costBurn":"75/75/75/75/75","costType":"法力","rankValues":[]}}},"Yorick":{"Q:临终仪式":{"slot":"Q","skill":{"id":"YorickQ","name":"临终仪式","description":"约里克的下次攻击造成额外伤害并治疗自身。如果目标死亡，则会留下一个坟墓。","maxrank":5,"cooldown":[6,5.5,5,4.5,4],"cost":[20,20,20,20,20],"image":{"full":"YorickQ.png","sprite":"spell16.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"6/5.5/5/4.5/4","costBurn":"20/20/20/20/20","costType":"法力","rankValues":[]}},"P:牧魂人":{"slot":"P","passive":{"name":"牧魂人","description":"<font color='#FF9900'>受诅咒的部落：</font>约里克可以召唤雾行者来蜂拥并攻击附近的敌人。","image":{"full":"Yorick_P.png","sprite":"passive5.png","group":"passive","x":48,"y":48,"w":48,"h":48},"rankValues":[]}},"E:哀伤之雾":{"slot":"E","skill":{"id":"YorickE","name":"哀伤之雾","description":"约里克扔出一小团黑雾，对敌人造成伤害、减速效果并标记敌人。被召唤出的单位在朝带标记的目标移动时会获得移动速度。 ","maxrank":5,"cooldown":[12,11,10,9,8],"cost":[50,55,60,65,70],"image":{"full":"YorickE.png","sprite":"spell16.png","group":"spell","x":192,"y":96,"w":48,"h":48},"coo
":[{"file":"patch-notes/icons/3571a41ed8094583d4bd2493fb68b77b.webp","spellId":"AhriQ"}]}},"Azir":{"Q:사막의 맹습":{"slot":"Q","skill":{"id":"AzirQWrapper","name":"사막의 맹습","description":"아지르가 모든 모래 병사를 특정 위치로 보냅니다. 모래 병사들은 통과하는 적에게 마법 피해를 입히고, 1초 둔화 효과를 적용합니다.","maxrank":5,"cooldown":[14,12,10,8,6],"cost":[70,80,90,100,110],"image":{"full":"AzirQWrapper.png","sprite":"spell1.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"14/12/10/8/6","costBurn":"70/80/90/100/110","costType":"마나","rankValues":[{"label":"기본 피해량","values":"60 / 80 / 100 / 120 / 140"}]},"icons":[{"file":"patch-notes/icons/b391531c43df417b33716f3083d0461b.webp","spellId":"AzirQWrapper"}]},"W:일어나라!":{"slot":"W","skill":{"id":"AzirW","name":"일어나라!","description":"아지르가 모래 병사를 소환하여 근처에 있는 대상을 공격합니다. 아지르의 기본 공격은 모래 병사의 공격 범위 내에 있는 대상에게 가해집니다. 아지르와 모래 병사의 공격은 일직선 상의 적들에게 마법 피해를 입힙니다.","maxrank":5,"cooldown":[1.5],"cost":[40,35,30,25,20],"image":{"full":"AzirW.png","sprite":"spell1.png","group":"spell","x":48,"y":144,"w":48,"h":48},"cooldownBurn":"1.5","costBurn":"40/35/30/25/20","costType":"마나","rankValues":[{"label":"기본 피해량","values":"50 / 65 / 80 / 95 / 110"}]},"icons":[{"file":"patch-notes/icons/1c0d7db858378fcaba0f9c2cbb078e89.webp","spellId":"AzirW"}]}},"Cassiopeia":{"E:쌍독니":{"slot":"E","skill":{"id":"CassiopeiaE","name":"쌍독니","description":"카시오페아가 대상에게 강력한 공격을 가하고 그 피해량에 비례해 자신의 체력을 회복합니다. 적이 독에 중독되면 피해량이 상승하며 적이 처치될 경우 카시오페아의 마나가 회복됩니다.","maxrank":5,"cooldown":[0.75],"cost":[40,40,40,40,40],"image":{"full":"CassiopeiaE.png","sprite":"spell2.png","group":"spell","x":384,"y":96,"w":48,"h":48},"cooldownBurn":"0.75","costBurn":"40/40/40/40/40","costType":"마나","rankValues":[{"label":"추가 피해량","values":"20 / 43 / 66 / 89 / 112"}]},"icons":[{"file":"patch-notes/icons/c77e5e2e4d52e3e827f6eb234d3c3092.webp","spellId":"CassiopeiaE"}]}},"Olaf":{"Q:역류":{"slot":"Q","skill":{"id":"OlafAxeThrowCast","name":"역류","description":"올라프가 지정한 곳에 도끼를 던져 맞은 적에게 피해를 입히고 방어력과 이동 속도를 감소시킵니다. 올라프가 도끼를 다시 집으면 이 스킬의 재사용
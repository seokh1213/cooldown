{"schemaVersion":1,"patchVersion":"26.6","sources":{"ddragon":"16.6.1","cdragon":"16.6"},"locale":"ko_KR","champions":{"Lissandra":{"Q:얼음 파편":{"slot":"Q","skill":{"id":"LissandraQ","name":"얼음 파편","description":"적을 맞히면 부서지는 얼음창을 던져 마법 피해를 입히고 이동 속도를 늦춥니다. 파편들이 대상을 꿰뚫고 나가, 여기에 맞는 다른 적들에게도 동일한 피해를 입힙니다.","maxrank":5,"cooldown":[7,6,5,4,3],"cost":[55,60,65,70,75],"image":{"full":"LissandraQ.png","sprite":"spell7.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"7/6/5/4/3","costBurn":"55/60/65/70/75","costType":"마나","rankValues":[]}}},"Shyvana":{"Q:잉걸불 일격":{"slot":"Q","skill":{"id":"ShyvanaQ","name":"잉걸불 일격","description":"쉬바나의 다음 기본 공격이 대상과 주변 지역을 모두 타격합니다. 이 스킬은 재사용할 수 있습니다. 용 형상일 때는 스킬을 한 번 더 사용할 수 있으며, 단일 대상에게 막대한 피해를 입힙니다.","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaQ.png","sprite":"spell12.png","group":"spell","x":96,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[]}},"W:지옥불 방패":{"slot":"W","skill":{"id":"ShyvanaW","name":"지옥불 방패","description":"쉬바나가 보호막과 이동 속도를 얻으며, 잠시 후 쉬바나 주변에 폭발을 일으킵니다.  용 형상일 때 폭발이 적 챔피언에게 적중하면 체력을 회복합니다.","maxrank":5,"cooldown":[14,13.5,13,12.5,12],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaW.png","sprite":"spell12.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"14/13.5/13/12.5/12","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기본 피해량","values":"80 / 100 / 120 / 140 / 160"}]},"icons":[{"file":"patch-notes/icons/a27b376c05217e64f4e7c8e47ddc8632.webp","spellId":"ShyvanaW"}]},"E:용암 분출":{"slot":"E","skill":{"id":"ShyvanaE","name":"용암 분출","description":"쉬바나가 화염구를 날리고 대형 대상에게 적중 시 폭발하며 둔화를 적용합니다. 용 형상일 때는 화염구가 대형 적에게 적중 시 관통하며 폭발하고 지나간 자리에 불길을 남깁니다.","maxrank":5,"cooldown":[12,11.5,11,10.5,10],"cost":[0,0,0,0,0],"image":{"full":"ShyvanaE.png","sprite":"spell12.png","group":"spell","x":192,"y":96,"w":48,"h":48},"cooldownBurn":"12/11.5/11/10.5/10","costBurn":"0/0/0/0/0","costType":"분노","rankValues":[{"label":"기
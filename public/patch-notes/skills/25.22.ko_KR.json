{"schemaVersion":1,"patchVersion":"25.22","sources":{"ddragon":"15.22.1","cdragon":"15.22"},"locale":"ko_KR","champions":{"Akshan":{"Q:복수의 부메랑":{"slot":"Q","skill":{"id":"AkshanQ","name":"복수의 부메랑","description":"아크샨이 날아가고 돌아오며 피해를 입히는 부메랑을 던집니다. 적에게 적중할 때마다 부메랑의 사거리가 증가합니다.","maxrank":5,"cooldown":[9,8,7,6,5],"cost":[60,65,70,75,80],"image":{"full":"AkshanQ.png","sprite":"spell0.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"9/8/7/6/5","costBurn":"60/65/70/75/80","costType":"마나","rankValues":[]}}},"Blitzcrank":{"E:강철 주먹":{"slot":"E","skill":{"id":"PowerFist","name":"강철 주먹","description":"블리츠크랭크가 주먹에 힘을 모아 다음 공격 시 적에게 두 배의 피해를 입히고 적을 공중으로 띄웁니다.","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[25,25,25,25,25],"image":{"full":"PowerFist.png","sprite":"spell2.png","group":"spell","x":192,"y":0,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"25/25/25/25/25","costType":"마나","rankValues":[]}}},"Skarner":{"Q:부서진 대지/지반 돌출":{"slot":"Q","skill":{"id":"SkarnerQ","name":"부서진 대지/지반 돌출","description":"스카너가 대지에서 바위를 뜯어냅니다. 바위는 기본 공격을 강화하며 강력한 투사체로 던질 수 있습니다.","maxrank":5,"cooldown":[8,7,6,5,4],"cost":[45,45,45,45,45],"image":{"full":"SkarnerQ.png","sprite":"spell12.png","group":"spell","x":384,"y":144,"w":48,"h":48},"cooldownBurn":"8/7/6/5/4","costBurn":"45/45/45/45/45","costType":"마나","rankValues":[]}},"E:이쉬탈의 격돌":{"slot":"E","skill":{"id":"SkarnerE","name":"이쉬탈의 격돌","description":"스카너가 앞으로 돌진하며 지형을 통과합니다. 챔피언이나 대형 몬스터와 충돌하면 다음에 부딪치는 벽에 내동댕이쳐 피해를 입히고 기절시킵니다.","maxrank":5,"cooldown":[22,21,20,19,18],"cost":[50,55,60,65,70],"image":{"full":"SkarnerE.png","sprite":"spell13.png","group":"spell","x":0,"y":0,"w":48,"h":48},"cooldownBurn":"22/21/20/19/18","costBurn":"50/55/60/65/70","costType":"마나","rankValues":[]}},"R:꿰뚫기":{"slot":"R","skill":{"id":"SkarnerR","name":"꿰뚫기","description":"스카너가 꼬리를 앞으로 후려쳐 적 챔피언을 제압합니다. 제압한 적 챔피언은 스카너를 따라 끌려다닙니다.","maxrank":3,"cooldown":[120,105,90],"cost":[100,100,100],"image":{"full":"SkarnerR.png","sprite":"spell13.png","grou
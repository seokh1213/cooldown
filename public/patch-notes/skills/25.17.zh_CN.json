{"schemaVersion":1,"patchVersion":"25.17","sources":{"ddragon":"15.17.1","cdragon":"15.17"},"locale":"zh_CN","champions":{"AurelionSol":{"W:星穹流丽":{"slot":"W","skill":{"id":"AurelionSolW","name":"星穹流丽","description":"奥瑞利安 · 索尔沿着目标方向飞越地形。在这个状态下，他可以施放其它技能。飞行期间，星河冲荡没有冷却时间，也没有最长蓄力时间，并且造成的伤害会提升。<br><br>如果有敌方英雄因为奥瑞利安 · 索尔近期造成的伤害阵亡，星穹流丽的冷却时间会缩短。<br><br>星尘会提升星穹流丽的最大飞行距离。","maxrank":5,"cooldown":[22,20.5,19,17.5,16],"cost":[50,55,60,65,70],"image":{"full":"AurelionSolW.png","sprite":"spell1.png","group":"spell","x":144,"y":96,"w":48,"h":48},"cooldownBurn":"22/20.5/19/17.5/16","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"Irelia":{"E:比翼双刃":{"slot":"E","skill":{"id":"IreliaE","name":"比翼双刃","description":"艾瑞莉娅放出两柄相互聚拢的利刃。利刃之间被击中的敌人会受到伤害、晕眩效果并被标记。","maxrank":5,"cooldown":[16,14.5,13,11.5,10],"cost":[50,50,50,50,50],"image":{"full":"IreliaE.png","sprite":"spell5.png","group":"spell","x":384,"y":0,"w":48,"h":48},"cooldownBurn":"16/14.5/13/11.5/10","costBurn":"50/50/50/50/50","costType":"法力","rankValues":[]}},"W:距破之舞":{"slot":"W","skill":{"id":"IreliaW","name":"距破之舞","description":"艾瑞莉娅开始蓄力以进行一次打击，蓄力越久则打击造成的伤害越多。在蓄力期间她所受的物理伤害降低。","maxrank":5,"cooldown":[20,18,16,14,12],"cost":[70,75,80,85,90],"image":{"full":"IreliaW.png","sprite":"spell5.png","group":"spell","x":336,"y":0,"w":48,"h":48},"cooldownBurn":"20/18/16/14/12","costBurn":"70/75/80/85/90","costType":"法力","rankValues":[]}}},"Kayn":{"Q:巨镰横扫":{"slot":"Q","skill":{"id":"KaynQ","name":"巨镰横扫","description":"凯隐向前冲刺并打击附近的敌人。冲刺和打击都会造成伤害。","maxrank":5,"cooldown":[7,6.5,6,5.5,5],"cost":[40,40,40,40,40],"image":{"full":"KaynQ.png","sprite":"spell6.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"7/6.5/6/5.5/5","costBurn":"40/40/40/40/40","costType":"法力","rankValues":[]}},"W:利刃纵贯":{"slot":"W","skill":{"id":"KaynW","name":"利刃纵贯","description":"凯隐伤害并减速一条直线上的敌人。","maxrank":5,"cooldown":[13,12,11,10,9],"cost":[40,45,50,55,60],"image":{"full":"KaynW.png","sprite":"spell6.png","group":"spell","x":336,"y":96,
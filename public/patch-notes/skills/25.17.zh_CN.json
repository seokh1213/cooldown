rite":"spell7.png","group":"spell","x":432,"y":0,"w":48,"h":48},"cooldownBurn":"2/1.5/1","costBurn":"40/40/40","costType":"法力","rankValues":[]}}},"MasterYi":{"Q:阿尔法突袭":{"slot":"Q","skill":{"id":"AlphaStrike","name":"阿尔法突袭","description":"易以肉眼难以发觉的速度穿梭于战场，对多个敌人造成物理伤害，同时处于不可被选取的状态下。阿尔法突袭可以暴击，并对野怪造成额外物理伤害。普通攻击可以减少阿尔法突袭的冷却时间。","maxrank":5,"cooldown":[20,19.5,19,18.5,18],"cost":[50,55,60,65,70],"image":{"full":"AlphaStrike.png","sprite":"spell8.png","group":"spell","x":384,"y":48,"w":48,"h":48},"cooldownBurn":"20/19.5/19/18.5/18","costBurn":"50/55/60/65/70","costType":"法力","rankValues":[]}}},"MissFortune":{},"Nilah":{"Q:游刃万变":{"slot":"Q","skill":{"id":"NilahQ","name":"游刃万变","description":"随着她鞭刃的一次抽击，尼菈对她所选方向中一条直线上命中的任何敌人们造成伤害。这个行动会在短时间里延伸她的攻击距离。","maxrank":5,"cooldown":[4],"cost":[30,30,30,30,30],"image":{"full":"NilahQ.png","sprite":"spell9.png","group":"spell","x":0,"y":144,"w":48,"h":48},"cooldownBurn":"4","costBurn":"30/30/30/30/30","costType":"法力","rankValues":[]}}},"Rumble":{"P:机械重组":{"slot":"P","passive":{"name":"机械重组","description":"兰博的技能都能使其获得热量。当兰博的热量达到50%时，他会处于危险温度状态，所有基础技能都会获得额外效果。当热量达到100%时，他会进入过热状态，获得额外的攻击速度并让他的普通攻击造成额外伤害，但也会让他在数秒内无法施放技能。","image":{"full":"Rumble_JunkyardTitan1.png","sprite":"passive3.png","group":"passive","x":96,"y":96,"w":48,"h":48},"rankValues":[{"label":"过热攻击速度（1–18级）","values":"50–130%"},{"label":"对野怪伤害上限（1–18级）","values":"65–150"}]},"icons":[{"file":"patch-notes/icons/f666501a8d1d64ec185ca939378ce08c.webp","spellId":"RumbleHeatSystem"}]},"Q:纵火盛宴":{"slot":"Q","skill":{"id":"RumbleFlameThrower","name":"纵火盛宴","description":"兰博朝敌人放火，每秒对前方锥形范围内的敌人造成伤害，持续3秒。在危险温度时，兰博增加对其造成的伤害。","maxrank":5,"cooldown":[10,9,8,7,6],"cost":[0,0,0,0,0],"image":{"full":"RumbleFlameThrower.png","sprite":"spell11.png","group":"spell","x":288,"y":96,"w":48,"h":48},"cooldownBurn":"10/9/8/7/6","costBurn":"0/0/0/0/0","costType":"热量","rankValues":[]}}},"Senna":{"Q:黑暗洞灭":{"slot":"Q","skill":{"id":"SennaQ","name":"黑暗洞灭","description":"赛娜从她的圣物火炮的双生炮管中射出一道光影相生之芒来洞穿一个目标，治疗
            "iconPath": "assets/characters/nidalee/hud/icons2d/nidalee_q2.png",
            "iconVersion": "16.18",
            "bodyHtml": "<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Cougar Form:</span> Nidalee's next Attack deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(5/30/55/80 + ([[si:scalead]]75% Attack Damage) + ([[si:scaleap]]40% Ability Power)) plus 1/1.25/1.5/1.75% per 1% missing Health magic damage</span>.<br /><br />If the enemy was <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Hunted</span>, deals 30% increased damage.",

      "P": {
        "slot": "P",
        "id": "GnarPassive",
        "name": "Rage Gene",
        "maxRank": 0,
        "summary": "While in combat Gnar generates Rage. At maximum Rage his next ability will transform him into Mega Gnar, granting increased survivability and access to new spells.",
        "bodyHtml": "Gnar generates <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Rage</span> by dealing and receiving damage. At max <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Rage</span> his next Ability transforms him into <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Mega Gnar</span> for 15 seconds.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Mini Gnar:</span> Gain <span class=\"text-cyan-600 dark:text-cyan-500\">(0 ~ 20[[si:scalelevel]]) Move Speed</span>, <span>(5.5% ~ 99.0%[[si:scalelevel]]) Attack Speed</span>, and (0 ~ 100[[si:scalelevel]]) Attack Range.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Mega Gnar:</span> Gain <span class=\"text-green-600 dark:text-green-400\">(100 ~ 831[[si:scalelevel]]) max Health</span>, <span class=\"text-orange-600 dark:text-orange-400\">(4 ~ 55[[si:scalelevel]]) Armor</span>, <span>(4 ~ 63[[si:scalelevel]]) Magic Resist</span>, and <span class=\"text-red-600 dark:text-red-500 font-semibold\">(6 ~ 49[[si:scalelevel]]) Attack Damage</span>.",

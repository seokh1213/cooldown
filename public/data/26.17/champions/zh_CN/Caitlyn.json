    "abilities": {
      "P": {
        "slot": "P",
        "id": "CaitlynPassive",
        "name": "爆头",
        "summary": "每进行几次基础攻击，对中了她的陷阱或绳网的单位进行攻击时，凯特琳就会造成一次【爆头】效果，造成随暴击几率增长的额外伤害。在对中了陷阱或绳网的目标进行攻击时，凯特琳的【爆头】攻击距离翻倍。",
        "bodyHtml": "每攻击5次，凯特琳就会发射一次<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">爆头</span>。草丛中的攻击在积攒<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">爆头</span>次数时会算为次。<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">爆头</span>造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">物理伤害</span>。爆头对被<span></span>和<span></span>影响的敌人们拥有双倍距离。<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">爆头</span>对被<span></span>命中的敌人会造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">物理伤害</span>。",
        "iconFile": "Caitlyn_Headshot.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "conditions": [],
        "source": "communitydragon",

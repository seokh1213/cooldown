      "P": {
        "slot": "P",
        "id": "HeimerdingerPassive",
        "name": "海克斯科技亲和",
        "maxRank": 0,
        "summary": "在友方防御塔和由黑默丁格部署的炮台附近时，获得移动速度加成。",
        "bodyHtml": "黑默丁格在他的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">炮台</span>和友方防御塔附近时会获得<span class=\"text-cyan-600 dark:text-cyan-500\">20%移动速度</span>。",
        "iconFile": "Heimerdinger_Passive.png",

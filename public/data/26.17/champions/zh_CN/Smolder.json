    "abilities": {
      "P": {
        "slot": "P",
        "id": "SmolderP",
        "name": "龙之研习",
        "maxRank": 0,
        "summary": "用技能命中英雄和用超级灼热龙息 击杀敌人时会提供一层龙之研习。层数会提升斯莫德各基础技能的伤害。",
        "bodyHtml": "用技能命中英雄和用<span></span>击杀敌人时会提供一层<span></span>，这些层数可强化斯莫德的各个基础技能。<br /><span><span></span>：造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">0.25魔法伤害</span>并在层、层和层时获得新效果。<span><span></span>：爆炸造成额外<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">0.55魔法伤害</span>。<span><span></span>：每次命中造成额外<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">0.08魔法伤害</span>并且每100层获得一个额外弹体。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">斯莫德已获得<span style=\"color: #c93c3c\">龙之研习</span>：<span style=\"color: #c93c3c\"></span>。</span>",
        "iconFile": "Icons_Smolder_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",
          "unsupportedPartTypes": []
        },

      "Q": {
        "slot": "Q",
        "id": "KindredQ",
        "name": "乱箭之舞",
        "maxRank": 5,
        "summary": "千珏进行翻滚并朝附近的敌人射出最多三支箭矢。",
        "bodyHtml": "千珏进行翻滚，对至多3名敌人发射一根箭矢，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(40/65/90/115/140 + (75% 额外攻击力))物理伤害</span>并提供持续4秒的<span>40%攻击速度</span>。<br /><br />在<span>狼灵狂热</span>之中时，这个技能的冷却时间会缩短至4/3.5/3/2.5/2秒。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">攻击速度受益于已获取的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">印记</span>层数。</span>",
        "iconFile": "KindredQ.png",

      "P": {
        "slot": "P",
        "id": "AuroraPassive",
        "name": "驱灵奇术",
        "maxRank": 0,
        "summary": "阿萝拉的技能或攻击伤害能从敌人身上抽离出灵物。被抽离灵物跟随阿萝拉并治疗她。",
        "bodyHtml": "用技能或攻击对一个敌人造成3次伤害时会对其驱灵，造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\"> (1% + (每100点法术强度2.7%))最大生命值的魔法伤害</span>；如果该敌人是英雄，还会被抽出一个灵物跟随阿萝拉4秒，每秒回复她<span class=\"text-green-600 dark:text-green-400\">(2% 法术强度)</span>生命值。",
        "iconFile": "AuroraPassive.png",

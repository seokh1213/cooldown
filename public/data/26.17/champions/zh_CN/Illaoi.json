    "abilities": {
      "P": {
        "slot": "P",
        "id": "IllaoiPassive",
        "name": "古神先知",
        "maxRank": 0,
        "summary": "俄洛伊和她创造的<font color='#669900'>躯壳</font>会在附近的不可穿越的地形上生成触手。触手会挥向灵魂，<font color='#669900'>躯壳</font>，以及俄洛伊的【严酷训诫】的受害者们。触手会在命中敌人时造成物理伤害，如果命中目标是英雄还会治疗俄洛伊。",
        "bodyHtml": "俄洛伊彰显她神祗的风采，如果附近没有任何触手存在的话，就会在附近地形上生成一条触手(<span class=\"text-gray-600 dark:text-gray-400\">(18 ~ 7)</span>秒冷却时间)。触手不会自行攻击，但可通过俄洛伊的技能来让它们<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">猛击</span>。<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">猛击</span>造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">?物理伤害</span>。如果猛击对1名以上的敌方英雄造成伤害，那么俄洛伊就会治疗自身<span class=\"text-green-600 dark:text-green-400\">5%的已损失生命值</span>。",
        "iconFile": "Illaoi_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],

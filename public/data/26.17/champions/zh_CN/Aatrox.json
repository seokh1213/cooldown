    "abilities": {
      "P": {
        "slot": "P",
        "id": "AatroxPassive",
        "name": "赐死剑气",
        "maxRank": 0,
        "summary": "每过一段时间，亚托克斯的下次普攻会造成额外<magicDamage>魔法伤害</magicDamage>，并治疗亚托克斯，治疗量基于目标的最大生命值。 ",
        "bodyHtml": "亚托克斯的攻击造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(4% ~ 10%)最大生命值魔法伤害</span>并回复<span class=\"text-green-600 dark:text-green-400\">100%实际伤害值的生命值</span>，对小兵时降低至25%。这个效果有(22 ~ 10)秒冷却时间。<br /><br />对英雄和大型野怪进行的攻击和技能会使这个效果的冷却时间缩短2秒。用<span>暗裔利刃</span>的边缘命中时会使这个效果的冷却时间缩短4秒。",
        "iconFile": "Aatrox_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],

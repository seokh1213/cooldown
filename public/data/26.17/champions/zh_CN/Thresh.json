      "P": {
        "slot": "P",
        "id": "ThreshPassiveSouls",
        "name": "地狱诅咒",
        "maxRank": 0,
        "summary": "锤石可以收割那些死在他身边的敌人们的灵魂，从而为他提供护甲和法术强度。",
        "bodyHtml": "锤石在走过已死敌人身边的时候，会收集他们的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">灵魂</span>。每个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">灵魂</span>为他提供<span class=\"text-orange-600 dark:text-orange-400\">1护甲</span>和<span class=\"text-blue-600 dark:text-blue-400\">1法术强度</span>。",
        "iconFile": "Thresh_Passive.png",

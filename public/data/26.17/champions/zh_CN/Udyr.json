    "abilities": {
      "P": {
        "slot": "P",
        "id": "UdyrPassive",
        "name": "众灵纽带",
        "summary": "乌迪尔的四个基础技能会让他在四种姿态之间来回转换，并且再次施放同一技能会带来终极技能助益。此外，在使用一个技能后，乌迪尔的下两次攻击获得攻击速度。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">兽灵觉醒：</span>乌迪尔的四个基础技能会让他在四种<span>姿态</span>之间来回转换。乌迪尔能够<span class=\"text-yellow-600 dark:text-yellow-300\">再次施放</span>同一技能来提供此技能的觉醒效果，带来终极技能助益。(20秒冷却时间)。<br /><br /><span class=\"text-gray-600 dark:text-gray-500 italic\">武僧修行：</span>在使用一个技能后，乌迪尔在4秒内的下两次攻击获得<span>30%攻击速度</span>并返还5%的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">觉醒</span>冷却时间。<br />",
        "iconFile": "Udyr_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

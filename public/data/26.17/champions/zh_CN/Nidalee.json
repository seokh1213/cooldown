      "Q": {
        "slot": "Q",
        "id": "JavelinToss",
        "name": "标枪投掷 / 推倒",
        "maxRank": 5,
        "summary": "人类形态下，奈德丽向她的目标投掷标枪，飞行中击中目标造成伤害。美洲狮形态下，她的下一次攻击会试图对目标造成致命伤害，目标的生命值越低，造成的伤害越大。",
        "bodyHtml": "<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">人类形态：</span>奈德丽投掷她的标枪，造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(70/90/110/130/150 + (50% 法术强度))魔法伤害</span>，基于标枪飞行距离至多提升至<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(227.5/292.5/357.5/422.5/487.5 + (162.5% 法术强度))魔法伤害</span>。",
        "iconFile": "JavelinToss.png",

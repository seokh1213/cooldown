      "P": {
        "slot": "P",
        "id": "LockePassive",
        "name": "圣银穿心",
        "maxRank": 0,
        "summary": "洛克的攻击会附带额外的魔法伤害，伤害值基于敌人的已损失生命值而提升。",
        "bodyHtml": "洛克的攻击附带额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((5 ~ 40) + (10% 法术强度))魔法伤害</span>，基于目标的已损失生命值至多提升至<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((10 ~ 80) + (20% 法术强度))魔法伤害</span>。",
        "iconFile": "Locke_Passive.png",

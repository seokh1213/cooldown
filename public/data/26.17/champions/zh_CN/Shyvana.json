    "abilities": {
      "P": {
        "slot": "P",
        "id": "ShyvanaPassive",
        "name": "龙鳞铁衣",
        "maxRank": 0,
        "summary": "参与击杀敌方英雄、大型小兵和大型野怪后，希瓦娜会获得【龙鳞铁衣】层数，从而改进她的防御属性。",
        "bodyHtml": "参与击杀敌方英雄、大型小兵和大型野怪后，希瓦娜会获得<span>? </span>层数， 每层为希瓦娜提供永久的<span class=\"text-orange-600 dark:text-orange-400\">0.3护甲</span>和<span>0.3魔法抗性</span>。<br /><br /><span class=\"text-orange-600 dark:text-orange-400\">额外护甲：0.3</span><br /><span>额外魔法抗性：0.3</span>",
        "iconFile": "Shyvana_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "ZaahenPassive",
        "name": "不落之志",
        "maxRank": 0,
        "summary": "亚恒对敌方英雄打出的攻击和技能会为他提供【果决】层数，每层获得额外攻击力。当叠满【果决】时，亚恒获得攻击力提升并且能够复活。",
        "bodyHtml": "亚恒在用一次攻击或技能命中一个敌方英雄时，会获得一层<span>果决</span>(最大12层)。他每层获得<span class=\"text-red-600 dark:text-red-500 font-semibold\">(1.5% ~ 2.8%)攻击力提升</span>。<br /><br />当叠满<span>果决</span>时，亚恒使已提供的<span class=\"text-red-600 dark:text-red-500 font-semibold\">攻击力</span>翻倍，并且如果他即将阵亡，那么他会转而进入持续4秒的凝滞状态然后带着<span class=\"text-green-600 dark:text-green-400\">他的(30% ~ 75%)最大生命值</span>复活。<br /><br />亚恒的复活有120秒冷却时间。<br />",
        "iconFile": "ZaahenP.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

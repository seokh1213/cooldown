      "P": {
        "slot": "P",
        "id": "YonePassive",
        "name": "狩人之道",
        "maxRank": 0,
        "summary": "永恩每第二次攻击造成魔法伤害。此外，他的暴击几率提升。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">凡灵双剑：</span>永恩手持双剑，所以他的每第二次攻击可造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">50%魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-500 italic\">向死而生：</span>永恩的暴击几率提升100暴击伤害)。100%以上的暴击几率，会每1%转化为<span class=\"text-red-600 dark:text-red-500 font-semibold\">?额外攻击力</span>。",
        "iconFile": "YonePassive.png",

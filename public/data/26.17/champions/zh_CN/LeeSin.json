      "P": {
        "slot": "P",
        "id": "LeeSinPassive",
        "name": "疾风骤雨",
        "summary": "在李青使用一次技能后，他的下两次攻击会获得攻速加成，且回复能量。",
        "bodyHtml": "李青的技能会为他的下两次攻击提供<span>40%攻击速度</span>。第一次攻击回复<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">20/40能量</span>，第二次攻击回复<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">(10 ~ 20)能量</span>。",
        "iconFile": "LeeSinPassive.png",

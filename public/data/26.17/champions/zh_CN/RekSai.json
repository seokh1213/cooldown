      "P": {
        "slot": "P",
        "id": "RekSaiPassive",
        "name": "艾克塞之怒",
        "maxRank": 0,
        "summary": "雷克塞可通过攻击和命中基础技能来生成怒气。她在位于地下时可消耗怒气来回复生命值。",
        "bodyHtml": "雷克塞的攻击生成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25怒气</span>，技能生成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25怒气</span>。<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">位于地下</span>时，她会消耗<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">怒气</span>，3秒内持续最多回复<span class=\"text-green-600 dark:text-green-400\">?生命值</span>，随等级提升。",
        "iconFile": "RekSai_Passive.png",

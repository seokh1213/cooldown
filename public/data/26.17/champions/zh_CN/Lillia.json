      "P": {
        "slot": "P",
        "id": "LilliaP",
        "name": "梦满枝",
        "maxRank": 0,
        "summary": "用一个技能命中一位英雄或野怪，将持续造成额外的最大生命值伤害。",
        "bodyHtml": "莉莉娅的技能会施加<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">梦尘</span>，在3秒里持续造成共<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(5% + (每100点法术强度1.25%))最大生命值的魔法伤害</span>。在此期间，莉莉娅在对抗大型野怪时会持续回复共<span class=\"text-green-600 dark:text-green-400\">(39 + (15% 法术强度))生命值</span>，在对抗英雄时持续回复共<span class=\"text-green-600 dark:text-green-400\">((6 ~ 90) + (30% 法术强度))生命值</span>。",
        "iconFile": "Lillia_Icon_Passive.png",

      "Q": {
        "slot": "Q",
        "id": "LilliaQ",
        "name": "飞花挞",
        "maxRank": 5,
        "summary": "被动部分：莉莉娅在用技能命中敌人时，会获得移动速度。主动部分：莉莉娅对附近的敌人造成魔法伤害，并对边缘的敌人造成额外真实伤害。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span>莉莉娅的技能在命中时会提供<span class=\"text-cyan-600 dark:text-cyan-500\">(3/4/5/6/7% + (每100点法术强度3%))移动速度</span>，持续6.5秒，可叠加4层。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动：</span>莉莉娅猛掷她的香炉，造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(35/45/55/65/75 + (35% 法术强度))魔法伤害</span>，并在外侧边缘造成额外的<span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">(35/45/55/65/75 + (35% 法术强度))真实伤害</span> 。",
        "iconFile": "LilliaQ.png",

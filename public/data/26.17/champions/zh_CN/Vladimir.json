    "abilities": {
      "P": {
        "slot": "P",
        "id": "VladimirBloodGorged",
        "name": "血色契约",
        "maxRank": 0,
        "summary": "每30生命值加成给予弗拉基米尔1法术强度，每1法术强度给予弗拉基米尔1.6生命值（不会自我循环叠加）。",
        "bodyHtml": "弗拉基米尔的每<span>30额外生命值</span>为他提供<span class=\"text-blue-600 dark:text-blue-400\">1法术强度</span>。他的每<span class=\"text-blue-600 dark:text-blue-400\">1法术强度</span>也为他提供<span>1.6最大生命值</span>。<br /><br /><span class=\"text-blue-600 dark:text-blue-400\">额外法术强度：((3.533% 额外生命值) + (-5.653% 法术强度))</span><br /><span>额外生命值：((169.6% 攻击力) + (-5.653% 额外生命值))</span>",
        "iconFile": "VladimirP.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {

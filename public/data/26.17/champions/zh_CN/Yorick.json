    "abilities": {
      "P": {
        "slot": "P",
        "id": "YorickPassive",
        "name": "牧魂人",
        "maxRank": 0,
        "summary": "<font color='#FF9900'>受诅咒的部落：</font>约里克可以召唤雾行者来蜂拥并攻击附近的敌人。",
        "bodyHtml": "附近每阵亡2名敌人，约里克就会升起一座坟墓。英雄和大型野怪在阵亡时总会留下一座坟墓。<br /><br />这些坟墓可以被用来<span>唤醒</span>拥有<span class=\"text-green-600 dark:text-green-400\">((100 ~ 300) + (15% 额外生命值))生命值</span>和<span class=\"text-red-600 dark:text-red-500 font-semibold\">((15 ~ 100) + (20% 额外攻击力))攻击力</span>的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">雾行者</span>，在一个区域内至多至4座。",
        "iconFile": "Yorick_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],

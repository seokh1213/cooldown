      "P": {
        "slot": "P",
        "id": "MordekaiserPassive",
        "name": "黑暗起兮",
        "maxRank": 0,
        "summary": "莫德凯撒在对英雄或野怪打出3次攻击或技能之后获得一个强力的伤害光环和移动速度。",
        "bodyHtml": "莫德凯撒的攻击会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(40% 法术强度)魔法伤害</span>。<br /><br />在用3次普通技能或攻击命中英雄或野怪后，莫德凯撒会将自身笼罩在负能量的遮蔽中。这个遮蔽每秒造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(5 + (30% 法术强度))加上(1 ~ 5)最大生命值的魔法伤害</span>并为他提供<span class=\"text-cyan-600 dark:text-cyan-500\">9%移动速度</span>。",
        "iconFile": "MordekaiserPassive.png",

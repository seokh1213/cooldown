    "abilities": {
      "P": {
        "slot": "P",
        "id": "VolibearP",
        "name": "狂雷渐起",
        "maxRank": 0,
        "summary": "沃利贝尔的攻击和技能会提供攻击速度，并且最终使他的攻击对附近的敌人们造成额外魔法伤害。",
        "bodyHtml": "沃利贝尔在每次用攻击或技能造成伤害时都会获得<span>(5% + (每100点法术强度3%))攻击速度</span>，持续6秒，至多可叠加5层。<br /><br />叠满5层时，沃利贝尔的双爪会激荡闪电，使他的攻击对目标和相距最近的4名敌人造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((11 ~ 58) + (45% 法术强度))魔法伤害</span>。",
        "iconFile": "Volibear_Icon_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "TalonPassive",
        "name": "刀锋之末",
        "maxRank": 0,
        "summary": "泰隆的技能会创伤英雄和大型野怪，可叠加3层。当泰隆用普攻攻击一个带有3层创伤效果的目标时，目标会流血，受到重度的持续伤害。",
        "bodyHtml": "泰隆的技能会对英雄和大型野怪施加一层效果，持续6秒(至多可叠3层)。<br /><br />当泰隆攻击一个带有3层效果的目标时，他会在2秒里持续造成共<span class=\"text-red-600 dark:text-red-500 font-semibold\">((80 ~ 280) + ([[si:scalead]]210% 额外攻击力))额外物理伤害</span>。",
        "iconFile": "TalonP.png",
        "cooldownSeconds": [],
        "range": [],

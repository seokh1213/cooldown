    "abilities": {
      "P": {
        "slot": "P",
        "id": "OriannaP",
        "name": "发条协奏",
        "maxRank": 0,
        "summary": "奥莉安娜的攻击会造成额外魔法伤害。这个伤害可在奥莉安娜对相同目标进行更多次攻击后提升。",
        "bodyHtml": "奥莉安娜的技能都源自她的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>。如果<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>与奥莉安娜相距太远，就会自动回到她身边。<br /><br />奥莉安娜的攻击会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(15% 法术强度)魔法伤害</span>。4秒内对相同目标的后续攻击会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(2.25% 法术强度)魔法伤害</span>(最大<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(4.5% 法术强度)伤害</span>)。",
        "iconFile": "OriannaPassive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

      "Q": {
        "slot": "Q",
        "id": "OrianaIzunaCommand",
        "name": "指令：攻击",
        "maxRank": 5,
        "summary": "奥莉安娜指挥她的魔偶，朝目标区域发射，对沿途目标造成魔法伤害（对后续目标伤害递减）。指令结束后魔偶会停在目标区域。",
        "bodyHtml": "奥莉安娜指挥她的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>移动至一个区域，对附近敌人和它途经的敌人造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + (55% 法术强度))魔法伤害</span>。对第一个敌人之后的所有敌人造成的伤害就减少30%。",
        "iconFile": "OrianaIzunaCommand.png",

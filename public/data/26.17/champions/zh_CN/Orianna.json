      "W": {
        "slot": "W",
        "id": "OrianaDissonanceCommand",
        "name": "指令：杂音",
        "maxRank": 5,
        "summary": "奥莉安娜指挥她的魔偶，释放能量脉冲，造成魔法伤害，并产生一个加速友军、减速敌军的能量场。",
        "bodyHtml": "奥莉安娜指挥她的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>释放一股电脉冲，对周围敌军造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(70/110/150/190/230 + (80% 法术强度))魔法伤害</span>。<br /><br />此电脉冲会留下持续3秒的能量场，使敌人<span class=\"text-purple-600 dark:text-purple-500\">减速</span>20/25/30/35/40%，并为友军提供<span class=\"text-cyan-600 dark:text-cyan-500\">20/25/30/35/40%移动速度</span>，在2秒里持续衰减。",
        "iconFile": "OrianaDissonanceCommand.png",

      "E": {
        "slot": "E",
        "id": "OrianaRedactCommand",
        "name": "指令：防卫",
        "maxRank": 5,
        "summary": "奥莉安娜指挥她的魔偶，依附于友军英雄身上，保护他们并对经过的敌人造成魔法伤害。此外，魔偶还会对依附的友军增加额外护甲和魔法抗性。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>为附身的友军英雄增加<span class=\"text-orange-600 dark:text-orange-400\">6/12/18/24/30护甲</span>和<span>6/12/18/24/30魔法抗性</span>。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动：</span>奥莉安娜指挥她的魔偶附身在一名友方英雄身上，为其提供<span class=\"text-blue-600 dark:text-blue-300\">(55/90/125/160/195 + (45% 法术强度))护盾值</span>，持续2.5秒。<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">魔偶</span>途经的敌方单位都会受到<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + (30% 法术强度))魔法伤害</span>。",
        "iconFile": "OrianaRedactCommand.png",

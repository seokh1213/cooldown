    "abilities": {
      "P": {
        "slot": "P",
        "id": "ViktorPassive",
        "name": "光荣进化",
        "maxRank": 0,
        "summary": "维克托会在击杀一名敌人后获得海克斯碎片。每获得100个海克斯碎片，维克托将永久强化一个主动技能。升级完所有基础技能后，他可以再收集100个海克斯碎片，用来强化自己的终极技能。",
        "bodyHtml": "维克托会在击杀一名敌人后获得<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">海克斯碎片</span>。每获得100个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">海克斯碎片</span>，维克托将永久升级一个主动技能。在维克托升级他的所有基础技能后，就能升级他的终极技能了。<br /><br />击杀小兵提供1个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">海克斯碎片</span>。<br />击杀炮兵提供10个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">海克斯碎片</span>。<br />参与击杀英雄提供20个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">海克斯碎片</span>。",
        "iconFile": "Viktor_Passive.png",
        "cooldownSeconds": [],

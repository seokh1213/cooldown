      "W": {
        "slot": "W",
        "id": "SowTheWind",
        "name": "和风守护",
        "maxRank": 5,
        "summary": "迦娜召唤出一个空气元素灵体，来被动地提升她的移动速度，并使她能够穿越单位。她也可以主动激活这个技能，来对一个敌人造成伤害和减速效果。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span>迦娜获得<span class=\"text-cyan-600 dark:text-cyan-500\">(6/7/8/9/10% + (0.02% 法术强度))移动速度</span>并处在幽灵状态。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动：</span>迦娜的风灵打击一名敌人，对其造成持续2秒的(20/24/28/32/36% + (0.06% 法术强度))<span class=\"text-purple-600 dark:text-purple-500\">减速</span>和<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(55/85/115/145/175 + (50% 法术强度)) + (30% 额外 移动速度)魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">幽灵状态的单位无视其它单位的碰撞体积。</span><br />",
        "iconFile": "SowTheWind.png",

      "Q": {
        "slot": "Q",
        "id": "EliseHumanQ",
        "name": "神经毒素 / 剧毒之蜇",
        "maxRank": 5,
        "summary": "人类形态：根据目标的当前生命值来造成伤害。<br><br>蜘蛛形态：戳刺目标，并根据目标已损失的生命值来造成伤害。",
        "bodyHtml": "<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">人类形态</span>：伊莉丝注入神经毒素，造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">40/70/100/130/160外加 (4% + ([[si:scaleap]]每100点法术强度3%))当前生命值的魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\"><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">人类形态</span>和<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">蜘蛛形态</span>的百分比生命值伤害对野怪的封顶值为(65/85/105/125/145 + ([[si:scaleap]]90% 法术强度))。</span>",
        "iconFile": "EliseHumanQ.png",

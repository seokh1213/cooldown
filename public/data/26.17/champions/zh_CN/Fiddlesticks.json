    "abilities": {
      "P": {
        "slot": "P",
        "id": "FiddleSticksPassive",
        "name": "巫骇草人",
        "maxRank": 0,
        "summary": "费德提克的饰品会被替换为【草间人】。",
        "bodyHtml": "费德提克的饰品会被替换为<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">草间人</span>。当被敌人发现时，<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">草间人</span>会暂时冒充费德提克。如果费德提克在2秒内没有移动，那么他将冒充成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">草间人</span>。在6级后，<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">草间人</span>可以显形附近的守卫，持续6秒。",
        "iconFile": "FiddlesticksP.png",
        "cooldownSeconds": [],
        "range": [],

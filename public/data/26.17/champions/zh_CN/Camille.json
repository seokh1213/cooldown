    "abilities": {
      "P": {
        "slot": "P",
        "id": "CamillePassive",
        "name": "适应性防御",
        "maxRank": 0,
        "summary": "对敌方英雄发起的普攻会基于该英雄的伤害类型（物理或魔法）提供一层专门吸收该类型伤害的护盾，护盾的生命值相当于卡蜜尔的一部分最大生命值，持续一小段时间。",
        "bodyHtml": "卡蜜尔对敌方英雄发起的攻击会基于该英雄的伤害类型(<span class=\"text-red-600 dark:text-red-500 font-semibold\">物理</span>或<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">魔法</span>)提供专门吸收该类型伤害的<span class=\"text-blue-600 dark:text-blue-300\">([[si:scalehealth]]20% 生命值)护盾</span>，持续2秒。这个效果有8秒的冷却时间。",
        "iconFile": "Camille_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

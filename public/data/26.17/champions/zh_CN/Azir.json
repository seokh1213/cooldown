      "P": {
        "slot": "P",
        "id": "AzirPassive",
        "name": "恕瑞玛的传承",
        "maxRank": 0,
        "summary": "阿兹尔可以从友方或敌方防御塔的废墟中召唤太阳圆盘。",
        "bodyHtml": "阿兹尔能够在一座防御塔的废墟上召唤<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">太阳圆盘</span>。<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">太阳圆盘</span>造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((230 ~ 410) + (40% 法术强度))魔法伤害</span>并且拥有(30 ~ 90) <span class=\"text-orange-600 dark:text-orange-400\">护甲</span>和<span>魔法抗性</span>，但会在45秒里持续瓦解。",

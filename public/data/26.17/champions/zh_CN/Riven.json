      "P": {
        "slot": "P",
        "id": "RivenPassive",
        "name": "符文之刃",
        "maxRank": 0,
        "summary": "锐雯的技能会为她的剑刃充能，并且她的普通攻击会消耗充能来造成额外伤害。",
        "bodyHtml": "使用一个技能后，会为锐雯提供一层持续6秒的充能(最多3层)。她的攻击会花费一层充能来造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">?物理伤害</span>。",
        "iconFile": "RivenRunicBlades.png",

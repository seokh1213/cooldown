    "abilities": {
      "P": {
        "slot": "P",
        "id": "TalonPassive",
        "name": "검의 최후",
        "maxRank": 0,
        "summary": "탈론이 챔피언이나 대형 몬스터에게 스킬을 사용하면 최대 3회까지 중첩되는 상처가 남습니다. 상처가 3회 중첩된 챔피언에게 기본 공격을 가하면 출혈을 일으켜 일정 시간 동안 큰 피해를 입힙니다.",
        "bodyHtml": "탈론이 챔피언이나 대형 정글 몬스터에게 스킬을 사용해 피해를 입히면 6초 동안 중첩을 적용합니다. (최대 3회 중첩)<br /><br />3회 중첩된 대상에게 탈론이 기본 공격을 가하면 2초에 걸쳐 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(210% 추가 공격력)의 물리 피해</span>를 추가로 입힙니다.",
        "iconFile": "TalonP.png",

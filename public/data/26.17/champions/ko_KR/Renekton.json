    "abilities": {
      "P": {
        "slot": "P",
        "id": "RenektonPredator",
        "name": "분노의 지배",
        "maxRank": 0,
        "summary": "레넥톤이 기본 공격 시 분노를 생성합니다. 레넥톤의 체력이 낮으면 생성되는 분노가 증가합니다. 분노는 레넥톤의 스킬을 강화시키며 추가 효과를 줍니다.",
        "bodyHtml": "레넥톤이 기본 공격을 가할 때마다 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5의 분노</span>를 얻습니다. <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">분노가 50</span> 이상 쌓이면 다음 스킬 사용 시 소모되어 스킬이 강화됩니다. 전투에서 벗어나면 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">분노</span>가 서서히 감소합니다.<br /><br />체력이 50% 미만일 경우 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">분노</span>가 50% 증가합니다.",
        "iconFile": "Renekton_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

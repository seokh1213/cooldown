    "abilities": {
      "P": {
        "slot": "P",
        "id": "LeonaSunlightPassive",
        "name": "햇빛",
        "summary": "공격 스킬은 대상에게 1.5초 동안 햇빛 효과를 부여합니다. 아군 챔피언이 햇빛에 걸린 적을 공격하면 햇빛 효과가 사라지며 추가 마법 피해를 줍니다.",
        "bodyHtml": "레오나의 스킬은 적에게 2.5초 동안 표식을 남깁니다. 아군 챔피언이 공격할 경우 표식을 터트리면서 적에게 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">의 마법 피해</span>를 추가로 입힙니다.",
        "iconFile": "LeonaSunlight.png",

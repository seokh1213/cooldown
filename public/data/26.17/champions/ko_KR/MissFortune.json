      "P": {
        "slot": "P",
        "id": "MissFortunePassive",
        "name": "사랑의 한 방",
        "maxRank": 0,
        "summary": "미스 포츈은 새로운 대상에게 기본 공격을 가할 때마다 추가 물리 피해를 입힙니다.",
        "bodyHtml": "미스 포츈이 새로운 대상에게 기본 공격을 가하면 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(100% 공격력)의 물리 피해</span>를 추가로 입힙니다. <br /><br /><span>?</span> 효과 발동 시 <span>?</span> 스킬의 재사용 대기시간이 ?초 감소합니다.",
        "iconFile": "MissFortune_W.png",

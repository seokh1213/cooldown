    "abilities": {
      "P": {
        "slot": "P",
        "id": "LilliaP",
        "name": "꿈나무 지팡이",
        "maxRank": 0,
        "summary": "챔피언 또는 몬스터에게 스킬이 적중하면 지속시간 동안 최대 체력에 비례한 피해를 추가로 입힙니다.",
        "bodyHtml": "릴리아의 스킬이 적에게 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">꿈가루</span>를 묻혀 3초 동안 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">최대 체력의 (5% + (0.012% 주문력))에 해당하는 마법 피해</span>를 입힙니다. 대상이 대형 정글 몬스터인 경우 릴리아가 지속시간 동안 <span class=\"text-green-600 dark:text-green-400\">(39 + (15% 주문력))의 체력</span>을 회복하며, 대상이 챔피언인 경우 <span class=\"text-green-600 dark:text-green-400\">(30% 주문력)의 체력</span>을 회복합니다.",
        "iconFile": "Lillia_Icon_Passive.png",

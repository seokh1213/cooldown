    "abilities": {
      "P": {
        "slot": "P",
        "id": "EkkoPassive",
        "name": "Z 드라이브 공진",
        "maxRank": 0,
        "summary": "같은 대상에 대한 세 번째 기본 공격 및 스킬 공격마다 추가 마법 피해를 입힙니다. 대상이 챔피언일 경우, 에코의 이동 속도가 상승합니다.<br><br>",
        "bodyHtml": "같은 대상에 대한 세 번째 기본 공격 및 스킬 공격마다 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(30 + (80% 주문력))의 마법 피해</span>를 추가로 입힙니다. 대상이 챔피언인 경우, 3초 동안 에코의 <span class=\"text-cyan-600 dark:text-cyan-500\">이동 속도가 80%</span> 증가합니다. 이 효과는 동일 적에게 4초에 한 번만 발동됩니다.",
        "iconFile": "Ekko_P.png",
        "cooldownSeconds": [],

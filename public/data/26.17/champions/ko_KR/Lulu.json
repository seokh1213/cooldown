    "abilities": {
      "P": {
        "slot": "P",
        "id": "LuluPassive",
        "name": "요정 친구 픽스",
        "maxRank": 0,
        "summary": "픽스는 현재 따라다니는 챔피언이 적 유닛을 공격할 때마다 함께 마법 광선을 발사합니다. 이 마법 광선은 목표를 추적하지만, 다른 유닛이 막아서 대신 맞을 수 있습니다.",
        "bodyHtml": "요정 픽스가 룰루를 돕습니다. 룰루가 기본 공격 시 픽스도 같은 대상에게 광선을 3번 발사해 처음 적중한 적에게 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(15% 주문력)의 마법 피해</span>를 입힙니다.",
        "iconFile": "Lulu_PixFaerieCompanion.png",

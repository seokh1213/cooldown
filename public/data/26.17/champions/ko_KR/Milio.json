    "abilities": {
      "P": {
        "slot": "P",
        "id": "MilioPassive",
        "name": "타오르는 힘",
        "maxRank": 0,
        "summary": "밀리오의 스킬에 닿은 아군은 다음 공격으로 큰 추가 피해를 입히고 대상을 불태웁니다.",
        "bodyHtml": "밀리오의 스킬에 닿은 아군 챔피언의 다음 기본 공격 또는 스킬이 <span class=\"text-red-600 dark:text-red-500 font-semibold\">아군 공격력의 15%</span>에 해당하는 추가 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">마법 피해</span>를 입히며, 1.5초 동안 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((10 ~ 50) + ([[si:scaleap]]20% 주문력))의 마법 피해</span>를 입힙니다.",
        "iconFile": "Milio_P.png",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "NunuPassive",
        "name": "프렐요드의 부름",
        "summary": "누누가 윌럼프와 주변 아군 1명의 공격 속도와 이동 속도를 증가시키고, 윌럼프의 기본 공격이 대상 근처의 적에게 피해를 줍니다.",
        "bodyHtml": "챔피언, 대형 정글 몬스터, 또는 구조물에 피해를 입히면 4초 동안 누누와 윌럼프, 주변 아군의 공격 속도가 <span>20%</span> 증가하고 이동 속도가 <span class=\"text-cyan-600 dark:text-cyan-500\">10%</span> 증가합니다.<br /><br />강화 효과가 지속되는 동안 기본 공격 시 주변 적들에게 최대 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(30% 공격력)의 추가 물리 피해</span>를 입힙니다.",
        "iconFile": "NunuPassive.png",
        "cooldownSeconds": [],
        "range": [],

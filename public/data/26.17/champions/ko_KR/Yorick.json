    "abilities": {
      "P": {
        "slot": "P",
        "id": "YorickPassive",
        "name": "영혼의 길잡이",
        "maxRank": 0,
        "summary": "<font color='#FF9900'>저주받은 무리:</font> 요릭이 안개 망령 무리를 소환해 주변 적을 공격합니다.",
        "bodyHtml": "요릭 근처에서 적 2명이 죽을 때마다 무덤이 생성됩니다. 챔피언 및 대형 몬스터가 죽으면 항상 무덤이 생성됩니다.<br /><br />이 무덤을 사용하여 범위 내에서 <span class=\"text-green-600 dark:text-green-400\">(15% 추가 체력)의 체력</span>과 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(20% 추가 공격력)의 공격력</span>을 지닌 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">안개 망령</span>을 최대 4명 <span>각성</span>시킬 수 있습니다.",
        "iconFile": "Yorick_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

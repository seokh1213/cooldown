      "P": {
        "slot": "P",
        "id": "YunaraPassive",
        "name": "최초의 땅의 맹세",
        "maxRank": 0,
        "summary": "유나라의 치명타가 추가 마법 피해를 입힙니다.",
        "bodyHtml": "유나라의 치명타가 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10% + (0.1% 주문력))의 마법 피해</span>를 추가로 입힙니다.",

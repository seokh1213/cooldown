    "abilities": {
      "P": {
        "slot": "P",
        "id": "DianaPassive",
        "name": "서늘한 달빛 검",
        "maxRank": 0,
        "summary": "3번째 공격마다 근처 적들을 베어 추가 마법 피해를 입힙니다. 스킬 사용 후 5초 동안 공격 속도가 증가합니다.",
        "bodyHtml": "다이애나의 <span>공격 속도가 (15% ~ 35%)</span> 증가합니다. 스킬을 사용한 후에는 5초 동안 추가 공격 속도가 <span>45/105%</span>까지 증가합니다.<br /><br />3번째 기본 공격마다 주위 적들을 베어 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20 + (50% 주문력))의 추가 마법 피해</span>를 입힙니다.",
        "iconFile": "Diana_Passive_LunarBlade.png",

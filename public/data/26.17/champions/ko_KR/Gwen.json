    "abilities": {
      "P": {
        "slot": "P",
        "id": "GwenP",
        "name": "가위 난도질",
        "summary": "그웬의 기본 공격이 대상의 체력에 비례해 추가 마법 피해를 입힙니다. 챔피언을 상대로 기본 공격 시 해당 피해의 일부만큼 체력을 회복합니다. ",
        "bodyHtml": "그웬의 기본 공격이 적중 시 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">최대 체력의 (1% + (0.006% 주문력))에 해당하는 마법 피해</span>를 추가로 입힙니다. 그웬은 이 스킬로 챔피언에게 입힌 <span class=\"text-green-600 dark:text-green-400\">피해량의 67%</span>만큼 체력을 회복합니다. (최대 <span class=\"text-green-600 dark:text-green-400\">(7% 주문력)</span>)<br />",
        "iconFile": "Gwen_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "conditions": [],
        "source": "communitydragon",

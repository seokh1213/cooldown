    "abilities": {
      "P": {
        "slot": "P",
        "id": "LockePassive",
        "name": "은빛 말뚝",
        "summary": "기본 공격 적중 시 추가 마법 피해를 입힙니다. 피해량은 적이 잃은 체력에 비례해 증가합니다.",
        "bodyHtml": "기본 공격 적중 시 추가로 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10% 주문력)의 마법 피해</span>를 입힙니다. 피해량은 대상이 잃은 체력에 비례해 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20% 주문력)의 마법 피해</span>까지 증가합니다.",
        "iconFile": "Locke_Passive.png",
        "cooldownSeconds": [],

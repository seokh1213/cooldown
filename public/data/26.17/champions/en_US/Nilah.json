      "W": {
        "slot": "W",
        "id": "NilahW",
        "name": "Jubilant Veil",
        "maxRank": 5,
        "summary": "Nilah envelops herself in mist, increasing her movement speed and allowing her to gracefully dodge all incoming attacks. Any allies she touches during the mist's duration will also gain this effect.",
        "bodyHtml": "Nilah envelops herself in mist for 2.25 seconds, becoming Ghosted, gaining <span class=\"text-cyan-600 dark:text-cyan-500\">15/17.5/20/22.5/25% Move Speed</span>, dodging Attacks, and reducing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">magic damage</span> taken by 25%.<br /><br />While active, touching allied champions envelops them in mist, granting the same benefits for 1.5 seconds.<br /><br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Ghosted units can pass through other units.</span>",

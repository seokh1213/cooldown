        "id": "MonkeyKingPassive",
        "name": "Stone Skin",
        "maxRank": 0,
        "summary": "Wukong gains stacking armor and max health regeneration while fighting champions and monsters.",
        "bodyHtml": "Wukong gains <span class=\"text-orange-600 dark:text-orange-400\">(6 ~ 10) Armor</span> and regenerates <span class=\"text-green-600 dark:text-green-400\">0.35% max Health per 5 seconds</span>. These bonuses are increased by 100% for 5 seconds every time he or his <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Clone</span> hit an enemy champion or jungle monster with an Attack or Ability, stacking up to 5 times.",

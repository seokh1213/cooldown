      "W": {
        "slot": "W",
        "id": "MonkeyKingDecoy",
        "name": "Warrior Trickster",
        "maxRank": 5,
        "summary": "Wukong becomes <font color='#91d7ee'>Invisible</font> and dashes in a direction, leaving behind a clone that will attack nearby enemies.",
        "bodyHtml": "Wukong dashes and becomes <span class=\"text-purple-600 dark:text-purple-400 font-semibold\">Invisible</span> for 1 second, leaving behind a stationary <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Clone</span> for 4 seconds.<br /><br />The <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Clone</span> Attacks nearby enemies Wukong has recently damaged and will mimic his ultimate, each dealing 40/45/50/55/60% of normal damage.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\"><span class=\"text-purple-600 dark:text-purple-400 font-semibold\">Invisible</span> units cannot be revealed except by turrets or true sight.</span>",

      "P": {
        "slot": "P",
        "id": "NaafiriP",
        "name": "We Are More",
        "maxRank": 0,
        "summary": "Naafiri spawns packmates that attack the targets of her attacks and abilities.",
        "bodyHtml": "Naafiri creates a <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Packmate</span> every 10 seconds that will Attack enemies that she targets for <span class=\"text-red-600 dark:text-red-500 font-semibold\">(4% bonus Attack Damage) physical damage</span>, increased to <span class=\"text-red-600 dark:text-red-500 font-semibold\">(5.2% bonus Attack Damage)</span> after she uses an Ability. <br /><br />Hitting champions and large monsters with Abilities reduces this Ability's Cooldown by 4 seconds. Killing enemies reduces it by 1 seconds.<br /><br />Max <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Packmates</span>: 5",

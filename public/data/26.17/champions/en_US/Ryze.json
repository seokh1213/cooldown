        "name": "Arcane Mastery",
        "maxRank": 0,
        "summary": "<mainText>Ryze's spells deal extra damage based on his Bonus Mana, and he gains a percentage increase to his maximum Mana based on his Ability Power.</mainText>",
        "bodyHtml": "Ryze gains <span>([[si:scaleap]]10% Ability Power)max Mana</span>. His Abilities do additional damage based on his <span>bonus Mana</span>.",

      "Q": {
        "slot": "Q",
        "id": "AmbessaQ",
        "name": "Cunning Sweep / Sundering Slam",
        "maxRank": 5,
        "summary": "Ambessa sweeps her twin drakehounds in a semicircle in front of her, dealing bonus damage to enemies hit by the blades. Striking an enemy will transform the next cast of this ability for a short period of time, causing her to slam her twin drakehounds down in a line in front of her, dealing bonus damage to the first enemy hit.",
        "bodyHtml": "<span class=\"text-gray-900 dark:text-white font-semibold\">Cunning Sweep</span>: Ambessa sweeps her blades forward, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(40/60/80/100/120 + (60% bonus Attack Damage)) + (4/4.5/5/5.5/6% + (0.03% bonus Attack Damage)) max Health physical damage</span> to enemies at the edge of the strike. All other enemies take 50% damage. Striking an enemy readies a <span class=\"text-gray-900 dark:text-white font-semibold\">Sundering Slam</span>.<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">Sundering Slam</span>: Ambessa slams her blades down, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(50/75/100/125/150 + (90% bonus Attack Damage)) + (4/4.5/5/5.5/6% + (0.04% bonus Attack Damage)) max Health physical damage</span> against the first enemy hit. All other enemies take 50% damage.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">75 physical damage</span> to monsters.<br />The percent of max Health damage to monsters is capped at <span class=\"text-red-600 dark:text-red-500 font-semibold\">(100 ~ 300)</span>.</span>",
        "iconFile": "AmbessaQ.png",

      "E": {
        "slot": "E",
        "id": "RumbleGrenade",
        "name": "Electro Harpoon",
        "maxRank": 5,
        "summary": "Rumble launches a harpoon, electrocuting his target with magic damage, slowing their Move Speed, and reducing their Magic Resist. Rumble can carry 2 harpoons at a time. While in Danger Zone the damage and slow percentage is increased.",
        "bodyHtml": "Rumble launches an electrified harpoon, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(55/80/105/130/155 + (50% Ability Power)) magic damage</span>, <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> by 15/20/25/30/35% for 2 seconds, and reducing the enemy's <span>Magic Resist</span> by 10/12/14/16/18% for 4 seconds.<br /><br />Hitting an enemy who's already <span class=\"text-purple-600 dark:text-purple-500\">Slowed</span> by this Ability increases the <span class=\"text-purple-600 dark:text-purple-500\">Slow</span> to 30/40/50/60/70% and reduces the enemy's <span>Magic Resist</span> by 20/24/28/32/36%<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Danger Zone:</span> The harpoon deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(82.5/120/157.5/195/232.5 + (75% Ability Power)) magic damage</span> instead and the <span class=\"text-purple-600 dark:text-purple-500\">Slow</span> and reduced <span>Magic Resist</span> are increased by 50%.",

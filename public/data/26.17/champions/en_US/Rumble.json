      "W": {
        "slot": "W",
        "id": "RumbleShield",
        "name": "Scrap Shield",
        "maxRank": 5,
        "summary": "Rumble pulls up a shield, protecting him from damage and granting him a quick burst of speed. While in Danger Zone, the shield strength and speed bonus is increased.",
        "bodyHtml": "Rumble tosses up a barrier, gaining <span class=\"text-blue-600 dark:text-blue-300\">(25/55/85/115/145 + (30% Ability Power) + (4% Health)) Shield</span> for 1.5 seconds and <span class=\"text-cyan-600 dark:text-cyan-500\">10/15/20/25/30% Move Speed</span> for 1 second.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Danger Zone:</span> The barrier grants <span class=\"text-blue-600 dark:text-blue-300\">(37.5/82.5/127.5/172.5/217.5 + (45% Ability Power) + (6% Health)) Shield</span> and <span class=\"text-cyan-600 dark:text-cyan-500\">15/22.5/30/37.5/45% Move Speed</span> instead.",

      "Q": {
        "slot": "Q",
        "id": "PantheonQ",
        "name": "Comet Spear",
        "maxRank": 5,
        "summary": "Pantheon either thrusts his spear or throws his spear in the chosen direction.",
        "bodyHtml": "<span style=\"color: #FF8C00\">Tap:</span> Pantheon thrusts his spear, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(70/100/130/160/190 + (115% bonus Attack Damage)) physical damage</span> to enemies hit. Refunds 60% of this Ability's Cooldown.<br /><br /><span style=\"color: #FF8C00\">Hold:</span> Pantheon hurls his spear, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(70/100/130/160/190 + (115% bonus Attack Damage) + (50% Ability Power)) physical damage</span> to the first enemy hit and 50% less to further targets. <br /><br />This Ability is enhanced against enemies below 20% Health to deal <span class=\"text-red-600 dark:text-red-500 font-semibold\">(155/230/305/380/455 + (230% bonus Attack Damage)) physical damage</span> instead.<br /><br /><span style=\"color: #EDDA74\">Mortal Will Bonus:</span> Deals an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(115% bonus Attack Damage) physical damage</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals 80% damage to monsters.</span><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals 70% damage to minions.</span>",

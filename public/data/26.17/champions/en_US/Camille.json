      "Q": {
        "slot": "Q",
        "id": "CamilleQ",
        "name": "Precision Protocol",
        "maxRank": 5,
        "summary": "Camille's next attack deals bonus damage and grants bonus Move Speed. This spell can be recast for a short period of time, doing significantly increased bonus damage if Camille delays a period of time between the two attacks.",
        "bodyHtml": "Camille's next Attack deals an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(20/25/30/35/40% Attack Damage) physical damage</span> and grants her <span class=\"text-cyan-600 dark:text-cyan-500\">25/30/35/40/45% Move Speed</span> for 1 second. This ability can be <span class=\"text-yellow-600 dark:text-yellow-300\">Recast</span> in the next 3.5 seconds.<br /><br />If the <span class=\"text-yellow-600 dark:text-yellow-300\">Recast</span> Attack hits at least 1.5 seconds after the first, the bonus damage is increased to <span class=\"text-red-600 dark:text-red-500 font-semibold\">(40/50/60/70/80% Attack Damage)</span> and (40% ~ 100%) of the Attack's damage is converted into <span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">true damage</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">This Ability triggers spell effects upon dealing damage.</span>",

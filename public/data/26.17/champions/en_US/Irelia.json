      "P": {
        "slot": "P",
        "id": "IreliaPassive",
        "name": "Ionian Fervor",
        "maxRank": 0,
        "summary": "When Irelia strikes enemies with spells she gains stacking bonus Attack Speed. At maximum stacks she also gains bonus damage on hit.",
        "bodyHtml": "Irelia gains a stack for 6 seconds when she hits an enemy with an Ability (max 4). She gains <span>(10 ~ 25)Attack Speed</span> per stack, and at max stacks her Attacks deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((10 ~ 3) + ([[si:scalead]]20% bonus Attack Damage)) magic damage</span>.<br /><br />Attacking a champion, structure, or large monster refreshes the duration of the stacks. Irelia gains a stack for each champion hit, or if she hits at least one non-champion enemy.",
        "iconFile": "Irelia_Passive.png",

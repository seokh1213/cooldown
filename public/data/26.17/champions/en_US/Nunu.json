      "P": {
        "slot": "P",
        "id": "NunuPassive",
        "name": "Call of the Freljord",
        "maxRank": 0,
        "summary": "Nunu increases the attack speed and Move Speed of Willump and a nearby ally, and causes Willump's basic attacks to damage enemies around the target.",
        "bodyHtml": "When Nunu and Willump deal damage to champions, large jungle monsters, or structures, they and a nearby ally gain <span>20% Attack Speed</span> and <span class=\"text-cyan-600 dark:text-cyan-500\">10% Move Speed</span> for 4 seconds.<br /><br />Willump's Attacks deal an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">([[si:scalead]]30% Attack Damage) physical damage</span> to other nearby enemies while he has this buff.",
        "iconFile": "NunuPassive.png",

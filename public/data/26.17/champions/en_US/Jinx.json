      "P": {
        "slot": "P",
        "id": "JinxPassiveMarker",
        "name": "Get Excited!",
        "maxRank": 0,
        "summary": "Jinx receives massively increased Move Speed and Attack Speed whenever she helps kill or destroy an enemy champions epic jungle monster, or structure.",
        "bodyHtml": "Whenever a champion, epic monster, or structure that Jinx has dealt damage to within the last 3 seconds is killed or destroyed, she gains <span class=\"text-cyan-600 dark:text-cyan-500\">175% decaying Move Speed</span> and <span>25% Attack Speed</span> for 6 seconds.<br /><br />Champion takedowns stack the <span>Attack Speed</span> up to 5 times.",
        "iconFile": "Jinx_Passive.png",

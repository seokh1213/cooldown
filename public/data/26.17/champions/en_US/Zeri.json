      "Q": {
        "slot": "Q",
        "id": "ZeriQ",
        "name": "Burst Fire",
        "maxRank": 5,
        "summary": "Burst Fire shoots a burst of 7 rounds that deal attack damage to the first enemy hit. This Ability is treated as an Attack.",
        "bodyHtml": "Zeri fires a burst of 7 rounds that deals <span class=\"text-red-600 dark:text-red-500 font-semibold\">(22/26/30/34/38 + (102/104/106/108/110% Attack Damage)) physical damage</span> to the first enemy hit. This Ability is treated as an Attack.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">This Ability can crit, apply on-hit effects once per target, and hit anything that an Attack can. The Cooldown and cast time scale down with <span>Attack Speed</span> (max <span>1.5 attacks per second</span>). 60% of excess <span>Attack Speed</span> is converted into <span class=\"text-red-600 dark:text-red-500 font-semibold\">Attack Damage</span>.</span>",

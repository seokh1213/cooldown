      "E": {
        "slot": "E",
        "id": "ZeriE",
        "name": "Spark Surge",
        "maxRank": 5,
        "summary": "Zeri dashes a short distance and energizes Burst Fire to pierce through enemies. She will vault and grind over any terrain she touches.",
        "bodyHtml": "Zeri dashes a short distance and vaults over any terrain she touches, greatly extending the dash range. For the next 5 seconds, her shots of <span>Burst Fire</span> pierce dealing 80/85/90/95/100% damage to enemies after the first and an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(22/24/26/28/30 + (20% Ability Power)) magic damage</span> On-Hit to the first target struck. <br /><br />Hitting an enemy with an Attack reduces this Ability's cooldown by 0.5 seconds. Critical strikes reduce the cooldown by 1.5 seconds instead.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">On-hit damage is increased by Zeri's Critical Strike Chance and Critical Strike Damage at 100% effectiveness.<br />Pierce damage can critically strike but does not apply On-Hit effects.</span>",
        "iconFile": "ZeriE.png",

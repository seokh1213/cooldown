      "P": {
        "slot": "P",
        "id": "EvelynnPassive",
        "name": "Demon Shade",
        "maxRank": 0,
        "summary": "When out of combat, Evelynn enters Demon Shade. Demon Shade heals Evelynn when she is low on health and grants Camouflage after level 6.",
        "bodyHtml": "Evelynn enshrouds herself in her <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Demon Shade</span> after 4 seconds of not Attacking or using Abilities. <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Demon Shade</span> restores <span class=\"text-green-600 dark:text-green-400\">(15 ~ 150) Health per second</span> while below <span class=\"text-green-600 dark:text-green-400\">(250 + (250% Ability Power)) Health</span>. From level 6 onward, it also grants <span class=\"text-purple-600 dark:text-purple-400 font-semibold\">Camouflage</span>.<br /><br />Taking damage from champions or towers removes <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Demon Shade</span> for 1.5 seconds.",

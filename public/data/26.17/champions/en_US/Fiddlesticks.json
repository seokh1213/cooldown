    "abilities": {
      "P": {
        "slot": "P",
        "id": "FiddleSticksPassive",
        "name": "A Harmless Scarecrow",
        "summary": "Fiddlesticks' trinket is replaced by scarecrow effigies.",
        "bodyHtml": "Fiddlesticks' trinket is replaced by <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Scarecrow Effigies</span>. When discovered by enemies, <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Effigies</span> briefly impersonate Fiddlesticks. If Fiddlesticks does not move for 2 seconds, he will impersonate an <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Effigy</span>. At level six <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Effigies</span> reveal nearby wards for 6 seconds.",
        "iconFile": "FiddlesticksP.png",

      "Q": {
        "slot": "Q",
        "id": "SionQ",
        "name": "Decimating Smash",
        "maxRank": 5,
        "summary": "Sion charges a powerful swing in an area in front of himself that will deal damage to enemies when released. If he charges for enough time, enemies hit by the swing will also be knocked up and stunned.",
        "bodyHtml": "<span>Begin Charging</span>: Sion charges a heavy blow for up to 2 seconds.<br /><br /><span>Release</span>: Sion slams his axe down, briefly <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> and dealing between <span class=\"text-red-600 dark:text-red-500 font-semibold\">(30/45/60/75/90 + (40/50/60/70/80% Attack Damage)) and (90/155/220/285/350 + (120/150/180/210/240% Attack Damage)) physical damage</span> based on charge time. If Sion charged for at least 1 second, enemies are <span class=\"text-purple-600 dark:text-purple-500\">Knocked Up</span> and <span class=\"text-purple-600 dark:text-purple-500\">Stunned</span> for between 1.25 and 2.25 seconds based on charge time.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals 165% damage to jungle monsters and 60% damage to minions.</span>",
        "iconFile": "SionQ.png",

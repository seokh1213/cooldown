      "P": {
        "slot": "P",
        "id": "EkkoPassive",
        "name": "Z-Drive Resonance",
        "maxRank": 0,
        "summary": "Every third attack or damaging spell on the same target deals bonus magic damage, and grants Ekko a burst of speed if the target is a champion.<br><br>",
        "bodyHtml": "Every third Attack or damaging Ability on the same target deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((30 ~ 90) + (80% Ability Power)) magic damage</span>. If the target is a champion, Ekko gains <span class=\"text-cyan-600 dark:text-cyan-500\">80% Move Speed</span> for 3 seconds. This effect can't trigger on the same enemy more than once every 4 seconds.",
        "iconFile": "Ekko_P.png",

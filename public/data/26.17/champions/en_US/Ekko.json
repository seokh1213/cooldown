      "W": {
        "slot": "W",
        "id": "EkkoW",
        "name": "Parallel Convergence",
        "maxRank": 5,
        "summary": "Ekko's basic attacks deal bonus magic damage to low health enemies. He can cast Parallel Convergence to split the timeline, creating an anomaly after a few seconds that slows enemies caught inside. If Ekko enters the anomaly, he gains shielding and stuns enemies by suspending them in time.",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">Passive:</span> Ekko's Attacks against enemies below 30% Health deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(3% + (3% per 100 Ability Power)) missing Health magic damage</span>.<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">Active:</span> Ekko launches a chronosphere lasting 1.5 seconds after a delay that <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> enemies inside by 40%. If Ekko enters the sphere, he detonates it, <span class=\"text-purple-600 dark:text-purple-500\">Stunning</span> for 2.25 seconds and gaining <span class=\"text-blue-600 dark:text-blue-300\">(100/120/140/160/180 + (150% Ability Power)) Shield</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Bonus Attack damage deals a min of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">15</span> and a max of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">150 damage</span> against minions and monsters.</span>",
        "iconFile": "EkkoW.png",

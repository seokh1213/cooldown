      "R": {
        "slot": "R",
        "id": "UrgotR",
        "name": "Fear Beyond Death",
        "maxRank": 3,
        "summary": "Urgot fires a chem-drill that impales the first enemy champion hit. If that champion falls below a health threshold, Urgot judges them weak and can execute them.",
        "bodyHtml": "Urgot fires a chem-drill, impaling the first champion hit, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(100/225/350 + ([[si:scalead]]50% bonus Attack Damage)) physical damage</span> and <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> for 4 seconds by 1% per 1% missing Health, up to 75%.<br /><br />If the impaled victim falls below 25% Health, Urgot can <span class=\"text-yellow-600 dark:text-yellow-300\">Recast</span> this Ability, <span class=\"text-purple-600 dark:text-purple-500\">Suppressing</span> the victim and dragging them to himself. On reaching Urgot, they are killed and nearby enemies are <span class=\"text-purple-600 dark:text-purple-500\">Feared</span> for 1.5 seconds.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">This Ability will automatically <span class=\"text-yellow-600 dark:text-yellow-300\">Recast</span> at the end of the duration if the victim is under the execution threshold.</span>",

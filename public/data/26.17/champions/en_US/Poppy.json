      "P": {
        "slot": "P",
        "id": "PoppyPassive",
        "name": "Iron Ambassador",
        "maxRank": 0,
        "summary": "Poppy throws her buckler that bounces off the target. Poppy can pick it up to gain a temporary shield.",
        "bodyHtml": "Every 8 seconds, Poppy's next Attack throws her buckler, gaining 350 range and dealing an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20 ~ 180) magic damage</span>. The buckler ricochets off the target, landing nearby. Poppy can pick it up to gain <span class=\"text-blue-600 dark:text-blue-300\">(11/20% Health) Shield</span>, and enemies can step on it to destroy it.<br /><br />The buckler automatically returns to Poppy if it kills the target.",

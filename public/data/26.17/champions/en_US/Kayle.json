      "P": {
        "slot": "P",
        "id": "KaylePassive",
        "name": "Divine Ascent",
        "maxRank": 0,
        "summary": "Kayle's attacks are empowered by the heavens as she levels up and spends skill points. Her wings are lit aflame as she progressively gains Attack Speed, Move Speed, Attack Range, and waves of fire on her attacks.",
        "bodyHtml": "Kayle's attacks rank up as she gains levels and spends skill points.<br /><br /><span><span><span class=\"text-gray-600 dark:text-gray-400\">Level 1 - Zealous:</span> Attacks grant <span>6% Attack Speed</span> for 5 seconds (max 5 stacks). At max stacks Kayle becomes Exalted, gaining <span class=\"text-cyan-600 dark:text-cyan-500\">10% Move Speed</span>.<br /></span><span><span class=\"text-gray-600 dark:text-gray-400\">Level 6 - Arisen: </span>Attack range is increased to 525.<br /></span><span><span class=\"text-gray-600 dark:text-gray-400\">Level 11 - Aflame:</span> Exalted attacks launch fire waves that deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20 + (25% Ability Power) + (10% bonus Attack Damage)) magic damage</span>.<br /></span><span><span class=\"text-gray-600 dark:text-gray-400\">Level 16 - Transcendent:</span> Become permanently Exalted. Attack range is increased to 625.</span></span>",
        "iconFile": "Kayle_P.png",

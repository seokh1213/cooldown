    "abilities": {
      "P": {
        "slot": "P",
        "id": "SyndraPassive",
        "name": "Transcendent",
        "maxRank": 0,
        "summary": "Syndra collects Splinters of Wrath from gaining levels and damaging enemies which upgrade her abilities.<br><br><font color='#FF9900'>Dark Sphere</font>: Syndra can hold an additional charge<br><font color='#FF9900'>Force of Will</font>: Bonus true damage.<br><font color='#FF9900'>Scatter the Weak</font>: Increased width and slows all targets<br><font color='#FF9900'>Unleashed Power</font>: Executes low health targets",
        "bodyHtml": "Syndra can collect up to 120 <span>Splinters of Wrath</span>. These enhance Syndra's Abilities and restore <span>(20 ~ 195) Mana</span> each time she claims one from an enemy. <br /><br />Syndra collects <span>Splinters of Wrath</span> from the following:<span><span>3 Splinter(s)</span> when damaging enemy champions with two Abilities within 4 seconds (8s Cooldown)<span><span>5 Splinters</span> upon spending Ability points<span><span>1 Splinter</span> on killing large minions<br /><br />At 120 <span>Splinters of Wrath</span>, Syndra increases her <span class=\"text-blue-600 dark:text-blue-400\">Ability Power by 15%</span>.<br />",
        "iconFile": "SyndraPassive.png",

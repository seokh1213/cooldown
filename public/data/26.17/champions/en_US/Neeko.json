      "Q": {
        "slot": "Q",
        "id": "NeekoQ",
        "name": "Blooming Burst",
        "maxRank": 5,
        "summary": "Neeko throws a seed dealing magic damage. The seed blooms again on hitting champions or killing units.",
        "bodyHtml": "Neeko throws a seed that blooms to deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/110/160/210/260 + (60% Ability Power)) magic damage</span>. If it kills a unit or hits a champion or large monster, it will bloom again, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(35/60/85/110/135 + (25% Ability Power)) magic damage</span>. Max 2 extra blooms.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Each bloom deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">35/50/65/80/95 magic damage</span> to monsters.</span>",

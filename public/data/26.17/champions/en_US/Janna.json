      "W": {
        "slot": "W",
        "id": "SowTheWind",
        "name": "Zephyr",
        "maxRank": 5,
        "summary": "Janna summons an air elemental that passively increases her Move Speed and enables her to pass through units. She may also activate this ability to deal damage and slow an enemy's Move Speed.",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">Passive:</span> Janna gains <span class=\"text-cyan-600 dark:text-cyan-500\">(6/7/8/9/10% + (0.02% Ability Power)) Move Speed</span> and is Ghosted.<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">Active:</span> Janna's elemental strikes an enemy, <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> them by (20/24/28/32/36% + (0.06% Ability Power)) for 2 seconds, and dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(55/85/115/145/175 + (50% Ability Power)) + (30% bonus Movement Speed) magic damage</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Ghosted units ignore collision with other units.</span><br />",

      "Q": {
        "slot": "Q",
        "id": "QiyanaQ",
        "name": "Elemental Wrath / Edge of Ixtal",
        "maxRank": 5,
        "summary": "Qiyana swings her weapon, dealing damage with a bonus effect based on her element.",
        "bodyHtml": "If Qiyana does not have an <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Enchantment</span>, she slashes, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(80/110/140/170/200 + (90% bonus Attack Damage)) physical damage</span> to enemies in a small area. If she does, this Ability gains extra range and an additional effect based on the type of <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Enchantment</span>:<span><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Ice Enchantment</span>: Briefly <span class=\"text-purple-600 dark:text-purple-500\">Roots</span>, then <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> by 20% for 1 second.<span><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Rock Enchantment</span>: Deals an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(48/66/84/102/120 + (54% bonus Attack Damage)) physical damage</span> to units below 50% Health.<span><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Wild Enchantment</span>: Leaves a trail that turns Qiyana <span class=\"text-purple-600 dark:text-purple-400 font-semibold\">Invisible</span> and grants <span class=\"text-cyan-600 dark:text-cyan-500\">20% Move Speed</span>.<br /><br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Enemies beyond the first take <span class=\"text-red-600 dark:text-red-500 font-semibold\">75% physical damage</span> instead.<br />This Ability deals 160% damage to jungle monsters.<br /><span class=\"text-purple-600 dark:text-purple-400 font-semibold\">Invisible</span> units cannot be revealed except by turrets or <span style=\"color: #ee91d7\">True Sight</font color>.</span>",
        "iconFile": "QiyanaQ.png",

      "R": {
        "slot": "R",
        "id": "HweiR",
        "name": "Spiraling Despair",
        "maxRank": 3,
        "summary": "Hwei paints a vision of pure despair. The first enemy champion struck becomes the center of an expanding painting that slows and damages nearby enemies. The vision explodes after reaching its maximum size or when the champion dies.",
        "bodyHtml": "Hwei launches a vision of pure despair that sticks to an enemy champion for 3 seconds. The vision expands over time applying a <span class=\"text-purple-600 dark:text-purple-500\">Slow</span> to enemies for 10% stacking every 0.25 seconds, and dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10/20/30 + (5% Ability Power)) magic damage per second</span>.<br /><br />Upon completion, the vision shatters, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(200/325/450 + (80% Ability Power)) magic damage</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Maximum damage possible is <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(230/385/540 + (95% Ability Power)) magic damage</span>.</span>",

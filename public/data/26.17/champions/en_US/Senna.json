      "Q": {
        "slot": "Q",
        "id": "SennaQ",
        "name": "Piercing Darkness",
        "maxRank": 5,
        "summary": "From the twin barrels of her Relic Cannon, Senna fires a unified beam of light and shadow through a target, healing allies and damaging enemies.",
        "bodyHtml": "Senna shoots a bolt of piercing shadow through an ally or enemy, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(30/55/80/105/130 + (60% bonus Attack Damage)) physical damage</span> to enemies and <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> them by (15% + (0.07% Ability Power) + (0.15% bonus Attack Damage)) for 1/1.25/1.5/1.75/2 second(s). Restores <span class=\"text-green-600 dark:text-green-400\">(40/60/80/100/120 + (35% Ability Power) + (40% bonus Attack Damage)) Health</span> to allied champions. <br /><br />Attacks reduce this Ability's Cooldown by 1 second.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">This Ability's cast range matches Senna's attack range and its cast time is improved with Attack Speed. It can target anything and applies on-hit effects to enemy champions.</span>",
        "iconFile": "SennaQ.png",

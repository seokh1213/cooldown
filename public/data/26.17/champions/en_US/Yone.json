      "W": {
        "slot": "W",
        "id": "YoneW",
        "name": "Spirit Cleave",
        "maxRank": 5,
        "summary": "Cleaves forward, damaging all enemies in a cone. Grants a shield to Yone, the value is increased by the number of champions hit by the swipe.<br><br>Spirit Cleave's cooldown and cast time scale with attack speed.",
        "bodyHtml": "Yone cleaves forward, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">5/10/15/20/25 + 4/4.5/5/5.5/6% max Health physical damage</span> and <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">5/10/15/20/25 + 4/4.5/5/5.5/6% max Health magic damage</span>.<br /><br />If Yone hits, he gains <span class=\"text-blue-600 dark:text-blue-300\">(65% bonus Attack Damage) Shield</span> for 1.5 seconds. The amount of <span class=\"text-blue-600 dark:text-blue-300\">Shield</span> increases for each champion struck.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Shield increased by 100% for the first champion hit and 50% for all subsequent champions.<br />This abilities cooldown and cast time are reduced by Attack Speed.<br />Minimum <span class=\"text-gray-600 dark:text-gray-400\">(30 ~ 30)</span> total damage against minions.</span>",

      "E": {
        "slot": "E",
        "id": "TahmKenchE",
        "name": "Thick Skin",
        "maxRank": 5,
        "summary": "<passive>Passive:</passive> Tahm Kench stores a percent of the damage he takes and heals based on it while out of combat.<br><br><active>Active:</active> Convert all stored damage into a temporary shield.",
        "bodyHtml": "<span>Passive:</span> 15/23/31/39/47% of damage Tahm Kench takes is stored by his <span>Thick Skin</span>, increased to 42/44/46/48/50% if there are at least 2 nearby enemy champions. If Kench has not taken damage within 4 seconds, <span>Thick Skin</span> will rapidly be consumed to heal Tahm for (60% ~ 100%) of its value.<br /><br /><span>Active:</span> Convert all your stored <span>Thick Skin</span> into a <span class=\"text-blue-600 dark:text-blue-300\">Shield</span>, lasting 2.5 seconds.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Grey Health is capped at (300% Health)</span>",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "TahmKenchPassive",
        "name": "An Acquired Taste",
        "maxRank": 0,
        "summary": "Tahm Kench puts the heft of his immense body behind his attacks, gaining extra damage based on his total health. Damaging enemy champions builds stacks of <spellName>An Acquired Taste</spellName>. At three stacks, he can use <spellName>Devour</spellName> on an enemy champion.",
        "bodyHtml": "Attacks deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10 + (4% bonus Health) + (0% Ability Power)) bonus magic damage</span>. Against champions, they add a stack of <span>An Acquired Taste</span> for 5 seconds, up to 3 times.<br /><br />At 3 stacks, <span>Tongue Lash</span> and <span style=\"color: #0bf7de\">Devour</span> become empowered against that champion.",
        "iconFile": "TahmKenchP.png",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "AkshanPassive",
        "name": "Dirty Fighting",
        "maxRank": 0,
        "summary": "Every three hits from Akshan's Attacks and Abilities deals bonus damage and grants him a Shield if the target was a champion.<br><br>When Akshan Attacks, he fires an additional Attack for reduced damage. If he cancels the additional Attack, he instead gains Move Speed.",
        "bodyHtml": "After launching an Attack, Akshan will fire an additional shot for <span class=\"text-red-600 dark:text-red-500 font-semibold\">(50% Attack Damage) physical damage</span>. He can cancel this shot to instead gain <span class=\"text-cyan-600 dark:text-cyan-500\">(20 ~ 75) × (1 + 100% bonus Attack Speed) Move Speed</span> decaying over 1 second.<br /><br />Every three hits from Attacks or Abilities deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(150 + (60% Ability Power)) magic damage</span>. Against champions, Akshan also gains <span class=\"text-blue-600 dark:text-blue-300\">((40 ~ 280) + (35% bonus Attack Damage)) Shield</span> for 2 seconds (4 second Cooldown).<br /><br />",
        "iconFile": "akshan_p.png",

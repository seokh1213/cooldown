      "W": {
        "slot": "W",
        "id": "IllaoiW",
        "name": "Harsh Lesson",
        "maxRank": 5,
        "summary": "Illaoi leaps to her target, dealing physical damage and causing nearby Tentacles to also swing at the target.",
        "bodyHtml": "Illaoi's next Attack causes her to leap at the target, dealing an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(3/3.5/4/4.5/5% + (0.035% Attack Damage)) max Health physical damage</span>. When she strikes, nearby Tentacles will <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Slam</span> at the target.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">The percent Health damage does a minimum of 20/30/40/50/60. Against jungle monsters the damage is capped at 300.<br />This Ability triggers spell effects upon dealing damage.</span>",

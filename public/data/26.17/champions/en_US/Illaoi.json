    "abilities": {
      "P": {
        "slot": "P",
        "id": "IllaoiPassive",
        "name": "Prophet of an Elder God",
        "maxRank": 0,
        "summary": "Illaoi and the <font color='#669900'>Vessels</font> she creates spawn Tentacles on nearby impassible terrain. Tentacles swing at spirits, <font color='#669900'>Vessels</font>, and victims of Illaoi's Harsh lesson. Tentacles deal physical damage to enemies hit, and will heal Illaoi if they damage a champion.",
        "bodyHtml": "<span>Prophet of an Elder God</span><span>Illaoi draws the presence of her god, spawning a Tentacle on nearby impassible terrain if no other Tentacles are nearby (<span style=\"color: #FFFFFF\">?</span> second cooldown). Tentacles will not attack on their own, but can be made to <span style=\"color: #85FFAD\">Slam</span> by Illaoi's abilities.<br /><br /><span style=\"color: #85FFAD\">Slam</span> deals <span style=\"color: #FFFFFF\">?</span> <span style=\"color: #FF8C00\">( + ?)</span><span class=\"text-blue-600 dark:text-blue-400\"> ( + ?)</span> physical damage. If <span style=\"color: #85FFAD\">Slam</span> damages one or more enemy champions, Illaoi is healed for ?% of her missing health.<br /><br /><span style=\"color: #919191\"><span>Enemies hit by multiple Slams at once take 50% damage beyond the first.<br />Tentacles last until killed or Illaoi is out of range for 1 minute.</span></span></span>",
        "iconFile": "Illaoi_P.png",

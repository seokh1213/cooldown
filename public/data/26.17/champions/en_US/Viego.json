    "abilities": {
      "P": {
        "slot": "P",
        "id": "ViegoPassive",
        "name": "Sovereign's Domination",
        "maxRank": 0,
        "summary": "Enemies who fall before Viego become wraiths. By attacking a wraith, Viego temporarily seizes control of the dead enemy's body, healing for a percentage of his target's max health and gaining access to their basic abilities and items. He replaces their Ultimate with a free cast of his own.",
        "bodyHtml": "The souls of enemy champions that die within 3 seconds of being hit by Viego become wraiths. Viego can Attack wraiths to <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Possess</span> them, restoring <span class=\"text-green-600 dark:text-green-400\">(2 + (2.5% bonus Attack Damage) + (2% Ability Power) + (500% bonus Attack Speed))of enemy's max Health</span> and gaining access to their non-ultimate Abilities, Attacks, and items for 10 seconds. During this time he replaces their Ultimate with a free cast of his own and gains <span class=\"text-cyan-600 dark:text-cyan-500\">10% Move Speed</span> towards enemy champions.",
        "iconFile": "Viego_Passive.png",

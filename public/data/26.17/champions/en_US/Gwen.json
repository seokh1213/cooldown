      "P": {
        "slot": "P",
        "id": "GwenP",
        "name": "A Thousand Cuts",
        "maxRank": 0,
        "summary": "Gwen's attacks deal bonus magic damage based on the targets health. She heals for a portion of the damage dealt to champions by this effect. ",
        "bodyHtml": "Gwen's Attacks deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(1% + (0.006% Ability Power)) Max Health magic damage</span> on hit. Gwen recovers Health equal to <span class=\"text-green-600 dark:text-green-400\">67% of the damage</span> this Ability deals to champions, up to a maximum of <span class=\"text-green-600 dark:text-green-400\">(7% Ability Power)</span>.<br />",
        "iconFile": "Gwen_Passive.png",

      "Q": {
        "slot": "Q",
        "id": "GwenQ",
        "name": "Snip Snip!",
        "maxRank": 5,
        "summary": "Gwen snips her scissors in a cone up to 6 times dealing magic damage. Gwen deals true damage to units in the center and applies her passive to them on each snip.",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">Passive</span>: Gwen gains 1 stack when she hits an enemy with an attack (max 4, lasts 6 seconds).<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">Active</span>: Consumes stacks. Gwen snips once for <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10/14/18/22/26 + (5% Ability Power)) magic damage</span>, snips again for each ammo consumed, and then snips a final time for <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/85/110/135/160 + (35% Ability Power)) magic damage</span>. <br /><br />The center of each strikes converts 50% of the damage into <span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">true damage</span> instead and applies <span>A Thousand Cuts</span> to enemies hit.<br /><span class=\"text-gray-600 dark:text-gray-400 italic\"><br />Deals 80% damage to minions.<br />Minions below 20% health take 1000% bonus damage instead of reduced damage.</span><br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Max damage: (110/155/200/245/290 + (60% Ability Power)), plus (6% + (0.036% Ability Power)) percent health from <span>A Thousand Cuts</span></span>.",
        "iconFile": "GwenQ.png",

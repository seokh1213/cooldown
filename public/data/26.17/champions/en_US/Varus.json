      "P": {
        "slot": "P",
        "id": "VarusPassive",
        "name": "Living Vengeance",
        "maxRank": 0,
        "summary": "On kill or assist, Varus temporarily gains Attack Damage and Ability Power. This bonus is larger if the enemy is a champion.",
        "bodyHtml": "When Varus kills an enemy, he gains <span>20% Attack Speed</span>, <span class=\"text-orange-600 dark:text-orange-500\">([[si:scaleas]]1100% bonus Attack Speed) Attack Damage</span>, and <span class=\"text-blue-600 dark:text-blue-400\">([[si:scaleas]]1100% bonus Attack Speed) Ability Power</span> for 11 seconds.<br /><br />Champion takedowns grant <span>30% Attack Speed</span> that can bypass the Attack Speed cap, <span class=\"text-orange-600 dark:text-orange-500\">([[si:scaleas]]3300% bonus Attack Speed) Attack Damage</span>, and <span class=\"text-blue-600 dark:text-blue-400\">([[si:scaleas]]3300% bonus Attack Speed) Ability Power</span> instead.",
        "iconFile": "VarusPassive.png",

      "E": {
        "slot": "E",
        "id": "SwainE",
        "name": "Nevermove",
        "maxRank": 5,
        "summary": "Swain launches a wave of demonic power forward. It then returns to Swain and roots enemies it hits. Swain can then choose to pull all rooted champions closer. This ability has a shorter cooldown during Demonic Ascension.",
        "bodyHtml": "Swain launches a wave of demonic power that returns, detonating on the first enemy hit to deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(90/130/170/210/250 + ([[si:scaleap]]70% Ability Power)) magic damage</span> and <span class=\"text-purple-600 dark:text-purple-500\">Root</span> enemies in the area for 1.5 seconds.<br /><br /><span class=\"text-purple-600 dark:text-purple-500\">Rooting</span> a champion allows Swain to reactivate this ability to pull all champions <span class=\"text-purple-600 dark:text-purple-500\">Rooted</span> by <span>Nevermove</span> toward him, gaining a <font color='#FF3F3F' size='18'>Soul Fragment</span> for each.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\"><span>Nevermove</span> temporarily grants vision of rooted champions.</span>",

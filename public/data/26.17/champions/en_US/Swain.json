      "R": {
        "slot": "R",
        "id": "SwainR",
        "name": "Demonic Ascension",
        "maxRank": 3,
        "summary": "Swain transforms into a demon and drains health from nearby enemy champions, minions, and neutral monsters. Swain can cast Demonflare to decimate and slow nearby enemies with a nova of soulfire. This form is indefinite as long as Swain drains enemy champions.",
        "bodyHtml": "Swain frees the demon, which deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(15/25/35 + ([[si:scaleap]]4% Ability Power)) magic damage</span> and drains <span class=\"text-green-600 dark:text-green-400\">(15/30/45 + ([[si:scaleap]]5% Ability Power) + ([[si:scalehealth]]1.5% bonus Health)) Health</span> per second from nearby enemies. His Demonic Energy depletes over time but can be recharged indefinitely by draining enemy Champions and is fully restored on Champion takedowns.<br /><br />After 2 seconds and every 8 seconds thereafter, Swain can cast <span>Demonflare</span> while transformed, which deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(150/250/350 + ([[si:scaleap]]40% Ability Power)) magic damage</span> and <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> enemies by 50%, decaying over 1.5s.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Healing is reduced to <span class=\"text-green-600 dark:text-green-400\">10%</span> against non-champions.<br />Depletes 10 Demonic Energy per second. After 5 seconds, this increases to 15.<br />Regenerates 20 Demonic Energy per second while draining from champions.</span>",
        "iconFile": "SwainR.png",

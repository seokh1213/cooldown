      "W": {
        "slot": "W",
        "id": "SwainW",
        "name": "Vision of Empire",
        "maxRank": 5,
        "summary": "Swain opens a demon eye that deals damage and slows enemies. Champions hit are revealed and also grant Swain a Soul Fragment.",
        "bodyHtml": "Swain opens a demon eye, revealing a location for 1.5 seconds, then deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(70/105/140/175/210 + ([[si:scaleap]]60% Ability Power)) magic damage</span> and <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> by 50% for 1.5 seconds.<br /><br />Champions hit grant Swain a <font color='#FF3F3F' size='18'>Soul Fragment</span> and are revealed for 6 seconds.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(35/52.5/70/87.5/105 + (30% Ability Power)) damage</span> instead to minions.</span>",

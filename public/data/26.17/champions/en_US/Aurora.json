      "P": {
        "slot": "P",
        "id": "AuroraPassive",
        "name": "Spirit Abjuration",
        "maxRank": 0,
        "summary": "Aurora's spells and attacks exorcise spirits from the enemies she damages. Exorcised spirits follow Aurora around and heal her.",
        "bodyHtml": "Damaging an enemy 3 times with Abilities or Attacks exorcises them, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(1% + (0.027% Ability Power)) max Health magic damage</span> and, if the enemy is a champion, frees a spirit that follows Aurora for 4 seconds, restoring her Health for <span class=\"text-green-600 dark:text-green-400\">(2% Ability Power)</span> every second.",
        "iconFile": "AuroraPassive.png",

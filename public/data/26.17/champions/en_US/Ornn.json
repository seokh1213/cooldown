      "W": {
        "slot": "W",
        "id": "OrnnW",
        "name": "Bellows Breath",
        "maxRank": 5,
        "summary": "Ornn advances, breathing fire. Enemies hit by the final gout of flame become Brittle.",
        "bodyHtml": "Ornn stomps forward Unstoppably while breathing fire, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">12/13/14/15/16% max Health magic damage</span> over 0.75 seconds. Enemies hit by the final bout of flame become <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Brittle</span> for 3 seconds.<br /><br /><span class=\"text-purple-600 dark:text-purple-500\">Immobilizing</span> effects on <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Brittle</span> targets have their duration increased by 30% and deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(9% ~ 17%) max Health magic damage</span>. Ornn's Attacks against <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Brittle</span> targets <span class=\"text-purple-600 dark:text-purple-500\">Knock</span> them <span class=\"text-purple-600 dark:text-purple-500\">Back</span>, dealing the additional damage.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals a minimum of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">80/130/180/230/280 magic damage</span> to champions and minions, and a max of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">260/320/380/440/500 magic damage</span> to jungle monsters.</span>",

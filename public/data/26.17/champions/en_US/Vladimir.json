      "E": {
        "slot": "E",
        "id": "VladimirE",
        "name": "Tides of Blood",
        "maxRank": 5,
        "summary": "Vladimir pays his own health to charge up a reservoir of blood which, when released, deals damage in the area around him but can be blocked by enemy units.",
        "bodyHtml": "<span>Begin Charging: </span>Vladimir charges up a reservoir of blood, spending up to <span style=\"color: #CC3300\">([[si:scalehealth]]8% Health) Health</span>. While at full charge, Vladimir is <span class=\"text-purple-600 dark:text-purple-500\">Slowed</span> by 20%.<br /><br /><span>Release: </span>Vladimir unleashes a torrent of blood missiles at surrounding enemies, dealing between <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(30/45/60/75/90 + ([[si:scalehealth]]1.5% Health) + ([[si:scaleap]]35% Ability Power))</span> and <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + ([[si:scalehealth]]6% Health) + ([[si:scaleap]]80% Ability Power)) magic damage</span> based on charge time. If this Ability was charged for at least 1 second, it also <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> targets by 40/45/50/55/60% for 0.5 seconds.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">This Ability releases automatically after 1.5 seconds.<br />Enemies can be hit by multiple blood missiles, but take no damage after the first.<br /></span>",
        "iconFile": "VladimirE.png",

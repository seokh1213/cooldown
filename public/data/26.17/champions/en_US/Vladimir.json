      "P": {
        "slot": "P",
        "id": "VladimirBloodGorged",
        "name": "Crimson Pact",
        "maxRank": 0,
        "summary": "Every 30 points of bonus Health gives Vladimir 1 Ability Power and every 1 point of Ability Power gives Vladimir 1.6 bonus Health (does not stack with itself).",
        "bodyHtml": "Vladimir gains <span class=\"text-blue-600 dark:text-blue-400\">1 Ability Power</span> for every <span>30 bonus Health</span>. He also gains <span>1.6 max Health</span> per <span class=\"text-blue-600 dark:text-blue-400\">1 Ability Power</span>.<br /><br /><span class=\"text-blue-600 dark:text-blue-400\">Bonus Ability Power: (([[si:scalehealth]]3.533% bonus Health) + ([[si:scaleap]]-5.653% Ability Power))</span><br /><span>Bonus Health: (([[si:scalead]]169.6% Attack Damage) + ([[si:scalehealth]]-5.653% bonus Health))</span>",

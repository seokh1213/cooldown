      "Q": {
        "slot": "Q",
        "id": "VladimirQ",
        "name": "Transfusion",
        "maxRank": 5,
        "summary": "Vladimir steals life from the target enemy. When Vladimir's resource is full, Transfusion will benefit from massively increased damage and healing for a brief time.",
        "bodyHtml": "Vladimir drains his target's lifeforce, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(80/100/120/140/160 + ([[si:scaleap]]60% Ability Power)) magic damage</span> and restoring <span class=\"text-green-600 dark:text-green-400\">(20/25/30/35/40 + ([[si:scaleap]]35% Ability Power)) Health</span>. After using this Ability twice, Vladimir gains <span class=\"text-cyan-600 dark:text-cyan-500\">40% Move Speed</span> for 0.5 seconds and empowers the next use of this Ability for 2.5 seconds.<br /><br />The empowered version of this Ability deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(148/185/222/259/296 + (111% Ability Power)) magic damage</span> instead and restores an additional <span class=\"text-green-600 dark:text-green-400\">(30 ~ 200) plus (5% + (4% per 100 Ability Power)) missing Health</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Empowered healing reduced to 30% against minions.</span>",
        "iconFile": "VladimirQ.png",

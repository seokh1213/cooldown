      "P": {
        "slot": "P",
        "id": "TryndamerePassive",
        "name": "Battle Fury",
        "summary": "Tryndamere gains Fury for each attack, critical strike, and killing blow he makes. Fury passively increases his Critical Strike Chance and can be consumed with his Bloodlust spell.",
        "bodyHtml": "Tryndamere's Attacks grant him <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5 Fury</span> or <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">10 Fury</span> for a critical strike, and <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">10 Fury</span> for killing a unit. After 8 seconds of being out of combat, Tryndamere loses <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5 Fury</span> every second.<br /><br />Each point of <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Fury</span> grants 0.5% Critical Strike Chance.",
        "iconFile": "Tryndamere_Passive.png",

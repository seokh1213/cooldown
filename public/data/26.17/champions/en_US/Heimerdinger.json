      "W": {
        "slot": "W",
        "id": "HeimerdingerW",
        "name": "Hextech Micro-Rockets",
        "maxRank": 5,
        "summary": "Heimerdinger fires long-range rockets that converge on his cursor.",
        "bodyHtml": "Heimerdinger unleashes a barrage of 5 rockets that deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(50/75/100/125/150 + (55% Ability Power)) magic damage</span> to the first enemy hit. Additional rocket hits deal reduced damage.<br /><br />Max Damage: <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(90/135/180/225/270 + (103% Ability Power)) magic damage</span>.<br /><br />Nearby <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Turrets</span> gain 20% charge per rocket that hits a champion.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Enemies hit by multiple rockets take <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10/15/20/25/30 + (12% Ability Power)) magic damage</span> beyond the first. Minions instead take <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(30/45/60/75/90 + (36% Ability Power)) magic damage</span> beyond the first</span>",

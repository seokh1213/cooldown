      "W": {
        "slot": "W",
        "id": "AhriW",
        "name": "Fox-Fire",
        "maxRank": 5,
        "summary": "Ahri gains a brief burst of Move Speed and releases three fox-fires, that lock onto and attack nearby enemies.",
        "bodyHtml": "Ahri releases 3 fox-fires that seek nearby enemies and deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(40/60/80/100/120 + ([[si:scaleap]]40% Ability Power)) magic damage</span>, reduced to <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(16/24/32/40/48 + (16% Ability Power)) damage</span> beyond the first. She also gains <span class=\"text-cyan-600 dark:text-cyan-500\">40% Move Speed</span> decaying over 2 seconds.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Fox-fires prioritize champions hit by <span>Charm</span>, enemies Ahri has attacked, then other champions. Minions below 20% Health take 200% damage.</span><br />",

      "P": {
        "slot": "P",
        "id": "PykePassive",
        "name": "Gift of the Drowned Ones",
        "maxRank": 0,
        "summary": "When Pyke is hidden from enemies, he regenerates damage that he has recently taken from champions. Pyke also cannot gain extra Maximum Health from any source, and instead gains Bonus AD.",
        "bodyHtml": "Pyke stores (9% + (0.2% Lethality)) of damage taken from champions, increased to (40% + (0.4% Lethality)) when there's more than one enemy nearby. Pyke can store up to (80 + (800% bonus Attack Damage)) damage. While <span>unseen</span> by enemies, he rapidly regenerates this stored damage.<br /><br />Additionally, Pyke converts all Maximum Health increases to Attack Damage instead at a rate of <span class=\"text-green-600 dark:text-green-400\">14 Health</span> to <span class=\"text-red-600 dark:text-red-500 font-semibold\">1 Attack Damage</span>.",
        "iconFile": "PykePassive.png",

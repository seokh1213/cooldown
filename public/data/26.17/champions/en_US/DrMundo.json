    "abilities": {
      "P": {
        "slot": "P",
        "id": "DrMundoP",
        "name": "Goes Where He Pleases",
        "maxRank": 0,
        "summary": "Dr. Mundo resists the first Immobilizing effect that hits him, instead losing Health and dropping a chemical cannister nearby. Dr. Mundo can pick it up by walking over it, restoring Health and reducing this Ability's Cooldown.<br><br>Dr. Mundo also has significantly increased Health regeneration.<br>",
        "bodyHtml": "Dr. Mundo resists the first <span class=\"text-purple-600 dark:text-purple-500\">Immobilizing</span> effect that hits him, instead losing <span class=\"text-green-600 dark:text-green-400\">4% current Health</span> and dropping a chemical cannister nearby for 7 seconds. Moving over it reduces this Ability's Cooldown by 15 seconds and restores <span class=\"text-green-600 dark:text-green-400\">4% max Health</span>. Enemy champions moving over the cannister destroy it.<br /><br />Dr. Mundo regenerates <span class=\"text-green-600 dark:text-green-400\">(0.4% ~ 0.65%) max Health</span> every 5 seconds.",
        "iconFile": "DrMundo_P.png",

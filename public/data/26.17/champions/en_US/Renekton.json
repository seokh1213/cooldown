      "P": {
        "slot": "P",
        "id": "RenektonPredator",
        "name": "Reign of Anger",
        "maxRank": 0,
        "summary": "Renekton's attacks generate Fury, increased when he is low on life. This Fury can empower his abilities with bonus effects.",
        "bodyHtml": "Renekton gains <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5 Fury</span> per Attack. While above <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">50 Fury</span>, his next Ability spends it to become empowered. <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Fury</span> decays while out of combat.<br /><br />While below 50% Health, Renekton gains 50% increased <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Fury</span>.",
        "iconFile": "Renekton_Passive.png",

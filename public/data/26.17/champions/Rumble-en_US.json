    "passive": {
      "name": "Junkyard Titan",
      "description": "Rumble's Abilities generate <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Heat</span>. While above <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">50 Heat</span>, he enters the <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Danger Zone</span>, causing his basic Abilities to gain bonus effects. When he reaches <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">150 Heat</span>, he overheats for 4 seconds. <br /><br />While overheated, Rumble <span class=\"text-purple-600 dark:text-purple-500\">Silences</span> himself, but gains <span>(50% ~ 130%) Attack Speed</span> and causes his Attacks to deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(25% Ability Power) plus 4% max Health magic damage</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Percent damage is limited to (65 ~ 150) damage on Monsters. </span>",
      "image": {
        "full": "Rumble_JunkyardTitan1.png",
        "sprite": "passive3.png",
        "group": "passive",
        "x": 144,
        "y": 96,
        "w": 48,
        "h": 48
      },
      "summary": "Every spell Rumble casts gives him Heat. When he reaches 50% Heat he reaches Danger Zone, granting all his basic abilities bonus effects. When he reaches 100% Heat, he starts Overheating, gaining bonus Attack Speed and granting his basic attacks bonus damage, but making him unable to cast spells for a few seconds.",
      "spellId": "RumbleHeatSystem",
      "tooltipSource": "communitydragon"
    },

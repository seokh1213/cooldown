    "passive": {
      "name": "Battle Fury",
      "description": "Tryndamere's Attacks grant him <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5 Fury</span> or <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">10 Fury</span> for a critical strike, and <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">10 Fury</span> for killing a unit. After 8 seconds of being out of combat, Tryndamere loses <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">5 Fury</span> every second.<br /><br />Each point of <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Fury</span> grants 0.5% Critical Strike Chance.",
      "image": {
        "full": "Tryndamere_Passive.png",
        "sprite": "passive4.png",
        "group": "passive",
        "x": 48,
        "y": 96,
        "w": 48,
        "h": 48

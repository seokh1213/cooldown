    "localized": {
      "ko_KR": {
        "name": "이케시아식 마무리",
        "summary": "코그모가 죽으면 4초 후 폭발하여 주변 적에게 고정 피해를 입힙니다.",
        "tooltip": "코그모가 죽은 후 4초 동안 유닛을 통과해 계속 움직일 수 있으며 <span class=\"text-cyan-600 dark:text-cyan-500\">이동 속도가 10%</span> 증가하고 지속시간 동안 <span class=\"text-cyan-600 dark:text-cyan-500\">이동 속도가 50%</span>까지 증가합니다. 지속시간이 끝나면 폭발하여 근처 적에게 <span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">(140 ~ 650)의 고정 피해</span>를 입힙니다."
      },
      "en_US": {
        "name": "Icathian Surprise",
        "summary": "4 seconds after dying, Kogmaw explodes, dealing true damage to surrounding enemies.",
        "tooltip": "For 4 seconds after dying, Kog'Maw can continue to move, can move through units, and gains <span class=\"text-cyan-600 dark:text-cyan-500\">10% Move Speed</span>, increasing to <span class=\"text-cyan-600 dark:text-cyan-500\">50% Move Speed</span> over the duration. At the end of the duration, he explodes and deals <span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">(140 ~ 650) true damage</span> to nearby enemies."
      },
      "zh_CN": {
        "name": "来自艾卡西亚的惊喜",
        "summary": "在死后4秒，克格莫会爆炸，对周围的敌人造成真实伤害。",
        "tooltip": "在阵亡后的4秒里，克格莫能够继续移动，能够无视单位碰撞体积，并且获得<span class=\"text-cyan-600 dark:text-cyan-500\">10%移动速度</span>，在此期间持续提升至<span class=\"text-cyan-600 dark:text-cyan-500\">50%移动速度</span>。持续时间结束时，他会爆炸并对附近敌人造成<span class=\"text-yellow-600 dark:text-yellow-500 font-semibold\">(140 ~ 650)真实伤害</span>。"
      }
    }
  }

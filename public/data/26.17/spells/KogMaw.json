  "passive": {
    "id": "KogMawIcathianSurpriseReady",
    "path": "Characters/KogMaw/Spells/KogMawIcathianSurpriseReadyAbility/KogMawIcathianSurpriseReady",
    "locKeys": {
      "keyName": "game_character_passiveName_KogMaw",

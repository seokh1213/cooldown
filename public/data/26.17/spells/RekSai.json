    "localized": {
      "ko_KR": {
        "name": "제르사이의 분노",
        "summary": "렉사이의 기본 공격과 기본 스킬이 적중할 때마다 분노가 생성됩니다. 생성된 분노는 매복 상태일 때 체력 회복에 사용됩니다.",
        "tooltip": "렉사이는 기본 공격 시 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25의 분노</span>를, 기본 스킬 사용 시 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25의 분노</span>를 생성합니다.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">매복 상태</span>에서 렉사이가 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">분노</span>를 소모해 3초 동안 최대 <span class=\"text-green-600 dark:text-green-400\">의 체력</span>을 회복합니다. 체력 회복량은 레벨에 따라 증가합니다."
      },
      "en_US": {
        "name": "Fury of the Xer'Sai",
        "summary": "Rek'Sai generates Fury by Attacking and hitting with basic Abilities. She consumes this Fury while Burrowed to restore health.",
        "tooltip": "Rek'Sai generates <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25 Fury</span> when she Attacks and <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25 Fury</span> from Abilities.<br /><br />While <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Burrowed</span>, she consumes her <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Fury</span> to restore up to <span class=\"text-green-600 dark:text-green-400\"> Health</span> over 3 seconds, increasing with level."
      },
      "zh_CN": {
        "name": "艾克塞之怒",
        "summary": "雷克塞可通过攻击和命中基础技能来生成怒气。她在位于地下时可消耗怒气来回复生命值。",
        "tooltip": "雷克塞的攻击生成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25怒气</span>，技能生成<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25怒气</span>。<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">位于地下</span>时，她会消耗<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">怒气</span>，3秒内持续最多回复<span class=\"text-green-600 dark:text-green-400\">生命值</span>，随等级提升。"
      }
    }
  }

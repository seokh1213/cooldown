    },
    "localized": {
      "ko_KR": {
        "name": "죽지 않는 복수심",
        "summary": "적을 처치하거나 어시스트를 올리면 잠시 바루스의 공격력과 주문력이 상승합니다. 대상이 챔피언인 경우 공격력과 주문력이 더 큰 폭으로 상승합니다.",
        "tooltip": "바루스가 적을 처치하면 15초간 <span>공격 속도가 20%</span>, <span class=\"text-orange-600 dark:text-orange-500\">공격력이 (1100%)</span>, <span class=\"text-blue-600 dark:text-blue-400\">주문력이 (1100%)</span> 상승합니다.<br /><br />챔피언 처치 관여 시 <span>공격 속도가 30%</span> (최고 공격 속도 제한을 초과할 수 있음), <span class=\"text-orange-600 dark:text-orange-500\">공격력이 (3300%)</span>, <span class=\"text-blue-600 dark:text-blue-400\">주문력이 (3300%)</span> 상승합니다."
      },
      "en_US": {
        "name": "Living Vengeance",
        "summary": "On kill or assist, Varus temporarily gains Attack Damage and Ability Power. This bonus is larger if the enemy is a champion.",
        "tooltip": "When Varus kills an enemy, he gains <span>20% Attack Speed</span>, <span class=\"text-orange-600 dark:text-orange-500\">(1100%) Attack Damage</span>, and <span class=\"text-blue-600 dark:text-blue-400\">(1100%) Ability Power</span> for 15 seconds.<br /><br />Champion takedowns grant <span>30% Attack Speed</span> that can bypass the Attack Speed cap, <span class=\"text-orange-600 dark:text-orange-500\">(3300%) Attack Damage</span>, and <span class=\"text-blue-600 dark:text-blue-400\">(3300%) Ability Power</span> instead."
      },
      "zh_CN": {
        "name": "复仇之欲",
        "summary": "每完成一次击杀或助攻，韦鲁斯就会暂时获得攻击速度、攻击力和法术强度。如果敌人是个英雄，则这个加成的幅度会更大。",
        "tooltip": "韦鲁斯在每击杀一名敌人后，就会获得持续15秒的<span>20%攻击速度</span>、<span class=\"text-orange-600 dark:text-orange-500\">(1100%)攻击力</span>、和<span class=\"text-blue-600 dark:text-blue-400\">(1100%)法术强度</span>。<br /><br />参与击杀英雄后会使这个加成转而提供<span>30%攻击速度</span>(能够突破攻速上限)、<span class=\"text-orange-600 dark:text-orange-500\">(3300%)攻击力</span>、和<span class=\"text-blue-600 dark:text-blue-400\">(3300%)法术强度</span>。"
      }
    }
  }

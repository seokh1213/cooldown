    "localized": {
      "ko_KR": {
        "name": "마나 보호막",
        "summary": "체력이 낮아지면 블리츠크랭크가 마나에 비례하여 보호막을 얻습니다.",
        "tooltip": "블리츠크랭크의 체력이 30% 미만이 되면 10초 동안 <span class=\"text-blue-600 dark:text-blue-300\">(35% 마나)의 피해를 흡수하는 보호막</span>을 얻습니다."
      },
      "en_US": {
        "name": "Mana Barrier",
        "summary": "Blitzcrank gains a shield based on their mana when dropping to low health.",
        "tooltip": "When Blitzcrank falls below 30% Health, they gain <span class=\"text-blue-600 dark:text-blue-300\">(35% Mana) Shield</span> for 10 seconds."
      },
      "zh_CN": {
        "name": "法力屏障",
        "summary": "布里茨在血量过低时会获得一层基于它法力值的护盾。",
        "tooltip": "当布里茨跌到30%生命值以下时，它会获得持续10秒的<span class=\"text-blue-600 dark:text-blue-300\">(35% 法力值)护盾值</span>。"
      }
    }

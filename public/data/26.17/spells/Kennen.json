    "localized": {
      "ko_KR": {
        "name": "폭풍의 표식",
        "summary": "케넨의 스킬에 3번 적중당한 적은 기절합니다.",
        "tooltip": "케넨의 스킬이 적중하면 6초 동안 중첩이 1회 쌓입니다. 중첩이 3회 쌓이면 해당 적은 1.25초 동안 <span class=\"text-purple-600 dark:text-purple-500\">기절</span>하며 케넨이 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25의 기력</span>을 얻습니다."
      },
      "en_US": {
        "name": "Mark of the Storm",
        "summary": "Kennen stuns enemies he hits 3 times with his abilities.",
        "tooltip": "Kennen's abilities apply a stack for 6 seconds. At 3 stacks, enemies are <span class=\"text-purple-600 dark:text-purple-500\">Stunned</span> for 1.25 seconds and Kennen gains <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25 Energy</span>."
      },
      "zh_CN": {
        "name": "【忍法！雷缚印】",
        "summary": "凯南在用他的技能命中同一敌方3次后，会将其晕眩。",
        "tooltip": "凯南的技能会施加一层持续6秒的印记。在3层时，敌人会被<span class=\"text-purple-600 dark:text-purple-500\">晕眩</span>1.25秒并且凯南会回复<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25能量</span>。"
      }
    }

    "localized": {
      "ko_KR": {
        "name": "약자 멸시",
        "summary": "제드가 체력이 낮은 적을 기본 공격하면 마법 피해를 추가로 입힙니다. 같은 적 챔피언에게는 몇 초가 지나야 이 효과가 다시 적용됩니다.",
        "tooltip": "제드가 체력 50% 이하인 적을 기본 공격하면 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">대상 최대 체력의 에 해당하는 마법 피해</span>를 추가로 입힙니다. 같은 적 챔피언에게는 이 효과가 10초에 한 번씩만 적용됩니다."
      },
      "en_US": {
        "name": "Contempt for the Weak",
        "summary": "Zed's basic attacks against low health targets deals bonus Magic Damage. This effect can only occur once every few seconds against the same enemy champion.",
        "tooltip": "Whenever Zed Attacks an enemy below 50% Health, he deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\"> max Health magic damage</span>. Enemy champions can only be hit once every 10 seconds."
      },
      "zh_CN": {
        "name": "影忍法！灭魂劫",
        "summary": "劫的普通攻击会对低生命值的目标造成额外魔法伤害。这个特效在数秒内只能对相同的敌方英雄生效一次。",
        "tooltip": "当劫对一名低于50%生命值的敌人进行攻击时，他会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">最大生命值的魔法伤害</span>。敌方英雄在10秒里只会受到一次此效果。"
      }
    }
  }
}
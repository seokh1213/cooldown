  "passive": {
    "id": "NaafiriP",
    "path": "Characters/Naafiri/Spells/NaafiriPAbility/NaafiriP",
    "locKeys": {
      "keyName": "Spell_NaafiriP_Name",
      "keySummary": "Spell_NaafiriP_Summary",
      "keyTooltip": "Spell_NaafiriP_Tooltip"
    },
    "localized": {
      "ko_KR": {
        "name": "늘어나는 무리",
        "summary": "나피리가 자신이 공격하거나 스킬을 사용하는 대상을 함께 공격하는 무리를 소환합니다.",
        "tooltip": "나피리가 자신이 지정한 적을 공격해 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(4% 추가 공격력)의 물리 피해</span>를 입히는 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">무리</span>를 10초마다 한 마리씩 생성합니다. 나피리가 스킬을 사용한 후에는 피해량이 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(5.2% 추가 공격력)</span>까지 증가합니다. <br /><br />챔피언과 대형 몬스터에게 스킬이 적중하면 이 스킬의 재사용 대기시간이 4초 감소합니다. 적을 처치하면 1초 감소합니다.<br /><br />최대 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">무리</span> 수: 5"
      },
      "en_US": {
        "name": "We Are More",
        "summary": "Naafiri spawns packmates that attack the targets of her attacks and abilities.",
        "tooltip": "Naafiri creates a <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Packmate</span> every 10 seconds that will Attack enemies that she targets for <span class=\"text-red-600 dark:text-red-500 font-semibold\">(4% bonus Attack Damage) physical damage</span>, increased to <span class=\"text-red-600 dark:text-red-500 font-semibold\">(5.2% bonus Attack Damage)</span> after she uses an Ability. <br /><br />Hitting champions and large monsters with Abilities reduces this Ability's Cooldown by 4 seconds. Killing enemies reduces it by 1 seconds.<br /><br />Max <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Packmates</span>: 5"
      },
      "zh_CN": {
        "name": "狂烈种群",
        "summary": "纳亚菲利生成狗群伙伴，它们会在她攻击或施放技能时攻击目标。",
        "tooltip": "纳亚菲利每10秒生成一个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">狗群伙伴</span>，它会攻击被她选取的目标，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(4% 额外攻击力)物理伤害</span>，在她使用一个技能后，这个伤害提升至<span class=\"text-red-600 dark:text-red-500 font-semibold\">(5.2% 额外攻击力)</span>。<br /><br />用技能命中英雄和大型野怪会使这个技能的冷却时间缩短4秒。击杀敌人会使这个技能的冷却时间缩短1秒。<br /><br />最大<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">狗群伙伴</span>数量：5"
      }
    }
  }
}
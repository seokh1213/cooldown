    "localized": {
      "ko_KR": {
        "name": "프렐요드의 부름",
        "summary": "누누가 윌럼프와 주변 아군 1명의 공격 속도와 이동 속도를 증가시키고, 윌럼프의 기본 공격이 대상 근처의 적에게 피해를 줍니다.",
        "tooltip": "챔피언, 대형 정글 몬스터, 또는 구조물에 피해를 입히면 4초 동안 누누와 윌럼프, 주변 아군의 공격 속도가 <span>20%</span> 증가하고 이동 속도가 <span class=\"text-cyan-600 dark:text-cyan-500\">10%</span> 증가합니다.<br /><br />강화 효과가 지속되는 동안 기본 공격 시 주변 적들에게 최대 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(30% 공격력)의 추가 물리 피해</span>를 입힙니다."
      },
      "en_US": {
        "name": "Call of the Freljord",
        "summary": "Nunu increases the attack speed and Move Speed of Willump and a nearby ally, and causes Willump's basic attacks to damage enemies around the target.",
        "tooltip": "When Nunu and Willump deal damage to champions, large jungle monsters, or structures, they and a nearby ally gain <span>20% Attack Speed</span> and <span class=\"text-cyan-600 dark:text-cyan-500\">10% Move Speed</span> for 4 seconds.<br /><br />Willump's Attacks deal an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(30% Attack Damage) physical damage</span> to other nearby enemies while he has this buff."
      },
      "zh_CN": {
        "name": "弗雷尔卓德的召唤",
        "summary": "努努提升威朗普和一名附近友军的攻击速度和移动速度，并使威朗普的普攻可以伤害目标周围的敌人。",
        "tooltip": "当努努和威朗普对英雄、野怪或建筑物造成伤害时，他们和一名附近的友方英雄会获得<span>20%攻击速度</span>和<span class=\"text-cyan-600 dark:text-cyan-500\">10%移动速度</span>，持续4秒。<br /><br />当威朗普有这个增益时，威朗普的攻击会对附近的其他敌人造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">(30% 攻击力)物理伤害</span>。"
      }
    }
  }

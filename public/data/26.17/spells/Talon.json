    "localized": {
      "ko_KR": {
        "name": "검의 최후",
        "summary": "탈론이 챔피언이나 대형 몬스터에게 스킬을 사용하면 최대 3회까지 중첩되는 상처가 남습니다. 상처가 3회 중첩된 챔피언에게 기본 공격을 가하면 출혈을 일으켜 일정 시간 동안 큰 피해를 입힙니다.",
        "tooltip": "탈론이 챔피언이나 대형 정글 몬스터에게 스킬을 사용해 피해를 입히면 6초 동안 중첩을 적용합니다. (최대 3회 중첩)<br /><br />3회 중첩된 대상에게 탈론이 기본 공격을 가하면 2초에 걸쳐 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(210% 추가 공격력)의 물리 피해</span>를 추가로 입힙니다."
      },
      "en_US": {
        "name": "Blade's End",
        "summary": "Talon's spells Wound champions and large monsters, stacking up to 3 times. When Talon attacks a champion with 3 stacks of Wound, they bleed for heavy damage over time.",
        "tooltip": "Talon's Abilities apply a stack to champions and large jungle monsters they damage for 6 seconds (max 3 stacks).<br /><br />When Talon Attacks a target with 3 stacks, he deals an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">(210% bonus Attack Damage) physical damage</span> over 2 seconds."
      },
      "zh_CN": {
        "name": "刀锋之末",
        "summary": "泰隆的技能会创伤英雄和大型野怪，可叠加3层。当泰隆用普攻攻击一个带有3层创伤效果的目标时，目标会流血，受到重度的持续伤害。",
        "tooltip": "泰隆的技能会对英雄和大型野怪施加一层效果，持续6秒(至多可叠3层)。<br /><br />当泰隆攻击一个带有3层效果的目标时，他会在2秒里持续造成共<span class=\"text-red-600 dark:text-red-500 font-semibold\">(210% 额外攻击力)额外物理伤害</span>。"
      }
    }
  }

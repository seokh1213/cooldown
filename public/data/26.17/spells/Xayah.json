    "localized": {
      "ko_KR": {
        "name": "관통상",
        "summary": "스킬 사용 후 다음 기본 공격이 경로에 있는 적을 모두 관통하고 <font color='#C200E1'>깃털</font>을 남깁니다.",
        "tooltip": "스킬 사용 후 다음 회 기본 공격이 경로에 있는 모든 적에게의 피해를 입히고 초 동안 유지되는 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">깃털</span>을 남깁니다.<br /><br /><span>연인의 귀환:</span> 자야와 라칸은 동시에 귀환할 수 있습니다."
      },
      "en_US": {
        "name": "Clean Cuts",
        "summary": "After using an ability, Xayah's next basic attacks will hit all targets along their path and leave a <font color='#C200E1'>Feather</font>.",
        "tooltip": "After using an Ability, Xayah's next Attacks will deal damage to all other targets along their path and leave a <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Feather</span> for seconds.<br /><br /><span>Lover's Leap:</span> Xayah and Rakan can recall together."
      },
      "zh_CN": {
        "name": "锐切",
        "summary": "在使用一次技能后，霞的下几次普攻将命中沿途的所有敌人，并各落下一根<font color='#C200E1'>羽毛</font>。",
        "tooltip": "在使用一个技能后，霞的下次攻击将对沿途的所有目标造成伤害并留下一支持续秒的<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">羽毛</span>。<br /><br /><span>情人跃：</span>洛和霞可以一起回城。"
      }
    }
  }

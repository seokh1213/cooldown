  "passive": {
    "id": "AmbessaPassive",
    "path": "Characters/Ambessa/Spells/AmbessaPassiveAbility/AmbessaPassive",
    "locKeys": {
      "keyName": "Spell_AmbessaP_Name",
      "keySummary": "Spell_AmbessaP_Summary",
      "keyTooltip": "Spell_AmbessaP_Tooltip"
    },
    "localized": {
      "ko_KR": {
        "name": "용사냥개의 발걸음",
        "summary": "스킬을 사용하는 동안 기본 공격 또는 이동 명령을 하면 암베사가 스킬을 사용한 후 짧은 거리를 돌진하며 다음 기본 공격의 사거리, 피해량, 공격 속도가 증가하고 기력을 돌려받습니다.",
        "tooltip": "암베사가 스킬을 사용할 때 기본 공격 또는 이동 명령을 하면 암베사가 스킬을 사용한 후 명령을 내린 방향으로 돌진합니다.<br /><br />이 스킬이 개시될 때마다 암베사에게 4초 동안 충전이 부여됩니다. (최대: 3) 충전을 보유하고 있으면 <span> 공격 사거리가 75</span>, <span> 공격 속도가 50%</span> 증가합니다. 기본 공격 시 충전을 하나 소모해 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(25% 추가 공격력)의 물리 피해</span>를 입히고 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">70의 기력</span>을 회복합니다."
      },
      "en_US": {
        "name": "Drakehound's Step",
        "summary": "Entering an attack or movement command while casting an ability will cause Ambessa to dash a short distance once the ability is cast, granting her next attack bonus range, damage, and attack speed, and refunding energy.",
        "tooltip": "When Ambessa is casting an Ability, issuing a Move or Attack order will cause her to dash in that direction after the Ability finishes.<br /><br />Each cast initiation grants her a charge for 4 seconds (max: 3). While Ambessa has a charge, she gains <span>75 Attack Range</span> and <span>50% Attack Speed</span>. Attacks consume a charge to deal <span class=\"text-red-600 dark:text-red-500 font-semibold\">(25% bonus Attack Damage) physical damage</span> and restore <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">70 Energy</span>."
      },
      "zh_CN": {
        "name": "龙犬诡步",
        "summary": "在施放技能的同时输入攻击或移动指令，会使安蓓萨在施放技能后冲刺一小段距离，为她的下一次攻击提供额外的攻击距离、伤害和攻击速度，并返还能量。",
        "tooltip": "在安蓓萨施放技能的起手阶段，下达移动或攻击指令，会让她在技能施放完成后朝该方向冲刺一段距离。<br /><br />每次施放都会为她带来一层持续4秒的充能（最多3层）。安蓓萨拥有充能时，获得<span>75攻击距离</span>和<span>50%攻击速度</span>。攻击会消耗一层充能，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(25% 额外攻击力)物理伤害</span>并回复<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">70能量</span>。"
      }
    }
  }
}
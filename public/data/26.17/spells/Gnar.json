  "passive": {
    "id": "GnarPassive",
    "path": "Characters/Gnar/Spells/GnarPassiveAbility/GnarPassive",
    "locKeys": {
      "keyName": "Spell_GnarPassive_Name",
      "keySummary": "Spell_GnarPassive_Summary",

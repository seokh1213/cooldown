      "ko_KR": {
        "name": "독성 급류",
        "summary": "신지드가 근처 챔피언을 회피하며 일시적으로 이동 속도가 증가합니다.",
        "tooltip": "신지드가 근처 아군 챔피언이나 적 챔피언을 회피하며 2초 동안 <span class=\"text-cyan-600 dark:text-cyan-500\">이동 속도가 25%</span> 증가합니다. 이 효과에는 챔피언당 8초의 재사용 대기시간이 적용됩니다."
      },
      "en_US": {
        "name": "Noxious Slipstream",
        "summary": "Singed drafts off nearby champions, gaining a burst of Move Speed when passing them.",
        "tooltip": "Singed drafts off of nearby allied or enemy champions, gaining <span class=\"text-cyan-600 dark:text-cyan-500\">25% Move Speed</span> for 2 seconds. This effect has an 8 second Cooldown per champion."
      },
      "zh_CN": {
        "name": "剧毒冲流",
        "summary": "辛吉德借助附近英雄进行漂移，在经过他们时获得爆发性的移动速度加成。",
        "tooltip": "辛吉德将借助附近英雄的冲流，来获得持续2秒的<span class=\"text-cyan-600 dark:text-cyan-500\">25%移动速度</span>。这个效果在每个英雄身上拥有8秒冷却时间。"
      }
    }

    "localized": {
      "ko_KR": {
        "name": "매사냥",
        "summary": "데마시아 독수리 발러가 주기적으로 적에게 <keywordMajor>매사냥</keywordMajor> 표식을 남깁니다. <keywordMajor>매사냥</keywordMajor> 대상에 대한 퀸의 첫 번째 기본 공격은 추가 물리 피해를 입힙니다.",
        "tooltip": "초마다 발러가 근처 적에게 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">매사냥</span> 표식을 남겨 4초간 모습을 드러내게 합니다. 퀸의 다음 기본 공격 <span>적중 시</span> 해당 대상에게 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(40% 추가 공격력)의 추가 물리 피해</span>를 입힙니다."
      },
      "en_US": {
        "name": "Harrier",
        "summary": "Valor, Quinn's Demacian eagle, periodically marks enemies with <keywordMajor>Harrier</keywordMajor>. Quinn's first basic attack against <keywordMajor>Harrier</keywordMajor> targets will deal bonus physical damage.",
        "tooltip": "Every seconds, Valor marks a nearby enemy with <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Harrier</span>, revealing it for 4 seconds and causing Quinn's next Attack <span>On-Hit</span> against them to deal <span class=\"text-red-600 dark:text-red-500 font-semibold\">(40% bonus Attack Damage) bonus physical damage</span>."
      },
      "zh_CN": {
        "name": "侵扰",
        "summary": "华洛，奎因的德玛西亚鹰，会周期性地用<keywordMajor>侵扰</keywordMajor>标记敌人。奎因对<keywordMajor>侵扰</keywordMajor>目标的第一次普攻将造成额外物理伤害。",
        "tooltip": "每过秒，华洛就会用<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">侵扰</span>标记一名附近的敌人，使其显形4秒并使奎因对其进行的下次攻击 <span>攻击特效</span>造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(40% 额外攻击力)额外物理伤害</span>。"
      }
    }
  }

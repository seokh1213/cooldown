    "localized": {
      "ko_KR": {
        "name": "공허 태세",
        "summary": "일정 시간 동안 군중 제어기에 적중당하거나 피해를 입지 않으면 받는 피해량이 큰 폭으로 감소하고 군중 제어기에 면역이 됩니다. 이 효과는 피해를 입거나 군중 제어기에 적중당하면 잠시 후 사라집니다.",
        "tooltip": "피해를 입거나 군중 제어기에 적중당하면 0.25초 동안 받는 피해량이 90% 감소하고, <span class=\"text-purple-600 dark:text-purple-500\">방해</span> 및 <span class=\"text-purple-600 dark:text-purple-500\">이동 불가</span>에 면역됩니다. 이 효과는 12초 후 다시 활성화됩니다."
      },
      "en_US": {
        "name": "Void Shift",
        "summary": "When he hasn't recently taken damage or been crowd controlled, Malzahar gains massive damage reduction and crowd control immunity, lingering for a short period after taking damage.",
        "tooltip": "Malzahar gains 90% damage reduction and immunity from <span class=\"text-purple-600 dark:text-purple-500\">Disabling</span> and <span class=\"text-purple-600 dark:text-purple-500\">Immobilizing</span> effects, lingering for 0.25 seconds after taking damage or blocking one of those effects. This effect has a 12 second Cooldown."
      },
      "zh_CN": {
        "name": "虚空穿越",
        "summary": "玛尔扎哈如果近期没有受到伤害或控制效果，就会获得巨幅伤害减免和免疫控制的效果，并且这个效果在受到伤害后还会残留一小段时间。",
        "tooltip": "玛尔扎哈获得90%伤害减免并免疫<span class=\"text-purple-600 dark:text-purple-500\">限制</span>和<span class=\"text-purple-600 dark:text-purple-500\">定身</span>效果，并且在受到或格挡了一次那些效果后，会存留0.25秒。这个效果有12秒的冷却时间。"
      }
    }
  }

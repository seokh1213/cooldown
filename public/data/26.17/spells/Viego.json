  "passive": {
    "id": "ViegoPassive",
    "path": "Characters/Viego/Spells/ViegoPassiveAbility/ViegoPassive",
    "locKeys": {
      "keyName": "Spell_ViegoPassive_Name",
      "keySummary": "Spell_ViegoPassive_Summary",

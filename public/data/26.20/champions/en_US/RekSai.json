          {
            "key": "B",
            "label": "Burrowed",
            "id": "RekSaiQBurrowed",
            "name": "Prey Seeker",
            "iconPath": "assets/characters/reksai/hud/icons2d/reksai_q2.png",
            "iconVersion": "16.20",
            "bodyHtml": "No Cost<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Burrowed:</span> Rek'Sai launches a burst of void-charged earth that explodes on the first enemy hit, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(50/80/110/140/170 + ([[si:scalead]]25% bonus Attack Damage) + ([[si:scaleap]]70% Ability Power)) magic damage</span> in a small area. It also reveals non-stealthed enemies for 5 seconds. If it hits a Champion, it generates <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">25 Fury</span>.",
            "cooldownSeconds": [
              12,

            "iconPath": "assets/characters/reksai/hud/icons2d/reksai_q1.png",
            "iconVersion": "16.20",
            "bodyHtml": "No Cost<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Unburrowed:</span> Rek'Sai's next 3 Attacks within 3 seconds gain <span>35% Attack Speed</span> and deal an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">([[si:scalead]]30/35/40/45/50% Attack Damage) physical damage</span> to nearby enemies. Attacks refresh the duration of this Ability.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">The bonus damage can critically strike the primary target.</span>",
            "cooldownSeconds": [
              4,

      "locale": "en_US",
      "tier": "tooltip",
      "text": "When Milio's Abilities touch ally champions, their next Attack or Ability deals (7% ~ 15%) ally Attack Damage as additional magic damage, plus ((10 ~ 50) + (20% Ability Power)) magic damage over 1.5 seconds.",
      "variant": null
    },

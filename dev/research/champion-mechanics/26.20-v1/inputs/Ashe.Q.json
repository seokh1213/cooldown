{
  "champion": "Ashe",
  "slot": "Q",
  "patch": "26.20",
  "slotRole": "ability",
  "sources": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Ashe builds up Focus by attacking. At maximum Focus, Ashe can cast Ranger's Focus to consume all stacks of Focus, temporarily increasing her Attack Speed and transforming her basic attack into a powerful flurry attack for the duration.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Passive: Ashe's Attacks grant a stack for 4 seconds. At 4 stacks, she may activate this Ability. Active: Ashe gains 20/30/40/50/60% Attack Speed and her Attacks deal (110/115/120/125/130% Attack Damage) damage instead for 6 seconds. The empowered Attacks are comprised of a flurry of 5 small strikes. They only apply on-hit effects once per Attack.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "애쉬는 공격을 계속하면 집중이 오릅니다. 집중 중첩이 최대치에 이르면 이를 모두 소모해 애쉬가 궁사의 집중을 사용할 수 있으며, 이 때 애쉬의 공격 속도가 잠시 동안 증가하고 그 동안 기본 공격이 강력한 다발 공격으로 변합니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "기본 지속 효과: 애쉬가 기본 공격 시 4초 동안 유지되는 중첩이 1회 쌓입니다. 4회 중첩 시 이 스킬을 사용할 수 있습니다. 사용 시: 6초 동안 애쉬의 공격 속도가 20/30/40/50/60% 오르며 기본 공격이 (110/115/120/125/130% 공격력)의 피해를 입힙니다. 강화된 기본 공격은 5개의 작은 공격을 한꺼번에 퍼붓습니다. 적중 시 효과는 기본 공격당 한 번만 적용됩니다.",
      "variant": null
    }
  ],

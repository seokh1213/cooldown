      "locale": "en_US",
      "tier": "tooltip",
      "text": "Using an Ability grants Riven a charge for 6 seconds (max 3). Her Attacks spend a charge to deal an additional ((30% ~ 45%) Attack Damage) physical damage.",
      "variant": null

  "sourceRefs": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Hammer Stance: Leaps to an enemy dealing physical damage and slowing enemies. Cannon Stance: Fires an orb of electricity that detonates upon hitting an enemy (or reaching the end of its path) dealing physical damage to all enemies hit.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Mercury Hammer: Jayce leaps to an enemy, dealing (60/110/160/210/260/310 + (135% bonus Attack Damage)) physical damage to surrounding enemies and Slowing them by 35/40/45/50/55/60% for 2 seconds. Deals 10 bonus damage to jungle monsters.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "해머 사용 시: 공중으로 도약해 적들에게 물리 피해를 입히고 이동 속도를 감소시킵니다. 캐논 사용 시: 적을 맞히거나 사거리 끝에 닿으면 폭발하는 전기 구체를 발사해 맞은 적 모두에게 물리 피해를 입힙니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "머큐리 해머: 제이스가 적에게 도약해 주변 적들에게 (60/110/160/210/260/310 + (135% 추가 공격력))의 물리 피해를 입히고 2초 동안 35/40/45/50/55/60% 둔화시킵니다. 정글 몬스터에게는 10의 추가 피해를 입힙니다.",
      "variant": null
    },
    {
      "id": "form:A:en",
      "text": "Mercury Hammer: Jayce leaps to an enemy, dealing (60/110/160/210/260/310 + (135% bonus Attack Damage)) physical damage to surrounding enemies and Slowing them by 35/40/45/50/55/60% for 2 seconds. Deals 10 bonus damage to jungle monsters.",
      "locale": "en_US",
      "tier": "tooltip",
      "variant": "form:A"
    },
    {
      "id": "form:B:en",
      "text": "Mercury Cannon: Jayce fires an orb of electricity, dealing (80/121/162/203/244/285 + (130% bonus Attack Damage)) physical damage to the first enemy hit and all surrounding enemies. Firing this orb through Acceleration Gate increases the range, speed and raises the damage to (112/169.4/226.8/284.2/341.6/399 + (182% bonus Attack Damage)). Deals 10 bonus damage to jungle monsters.",
      "locale": "en_US",
      "tier": "tooltip",
      "variant": "form:B"
    }
  ],

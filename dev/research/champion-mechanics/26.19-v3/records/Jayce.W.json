  "sourceRefs": [
    {
      "id": "en:summary",
      "locale": "en_US",
      "tier": "summary",
      "text": "Hammer Stance: Passive: Restores Mana per strike. Active: Creates a field of lightning damaging nearby enemies for several seconds. Cannon Stance: Gains a burst of energy, increasing Attack Speed to maximum for several attacks.",
      "variant": null
    },
    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Mercury Hammer - Passive: Jayce's Hammer Attacks grant 15/17/19/21/23/25 Mana. Mercury Hammer - Active: Jayce creates an electric aura dealing (140/200/260/320/380/440 + (100% Ability Power)) magic damage over 4 seconds.",
      "variant": null
    },
    {
      "id": "ko:summary",
      "locale": "ko_KR",
      "tier": "summary",
      "text": "해머 사용 시: 기본 지속 효과: 매 공격 시마다 마나가 회복됩니다. 사용 시: 몇 초 동안 주위 적에게 피해를 입히는 전류 역장을 생성합니다. 캐논 사용 시: 동력이 대폭 증가하여 다음 몇 차례의 공격에 대한 공격 속도가 최대로 증가합니다.",
      "variant": null
    },
    {
      "id": "ko:body",
      "locale": "ko_KR",
      "tier": "tooltip",
      "text": "머큐리 해머 - 기본 지속 효과: 해머로 공격 시 제이스의 마나가 15/17/19/21/23/25 회복됩니다. 머큐리 해머 - 사용 시: 제이스가 전류 오라를 생성해 4초 동안 (140/200/260/320/380/440 + (100% 주문력))의 마법 피해를 입힙니다.",
      "variant": null
    },
    {
      "id": "form:A:en",
      "text": "Mercury Hammer - Passive: Jayce's Hammer Attacks grant 15/17/19/21/23/25 Mana. Mercury Hammer - Active: Jayce creates an electric aura dealing (140/200/260/320/380/440 + (100% Ability Power)) magic damage over 4 seconds.",
      "locale": "en_US",
      "tier": "tooltip",
      "variant": "form:A"
    },
    {
      "id": "form:B:en",
      "text": "Mercury Cannon: Jayce overcharges his cannon, gaining maximum Attack Speed for his next 3 Attacks. These Attacks deal (70/78/86/94/102/110% Attack Damage) physical damage.",
      "locale": "en_US",
      "tier": "tooltip",
      "variant": "form:B"
    }

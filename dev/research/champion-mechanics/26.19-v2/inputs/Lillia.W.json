    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Lillia winds up a huge strike, dealing (80/100/120/140/160 + (35% Ability Power)) magic damage. Enemies in the center take (240/300/360/420/480 + (105% Ability Power)) damage instead. Lillia does not dash over terrain with this ability. Deals 50% less damage to minions.",
      "variant": null
    },

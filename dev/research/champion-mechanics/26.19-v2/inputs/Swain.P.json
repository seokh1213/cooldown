    {
      "id": "en:body",
      "locale": "en_US",
      "tier": "tooltip",
      "text": "Swain collects Soul Fragments from Vision of Empire, Nevermove, and enemy champion deaths. Soul Fragments restore 6% maximum Health and permanently grant Swain 15 max Health. Total Health gained: 15",
      "variant": null
    },

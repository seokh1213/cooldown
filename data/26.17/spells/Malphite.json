    "localized": {
      "ko_KR": {
        "name": "화강암 방패",
        "summary": "말파이트는 여러 겹의 돌로 감싸여 있어 자신의 최대 체력 10%만큼의 피해를 흡수할 수 있습니다. 말파이트가 몇 초 동안 공격 받지 않으면 보호막이 재생성됩니다.",
        "tooltip": "말파이트가 (8 ~ 6)초 동안 피해를 입지 않으면 <span class=\"text-blue-600 dark:text-blue-300\">(10% 체력)의 피해를 흡수하는 보호막</span>을 얻습니다."
      },
      "en_US": {
        "name": "Granite Shield",
        "summary": "Malphite is shielded by a layer of rock which absorbs damage up to 10% of his maximum Health. If Malphite has not been hit for a few seconds, this effect recharges.",
        "tooltip": "Malphite grants himself <span class=\"text-blue-600 dark:text-blue-300\">(10% Health) Shield</span> after not taking damage for (8 ~ 6) seconds."
      },
      "zh_CN": {
        "name": "花岗岩护盾",
        "summary": "墨菲特被岩石护盾保护，最多吸收10%最大生命值的伤害，若数秒内墨菲特未受到攻击，护盾将重置。",
        "tooltip": "在未受到伤害(8 ~ 6)秒后，墨菲特为自身提供<span class=\"text-blue-600 dark:text-blue-300\">(10% 生命值)护盾值</span>。"
      }
    }
  }

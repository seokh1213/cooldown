    "localized": {
      "ko_KR": {
        "name": "슈리마의 유산",
        "summary": "아지르는 무너진 아군 포탑이나 적 포탑 위에 태양 포탑을 소환할 수 있습니다.",
        "tooltip": "아지르는 무너진 포탑 위에 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">태양 원판</span>을 소환할 수 있습니다. <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">태양 원판</span>은 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(230 + (40% 주문력))의 마법 피해</span>를 입히고 30의 <span class=\"text-orange-600 dark:text-orange-400\">방어력</span>과 <span>마법 저항력</span>을 가지며 45초에 걸쳐 붕괴합니다."
      },
      "en_US": {
        "name": "Shurima's Legacy",
        "summary": "Azir can summon the Disc of the Sun from the ruins of allied or enemy turrets.",
        "tooltip": "Azir can summon the <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Sun Disc</span> from the rubble of a turret. The <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Sun Disc</span> deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(230 + (40% Ability Power)) magic damage</span> and has 30 <span class=\"text-orange-600 dark:text-orange-400\">Armor</span> and <span>Magic Resist</span> but disintegrates over 45 seconds."
      },
      "zh_CN": {
        "name": "恕瑞玛的传承",
        "summary": "阿兹尔可以从友方或敌方防御塔的废墟中召唤太阳圆盘。",
        "tooltip": "阿兹尔能够在一座防御塔的废墟上召唤<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">太阳圆盘</span>。<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">太阳圆盘</span>造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(230 + (40% 法术强度))魔法伤害</span>并且拥有30 <span class=\"text-orange-600 dark:text-orange-400\">护甲</span>和<span>魔法抗性</span>，但会在45秒里持续瓦解。"
      }
    }
  }

  "passive": {
    "id": "AkshanPassive",
    "path": "Characters/Akshan/Spells/AkshanPassiveAbility/AkshanPassive",
    "locKeys": {
      "keyName": "Spell_AkshanPassive_Name",
      "keySummary": "Spell_AkshanPassive_Summary",
      "keyTooltip": "Spell_AkshanPassive_Tooltip"
    },
    "localized": {
      "ko_KR": {
        "name": "비열한 싸움",
        "summary": "아크샨의 기본 공격 및 스킬이 세 번 적중할 때마다 추가 물리 피해를 입힙니다. 대상이 챔피언인 경우 아크샨이 보호막을 얻습니다.<br><br>아크샨이 기본 공격 후 피해량이 감소한 두 번째 공격을 발사합니다. 추가 공격을 도중에 취소하면 대신 이동 속도가 증가합니다.",
        "tooltip": "아크샨이 기본 공격 후 두 번째 공격을 발사해서 <span class=\"text-red-600 dark:text-red-500 font-semibold\">(50% 공격력)의 물리 피해</span>를 입힙니다. 두 번째 공격을 도중에 취소하면 <span class=\"text-cyan-600 dark:text-cyan-500\">이동 속도가 (20 ~ 75)</span> 증가했다가 1초에 걸쳐 원래대로 돌아옵니다.<br /><br />기본 공격 또는 스킬이 세 번째로 적중할 때마다 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(150 + (60% 주문력))의 마법 피해</span>를 추가로 입힙니다. 대상이 챔피언인 경우, 2초간 <span class=\"text-blue-600 dark:text-blue-300\">(35% 추가 공격력)의 피해</span>를 흡수하는 보호막을 얻습니다. (재사용 대기시간 4초)<br /><br />"
      },
      "en_US": {
        "name": "Dirty Fighting",
        "summary": "Every three hits from Akshan's Attacks and Abilities deals bonus damage and grants him a Shield if the target was a champion.<br><br>When Akshan Attacks, he fires an additional Attack for reduced damage. If he cancels the additional Attack, he instead gains Move Speed.",
        "tooltip": "After launching an Attack, Akshan will fire an additional shot for <span class=\"text-red-600 dark:text-red-500 font-semibold\">(50% Attack Damage) physical damage</span>. He can cancel this shot to instead gain <span class=\"text-cyan-600 dark:text-cyan-500\">(20 ~ 75) Move Speed</span> decaying over 1 second.<br /><br />Every three hits from Attacks or Abilities deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(150 + (60% Ability Power)) magic damage</span>. Against champions, Akshan also gains <span class=\"text-blue-600 dark:text-blue-300\">(35% bonus Attack Damage) Shield</span> for 2 seconds (4 second Cooldown).<br /><br />"
      },
      "zh_CN": {
        "name": "无所不用",
        "summary": "来自阿克尚攻击或技能的每第三次命中会造成额外伤害，并且如果目标是英雄还会为他提供一层护盾。<br><br>在阿克尚攻击时，他会进行一次额外的射击，来造成较少伤害。如果他取消掉了这次额外射击，那么他会转而获得移动速度。",
        "tooltip": "在打出一次攻击后，阿克尚将进行一次额外的射击，造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(50% 攻击力)物理伤害</span>。阿克尚可以取消这次射击来转而获得在1秒里持续衰减的<span class=\"text-cyan-600 dark:text-cyan-500\">(20 ~ 75)移动速度</span>。<br /><br />来自攻击或技能的每第三次命中会造成额外<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(150 + (60% 法术强度))魔法伤害</span>。如果目标是英雄，阿克尚还会获得<span class=\"text-blue-600 dark:text-blue-300\">(35% 额外攻击力)护盾值</span>，持续2秒(4秒冷却时间)。"
      }
    }
  }
}
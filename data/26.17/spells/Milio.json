    "localized": {
      "ko_KR": {
        "name": "타오르는 힘",
        "summary": "밀리오의 스킬에 닿은 아군은 다음 공격으로 큰 추가 피해를 입히고 대상을 불태웁니다.",
        "tooltip": "밀리오의 스킬에 닿은 아군 챔피언의 다음 기본 공격 또는 스킬이 <span class=\"text-red-600 dark:text-red-500 font-semibold\">아군 공격력의 15%</span>에 해당하는 추가 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">마법 피해</span>를 입히며, 1.5초 동안 <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20% 주문력)의 마법 피해</span>를 입힙니다."
      },
      "en_US": {
        "name": "Fired Up!",
        "summary": "Milio's abilities enchant allies on touch, making their next damage deal a burst of extra damage and burn the target.",
        "tooltip": "When Milio's Abilities touch ally champions, their next Attack or Ability deals <span class=\"text-red-600 dark:text-red-500 font-semibold\">15% ally Attack Damage</span> as additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">magic damage</span>, plus <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20% Ability Power) magic damage</span> over 1.5 seconds."
      },
      "zh_CN": {
        "name": "热情洋溢！",
        "summary": "米利欧的技能可以为队友提供增益，让他们下一次伤害造成更多伤害，并点燃目标。",
        "tooltip": "当米利欧的技能触碰到友方英雄时，会使其下一个攻击或技能造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">15%该友方英雄攻击力</span>的额外<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">魔法伤害</span>，外加在1.5秒里持续造成的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(20% 法术强度)魔法伤害</span>。"
      }
    }
  }

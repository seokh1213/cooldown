    "localized": {
      "ko_KR": {
        "name": "전투 태세",
        "summary": "칼리스타가 기본 공격이나 꿰뚫는 창의 준비 동작을 하는 동안 이동 명령을 하면, 칼리스타가 기본 공격과 함께 해당 위치로 도약합니다."
      },
      "en_US": {
        "name": "Martial Poise",
        "summary": "Enter a movement command while winding up Kalista's basic attack or Pierce to lunge a short distance when she launches her attack."
      },
      "zh_CN": {
        "name": "武术姿态",
        "summary": "如果卡莉丝塔在进行普攻或穿刺的同时被下达了移动指令，那么她会在发起进攻的同时朝着这个移动指令的方向位移小段距离。"
      }
    }
  }

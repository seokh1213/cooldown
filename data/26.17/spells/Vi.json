    "localized": {
      "ko_KR": {
        "name": "폭발 보호막",
        "summary": "바이는 시간이 흐르면 보호막이 1회 충전됩니다. 이 보호막은 적을 스킬로 적중시키면 활성화됩니다.",
        "tooltip": "바이가 스킬을 적이나 구조물에 맞히면 3초 동안 <span class=\"text-blue-600 dark:text-blue-300\">(12% 체력)의 피해를 흡수하는 보호막</span>을 얻습니다."
      },
      "en_US": {
        "name": "Blast Shield",
        "summary": "Vi charges a shield over time. The shield can be activated by hitting an enemy with an ability.",
        "tooltip": "Vi gains <span class=\"text-blue-600 dark:text-blue-300\">(12% Health) Shield</span> for 3 seconds after hitting an enemy or structure with an activated Ability."
      },
      "zh_CN": {
        "name": "爆裂护盾",
        "summary": "蔚持续为护盾充能。护盾会在蔚的技能命中一名敌人后激活。",
        "tooltip": "蔚在用一个已激活的技能命中一名敌人或建筑物后，会获得<span class=\"text-blue-600 dark:text-blue-300\">(12% 生命值)护盾值</span>，持续3秒。"
      }
    }

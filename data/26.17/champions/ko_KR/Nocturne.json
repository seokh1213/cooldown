    "abilities": {
      "P": {
        "slot": "P",
        "id": "NocturneP",
        "name": "그림자 칼날",
        "maxRank": 0,
        "summary": "몇 초마다 녹턴의 기본 공격이 주변 적에게 추가 물리 피해를 입히고 녹턴의 체력을 회복시킵니다. <br><br>녹턴이 기본 공격 시 이 효과의 재사용 대기시간이 감소합니다.",
        "bodyHtml": "12초마다 녹턴이 다음 기본 공격 시 주변 모든 적을 공격해 <span class=\"text-red-600 dark:text-red-500 font-semibold\">([[si:scalead]]120% 공격력)의 물리 피해</span>를 입히고 적중한 대상 하나당 <span class=\"text-green-600 dark:text-green-400\">체력을 ((13 ~ 32) + ([[si:scaleap]]30% 주문력))</span> 회복합니다.<br /><br />녹턴이 기본 공격 시 이 스킬의 재사용 대기시간이 1초 감소합니다. (적 챔피언이나 정글 몬스터 공격 시 3초 감소)",
        "iconFile": "Nocturne_UmbraBlades.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

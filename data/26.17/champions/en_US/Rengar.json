      "W": {
        "slot": "W",
        "id": "RengarW",
        "name": "Battle Roar",
        "maxRank": 5,
        "summary": "Rengar lets out a battle roar, damaging enemies and healing for some of the recent damage he has taken.<br><br>Ferocity effect: additionally breaks crowd control effects.",
        "bodyHtml": "Rengar roars, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(50/80/110/140/170 + (80% Ability Power)) magic damage</span> to nearby enemies and restoring <span class=\"text-green-600 dark:text-green-400\">50%</span> of the damage taken in the last 1.5 seconds as Health.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Max Ferocity:</span> Deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(80% Ability Power) magic damage</span> and additionally cleanses Rengar of crowd control.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(65 ~ 130) magic damage</span> to jungle monsters. Restores <span class=\"text-green-600 dark:text-green-400\">100%</span> of damage taken from jungle monsters.</span>",

      "Q": {
        "slot": "Q",
        "id": "ZacQ",
        "name": "Stretching Strikes",
        "maxRank": 5,
        "summary": "Zac stretches an arm, grabbing an enemy. Attacking a different enemy will cause him to throw both targets towards each other.",
        "bodyHtml": "Zac stretches his arm out, attaching it to the first enemy hit to deal <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + (30% Ability Power) + (3% bonus Health)) magic damage</span> and briefly <span class=\"text-purple-600 dark:text-purple-500\">Slow</span> them. Zac's next Attack gains increased range and applies the same damage and <span class=\"text-purple-600 dark:text-purple-500\">Slow</span>. <br /><br />If Zac hits a <span>different</span> enemy with this Attack, he <span class=\"text-purple-600 dark:text-purple-500\">Knocks Up</span> both towards each other. If they collide, they and surrounding enemies take <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60/90/120/150/180 + (30% Ability Power) + (3% bonus Health)) magic damage</span> and are briefly <span class=\"text-purple-600 dark:text-purple-500\">Slowed</span>.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\"><span class=\"text-purple-600 dark:text-purple-500\">Slows</span> by 40%. <br />Maximum magic damage: <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(120/180/240/300/360 + (60% Ability Power) + (6% bonus Health)).</span></span>",
        "iconFile": "ZacQ.png",

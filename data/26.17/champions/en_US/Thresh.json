        "name": "Damnation",
        "maxRank": 0,
        "summary": "Thresh can harvest the souls of enemies that die near him, permanently granting him Armor and Ability Power.",
        "bodyHtml": "Thresh collects the <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Souls</span> of dead enemies by walking near them. Each <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Soul</span> grants him <span class=\"text-orange-600 dark:text-orange-400\">1 Armor</span> and <span class=\"text-blue-600 dark:text-blue-400\">1 Ability Power</span>.",

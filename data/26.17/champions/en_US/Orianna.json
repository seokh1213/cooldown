      "P": {
        "slot": "P",
        "id": "OriannaP",
        "name": "Clockwork Windup",
        "maxRank": 0,
        "summary": "Orianna's Attacks deal additional magic damage. This damage increases the more Orianna Attacks the same target.",
        "bodyHtml": "Orianna's Abilities originate from her <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Ball</span>. Orianna's <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Ball</span> automatically returns to her if she is too far away from it.<br /><br />Orianna's Attacks deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((10 ~ 50) + ([[si:scaleap]]15% Ability Power)) magic damage</span>. Subsequent Attacks against the same target within 4 seconds deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((1.5 ~ 7.5) + (2.25% Ability Power)) magic damage</span> (max of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((3 ~ 15) + (4.5% Ability Power)) damage</span>).",

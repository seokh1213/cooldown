    "abilities": {
      "P": {
        "slot": "P",
        "id": "KaisaPassive",
        "name": "Second Skin",
        "maxRank": 0,
        "summary": "Kai'Sa's basic attacks stack Plasma, dealing increasing bonus magic damage. Allies' immobilizing effects help stack Plasma. Additionally, Kai'Sa's item purchases upgrade her basic spells to have more powerful properties.",
        "bodyHtml": "Kai'Sa's Attacks stack <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Plasma</span> for 4 seconds and deal an additional <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(12% Ability Power) plus (3% Ability Power) per stack magic damage</span>. Attacking an enemy with 4 stacks consumes the <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Plasma</span>, dealing <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(15% + (0.06% Ability Power)) missing Health magic damage</span>. Nearby allies apply 1 stack to champions they <span class=\"text-purple-600 dark:text-purple-500\">Immobilize</span>.<br /><br />Kai'Sa's suit evolves her basic Abilities based on her stats.<br /><span>Icathian Rain</span>: <span class=\"text-red-600 dark:text-red-500 font-semibold\">?/? Bonus Attack Damage</span><br /><span>Void Seeker</span>: <span class=\"text-blue-600 dark:text-blue-400\">?/? Ability Power</span><br /><span>Supercharge</span>: <span>?%/?% Bonus Attack Speed</span>",
        "iconFile": "Kaisa_Passive.png",

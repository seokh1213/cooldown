      "Q": {
        "slot": "Q",
        "id": "SkarnerQ",
        "name": "Shattered Earth / Upheaval",
        "maxRank": 5,
        "summary": "Skarner rips a boulder from the earth that empowers his attacks and can be thrown as a powerful projectile.",
        "bodyHtml": "Skarner rips a boulder from the ground, empowering his next 3 Attacks with <span>20/25/30/35/40% Attack Speed</span> and dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(10/20/30/40/50 + (90% bonus Attack Damage) + (3% bonus Health)) physical damage</span> to surrounding enemies. His final Attack will deal an additional <span class=\"text-red-600 dark:text-red-500 font-semibold\">11% max Health physical damage</span> and <span class=\"text-purple-600 dark:text-purple-500\">Slow</span> affected foes by 40% for 1s.<br /><br /><span class=\"text-yellow-600 dark:text-yellow-300\">Recast:</span> Skarner ends this Ability and throws his boulder, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\"> + max Health physical damage</span>, and additionally <span class=\"text-purple-600 dark:text-purple-500\">Slowing</span> the first enemy hit — and any other surrounding enemies — by for s.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Percent Health Damage to monsters is capped at 150/200/250/300/350.<br />This Ability deals 100% to structures.</span>",

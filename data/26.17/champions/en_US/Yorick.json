      "E": {
        "slot": "E",
        "id": "YorickE",
        "name": "Mourning Mist",
        "maxRank": 5,
        "summary": "Yorick throws a globule of Black Mist that reduces armor, damages, slows and marks enemies. Summoned units gain move speed when moving towards marked targets. ",
        "bodyHtml": "Yorick throws a globule of Black Mist that deals <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(6/6.5/7/7.5/8% + (0.03% Ability Power)) max Health magic damage</span>, <span class=\"text-purple-600 dark:text-purple-500\">Slows</span> by 30% for 1.5 seconds and marks champions and monsters for 4 seconds. Marked enemies continuously <span>Awaken</span> nearby graves (but not exceeding the maximum of 4) and suffer <span class=\"text-orange-600 dark:text-orange-400\">13/16/19/22/25% reduced Armor</span>.<br /><br />Yorick and his summoned units gain <span class=\"text-cyan-600 dark:text-cyan-500\">18/21/24/27/30% Move Speed</span> toward the mark. <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">Mist Walkers</span> will leap once at marked enemies that get away from them.<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Deals a minimum of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(70/105/140/175/210 + (100% Ability Power)) magic damage</span> to lane Minions.<br />Deals a maximum of <span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(50/75/100/125/150 + (100% Ability Power)) magic damage</span> to jungle Monsters.</span>",
        "iconFile": "YorickE.png",

        "id": "BelvethPassive",
        "name": "Death in Lavender ",
        "maxRank": 0,
        "summary": "Bel'Veth gains permanent attack speed stacks after taking down large minions and monsters and champions. She also gains temporary bonus attack speed after using an ability.",
        "bodyHtml": "After using an Ability, Bel'Veth becomes Ghosted and gains <span>(20% ~ 20%) Attack Speed</span> for 3 seconds.<br /><br />Bel'veth gains <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">1 Lavender</span> stack for large minion and monster takedowns and <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">2 Lavender</span> stacks for champion and epic monster takedowns. Each stack permanently grants <span>(0.1 ~ 1.8)Attack Speed</span>.<br /><br />Total bonus <span>Attack Speed</span>: <span>(0.1 ~ 1.8)</span>",
        "iconFile": "Belveth_Passive.png",

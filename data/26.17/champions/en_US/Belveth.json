      "E": {
        "slot": "E",
        "id": "BelvethE",
        "name": "Royal Maelstrom",
        "maxRank": 5,
        "summary": "Bel'Veth roots herself in place, channeling a storm of slashes around her that targets the lowest-health enemy and grants her lifesteal and damage reduction.",
        "bodyHtml": "Bel'Veth channels and slashes around herself, gaining 20/30/40/50/60% Damage Reduction, 20/25/30/35/40% Life Steal, and Attacking ? times over 1.5 seconds with the number of Attacks increasing based on her <span>Attack Speed</span>. Each Attack strikes the lowest-health enemy, dealing <span class=\"text-red-600 dark:text-red-500 font-semibold\">(10/12/14/16/18 + (12% Attack Damage))</span> to <span class=\"text-red-600 dark:text-red-500 font-semibold\">(20/24/28/32/36 + (24% Attack Damage)) physical damage</span> based on the target's missing Health.<br /><br />Using another Ability or <span class=\"text-yellow-600 dark:text-yellow-300\">Recasting</span> ends this Ability early.<br /><br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">Attacks from this Ability deal 200% damage to monsters and apply On-Hit Effects at 12% to 24% effectiveness based on the target's missing Health.</span><br />",

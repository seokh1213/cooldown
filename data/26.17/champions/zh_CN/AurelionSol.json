    "abilities": {
      "P": {
        "slot": "P",
        "id": "AurelionSolPassive",
        "name": "星海焕然",
        "maxRank": 0,
        "summary": "奥瑞利安·索尔的伤害型技能会将敌人们化为<font color='#3458eb'>星尘</font>，星尘可用来永久增强他的每个技能。 ",
        "bodyHtml": "奥瑞利安·索尔的伤害型技能会将敌人们化为<span style=\"color: #3458eb\">星尘</span>，星尘可用来永久增强他的每个技能。<span><span>?</span>：爆发造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">0.03%最大生命值的魔法伤害</span></span><span><span>?</span>：?%距离提升。</span><span><span>?</span>：?%区域提升和<span>0.03</span>额外处决阈值。</span><span><span>?和?</span>：?%区域提升。</span><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">奥瑞利安·索尔已获取的<span style=\"color: #3458eb\">星尘</span>数量：<span style=\"color: #3458eb\">?</span></span>",
        "iconFile": "AurelionSolP.png",
        "cooldownSeconds": [],

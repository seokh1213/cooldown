    "abilities": {
      "P": {
        "slot": "P",
        "id": "RenektonPredator",
        "name": "怒之领域",
        "maxRank": 0,
        "summary": "雷克顿的攻击会产生【怒气】，在它的生命值较低时产生更多【怒气】。【怒气】可以强化他的基础技能，使它们具有额外效果。",
        "bodyHtml": "雷克顿每次攻击获得<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\"> 5怒气</span>。在<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">50怒气</span>以上时，他的下一个技能会花费<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">怒气</span>以获得强化。 <span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">怒气</span>会在脱离战斗后衰减。<br /><br />在低于50%生命值时，雷克顿获得50%<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">怒气</span>提升。",
        "iconFile": "Renekton_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

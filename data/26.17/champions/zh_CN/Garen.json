      "W": {
        "slot": "W",
        "id": "GarenW",
        "name": "勇气",
        "maxRank": 5,
        "summary": "盖伦被动地通过击杀敌人来提升护甲和魔法抗性。他也可以激活这个技能来暂时获得一层护盾和韧性，并在接下来的较长持续时间里获得较弱的伤害减免效果。",
        "bodyHtml": "<span class=\"text-gray-600 dark:text-gray-500 italic\">被动：</span>盖伦获得<span class=\"text-orange-600 dark:text-orange-400\">0.2额外护甲</span>和<span>0.2额外魔法抗性</span>。击杀单位时会永久提供<span>0.2双抗</span>，至多至最大值<span>30</span>。<br /><br /><span class=\"text-gray-900 dark:text-white font-semibold\">主动：</span>盖伦加固他的勇气4秒，使即将到来的伤害降低25/29/33/37/41%。他还会获得持续0.75秒的<span class=\"text-blue-600 dark:text-blue-300\">(65/85/105/125/145 + (18% 额外生命值))护盾值</span>和<span>60%韧性</span>。",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "SeraphinePassive",
        "name": "星光漫射",
        "maxRank": 0,
        "summary": "萨勒芬妮施放的每第三个技能将进行双重施放。此外，施放技能时，附近的友军会为她的下一次普通攻击提供额外魔法伤害和攻击距离。",
        "bodyHtml": "萨勒芬妮施放的每第三个技能将会产生回响，以自动施放第二次。<br /><br />此外，萨勒芬妮会从她的友军身上汲取灵感，每当她施放技能时，附近的每位友方英雄都会为她生成一个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">音符</span>。每个<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">音符</span>都会使萨勒芬妮提升25攻击距离并造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((4 ~ 25) + ([[si:scaleap]]4% 法术强度))魔法伤害</span>，之后<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">音符</span>会被消耗掉。",
        "iconFile": "Seraphine_Passive.png",
        "cooldownSeconds": [],
        "range": [],

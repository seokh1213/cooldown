    "abilities": {
      "P": {
        "slot": "P",
        "id": "IreliaPassive",
        "name": "艾欧尼亚热诚",
        "maxRank": 0,
        "summary": "当艾瑞莉娅用技能命中敌人时，她会获得可叠加的攻击速度加成。这个效果在满层时还会为艾瑞莉娅提供攻击附伤。",
        "bodyHtml": "艾瑞莉娅在用一个技能命中一名敌人时，会获得一层持续6秒的效果(最大4层)。每层效果为她提供<span>(10 ~ 25)攻击速度</span>，并在满层时她的攻击会造成额外的<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((10 ~ 3) + ([[si:scalead]]20% 额外攻击力))魔法伤害</span>。<br /><br />攻击一个英雄、建筑或大型野怪，会刷新效果的持续时间。艾瑞莉娅每命中一个英雄都会获得一层效果，或在至少命中一个非英雄的敌人时获得一层效果。",
        "iconFile": "Irelia_Passive.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {

    "abilities": {
      "P": {
        "slot": "P",
        "id": "QuinnPassive",
        "name": "侵扰",
        "maxRank": 0,
        "summary": "华洛，奎因的德玛西亚鹰，会周期性地用<keywordMajor>侵扰</keywordMajor>标记敌人。奎因对<keywordMajor>侵扰</keywordMajor>目标的第一次普攻将造成额外物理伤害。",
        "bodyHtml": "每过?秒，华洛就会用<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">侵扰</span>标记一名附近的敌人，使其显形4秒并使奎因对其进行的下次攻击 <span>攻击特效</span>造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">(40% 额外攻击力)额外物理伤害</span>。",
        "iconFile": "Quinn_Passive.png",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "NilahPassive",
        "name": "喜色川流",
        "maxRank": 0,
        "summary": "尼菈在对小兵进行补刀时可获得提升过的经验值，并且能够增强与分享附近的来自她友方的治疗和护盾效果。",
        "bodyHtml": "当尼菈击杀一个小兵时，她和距她最近的那名友方英雄获得50%他们本该因分享击杀而正常损失的经验值。<br /><br />尼菈在获得来自友方英雄技能提供的治疗和护盾时，会将<span class=\"text-green-600 dark:text-green-400\">治疗效能提升7.5%</span>，将<span class=\"text-blue-600 dark:text-blue-300\">护盾效能提升15%</span>。如果一名友方英雄对她提供了治疗或护盾，那么该友方英雄自身也将获得相当于该提升数额的护盾和治疗。如果一名友方英雄对其自身提供了治疗或护盾，那么尼菈也将获得该额外效果。",
        "iconFile": "NIlahP.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
        "simulation": {
          "status": "unavailable",

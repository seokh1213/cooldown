    "abilities": {
      "P": {
        "slot": "P",
        "id": "NeekoPassive",
        "name": "天生幻魅",
        "maxRank": 0,
        "summary": "妮蔻可以假扮成一名友方英雄或地图上的其它单位。承受定身类限制效果、施放伤害型的技能、以非英雄单位的状态对敌方防御塔造成伤害、或者你的假扮受到了相当于其生命条的伤害时，都会打破这个假扮状态。",
        "bodyHtml": "妮蔻可以将自身假扮成地图上的其它单位。她在任何时候都可以假扮成一名友方英雄；在她紧挨着任何友方或中立单位时，她会储存其烁玛并使她能够假扮成该单位。你的假扮状态将在以下情况被打破：受到<span class=\"text-purple-600 dark:text-purple-500\">定身类控制效果</span>、施放一个伤害型的技能、假扮非英雄单位时对敌方防御塔造成伤害、或者受到了与假扮对象生命条相等的伤害。 <br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">妮蔻会获得她假扮单位的很多属性，包括有益和有害的。</span>",
        "iconFile": "Neeko_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],

    "abilities": {
      "P": {
        "slot": "P",
        "id": "KSanteP",
        "name": "血性本能",
        "maxRank": 0,
        "summary": "奎桑提的技能会标记目标来使他的下一次攻击对其造成更多伤害。<br><br>在全盛姿态下，奎桑提的所有攻击和技能造成更多伤害。",
        "bodyHtml": "奎桑提的伤害型技能会标记命中的敌人。攻击被标记的敌人可以造成<span class=\"text-red-600 dark:text-red-500 font-semibold\">12外加最大生命值的物理伤害</span>并消耗掉该标记。<br /><br /><span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">全盛姿态</span>：奎桑提的攻击、技能和被动造成额外的(1% + (0.01% 额外护甲) + (0.01% 额外魔法抗性))最大生命值的物理伤害。",
        "iconFile": "Icons_KSante_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

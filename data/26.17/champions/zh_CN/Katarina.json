    "abilities": {
      "P": {
        "slot": "P",
        "id": "KatarinaPassive",
        "name": "贪婪",
        "maxRank": 0,
        "summary": "每当一名在过去3秒被卡特琳娜所伤害的敌方英雄阵亡时，卡特琳娜的技能的冷却时间就会显著减少。<br><br>如果卡特琳娜拾起一把<font color='#FFF673'>匕首</font>，她会用它来斩击附近的所有敌人以造成魔法伤害。",
        "bodyHtml": "每当一名在过去3秒被卡特琳娜所伤害的敌方英雄阵亡时，卡特琳娜的技能的冷却时间就会减少15秒。<br /><br />如果卡特琳娜拾起一把<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">匕首</span>，她会用它来斩击附近的所有敌人来造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(60% 额外攻击力)魔法伤害</span>。",
        "iconFile": "Katarina_Passive.png",

    "abilities": {
      "P": {
        "slot": "P",
        "id": "TahmKenchPassive",
        "name": "培养品味",
        "maxRank": 0,
        "summary": "塔姆将他那庞大身躯的分量夹杂在他的攻击和技能中，从而使他能造成基于自身总生命值的额外伤害。对敌方英雄造成伤害时，塔姆可以在目标身上叠加<spellName>培养品味</spellName>的层数。当敌方英雄身上的层数到达3时，塔姆可以使用<spellName>大快朵颐</spellName>来吞噬这名敌方英雄。",
        "bodyHtml": "普攻造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(10 + (4% 额外生命值) + (0% 法术强度))额外魔法伤害</span>。 对英雄时，普攻会添加一层持续5秒的<span>?</span>，至多至3层。<br /><br />在3层时，对这个英雄施放的<span>巨舌鞭笞</span>和<span style=\"color: #0bf7de\">大快朵颐</span>会获得强化效果。",
        "iconFile": "TahmKenchP.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],

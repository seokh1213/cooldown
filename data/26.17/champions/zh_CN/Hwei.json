    "abilities": {
      "P": {
        "slot": "P",
        "id": "HweiPassive",
        "name": "落款",
        "maxRank": 0,
        "summary": "彗准备在那些受到他的技能伤害的敌人们身上留下落款。<br><br>用另一个伤害型技能命中时，即可完成他的落款，将其留在敌人脚下。落款会在短暂延迟后引爆，对范围内的所有敌人造成魔法伤害。",
        "bodyHtml": "彗的伤害型技能会对敌方英雄施加持续4秒的标记。<br /><br />用第二个伤害型技能命中被标记的敌人，即可在其脚下生成一次爆炸，对范围内的所有敌人造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">(35% 法术强度)魔法伤害</span>。",
        "iconFile": "HweiPassive.png",

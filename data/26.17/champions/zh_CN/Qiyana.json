      "P": {
        "slot": "P",
        "id": "QiyanaPassive",
        "name": "凌人贵气",
        "maxRank": 0,
        "summary": "奇亚娜对每名敌人发起的第一次普攻或技能会造成额外伤害。",
        "bodyHtml": "奇亚娜的攻击和技能会造成额外的<span class=\"text-red-600 dark:text-red-500 font-semibold\">((15 ~ 67) + (25% 额外攻击力) + (30% 法术强度))物理伤害</span>。这个效果对每个目标有25秒冷却时间。<br /><br />使用<span>?</span>来获得一个不同的武器<span class=\"text-yellow-600 dark:text-yellow-400 font-semibold\">附魔</span>的同时，会重置这个效果对所有目标的冷却时间。",
        "iconFile": "Qiyana_Passive.png",

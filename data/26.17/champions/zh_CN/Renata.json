    "abilities": {
      "P": {
        "slot": "P",
        "id": "RenataPassive",
        "name": "物尽其用",
        "maxRank": 0,
        "summary": "烈娜塔的攻击会造成额外伤害并标记敌人。烈娜塔的队友在对被标记的敌人造成伤害时可以造成额外伤害。",
        "bodyHtml": "烈娜塔的攻击会标记敌人6秒，并且会对未被标记的敌人造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((1% ~ 1.52%) + ([[si:scaleap]]每100点法术强度2%))最大生命值的魔法伤害</span>。<br /><br />友方英雄的攻击或技能会消耗掉这个标记，来造成<span class=\"text-blue-600 dark:text-blue-500 font-semibold\">((1% ~ 1.52%) + ([[si:scaleap]]每100点法术强度2%))最大生命值的魔法伤害</span>。<br /><br /><span class=\"text-gray-600 dark:text-gray-400 italic\">烈娜塔同一时间只能保留一个目标身上的标记。</span>",
        "iconFile": "Renata_P.png",
        "cooldownSeconds": [],
        "range": [],
        "rankValues": [],
        "scalings": [],
